#Использовать ".."

Процедура Проверить(Условие, Текст)
	Если Не Условие Тогда ВызватьИсключение Текст; КонецЕсли;
КонецПроцедуры

Если АргументыКоманднойСтроки.Количество() > 0 Тогда
	Клиент = Новый КлиентХранилища(АргументыКоманднойСтроки[0], "8.5.1.1529");
	Клиент.Подключиться("test", "test", "Repo");
	Отказ = Ложь;
	Попытка Клиент.СписокВерсий(); Исключение Отказ = СтрНайти(ОписаниеОшибки(), "history denied") > 0; КонецПопытки;
	Проверить(Отказ, "Ошибка истории не должна возвращать пустой список.");
	ЗавершитьРаботу(0);
КонецЕсли;

Параметры = Новый Структура("ИмяХранилища,ВерсияПлатформы,ПользовательХранилища,ХешПароляПользователя", "Repo", "8.5.1.1529", "test", "hash");
Тело = МенеджерЗапросов.ТелоЗапросаПолученияВерсийХранилища(Параметры);
Чтение = Новый ЧтениеXML; Чтение.УстановитьСтроку(Тело); Границ = 0;
Пока Чтение.Прочитать() Цикл
	Если Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента И (Чтение.ЛокальноеИмя = "beginVerNum" Или Чтение.ЛокальноеИмя = "endVerNum") Тогда
		Проверить(Чтение.ПолучитьАтрибут("value") = "-1", "Границы истории должны быть атрибутами value=-1.");
		Границ = Границ + 1;
	КонецЕсли;
КонецЦикла;
Чтение.Закрыть(); Проверить(Границ = 2, "Отсутствуют границы истории.");
Путь = ОбъединитьПути(ТекущийСценарий().Каталог, "fixtures", "version_history.xml");
Текст = Новый ЧтениеТекста(Путь, КодировкаТекста.UTF8); XML = Текст.Прочитать(); Текст.Закрыть();
Ответ = ОбработкаXML.ПрочитатьОтветИзТекста(XML);
Версии = Ответ.РезультатЧтения.Получить("call_return")._Элементы.Получить("versions");
Количество = 0;
Для Каждого Узел Из Версии Цикл
	Версия = Новый ВерсияХранилища; Версия.Заполнить(Узел["value"]["second"]);
	Проверить(ТипЗнч(Версия.Номер) = Тип("Число") И Версия.Номер = 42, "Номер версии не преобразован в число.");
	Проверить(Версия.ВнутренняяВерсия = "217.3" И Версия.Версия1С = "8.5.1.1529", "Неверно прочитаны версии формата и платформы.");
	Проверить(Версия.Комментарий = "История: проверка & тест", "Повреждён комментарий истории.");
	Проверить(Версия.Версия = "TCP-test" И ТипЗнч(Версия.Дата) = Тип("Дата"), "Неверно прочитаны свойства версии.");
	Количество = Количество + 1;
КонецЦикла;
Проверить(Количество = 1, "Неверное количество записей истории.");
Сообщить("История: XML-диапазон, номера, комментарий и версии формата/платформы проверены.");
