#Использовать ".."
Функция Объект(Вид, ИД, Родитель, Имя)
 О = Новый ОбъектХранилища; О.Идентификатор = ИД; О.ИдентификаторКласса = ИдентификаторыМетаданных.ИдентификаторКласса(Вид);
 О.Имя = Имя; О.Позиция = 0; О.НомерВерсии = 1; О.НомерСобственнойВерсии = 1;
 О.ИдентификаторРодителя = Родитель; О.ИдентификаторВладельца = "00000000-0000-0000-0000-000000000000";
 О.ИсходнаяВерсия = "2222222222222222222222222222222200000000"; О.ЛокальнаяВерсия = О.ИсходнаяВерсия; О.Удален = Ложь;
 Возврат О;
КонецФункции
Функция Описание(О)
 Возврат Новый Структура("id,class_id,name,pos,parent_id,owner_id,original,local", О.Идентификатор, О.ИдентификаторКласса, О.Имя, О.Позиция, О.ИдентификаторРодителя, О.ИдентификаторВладельца, О.ИсходнаяВерсия, О.ЛокальнаяВерсия);
КонецФункции
Для Каждого Вид Из СтрРазделить("Role,XDTOPackage", ",") Цикл
 Корень = Объект("Configuration", "11111111-1111-4111-8111-111111111111", "00000000-0000-0000-0000-000000000000", "Root");
 НовыйОбъект = Объект(Вид, "33333333-3333-4333-8333-333333333333", Корень.Идентификатор, "Created");
 Снимок = Новый СнимокОбъектаХранилища; Снимок.Объект = Корень; Снимок.ВерсияХранилища = "44444444-4444-4444-8444-444444444444";
 Снимки = Новый Массив; Снимки.Добавить(Снимок);
 Описания = Новый Массив; Описания.Добавить(Описание(НовыйОбъект)); Описания.Добавить(Описание(Корень));
 Внешние = Новый Массив; Внешние.Добавить(Новый Структура("object_id,name,version,action", НовыйОбъект.Идентификатор, НовыйОбъект.Идентификатор + ".0", "5555555555555555555555555555555500000000", 1));
 Результат = Новый Структура("data,object_id,version_code,descriptions,externals", "AgFTS2/0iI3BTqDV67a9oKcNAA==", НовыйОбъект.Идентификатор, "", Описания, Внешние);
 Пакет = Новый ПакетПомещенияОбъекта(Результат, Снимки, "Synthetic", "8.5.1.1529", ПравилаПакетовХранилища.Параметры("Создание", Вид)); Пакет.Проверить();
 Пакет.ВнешниеДанные[0].name = НовыйОбъект.Идентификатор + ".9";
 Отказ = Ложь; Попытка Пакет.Проверить(); Исключение Отказ = Истина; КонецПопытки;
 Если Не Отказ Тогда ВызватьИсключение "Не объявленный в профиле поток не отклонён."; КонецЕсли;
КонецЦикла;
Сообщить("Потоки файлов новых ролей и XDTO проверены по общему профилю.");
