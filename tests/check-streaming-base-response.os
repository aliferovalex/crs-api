#Использовать ".."

Процедура ДолженОтказать(Текст)
 Отказ = Ложь;
 Попытка ОбработкаXML.ПроверитьБазовыйОтветОбъектов(Текст);
 Исключение Отказ = Истина; КонецПопытки;
 Если Не Отказ Тогда ВызватьИсключение "Invalid response accepted"; КонецЕсли;
КонецПроцедуры

Начало = "<crs:call_return xmlns:crs=""http://v8.1c.ru/8.2/crs"">";
Конец = "</crs:call_return>";
ОбработкаXML.ПроверитьБазовыйОтветОбъектов(Начало + "<crs:statMap/>" + Конец);
ДолженОтказать(Начало + "<crs:statMap/><crs:exception>ZXJyb3I=</crs:exception>" + Конец);
ДолженОтказать(Начало + "<crs:statMap/><crs:exc>ZXJyb3I=</crs:exc>" + Конец);
ДолженОтказать("<crs:call_exception xmlns:crs=""http://v8.1c.ru/8.2/crs"">ZXJyb3I=</crs:call_exception>");
ДолженОтказать(Начало + "<foreign xmlns=""urn:foreign""/>" + Конец);
ДолженОтказать(Начало + "<crs:statMap/>" + Конец + "<broken");
ДолженОтказать(Начало + "<crs:statMap>" + Конец);
ДолженОтказать("");
Текст = "ИмяОбъектаНаРусском";
Ответ = Новый ОтветТранспортаХранилища(200, ПолучитьДвоичныеДанныеИзСтроки(Текст, КодировкаТекста.UTF8, Ложь));
Если Ответ.Текст() <> Текст Или Ответ.Текст() <> Текст Тогда ВызватьИсключение "UTF-8 response changed"; КонецЕсли;
Сообщить("Streaming response checks OK");
