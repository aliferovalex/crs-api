#Использовать ".."

Функция Настройки(Путь)
	Чтение = Новый ЧтениеJSON;
	Чтение.ОткрытьФайл(Путь);
	Результат = ПрочитатьJSON(Чтение);
	Чтение.Закрыть();
	Возврат Результат;
КонецФункции

Процедура Проверить(Условие, Сообщение)
	Если Не Условие Тогда
		ВызватьИсключение Сообщение;
	КонецЕсли;
КонецПроцедуры

Функция Состояние(Адрес, Параметры)
	Ответ = КоннекторHTTP.Post(Адрес, МенеджерЗапросов.ТелоЗапросаСостоянияОбъекта(Параметры));
	Проверить(Ответ.КодСостояния = 200, "Ошибка HTTP при проверке состояния");
	Проверить(Не ОбработкаXML.ПрочитатьОтветИзТекста(Ответ.Текст()).ЕстьОшибка, "Ошибка сервера при проверке состояния");
	Возврат ОбработкаXML.СостояниеОбъектаИзОтвета(Ответ.Текст(), Параметры.ИдентификаторОбъекта);
КонецФункции

Если АргументыКоманднойСтроки.Количество() <> 3 Тогда
	ВызватьИсключение "Укажите JSON хранилища, JSON разработчика и каталог для полученных снимков.";
КонецЕсли;
Администратор = Настройки(АргументыКоманднойСтроки[0]);
Разработчик = Настройки(АргументыКоманднойСтроки[1]);
Каталог = АргументыКоманднойСтроки[2];
СоздатьКаталог(Каталог);
Адрес = "http://127.0.0.1:18088/repo/repo.1ccr";
Версия = "8.5.4.1878";
Клиент = Новый КлиентХранилища(Адрес, Версия);
Клиент.Подключиться(Разработчик.User, Разработчик.Password, Администратор.Repository);
Объекты = Клиент.СписокОбъектовВерсии(0);
// Язык не менялся в версии 2. Дополняем выборку объектами версии 1,
// чьи версии остались актуальными, чтобы проверить получение дочернего объекта.
Для Каждого Кандидат Из Клиент.СписокОбъектовВерсии(1) Цикл
	Есть = Ложь;
	Для Каждого Объект Из Объекты Цикл
		Есть = Есть Или Объект.Идентификатор = Кандидат.Идентификатор;
	КонецЦикла;
	Если Не Есть Тогда
		Объекты.Добавить(Кандидат);
	КонецЕсли;
КонецЦикла;
Проверить(Объекты.Количество() >= 2, "Тест ожидает корень и язык в ProtocolLab");
Параметры = Новый Структура("ИмяХранилища,ВерсияПлатформы,ПользовательХранилища,ХешПользователяХранилища,ИдентификаторПодключения,ИдентификаторОбъекта",
	Администратор.Repository, Версия, Разработчик.User,
	Вспомогательный.ХешированныйПароль(Разработчик.Password), Новый УникальныйИдентификатор(), "");
Для Каждого Объект Из Объекты Цикл
	Параметры.ИдентификаторОбъекта = Объект.Идентификатор;
	До = Состояние(Адрес, Параметры);
	Снимок = Клиент.ПолучитьОбъект(Объект);
	Проверить(Снимок.Данные.Размер() > 0 И Снимок.ПакетСнимков.Размер() > Снимок.Данные.Размер(), "Не получены данные объекта");
	Проверить(Снимок.Объект.Идентификатор = Объект.Идентификатор, "Получен другой объект");
	После = Состояние(Адрес, Параметры);
	Проверить(До.Захвачен = После.Захвачен И До.Пользователь = После.Пользователь
		И До.НомерВерсии = После.НомерВерсии, "Получение изменило состояние объекта");
	ИмяФайла = ОбъединитьПути(Каталог, Объект.Идентификатор);
	Снимок.Данные.Записать(ИмяФайла + ".deflate");
	Снимок.ПакетСнимков.Записать(ИмяФайла + ".snapshot.bin");
	Сообщить("Объект " + Объект.Имя + ": получено " + Снимок.Данные.Размер() + " байт, состояние сохранено");
КонецЦикла;

Объект = Объекты[0];
АктуальнаяВерсия = Объект.НомерВерсии;
Объект.НомерВерсии = АктуальнаяВерсия - 1;
Отказ = Ложь;
Попытка
	Клиент.ПолучитьОбъект(Объект);
Исключение
	Отказ = СтрНайти(ОписаниеОшибки(), "устарело") > 0;
КонецПопытки;
Объект.НомерВерсии = АктуальнаяВерсия;
Проверить(Отказ, "Устаревшее описание не отклонено");

ИсходныйИдентификатор = Объект.Идентификатор;
Объект.Идентификатор = Строка(Новый УникальныйИдентификатор());
Отказ = Ложь;
Попытка
	Клиент.ПолучитьОбъект(Объект);
Исключение
	Отказ = СтрНайти(ОписаниеОшибки(), "не найден") > 0;
КонецПопытки;
Объект.Идентификатор = ИсходныйИдентификатор;
Проверить(Отказ, "Отсутствующий объект не отклонен");
Сообщить("Проверки получения: корень, язык, неизменность состояния, устаревшее описание, отсутствующий объект — успешно");
