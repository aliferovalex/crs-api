#Использовать ".."

// Constructor compiles the client; it does not connect to the repository.
Клиент = Новый КлиентХранилища("http://127.0.0.1:1/", "8.5.1.1529");
Чтение = Новый ЧтениеJSON;
Чтение.ОткрытьФайл(АргументыКоманднойСтроки[0]);
Данные = ПрочитатьJSON(Чтение);
Чтение.Закрыть();
План = СериализаторОбъектаХранилища.ОбъектыСсылокФормы(Данные.xml, Base64Значение(Данные.context), АргументыКоманднойСтроки[1]);
Если План.objects.Количество() <> 1 Тогда ВызватьИсключение "Не определено перечисление формы."; КонецЕсли;
Если План.objects[0].object_id <> Данные.expected_id Тогда ВызватьИсключение "Перечисление не соответствует контексту."; КонецЕсли;
Пустой = СериализаторОбъектаХранилища.ОбъектыСсылокФормы("<Form/>", Base64Значение(Данные.context), АргументыКоманднойСтроки[1]);
Если Пустой.objects.Количество() <> 0 Тогда ВызватьИсключение "Запрошены ненужные ссылки."; КонецЕсли;
Сообщить("План ссылок формы: компиляция клиента, Python-мост, UUID из контекста и пустой план — успешно.");
