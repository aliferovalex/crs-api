#Использовать ".."

Перем Объект;

Процедура Проверить(Условие, Сообщение)
	Если Не Условие Тогда
		ВызватьИсключение Сообщение;
	КонецЕсли;
КонецПроцедуры

Функция Пакет(Описание, Содержимое, ВторойОбъект = Ложь)
	Записи = Новый Массив;
	Записи.Добавить(ПолучитьБуферДвоичныхДанныхИзСтроки(Описание, КодировкаТекста.UTF8));
	Записи.Добавить(ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(Содержимое));
	Если ВторойОбъект Тогда
		Записи.Добавить(Записи[0]);
		Записи.Добавить(Записи[1]);
	КонецЕсли;
	Записи.Добавить(ПолучитьБуферДвоичныхДанныхИзСтроки("{0}", КодировкаТекста.UTF8));
	Размер = 12;
	Для Каждого Запись Из Записи Цикл
		Размер = Размер + 8 + Запись.Размер;
	КонецЦикла;
	Буфер = Новый БуферДвоичныхДанных(Размер);
	Буфер[0] = 68;
	Буфер[1] = 51;
	Буфер[2] = 34;
	Буфер[3] = 17;
	Буфер[4] = 2;
	Буфер[8] = 3;
	Позиция = 12;
	Для Каждого Запись Из Записи Цикл
		Длина = Запись.Размер;
		Для Индекс = 0 По 7 Цикл
			Буфер[Позиция + Индекс] = Длина % 256;
			Длина = Цел(Длина / 256);
		КонецЦикла;
		Позиция = Позиция + 8;
		Для Индекс = 0 По Запись.Размер - 1 Цикл
			Буфер[Позиция + Индекс] = Запись[Индекс];
		КонецЦикла;
		Позиция = Позиция + Запись.Размер;
	КонецЦикла;
	Возврат ПолучитьДвоичныеДанныеИзБуфераДвоичныхДанных(Буфер);
КонецФункции

Функция Ответ(Данные, Дополнение = "")
	Возврат "<crs:call_return xmlns:crs=""http://v8.1c.ru/8.2/crs""><crs:result/>"
		+ "<crs:snapshots><crs:data>" + Base64Строка(Данные) + "</crs:data></crs:snapshots>"
		+ Дополнение + "</crs:call_return>";
КонецФункции

Процедура ДолженОтказать(Текст)
	Отказ = Ложь;
	Попытка
		ОбработкаXML.ПрочитатьОтветПолученияОбъекта(Текст, Объект, Объект.Идентификатор);
	Исключение
		Отказ = Истина;
	КонецПопытки;
	Проверить(Отказ, "Ошибочный ответ не должен возвращать снимок");
КонецПроцедуры

Объект = Новый ОбъектХранилища;
Объект.Идентификатор = "11111111-1111-1111-1111-111111111111";
Объект.ИдентификаторКласса = "22222222-2222-2222-2222-222222222222";
Объект.НомерВерсии = 2;
Объект.НомерСобственнойВерсии = 1;
Описание = "{5," + Объект.Идентификатор + "," + Объект.ИдентификаторКласса
	+ ",00000000-0000-0000-0000-000000000000,00000000-0000-0000-0000-000000000000,2,1,0}";
Данные = Base64Значение("q64FAA=="); // raw DEFLATE строки {}.
ДвоичныйПакет = Пакет(Описание, Данные);
Снимок = ОбработкаXML.ПрочитатьОтветПолученияОбъекта(Ответ(ДвоичныйПакет), Объект, Объект.Идентификатор);
Проверить(Base64Строка(Снимок.Данные) = Base64Строка(Данные), "Содержимое повреждено");
Проверить(Base64Строка(Снимок.ПакетСнимков) = Base64Строка(ДвоичныйПакет), "Полный пакет поврежден");
Проверить(Снимок.Метаданные = Описание И Снимок.ВерсияХранилища = Объект.Идентификатор,
	"Метаданные снимка повреждены");
ДолженОтказать(Ответ(Пакет(СтрЗаменить(Описание, Объект.Идентификатор, Объект.ИдентификаторКласса), Данные)));
ДолженОтказать(Ответ(Пакет(СтрЗаменить(Описание, Объект.ИдентификаторКласса, Объект.Идентификатор), Данные)));
ДолженОтказать(Ответ(Пакет(СтрЗаменить(Описание, ",2,1,0}", ",3,1,0}"), Данные)));
ДолженОтказать(Ответ(Пакет(Описание, Данные, Истина)));
ДолженОтказать(Ответ(Пакет(Описание, Base64Значение(""))));
ДолженОтказать(Ответ(Base64Значение("AAAA")));
Буфер = ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(ДвоичныйПакет);
Буфер[12] = 255;
Буфер[13] = 255;
ДолженОтказать(Ответ(ПолучитьДвоичныеДанныеИзБуфераДвоичныхДанных(Буфер)));
ДолженОтказать("<crs:call_return xmlns:crs=""http://v8.1c.ru/8.2/crs""><crs:result/></crs:call_return>");
ДолженОтказать("<call_return><snapshots><data/></snapshots></call_return>");
Ошибка = Base64Строка(ПолучитьДвоичныеДанныеИзСтроки("Недостаточно прав", КодировкаТекста.UTF8, Ложь));
ДолженОтказать(Ответ(ДвоичныйПакет, "<crs:exc>" + Ошибка + "</crs:exc>"));
Для Каждого Раздел Из СтрРазделить("required,missing,changed,unprocessed,added,moved", ",") Цикл
	ДолженОтказать(Ответ(ДвоичныйПакет, "<crs:result><crs:" + Раздел
		+ "><crs:value/></crs:" + Раздел + "></crs:result>"));
КонецЦикла;
Отказ = Ложь;
Попытка
	Клиент = Новый КлиентХранилища("http://127.0.0.1:1", "8.5.4.1878");
	Клиент.ПолучитьОбъект(Объект);
Исключение
	Отказ = СтрНайти(ОписаниеОшибки(), "сначала подключитесь") > 0;
КонецПопытки;
Проверить(Отказ, "Не запрещено получение без авторизации");
Сообщить("Проверки получения: успешно (снимок, повреждения, UUID, версии, ошибки сервера, авторизация)");
