#Использовать ".."

Функция Описание(UUID, Класс, Имя, Родитель, Версия)
	Возврат Новый Структура("id,class_id,name,pos,parent_id,owner_id,original,local", UUID, Класс, Имя, 0, Родитель,
		"00000000-0000-0000-0000-000000000000", Версия, Версия);
КонецФункции

Процедура Проверить(Условие, Сообщение)
	Если Не Условие Тогда ВызватьИсключение Сообщение; КонецЕсли;
КонецПроцедуры

Корень = Новый ОбъектХранилища;
Корень.Идентификатор = Новый УникальныйИдентификатор("11111111-1111-4111-8111-111111111111");
Корень.ИдентификаторКласса = ИдентификаторыМетаданных.ИдентификаторКласса("CatalogForm");
Корень.Имя = "Root";
Корень.Позиция = 0;
Корень.НомерВерсии = 1;
Корень.НомерСобственнойВерсии = 1;
Корень.ИдентификаторРодителя = "00000000-0000-0000-0000-000000000000";
Корень.ИдентификаторВладельца = Корень.ИдентификаторРодителя;
Корень.ИсходнаяВерсия = "1111111111111111111111111111111100000000";
Корень.ЛокальнаяВерсия = Корень.ИсходнаяВерсия;
Корень.Удален = Ложь;
Снимок = Новый СнимокОбъектаХранилища;
Снимок.Объект = Корень;
Снимок.ВерсияХранилища = "22222222-2222-4222-8222-222222222222";
Результат = Новый Структура("data,object_id,class_id,original,local,external_name,external_version",
    "AgFTS2/0iI3BTqDV67a9oKcNAA==", Строка(Корень.Идентификатор), Корень.ИдентификаторКласса,
    Корень.ИсходнаяВерсия, "2222222222222222222222222222222200000000", Строка(Корень.Идентификатор) + ".0",
    "3333333333333333333333333333333300000000");
Пакет = Новый ПакетИзмененияФормы(Результат, Снимок, "Repo", "8.5.1.1529");
Параметры = Новый Структура("ИмяХранилища,ВерсияПлатформы,ПользовательХранилища,ХешПользователяХранилища,ИдентификаторПодключения,Объект,Пакет,Комментарий",
    "Repo", "8.5.1.1529", "test", "synthetic", Новый УникальныйИдентификатор(), Корень, Пакет, "Code & text");
XML = МенеджерЗапросов.ТелоЗапросаНаПомещениеОбъекта(Параметры);
Проверить(СтрНайти(XML, "Code &amp; text") > 0, "Комментарий не экранирован");
Проверить(СтрНайти(XML, "verID value=""3333333333333333333333333333333300000000""") > 0, "Версия внешнего текста потеряна");
Проверить(СтрНайти(XML, "action value=""1""") > 0, "Нет действия замены текста");
Для Каждого Режим Из СтрРазделить("header,class,object,original,local,external-name,external-version,platform", ",") Цикл
    Пакет = Новый ПакетИзмененияФормы(Результат, Снимок, "Repo", "8.5.1.1529");
    Если Режим = "header" Тогда Пакет.Данные = Base64Значение("AAAAAAAAAAAAAAAAAAAAAAAAAA=="); КонецЕсли;
    Если Режим = "class" Тогда Пакет.ИдентификаторКласса = ИдентификаторыМетаданных.КлассКонстанты(); КонецЕсли;
    Если Режим = "object" Тогда Пакет.ИдентификаторОбъекта = Строка(Новый УникальныйИдентификатор()); КонецЕсли;
    Если Режим = "original" Тогда Пакет.ИсходнаяВерсия = Пакет.ЛокальнаяВерсия; КонецЕсли;
    Если Режим = "local" Тогда Пакет.ЛокальнаяВерсия = Пакет.ИсходнаяВерсия; КонецЕсли;
    Если Режим = "external-name" Тогда Пакет.ИмяВнешнегоТекста = "other.0"; КонецЕсли;
    Если Режим = "external-version" Тогда Пакет.ВерсияВнешнегоТекста = "not-hex"; КонецЕсли;
    Если Режим = "platform" Тогда Пакет.ВерсияПлатформы = "8.5.4.1878"; КонецЕсли;
    Отказ = Ложь;
    Попытка Пакет.Проверить(Корень); Исключение Отказ = Истина; КонецПопытки;
    Проверить(Отказ, "Недопустимый пакет принят: " + Режим);
КонецЦикла;
Сообщить("Изменение формы: версии, UUID, внешний текст и XML — успешно.");
