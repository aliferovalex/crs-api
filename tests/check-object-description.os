#Использовать ".."

Перем UUID;

Процедура Проверить(Условие, Сообщение)
	Если Не Условие Тогда
		ВызватьИсключение Сообщение;
	КонецЕсли;
КонецПроцедуры

Функция Ответ(Тело)
	Возврат "<crs:call_return xmlns:crs=""http://v8.1c.ru/8.2/crs"">" + Тело + "</crs:call_return>";
КонецФункции

Процедура ДолженОтказать(Текст, ЭтоСостояние = Ложь, Версия = 2)
	Отказ = Ложь;
	Попытка
		Если ЭтоСостояние Тогда
			ОбработкаXML.ПрочитатьНомерВерсииОбъекта(Текст, UUID);
		Иначе
			ОбработкаXML.ПрочитатьОписаниеОбъекта(Текст, UUID, Версия);
		КонецЕсли;
	Исключение
		Отказ = Истина;
	КонецПопытки;
	Проверить(Отказ, "Ошибочный ответ описания принят");
КонецПроцедуры

UUID = "e2a9c158-4b91-424a-b10d-07b43280ce83";
Описание = "<crs:_super><crs:id value=""" + UUID + """/><crs:classID value=""cf4abeab-37b2-11d4-940f-008048da11f9""/></crs:_super>"
	+ "<crs:name value=""Корень &amp; &quot;тест&quot;""/><crs:pos value=""0""/><crs:verNum value=""2""/><crs:selfVerNum value=""1""/>"
	+ "<crs:parentID value=""00000000-0000-0000-0000-000000000000""/><crs:ownerID value=""00000000-0000-0000-0000-000000000000""/>"
	+ "<crs:version><crs:original value=""aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa""/><crs:local value=""bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb""/></crs:version><crs:removed value=""false""/>";
Запись = "<crs:value><crs:first value=""2""/><crs:second><crs:info>" + Описание + "</crs:info></crs:second></crs:value>";
ДругойUUID = "0e108dde-b410-4f8a-988b-3e90ae5210cb";
Текст = Ответ("<crs:objects>" + СтрЗаменить(Запись, UUID, ДругойUUID) + Запись + "</crs:objects>");
Объект = ОбработкаXML.ПрочитатьОписаниеОбъекта(Текст, ВРег(UUID), 2);
Проверить(Объект.Идентификатор = UUID И Объект.Имя = "Корень & ""тест""" И Объект.НомерСобственнойВерсии = 1,
	"Не получено полное описание нужного объекта");
Проверить(Объект.ИсходнаяВерсия = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "Утрачена исходная версия");
ДолженОтказать(Ответ("<crs:objects/>"));
ДолженОтказать(Ответ("<crs:objects>" + Запись + Запись + "</crs:objects>"));
ДолженОтказать(Текст, Ложь, 3);
ДолженОтказать(СтрЗаменить(Текст, "removed value=""false""", "removed value=""true"""));
ДолженОтказать(СтрЗаменить(Текст, "<crs:pos value=""0""/>", ""));
ДолженОтказать(СтрЗаменить(Текст, "<crs:name", "<name"));
ДолженОтказать(Ответ("<crs:objects>" + Запись + "</crs:objects><crs:exc>ZXJyb3I=</crs:exc>"));

Статистика = "<crs:value><crs:first value=""" + UUID + """/><crs:second><crs:verNum value=""2""/>"
	+ "<crs:revised value=""false""/><crs:revisorID value=""00000000-0000-0000-0000-000000000000""/></crs:second></crs:value>";
Текст = Ответ("<crs:statMap>" + Статистика + "</crs:statMap>");
Проверить(ОбработкаXML.ПрочитатьНомерВерсииОбъекта(Текст, UUID) = 2, "Не прочитана текущая версия");
ДолженОтказать(Ответ("<crs:statMap/>"), Истина);
ДолженОтказать(СтрЗаменить(Текст, UUID, ДругойUUID), Истина);
ДолженОтказать(Ответ("<crs:statMap>" + Статистика + Статистика + "</crs:statMap>"), Истина);
ДолженОтказать(СтрЗаменить(Текст, "<crs:verNum value=""2""/>", ""), Истина);
Для Каждого Номер Из СтрРазделить("0,-1,1.5", ",") Цикл
	ДолженОтказать(СтрЗаменить(Текст, "verNum value=""2""", "verNum value=""" + Номер + """"), Истина);
КонецЦикла;
ДолженОтказать(Ответ("<crs:statMap>" + Статистика + "</crs:statMap><crs:exception>ZXJyb3I=</crs:exception>"), Истина);

Клиент = Новый КлиентХранилища("http://127.0.0.1:1", "8.5.4.1878");
Значения = Новый Массив;
Значения.Добавить("");
Значения.Добавить("invalid");
Значения.Добавить(0);
Значения.Добавить("00000000-0000-0000-0000-000000000000");
Для Каждого Значение Из Значения Цикл
	Отказ = Ложь;
	Попытка
		Клиент.ПолучитьОписаниеОбъекта(Значение);
	Исключение
		Отказ = Истина;
	КонецПопытки;
	Проверить(Отказ, "Некорректный UUID принят");
КонецЦикла;
Отказ = Ложь;
Попытка
	Клиент.ПолучитьОписаниеОбъекта(UUID);
Исключение
	Отказ = СтрНайти(ОписаниеОшибки(), "подключитесь") > 0;
КонецПопытки;
Проверить(Отказ, "Нет проверки авторизации перед HTTP-запросом");
Сообщить("Проверки описания: успешно (UUID, авторизация, выборка, полные поля, версии, дубликаты, удаление, ошибки XML/сервера).");
