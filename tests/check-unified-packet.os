#Использовать ".."
Процедура Проверить(Условие, Сообщение)
 Если Не Условие Тогда ВызватьИсключение Сообщение; КонецЕсли;
КонецПроцедуры
Функция Источник(Класс)
 О = Новый ОбъектХранилища; О.Идентификатор = "11111111-1111-4111-8111-111111111111"; О.ИдентификаторКласса = ИдентификаторыМетаданных.ИдентификаторКласса(Класс);
 О.Имя = "Parent"; О.Позиция = 0; О.НомерВерсии = 1; О.НомерСобственнойВерсии = 1;
 О.ИдентификаторРодителя = "00000000-0000-0000-0000-000000000000"; О.ИдентификаторВладельца = О.ИдентификаторРодителя;
 О.ИсходнаяВерсия = "1111111111111111111111111111111100000000"; О.ЛокальнаяВерсия = О.ИсходнаяВерсия; О.Удален = Ложь;
 Возврат О;
КонецФункции
Функция Описание(О)
 Возврат Новый Структура("id,class_id,name,pos,parent_id,owner_id,original,local", О.Идентификатор, О.ИдентификаторКласса, О.Имя, О.Позиция, О.ИдентификаторРодителя, О.ИдентификаторВладельца, О.ИсходнаяВерсия, О.ЛокальнаяВерсия);
КонецФункции
Для Каждого Вид Из СтрРазделить("Constant,Catalog,Document,Enum,CommonModule,CatalogForm,DocumentForm,CommonForm", ",") Цикл
 Правила = ПравилаПакетовХранилища.Параметры("Создание", Вид); Родитель = Источник(Правила.ВидРодителя);
 Снимок = Новый СнимокОбъектаХранилища; Снимок.Объект = Родитель; Снимок.ВерсияХранилища = "33333333-3333-4333-8333-333333333333";
 Снимки = Новый Массив; Снимки.Добавить(Снимок);
 Новая = Источник(Вид); Новая.Идентификатор = "22222222-2222-4222-8222-222222222222"; Новая.Имя = "NewObject"; Новая.ИдентификаторРодителя = Родитель.Идентификатор;
 Новая.ИсходнаяВерсия = "2222222222222222222222222222222200000000"; Новая.ЛокальнаяВерсия = Новая.ИсходнаяВерсия;
 Описания = Новый Массив; Описания.Добавить(Описание(Новая)); Описания.Добавить(Описание(Родитель)); Внешние = Новый Массив;
 Если Вид = "CommonModule" Или СтрНайти(",CatalogForm,DocumentForm,CommonForm,", "," + Вид + ",") > 0 Тогда
  Внешние.Добавить(Новый Структура("object_id,name,version,action", Новая.Идентификатор, Новая.Идентификатор + ".0", "4444444444444444444444444444444400000000", ?(Вид = "CommonModule", 1, 0)));
 КонецЕсли;
 Результат = Новый Структура("data,object_id,version_code,descriptions,externals", "AgFTS2/0iI3BTqDV67a9oKcNAA==", Новая.Идентификатор, "", Описания, Внешние);
 Общий = Новый ПакетПомещенияОбъекта(Результат, Снимки, "Repo", "8.5.1.1529", Правила);
 Проверить(ПравилаПакетовХранилища.ЭтоПакет(Общий, "Создание", Вид), "Не распознаны правила общего пакета");
 Правила.ВидОбъекта = "Invalid"; Общий.Проверить();
 Если Вид = "Constant" Тогда
  Алиас = Новый ПакетСозданияКонстанты(Результат, Снимки, "Repo", "8.5.1.1529");
  Параметры = Новый Структура("ИмяХранилища,ВерсияПлатформы,ПользовательХранилища,ХешПользователяХранилища,ИдентификаторПодключения,Пакет,Комментарий", "Repo", "8.5.1.1529", "test", "synthetic", Новый УникальныйИдентификатор(), Общий, "same");
  Текст = МенеджерЗапросов.ТелоЗапросаНаПомещениеПакета(Параметры); Параметры.Пакет = Алиас;
  Проверить(Текст = МенеджерЗапросов.ТелоЗапросаНаПомещениеПакета(Параметры), "Алиас и общий пакет дают разные запросы");
 КонецЕсли;
 Ошибка = Ложь; Попытка Общий.ЗаполнитьИзЗапроса("invalid"); Исключение Ошибка = Истина; КонецПопытки;
 Проверить(Ошибка, "Импорт не должен менять режим готового пакета");
КонецЦикла;
Сообщить("Унифицированный пакет: классы, копирование правил, алиасы и одинаковые запросы — успешно.");
