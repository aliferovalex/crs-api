#Использовать ".."

Функция Настройки(Путь)
	Чтение = Новый ЧтениеJSON;
	Чтение.ОткрытьФайл(Путь);
	Результат = ПрочитатьJSON(Чтение);
	Чтение.Закрыть();
	Возврат Результат;
КонецФункции

Если АргументыКоманднойСтроки.Количество() <> 4 Тогда
	ВызватьИсключение "Укажите JSON хранилища, JSON пользователя, Python, файл результата. Только ProtocolLab.";
КонецЕсли;
Хранилище = Настройки(АргументыКоманднойСтроки[0]);
Пользователь = Настройки(АргументыКоманднойСтроки[1]);
Если Хранилище.Repository <> "ProtocolLab" Тогда ВызватьИсключение "Разрешен только ProtocolLab."; КонецЕсли;
Клиент = Новый КлиентХранилища("http://127.0.0.1:18088/repo/repo.1ccr", "8.5.4.1878");
Клиент.Подключиться(Пользователь.User, Пользователь.Password, Хранилище.Repository);
Корень = Клиент.ПолучитьОписаниеОбъекта("e2a9c158-4b91-424a-b10d-07b43280ce83");
Каталог = Клиент.ПолучитьКлассыМетаданных(Корень, АргументыКоманднойСтроки[2]);
Если Каталог.classes.Количество() <> 51 Или Каталог.groups.Количество() <> 7 Тогда
	ВызватьИсключение "Неожиданный каталог классов тестовой конфигурации.";
КонецЕсли;
Если Каталог.complete_platform_registry Тогда ВызватьИсключение "Ошибочная полнота списка."; КонецЕсли;
Пустых = 0;
Неизвестных = 0;
Для Каждого Класс Из Каталог.classes Цикл
	Если Класс.object_count = 0 Тогда Пустых = Пустых + 1; КонецЕсли;
	Если Не ЗначениеЗаполнено(Класс.name) Тогда Неизвестных = Неизвестных + 1; КонецЕсли;
КонецЦикла;
Если Пустых <> 48 Или Неизвестных <> 2 Тогда ВызватьИсключение "Неожиданное содержимое каталога."; КонецЕсли;
ПослеЧтения = Клиент.ПолучитьОписаниеОбъекта(Корень.Идентификатор);
Если ПослеЧтения.НомерВерсии <> Корень.НомерВерсии Тогда
	ВызватьИсключение "Версия корня изменилась во время проверки.";
КонецЕсли;
Запись = Новый ЗаписьJSON;
Запись.ОткрытьФайл(АргументыКоманднойСтроки[3]);
ЗаписатьJSON(Запись, Каталог);
Запись.Закрыть();
Сообщить("Классов: 51; групп: 7; пустых коллекций: " + Пустых + "; неизвестных названий: " + Неизвестных);
