#Использовать ".."

Процедура Проверить(Условие, Текст)
	Если Не Условие Тогда ВызватьИсключение Текст; КонецЕсли;
КонецПроцедуры

Если АргументыКоманднойСтроки.Количество() > 0 Тогда
	Адрес = АргументыКоманднойСтроки[0];
	Запрос = Новый ЧтениеТекста(АргументыКоманднойСтроки[1], КодировкаТекста.UTF8);
	Тело = Запрос.Прочитать(); Запрос.Закрыть();
	Попытка
		Ответ = ТранспортХранилища.Отправить(Адрес, Тело);
	Исключение
		Если АргументыКоманднойСтроки[3] = "ok" Тогда ВызватьИсключение; КонецЕсли;
		Проверить(СтрНайти(ОписаниеОшибки(), АргументыКоманднойСтроки[3]) > 0, ОписаниеОшибки());
		ЗавершитьРаботу(0);
	КонецПопытки;
	Проверить(АргументыКоманднойСтроки[3] = "ok", "Ожидалась ошибка транспорта.");
	Проверить(Ответ.КодСостояния = 201, "Неверный код ответа.");
	Запись = Новый ЗаписьТекста(АргументыКоманднойСтроки[2], КодировкаТекста.UTF8);
	Запись.Записать(Ответ.Текст()); Запись.Закрыть();
	ЗавершитьРаботу(0);
КонецЕсли;

Параметры = ТранспортХранилища.ПараметрыTCP("tcp://localhost");
Проверить(Параметры.Порт = 1542 И Параметры.Хост = "localhost", "Неверный порт по умолчанию.");
Параметры = ТранспортХранилища.ПараметрыTCP("TCP://[::1]:1543/Group/Repo");
Проверить(Параметры.Хост = "::1" И Параметры.Порт = 1543 И Параметры.ИмяХранилища = "Group/Repo", "Неверный IPv6-адрес.");
Клиент = Новый КлиентХранилища("tcp://127.0.0.1:1/First", "8.5.1.1529");
Отказ = Ложь;
Попытка Клиент.Подключиться("", "", "Other"); Исключение Отказ = СтрНайти(ОписаниеОшибки(), "не совпадает") > 0; КонецПопытки;
Проверить(Отказ, "Противоречивое имя хранилища принято.");
Для Каждого Адрес Из СтрРазделить("tcp://,tcp://host:0,tcp://host:65536,tcp://user@host,tcp://host:1?x=1,tcp://host/path with space", ",") Цикл
	Отказ = Ложь;
	Попытка ТранспортХранилища.ПараметрыTCP(Адрес); Исключение Отказ = Истина; КонецПопытки;
	Проверить(Отказ, "Принят неправильный TCP-адрес.");
КонецЦикла;
Перенос = Символы.ВК + Символы.ПС;
Заголовок = "HTTP/1.1 200 OK" + Перенос + "content-length: 10" + Перенос + Перенос;
Поля = ТранспортХранилища.РазобратьЗаголовок(Заголовок);
Проверить(Поля.Код = 200 И Поля.Длина = 10, "Неверно разобран заголовок.");
Для Каждого Поле Из СтрРазделить("Content-Length: -1|Content-Length: 268435457|Transfer-Encoding: chunked|Content-Length: one", "|") Цикл
	Отказ = Ложь;
	Попытка ТранспортХранилища.РазобратьЗаголовок("HTTP/1.1 200 OK" + Перенос + Поле + Перенос + Перенос); Исключение Отказ = Истина; КонецПопытки;
	Проверить(Отказ, "Принят неправильный TCP-заголовок.");
КонецЦикла;
Сообщить("Транспорт: TCP-адреса, IPv6, порт по умолчанию и заголовки проверены.");
