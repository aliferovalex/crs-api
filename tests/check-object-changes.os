#Использовать ".."

Процедура Проверить(Условие, Сообщение)
 Если Не Условие Тогда ВызватьИсключение Сообщение; КонецЕсли;
КонецПроцедуры

Функция Описание(Имя, Номер = 1, Удален = Ложь)
 Объект = Новый ОбъектХранилища;
 Объект.Идентификатор = "11111111-1111-4111-8111-111111111111";
 Объект.Имя = Имя; Объект.НомерВерсии = Номер; Объект.Удален = Удален;
 Объект.ИдентификаторКласса = "22222222-2222-4222-8222-222222222222";
 Объект.ИдентификаторРодителя = "33333333-3333-4333-8333-333333333333";
 Объект.ИдентификаторВладельца = Объект.ИдентификаторРодителя; Объект.Позиция = 0;
 Возврат Объект;
КонецФункции

Если АргументыКоманднойСтроки.Количество() > 0 Тогда
 Если АргументыКоманднойСтроки[0] = "--compare" Тогда
  До = Новый Структура("ПакетСнимков", Новый ДвоичныеДанные(АргументыКоманднойСтроки[1]));
  После = Новый Структура("ПакетСнимков", Новый ДвоичныеДанные(АргументыКоманднойСтроки[2]));
  Результат = СериализаторОбъектаХранилища.СравнитьСнимкиОбъекта("22222222-2222-4222-8222-222222222222", До, После, АргументыКоманднойСтроки[3]);
  Проверить(Результат.content_changed И Результат.streams.Количество() = 1, "Мост сравнения снимков");
  Проверить(Результат.streams[0].after.text = "after", "Текст после изменения");
  ЗавершитьРаботу(0);
 КонецЕсли;
 Клиент = Новый КлиентХранилища(АргументыКоманднойСтроки[0], "8.5.1.1529");
 Клиент.Подключиться("test", "test", "Repo");
 Изменения = Клиент.ПолучитьИзмененияВерсии(42, Ложь);
 Проверить(Изменения.Количество() = 3, "Состав помещения");
 Проверить(Изменения[0].Действие = "Изменение" И Изменения[0].До.НомерВерсии = 40, "Предыдущая версия именно объекта");
 Проверить(Изменения[1].Действие = "Удаление" И Изменения[1].До.НомерВерсии = 41, "Удаление");
 Проверить(Изменения[2].Действие = "Создание" И Изменения[2].До = Неопределено, "Создание");
 ЗавершитьРаботу(0);
КонецЕсли;

До = Описание("Old"); После = Описание("New", 7);
Результат = ИсторияИзменений.ИзменениеОбъекта(После, До);
Проверить(Результат.Действие = "Изменение" И Результат.Свойства.Количество() = 1, "Переименование");
Проверить(Результат.Свойства[0].До = "Old" И Результат.Свойства[0].После = "New", "Было/стало");
Проверить(Результат.До.НомерВерсии = 1 И Не Результат.СодержимоеПолучено, "Описание не является содержимым");
Проверить(ИсторияИзменений.ИзменениеОбъекта(После).Действие = "Создание", "Создание");
Удален = Описание("New", 8, Истина);
Проверить(ИсторияИзменений.ИзменениеОбъекта(Удален, После).Действие = "Удаление", "Удаление");
Проверить(ИсторияИзменений.ИзменениеОбъекта(После, Удален).Действие = "Создание", "Восстановление");
Отказ = Ложь; Попытка ИсторияИзменений.ИзменениеОбъекта(Удален); Исключение Отказ = Истина; КонецПопытки;
Проверить(Отказ, "Удаление без исходного состояния не должно считаться созданием");
Клиент = Новый КлиентХранилища("tcp://127.0.0.1:1/Repo", "8.5.1.1529");
Для Каждого Неверный Из СтрРазделить("0,-1,1.5", ",") Цикл
 Отказ = Ложь; Попытка Клиент.ПолучитьИзмененияВерсии(Число(Неверный)); Исключение Отказ = СтрНайти(ОписаниеОшибки(), "положительным целым") > 0; КонецПопытки;
 Проверить(Отказ, "Неверная версия должна отклоняться до соединения");
КонецЦикла;
Сообщить("Изменения описаний: создание, изменение, удаление, восстановление и проверка параметров — OK");
