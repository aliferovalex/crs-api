#Использовать ".."

Процедура Проверить(Условие, Сообщение)
 Если Не Условие Тогда ВызватьИсключение Сообщение; КонецЕсли;
КонецПроцедуры

Функция МеткаXML(Имя, Комментарий = "", Номер = "42")
 Возврат "<crs:label><crs:verNum value=""" + Номер + """/><crs:userID value=""88888888-8888-4888-8888-888888888888""/>"
  + "<crs:date value=""2026-01-02T03:04:05""/><crs:name value=""" + Имя + """/><crs:comment>" + Комментарий + "</crs:comment></crs:label>";
КонецФункции

Функция ДанныеИстории(Метки = "", ПустойКомментарий = Ложь)
 Путь = ОбъединитьПути(ТекущийСценарий().Каталог, "fixtures", "version_history.xml");
 Чтение = Новый ЧтениеТекста(Путь, КодировкаТекста.UTF8); XML = Чтение.Прочитать(); Чтение.Закрыть();
 XML = СтрЗаменить(XML, "</crs:info>", "</crs:info>" + Метки);
 Если ПустойКомментарий Тогда XML = СтрЗаменить(XML, "<crs:comment>История: проверка &amp; тест</crs:comment>", "<crs:comment/>"); КонецЕсли;
 Ответ = ОбработкаXML.ПрочитатьОтветИзТекста(XML);
 Узлы = Ответ.РезультатЧтения.Получить("call_return")._Элементы.Получить("versions");
 Для Каждого Узел Из Узлы Цикл Возврат Узел["value"]["second"]; КонецЦикла;
 ВызватьИсключение "Нет записи истории в синтетическом ответе.";
КонецФункции

Функция ВерсияИзДанных(Данные)
 Результат = Новый ВерсияХранилища; Результат.Заполнить(Данные); Возврат Результат;
КонецФункции

Если АргументыКоманднойСтроки.Количество() > 0 Тогда
 Клиент = Новый КлиентХранилища(АргументыКоманднойСтроки[0], "8.5.1.1529"); Клиент.Подключиться("test", "test", "Repo");
 Версии = Клиент.СписокВерсий();
 Проверить(Версии.Количество() = 3, "Публичный вход потерял записи истории.");
 Проверить(Версии[0].Метки.Количество() = 0 И Версии[0].Комментарий = "История: проверка & тест", "Искажена запись без меток.");
 Проверить(Не ЗначениеЗаполнено(Версии[1].Комментарий) И Версии[1].Метки.Количество() = 1 И Версии[1].Метки[0].Имя = "#DEMO-3409", "Публичный вход потерял Jira только в метке.");
 Проверить(Версии[2].Метки.Количество() = 2 И Версии[2].Метки[1].Комментарий = "Second label", "Публичный вход не разбирает несколько label.");
 Для Каждого Версия Из Версии Цикл Проверить(Версия.Версия = "TCP-test", "info/code ошибочно заменён меткой."); КонецЦикла;
 ЗавершитьРаботу(0);
КонецЕсли;

Версия = Новый ВерсияХранилища;
Проверить(ТипЗнч(Версия.Метки) = Тип("Массив") И Версия.Метки.Количество() = 0, "У нового объекта нет пустого массива меток.");
Версия.Заполнить(ДанныеИстории());
Проверить(Версия.Метки.Количество() = 0, "Версия конфигурации ошибочно превращена в метку.");
Проверить(Версия.Версия = "TCP-test" И Версия.Комментарий = "История: проверка & тест" И Версия.Данные = Неопределено, "Изменены прежние свойства истории.");

Версия = ВерсияИзДанных(ДанныеИстории(МеткаXML("#DEMO-101", "Метка &amp; текст", "41")));
Проверить(Версия.Метки.Количество() = 1, "Не прочитана единственная метка.");
Метка = Версия.Метки[0];
Проверить(Метка.Имя = "#DEMO-101" И Метка.Комментарий = "Метка & текст", "Повреждены имя или комментарий метки.");
Проверить(Метка.Пользователь = "88888888-8888-4888-8888-888888888888" И Метка.Пользователь <> Версия.Пользователь, "Автор метки подменён автором помещения.");
Проверить(ТипЗнч(Метка.НомерВерсии) = Тип("Число") И Метка.НомерВерсии = 41 И Версия.Номер = 42, "Номер метки подменён номером родительского info.");
Проверить(ТипЗнч(Метка.Дата) = Тип("Дата") И Метка.Дата = Дата(2026, 1, 2, 3, 4, 5), "Не прочитана дата метки.");
Проверить(Версия.Версия = "TCP-test" И Версия.Комментарий = "История: проверка & тест", "Метка перезаписала версию конфигурации или комментарий помещения.");

Данные = ДанныеИстории(МеткаXML("#DEMO-102") + МеткаXML("Build &amp; &quot;quoted&quot;", "Второй комментарий"));
Проверить(ТипЗнч(Данные) = Тип("Массив"), "Не проверено реальное представление повторных label в xml-parser.");
Версия = ВерсияИзДанных(Данные);
Проверить(Версия.Метки.Количество() = 2 И Версия.Метки[0].Имя = "#DEMO-102" И Версия.Метки[1].Имя = "Build & ""quoted""", "Потеряны метки или их порядок.");
Проверить(Версия.Метки[0].Комментарий = "" И Версия.Метки[1].Комментарий = "Второй комментарий", "Перемешаны комментарии разных меток.");
Версия.Заполнить(ДанныеИстории()); Проверить(Версия.Метки.Количество() = 0, "При повторном заполнении остались чужие метки.");

Версия = ВерсияИзДанных(ДанныеИстории(МеткаXML("#DEMO-3409"), Истина));
Проверить(Не ЗначениеЗаполнено(Версия.Комментарий) И Версия.Метки.Количество() = 1 И Версия.Метки[0].Имя = "#DEMO-3409", "Номер задачи, присутствующий только в метке, потерян при пустом комментарии помещения.");
Проверить(Версия.Метки[0].Комментарий = "" И Версия.Версия = "TCP-test", "Пустой комментарий или code неверно интерпретированы как метка.");

ИмяСоСписком = "#DEMO-3308, #DEMO-3195, #DEMO-2661";
Версия = ВерсияИзДанных(ДанныеИстории(МеткаXML(ИмяСоСписком)));
Проверить(Версия.Метки.Количество() = 1 И Версия.Метки[0].Имя = ИмяСоСписком, "Одна настоящая метка ошибочно разделена на несколько по запятым.");
Сообщить("История меток: без меток, одна/несколько, все поля, пустые комментарии, Jira только в метке, сброс и совместимость проверены.");
