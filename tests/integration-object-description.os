#Использовать ".."

Функция Настройки(Путь)
	Чтение = Новый ЧтениеJSON;
	Чтение.ОткрытьФайл(Путь);
	Результат = ПрочитатьJSON(Чтение);
	Чтение.Закрыть();
	Возврат Результат;
КонецФункции

Процедура Проверить(Условие, Сообщение)
	Если Не Условие Тогда
		ВызватьИсключение Сообщение;
	КонецЕсли;
КонецПроцедуры

Если АргументыКоманднойСтроки.Количество() <> 2 Тогда
	ВызватьИсключение "Укажите JSON хранилища и JSON разработчика. Только ProtocolLab; без изменений хранилища.";
КонецЕсли;
Хранилище = Настройки(АргументыКоманднойСтроки[0]);
Разработчик = Настройки(АргументыКоманднойСтроки[1]);
Проверить(Хранилище.Repository = "ProtocolLab", "Разрешен только ProtocolLab");
Клиент = Новый КлиентХранилища("http://127.0.0.1:18088/repo/repo.1ccr", "8.5.4.1878");
Клиент.Подключиться(Разработчик.User, Разработчик.Password, Хранилище.Repository);
Корень = Клиент.ПолучитьОписаниеОбъекта("E2A9C158-4B91-424A-B10D-07B43280CE83");
Язык = Клиент.ПолучитьОписаниеОбъекта(Новый УникальныйИдентификатор("0e108dde-b410-4f8a-988b-3e90ae5210cb"));
Проверить(Корень.НомерВерсии > Язык.НомерВерсии И Язык.НомерВерсии = 1, "Ожидается актуальный корень и язык из версии 1");
ЕстьЯзык = Ложь;
Для Каждого Объект Из Клиент.СписокОбъектовВерсии(0) Цикл
	ЕстьЯзык = ЕстьЯзык Или Объект.Идентификатор = Язык.Идентификатор;
КонецЦикла;
Проверить(Не ЕстьЯзык, "Язык должен отсутствовать в изменениях последней версии");
Для Каждого Объект Из Клиент.СписокОбъектовВерсии(1) Цикл
	Если Объект.Идентификатор = Язык.Идентификатор Тогда
		Проверить(Объект.ИсходнаяВерсия = Язык.ИсходнаяВерсия И Объект.ЛокальнаяВерсия = Язык.ЛокальнаяВерсия
			И Объект.ИдентификаторКласса = Язык.ИдентификаторКласса, "Описание языка отличается от версии 1");
	КонецЕсли;
КонецЦикла;
СнимокКорня = Клиент.ПолучитьОбъект(Корень);
СнимокЯзыка = Клиент.ПолучитьОбъект(Язык);
Проверить(СнимокКорня.Данные.Размер() > 0 И СнимокЯзыка.Данные.Размер() > 0, "Дескрипторы нельзя использовать для получения");
Отказ = Ложь;
Попытка
	Клиент.ПолучитьОписаниеОбъекта(Новый УникальныйИдентификатор());
Исключение
	Отказ = СтрНайти(ОписаниеОшибки(), "не найден") > 0;
КонецПопытки;
Проверить(Отказ, "Отсутствующий объект не отклонен");
Сообщить("Описание по UUID: корень версии " + Корень.НомерВерсии + ", язык версии " + Язык.НомерВерсии
	+ ", отсутствие в последних изменениях, получение снимков и неизвестный UUID — успешно.");
