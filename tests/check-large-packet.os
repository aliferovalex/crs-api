#Использовать ".."

Функция Описание(Ид, Класс, Позиция, Родитель, Исходная, Локальная)
 Возврат Новый Структура("id,class_id,name,pos,parent_id,owner_id,original,local", Ид, ИдентификаторыМетаданных.ИдентификаторКласса(Класс), "Object" + Строка(Позиция), Позиция, Родитель, "00000000-0000-0000-0000-000000000000", Исходная, Локальная);
КонецФункции

Процедура Проверить(Условие, Сообщение)
 Если Не Условие Тогда ВызватьИсключение Сообщение; КонецЕсли;
КонецПроцедуры

Версия = "44444444-4444-4444-8444-444444444444";
Исходная = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa";
Локальная = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb";
Корень = Строка(Новый УникальныйИдентификатор());
Снимки = Новый Массив; Изменения = Новый Массив; Описания = Новый Массив; Запрошенные = Новый Массив;
Для Индекс = 0 По 259 Цикл
 Ид = ?(Индекс = 0, Корень, Строка(Новый УникальныйИдентификатор()));
 Класс = ?(Индекс = 0, "Configuration", "Catalog"); Родитель = ?(Индекс = 0, "00000000-0000-0000-0000-000000000000", Корень);
 До = Описание(Ид, Класс, Индекс, Родитель, Исходная, Исходная);
 Снимок = Новый СнимокОбъектаХранилища; Снимок.Объект = ПравилаПакетовХранилища.ОписаниеОбъекта(До);
 Снимок.Объект.НомерВерсии = 1; Снимок.Объект.НомерСобственнойВерсии = 1; Снимок.ВерсияХранилища = Версия; Снимки.Добавить(Снимок);
 Изменения.Добавить(Ид); Запрошенные.Добавить(До); Описания.Добавить(Описание(Ид, Класс, Индекс, Родитель, Исходная, Локальная));
КонецЦикла;
Удаление = Строка(Новый УникальныйИдентификатор()); До = Описание(Удаление, "Catalog", 999, Корень, Исходная, Исходная);
Снимок = Новый СнимокОбъектаХранилища; Снимок.Объект = ПравилаПакетовХранилища.ОписаниеОбъекта(До);
Снимок.Объект.НомерВерсии = 1; Снимок.ВерсияХранилища = Версия; Снимки.Добавить(Снимок); Запрошенные.Добавить(До);
НовыйИд = Строка(Новый УникальныйИдентификатор()); Описания.Добавить(Описание(НовыйИд, "Constant", 0, Корень, Локальная, Локальная));
Новые = Новый Массив; Новые.Добавить(НовыйИд); Удаления = Новый Массив; Удаления.Добавить(Удаление);
Результат = Новый Структура("data,repository,platform,repository_version,version_code,descriptions,requested,changed_ids,new_ids,removed_ids,externals", "AgFTS2/0iI3BTqDV67a9oKcNAA==", "Synthetic", "8.5.1.1529", Версия, "", Описания, Запрошенные, Изменения, Новые, Удаления, Новый Массив);
Пакет = Новый ПакетПомещенияОбъекта; Пакет.ЗаполнитьКонфигурацию(Результат, Снимки); Пакет.Проверить();
Проверить(Пакет.ОбъектыПакета.Количество() = 261 И Пакет.УдаляемыеОбъекты.Количество() = 1 И Пакет.НовыеОбъекты.Количество() = 1, "Потеряны операции большой группы.");

// Проверяем конверт отдельно от нативной семантики: данные в сервер не отправляются.
Поток = Новый ПотокВПамяти;
Заголовок = ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(Base64Значение(Результат.data)); Поток.Записать(Заголовок, 0, Заголовок.Размер);
Заполнение = Новый БуферДвоичныхДанных(33 * 1024 * 1024); Поток.Записать(Заполнение, 0, Заполнение.Размер);
Пакет.Данные = Поток.ЗакрытьИПолучитьДвоичныеДанные(); Пакет.Проверить();
Параметры = Новый Структура("ИмяХранилища,ВерсияПлатформы,ПользовательХранилища,ХешПользователяХранилища,ИдентификаторПодключения,Пакет,Комментарий", "Synthetic", "8.5.1.1529", "test", "synthetic", Новый УникальныйИдентификатор(), Пакет, "Large packet");
XML = МенеджерЗапросов.ТелоЗапросаНаПомещениеПакета(Параметры);
ТранспортХранилища.ПроверитьРазмерСообщения(ПолучитьДвоичныеДанныеИзСтроки(XML, КодировкаТекста.UTF8, Ложь).Размер());
Проверить(СтрНайти(XML, Удаление) > 0 И СтрНайти(XML, НовыйИд) > 0, "Потеряны создание или удаление в XML.");
Пакет.ОбъектыПакета[1].Идентификатор = Пакет.ОбъектыПакета[0].Идентификатор;
Отказ = Ложь; Попытка Пакет.Проверить(); Исключение Отказ = Истина; КонецПопытки;
Проверить(Отказ, "Повтор UUID принят после увеличения размера группы.");
Для Каждого Размер Из СтрРазделить("-1,268435457", ",") Цикл
 Отказ = Ложь; Попытка ТранспортХранилища.ПроверитьРазмерСообщения(Число(Размер)); Исключение Отказ = Истина; КонецПопытки;
 Проверить(Отказ, "Неверный размер сообщения принят.");
КонецЦикла;
ТранспортХранилища.ПроверитьРазмерСообщения(268435456);
Сообщить("Большой конверт: 261 объект, создание и удаление, больше 33 МиБ; контроль UUID и предела сообщения сохранён.");
