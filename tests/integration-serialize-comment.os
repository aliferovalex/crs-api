#Использовать ".."

Функция JSONИзФайла(Путь)
	Чтение = Новый ЧтениеJSON;
	Чтение.ОткрытьФайл(Путь);
	Результат = ПрочитатьJSON(Чтение);
	Чтение.Закрыть();
	Возврат Результат;
КонецФункции

Функция ТекстИзФайла(Путь)
	Чтение = Новый ЧтениеТекста(Путь, КодировкаТекста.UTF8);
	Результат = Чтение.Прочитать();
	Чтение.Закрыть();
	Возврат Результат;
КонецФункции

Если АргументыКоманднойСтроки.Количество() <> 7 И АргументыКоманднойСтроки.Количество() <> 8 Тогда
	ВызватьИсключение "Укажите JSON хранилища, JSON разработчика, исходный и измененный XML, Python, каталог результата, prepare или commit. Только ProtocolLab.";
КонецЕсли;
Настройки = JSONИзФайла(АргументыКоманднойСтроки[0]);
Пользователь = JSONИзФайла(АргументыКоманднойСтроки[1]);
Если Настройки.Repository <> "ProtocolLab" Тогда
	ВызватьИсключение "Разрешен только тестовый ProtocolLab.";
КонецЕсли;
Клиент = Новый КлиентХранилища("http://127.0.0.1:18088/repo/repo.1ccr", "8.5.4.1878");
Клиент.Подключиться(Пользователь.User, Пользователь.Password, Настройки.Repository);
Корень = Клиент.ПолучитьОписаниеОбъекта("e2a9c158-4b91-424a-b10d-07b43280ce83");
Если АргументыКоманднойСтроки.Количество() = 8 И АргументыКоманднойСтроки[7] = "properties" Тогда
	Пакет = Клиент.ПодготовитьСвойстваИзXML(Корень,
		ТекстИзФайла(АргументыКоманднойСтроки[2]), ТекстИзФайла(АргументыКоманднойСтроки[3]), АргументыКоманднойСтроки[4]);
Иначе
	Пакет = Клиент.ПодготовитьКомментарийИзXML(Корень,
		ТекстИзФайла(АргументыКоманднойСтроки[2]), ТекстИзФайла(АргументыКоманднойСтроки[3]), АргументыКоманднойСтроки[4]);
КонецЕсли;
Сообщить("Нативный пакет сформирован из XML без сохраненного запроса помещения.");
Если АргументыКоманднойСтроки[6] = "commit" Тогда
	Если Не Клиент.ЗахватитьОбъект(Корень) Тогда
		ВызватьИсключение "Не удалось захватить корень.";
	КонецЕсли;
	// При неопределенном результате отправки не повторяем помещение автоматически.
	НовыйКорень = Клиент.ПоместитьОбъект(Корень, Пакет, "XML serializer integration");
	Снимок = Клиент.ПолучитьОбъект(НовыйКорень);
	СоздатьКаталог(АргументыКоманднойСтроки[5]);
	Снимок.Данные.Записать(ОбъединитьПути(АргументыКоманднойСтроки[5], "serialized-object.deflate"));
	Если Не Клиент.ОтменитьЗахватОбъекта(НовыйКорень) Тогда
		ВызватьИсключение "Не освобожден тестовый захват.";
	КонецЕсли;
	Сообщить("Помещение подтверждено: версия " + Корень.НомерВерсии + " -> " + НовыйКорень.НомерВерсии + "; захват освобожден.");
ИначеЕсли АргументыКоманднойСтроки[6] <> "prepare" Тогда
	ВызватьИсключение "Режим должен быть prepare или commit.";
КонецЕсли;
