#Использовать ".."

Процедура ДолженОтказать(Текст)
	Отказ = Ложь;
	Попытка
		ОбработкаXML.ПрочитатьПакетТекущейВерсии(Текст);
	Исключение
		Отказ = Истина;
	КонецПопытки;
	Если Не Отказ Тогда
		ВызватьИсключение "Некорректный контекст принят: " + Текст;
	КонецЕсли;
КонецПроцедуры

Начало = "<crs:call_return xmlns:crs=""http://v8.1c.ru/8.2/crs"">";
Конец = "</crs:call_return>";
Поле = "<crs:info><crs:file>AQID</crs:file></crs:info>";
Контекст = ОбработкаXML.ПрочитатьПакетТекущейВерсии(Начало + Поле + Конец);
Если Base64Строка(Контекст) <> "AQID" Тогда
	ВызватьИсключение "Изменены байты контекста.";
КонецЕсли;
ДолженОтказать(Начало + Конец);
ДолженОтказать(Начало + Поле + Поле + Конец);
ДолженОтказать(Начало + "<file>AQID</file>" + Конец);
ДолженОтказать(Начало + Поле + "<crs:exc>ZXJyb3I=</crs:exc>" + Конец);
ДолженОтказать("<crs:call xmlns:crs=""http://v8.1c.ru/8.2/crs"">" + Поле + "</crs:call>");
ДолженОтказать(Начало + "<crs:info><crs:file>!!</crs:file></crs:info>" + Конец);
Параметры = Новый Структура("ИмяХранилища,ВерсияПлатформы,ПользовательХранилища,ХешПользователяХранилища,ИдентификаторПодключения",
	"Test", "8.5.4.1878", "developer", "test-hash", Новый УникальныйИдентификатор());
Запрос = МенеджерЗапросов.ТелоЗапросаПакетаТекущейВерсии(Параметры);
Если СтрНайти(Запрос, "DevDepot_devObjectsVersionEx") = 0 Или СтрНайти(Запрос, "verNum value=""-1""") = 0 Тогда
	ВызватьИсключение "Некорректный запрос текущей версии.";
КонецЕсли;
Сообщить("Проверки контекста сериализации: успешно (байты, пропуск, дубликат, namespace, исключение, тип ответа, base64, запрос).");
