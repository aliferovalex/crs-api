#Использовать ".."
Функция Объект(Вид, ИД, Родитель, Имя, Позиция)
 О = Новый ОбъектХранилища; О.Идентификатор = ИД; О.ИдентификаторКласса = ИдентификаторыМетаданных.ИдентификаторКласса(Вид);
 О.Имя = Имя; О.Позиция = Позиция; О.НомерВерсии = 1; О.НомерСобственнойВерсии = 1;
 О.ИдентификаторРодителя = Родитель; О.ИдентификаторВладельца = "00000000-0000-0000-0000-000000000000";
 О.ИсходнаяВерсия = "2222222222222222222222222222222200000000"; О.ЛокальнаяВерсия = О.ИсходнаяВерсия; О.Удален = Ложь;
 Возврат О;
КонецФункции
Функция Описание(О)
 Возврат Новый Структура("id,class_id,name,pos,parent_id,owner_id,original,local", О.Идентификатор, О.ИдентификаторКласса, О.Имя, О.Позиция, О.ИдентификаторРодителя, О.ИдентификаторВладельца, О.ИсходнаяВерсия, О.ЛокальнаяВерсия);
КонецФункции
Для Каждого Вид Из СтрРазделить("Catalog,Document,InformationRegister", ",") Цикл
 Корень = Объект("Configuration", "11111111-1111-4111-8111-111111111111", "00000000-0000-0000-0000-000000000000", "Root", 0);
 Владелец = Объект(Вид, "22222222-2222-4222-8222-222222222222", Корень.Идентификатор, "Owner", 0);
 Снимок = Новый СнимокОбъектаХранилища; Снимок.Объект = Корень; Снимок.ВерсияХранилища = "33333333-3333-4333-8333-333333333333";
 Снимки = Новый Массив; Снимки.Добавить(Снимок); Описания = Новый Массив; Описания.Добавить(Описание(Владелец)); Описания.Добавить(Описание(Корень)); Внешние = Новый Массив;
 Для Каждого Ребенок Из СтрРазделить(Вид + "Form,Template", ",") Цикл
  Для Индекс = 0 По 1 Цикл
   ИД = Строка(Новый УникальныйИдентификатор()); О = Объект(Ребенок, ИД, Владелец.Идентификатор, "SameName" + Индекс, Индекс);
   Описания.Добавить(Описание(О)); Внешние.Добавить(Новый Структура("object_id,name,version,action", ИД, ИД + ".0", "4444444444444444444444444444444400000000", 0));
  КонецЦикла;
 КонецЦикла;
 Результат = Новый Структура("data,object_id,version_code,descriptions,externals", "AgFTS2/0iI3BTqDV67a9oKcNAA==", Владелец.Идентификатор, "", Описания, Внешние);
 Пакет = Новый ПакетПомещенияОбъекта(Результат, Снимки, "Synthetic", "8.5.1.1529", ПравилаПакетовХранилища.Параметры("Создание", Вид)); Пакет.Проверить();
 Пакет.ОбъектыПакета[3].Позиция = 0; Отказ = Ложь;
 Попытка Пакет.Проверить(); Исключение Отказ = Истина; КонецПопытки;
 Если Не Отказ Тогда ВызватьИсключение "Повтор позиции не отклонен."; КонецЕсли;
 Пакет.ОбъектыПакета[3].Позиция = 1; Пакет.ВнешниеДанные.Удалить(0); Отказ = Ложь;
 Попытка Пакет.Проверить(); Исключение Отказ = Истина; КонецПопытки;
 Если Не Отказ Тогда ВызватьИсключение "Отсутствие потока не отклонено."; КонецЕсли;
КонецЦикла;
Сообщить("Создание владельца с формами и макетами: классы, отдельные позиции коллекций и обязательные потоки проверены.");
