#Использовать ".."

Функция Объект(UUID, Класс, Родитель, Версия)
 О = Новый ОбъектХранилища; О.Идентификатор = UUID; О.ИдентификаторКласса = ИдентификаторыМетаданных.ИдентификаторКласса(Класс);
 О.Имя = "Object"; О.Позиция = 0; О.НомерВерсии = 7; О.НомерСобственнойВерсии = 7; О.ИдентификаторРодителя = Родитель;
 О.ИдентификаторВладельца = "00000000-0000-0000-0000-000000000000"; О.ИсходнаяВерсия = Версия; О.ЛокальнаяВерсия = Версия; О.Удален = Ложь;
 Возврат О;
КонецФункции

Для Каждого Вид Из СтрРазделить("Constant,CommonModule,Catalog,Document,Enum,Report,Role,DefinedType,CatalogForm,DocumentForm,DataProcessorForm,ReportForm,CommonForm,Template,CommonTemplate,InformationRegisterForm", ",") Цикл
 Правила = ПравилаПакетовХранилища.Параметры("Удаление", Вид);
 ВидРодителя = ?(Вид = "Template", "Report", Правила.ВидРодителя);
 Родитель = Объект("11111111-1111-4111-8111-111111111111", ВидРодителя, "00000000-0000-0000-0000-000000000000", "1111111111111111111111111111111100000000");
 Удаляемый = Объект("22222222-2222-4222-8222-222222222222", Вид, Родитель.Идентификатор, "2222222222222222222222222222222200000000");
 СР = Новый СнимокОбъектаХранилища; СР.Объект = Родитель; СР.ВерсияХранилища = "44444444-4444-4444-8444-444444444444";
 СО = Новый СнимокОбъектаХранилища; СО.Объект = Удаляемый; СО.ВерсияХранилища = СР.ВерсияХранилища;
 Снимки = Новый Массив; Снимки.Добавить(СР); Снимки.Добавить(СО);
 Описания = Новый Массив; Описания.Добавить(Новый Структура("id,class_id,name,pos,parent_id,owner_id,original,local", Родитель.Идентификатор, Родитель.ИдентификаторКласса, Родитель.Имя, 0, Родитель.ИдентификаторРодителя, Родитель.ИдентификаторВладельца, Родитель.ИсходнаяВерсия, "3333333333333333333333333333333300000000"));
 Результат = Новый Структура("data,object_id,parent_id,descriptions,version_code", "AgFTS2/0iI3BTqDV67a9oKcNAA==", Удаляемый.Идентификатор, Родитель.Идентификатор, Описания, "");
 Пакет = Новый ПакетПомещенияОбъекта(Результат, Снимки, "Repo", "8.5.1.1529", Правила);
 Если Пакет.УдаляемыйОбъект <> Удаляемый Или Пакет.Форма <> Удаляемый Тогда ВызватьИсключение "Не заполнено общее описание удаления."; КонецЕсли;
 Параметры = Новый Структура("ИмяХранилища,ВерсияПлатформы,ПользовательХранилища,ХешПользователяХранилища,ИдентификаторПодключения,Пакет,Комментарий", "Repo", "8.5.1.1529", "test", "synthetic", Новый УникальныйИдентификатор(), Пакет, "Delete");
 XML = МенеджерЗапросов.ТелоЗапросаНаПомещениеПакета(Параметры);
 Начало = СтрНайти(XML, "<crs:objectsToRemove>"); Конец = СтрНайти(XML, "</crs:objectsToRemove>"); Удаление = Сред(XML, Начало, Конец - Начало);
 Если СтрНайти(Удаление, Строка(Удаляемый.Идентификатор)) = 0 Или СтрНайти(Удаление, "verNum value=""7""") = 0 Тогда ВызватьИсключение "Не передано исходное описание удаляемого объекта."; КонецЕсли;
 Если Вид = "Catalog" Тогда
  Потомок = Объект("55555555-5555-4555-8555-555555555555", "CatalogForm", Удаляемый.Идентификатор, "5555555555555555555555555555555500000000");
  СП = Новый СнимокОбъектаХранилища; СП.Объект = Потомок; СП.ВерсияХранилища = СР.ВерсияХранилища; Снимки.Добавить(СП);
  Удаления = Новый Массив; Удаления.Добавить(Строка(Удаляемый.Идентификатор)); Удаления.Добавить(Строка(Потомок.Идентификатор)); Результат.Вставить("removed_ids", Удаления);
  Пакет = Новый ПакетПомещенияОбъекта(Результат, Снимки, "Repo", "8.5.1.1529", Правила); Параметры.Пакет = Пакет;
  XML = МенеджерЗапросов.ТелоЗапросаНаПомещениеПакета(Параметры);
  Начало = СтрНайти(XML, "<crs:objectsToRemove>"); Конец = СтрНайти(XML, "</crs:objectsToRemove>"); Удаление = Сред(XML, Начало, Конец - Начало);
  Если Пакет.УдаляемыеОбъекты.Количество() <> 2 Или СтрНайти(Удаление, Строка(Потомок.Идентификатор)) = 0 Тогда ВызватьИсключение "Потомок не включён в удаление."; КонецЕсли;
 КонецЕсли;
 Удаляемый.ИдентификаторРодителя = "99999999-9999-4999-8999-999999999999"; Ошибка = Ложь;
 Попытка Пакет.Проверить(); Исключение Ошибка = Истина; КонецПопытки;
 Если Не Ошибка Тогда ВызватьИсключение "Не проверен родитель удаления."; КонецЕсли;
КонецЦикла;
Правила = ПравилаПакетовХранилища.Параметры("Удаление", "Template");
Если Не ПравилаПакетовХранилища.РодительДопустим(Правила, ИдентификаторыМетаданных.ИдентификаторКласса("InformationRegister")) Тогда ВызватьИсключение "Карта не разрешила макет регистра."; КонецЕсли;
Если Не ПравилаПакетовХранилища.РодительДопустим(Правила, ИдентификаторыМетаданных.ИдентификаторКласса("ChartOfAccounts")) Тогда ВызватьИсключение "Карта не разрешила подтверждённую коллекцию макетов плана счетов."; КонецЕсли;
Если ПравилаПакетовХранилища.РодительДопустим(Правила, ИдентификаторыМетаданных.ИдентификаторКласса("ExternalDataSource")) Тогда ВызватьИсключение "Недопустимый родитель удаления разрешён."; КонецЕсли;
Сообщить("Общее удаление: классы, исходные версии, описание и проверки — успешно.");
