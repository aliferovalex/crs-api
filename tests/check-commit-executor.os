#Использовать ".."

Функция Описание(Данные)
 Объект = ПравилаПакетовХранилища.ОписаниеОбъекта(Данные);
 Объект.НомерВерсии = Данные.version; Объект.НомерСобственнойВерсии = Данные.version;
 Возврат Объект;
КонецФункции

Функция ПакетИзНастроек(Настройки)
 Снимки = Новый Массив;
 Для Каждого Данные Из Настройки.sources Цикл
  Снимок = Новый СнимокОбъектаХранилища; Снимок.Объект = Описание(Данные); Снимок.ВерсияХранилища = Настройки.repository_version; Снимки.Добавить(Снимок);
 КонецЦикла;
 Если Настройки.mode = "change" Тогда
  Объект = Снимки[0].Объект;
  Результат = Новый Структура("data,object_id,original,local,class_id,external_name,external_version", Настройки.data, Строка(Объект.Идентификатор), Объект.ИсходнаяВерсия, Настройки.expected[0].local, Объект.ИдентификаторКласса, Строка(Объект.Идентификатор) + ".0", Настройки.expected[0].local);
  Возврат Новый ПакетПомещенияОбъекта(Результат, Снимки[0], "Repo", "8.5.1.1529", ПравилаПакетовХранилища.Параметры("Изменение", "CommonModule"));
 ИначеЕсли Настройки.mode = "group" Тогда
  Результат = Новый Структура("data,repository_version,repository,platform,version_code,changed_ids,new_ids,removed_ids,descriptions,requested,externals", Настройки.data, Настройки.repository_version, "Repo", "8.5.1.1529", "", Настройки.changed_ids, Настройки.new_ids, Настройки.removed_ids, Настройки.expected, Настройки.expected, Новый Массив);
  Пакет = Новый ПакетПомещенияОбъекта; Пакет.ЗаполнитьКонфигурацию(Результат, Снимки); Возврат Пакет;
 Иначе
  Операция = ?(Настройки.mode = "create", "Создание", "Удаление");
  Результат = Новый Структура("data,object_id,parent_id,descriptions,version_code", Настройки.data, Настройки.target_id, Строка(Снимки[0].Объект.Идентификатор), Настройки.expected, "");
  Возврат Новый ПакетПомещенияОбъекта(Результат, Снимки, "Repo", "8.5.1.1529", ПравилаПакетовХранилища.Параметры(Операция, "Constant"));
 КонецЕсли;
КонецФункции

Если АргументыКоманднойСтроки.Количество() = 0 Тогда
 Сообщить("Исполнитель помещения проверяется test_commit_executor.py на синтетическом сервере."); ЗавершитьРаботу(0);
КонецЕсли;
Чтение = Новый ЧтениеJSON; Чтение.ОткрытьФайл(АргументыКоманднойСтроки[1]); Настройки = ПрочитатьJSON(Чтение); Чтение.Закрыть();
Пакет = ПакетИзНастроек(Настройки);
Если Настройки.fault = "wrong_repository" Тогда Пакет.ИмяХранилища = "Other"; КонецЕсли;
Клиент = Новый КлиентХранилища(АргументыКоманднойСтроки[0], "8.5.1.1529"); Клиент.Подключиться("test", "test", "Repo");
Ошибка = ""; Результат = Неопределено;
Попытка Результат = Клиент.ПоместитьПакет(Пакет, "Unified & commit"); Исключение Ошибка = ОписаниеОшибки(); КонецПопытки;
Если Настройки.fault = "none" Тогда
 Если ЗначениеЗаполнено(Ошибка) Тогда ВызватьИсключение Ошибка; КонецЕсли;
 Если Настройки.mode = "group" Тогда
  Если ТипЗнч(Результат) <> Тип("Массив") Или Результат.Количество() <> Настройки.expected.Количество() Тогда ВызватьИсключение "Неверный результат группы"; КонецЕсли;
 Иначе
  Если ТипЗнч(Результат) <> Тип("ОбъектХранилища") Или НРег(Строка(Результат.Идентификатор)) <> НРег(Настройки.result_id) Тогда ВызватьИсключение "Неверный результат одиночного помещения"; КонецЕсли;
 КонецЕсли;
Иначе
 Если Не ЗначениеЗаполнено(Ошибка) Тогда ВызватьИсключение "Ошибка сервера/предусловий не обнаружена"; КонецЕсли;
 Если ЗначениеЗаполнено(Настройки.error_contains) И СтрНайти(НРег(Ошибка), НРег(Настройки.error_contains)) = 0 Тогда ВызватьИсключение Ошибка; КонецЕсли;
КонецЕсли;
Сообщить("Unified commit: OK");
