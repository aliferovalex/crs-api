#Использовать ".."

Функция Настройки(Путь)
	Чтение = Новый ЧтениеJSON;
	Чтение.ОткрытьФайл(Путь);
	Результат = ПрочитатьJSON(Чтение);
	Чтение.Закрыть();
	Возврат Результат;
КонецФункции

Процедура Проверить(Условие, Сообщение)
	Если Не Условие Тогда
		ВызватьИсключение Сообщение;
	КонецЕсли;
КонецПроцедуры

Функция Состояние(Адрес, Параметры)
	Ответ = КоннекторHTTP.Post(Адрес, МенеджерЗапросов.ТелоЗапросаСостоянияОбъекта(Параметры));
	Проверить(Ответ.КодСостояния = 200, "Ошибка HTTP при проверке состояния");
	Обработанный = ОбработкаXML.ПрочитатьОтветИзТекста(Ответ.Текст());
	Проверить(Не Обработанный.ЕстьОшибка, "Ошибка сервера при проверке состояния");
	Возврат Ответ.Текст();
КонецФункции

Функция ЕстьЗахват(Текст)
	Чтение = Новый ЧтениеXML;
	Чтение.УстановитьСтроку(Текст);
	Результат = Ложь;
	Пока Чтение.Прочитать() Цикл
		Если Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента И Чтение.ЛокальноеИмя = "revised" Тогда
			Результат = Результат Или Чтение.ЗначениеАтрибута("value") = "true";
		КонецЕсли;
	КонецЦикла;
	Чтение.Закрыть();
	Возврат Результат;
КонецФункции

Если АргументыКоманднойСтроки.Количество() <> 2 Тогда
	ВызватьИсключение "Укажите JSON администратора и тестового разработчика. Запускайте только на тестовом хранилище.";
КонецЕсли;
Администратор = Настройки(АргументыКоманднойСтроки[0]);
Разработчик = Настройки(АргументыКоманднойСтроки[1]);
Адрес = "http://127.0.0.1:18088/repo/repo.1ccr";
Версия = "8.5.4.1878";
Клиент = Новый КлиентХранилища(Адрес, Версия);
Клиент.Подключиться(Разработчик.User, Разработчик.Password, Администратор.Repository);
// Перечисление пользователей не должно изменять авторизацию клиента.
Проверить(Клиент.СписокПользователей().Количество() > 0, "Не получен список пользователей");
Объекты = Клиент.СписокОбъектовВерсии(0);
Проверить(Объекты.Количество() > 0, "В последней версии нет объектов для проверки");
Объект = Объекты[0];
Владелец = Клиент.НайтиПользователя(Разработчик.User);
Привязка = Новый УникальныйИдентификатор();
Параметры = Новый Структура("ИмяХранилища,ВерсияПлатформы,ПользовательХранилища,ХешПользователяХранилища,ИдентификаторПодключения,ИдентификаторОбъекта,Объект,Захватить",
	Администратор.Repository, Версия, Разработчик.User,
	Вспомогательный.ХешированныйПароль(Разработчик.Password), Привязка, Объект.Идентификатор, Объект, Ложь);
Проверить(Не ЕстьЗахват(Состояние(Адрес, Параметры)), "Объект уже захвачен. Тест не изменяет существующий захват.");

Ошибка = "";
Попытка
	АктуальнаяВерсия = Объект.НомерВерсии;
	Объект.НомерВерсии = АктуальнаяВерсия - 1;
	Отказ = Ложь;
	Попытка
		Клиент.ЗахватитьОбъект(Объект, Привязка);
	Исключение
		Отказ = СтрНайти(ОписаниеОшибки(), "устарело") > 0;
	КонецПопытки;
	Объект.НомерВерсии = АктуальнаяВерсия;
	Проверить(Отказ И Не ЕстьЗахват(Состояние(Адрес, Параметры)), "Устаревшее описание не должно захватывать объект");
	Сообщить("Отказ для устаревшего описания без захвата: успешно");
	Проверить(Клиент.ЗахватитьОбъект(Объект, Привязка), "Метод не подтвердил захват");
	Проверить(ОбработкаXML.ОбъектЗахваченПользователем(Состояние(Адрес, Параметры),
		Объект.Идентификатор, Владелец.Идентификатор), "Захват не принадлежит разработчику");
	Сообщить("Захват разработчиком и проверка владельца: успешно");

	ВторойКлиент = Новый КлиентХранилища(Адрес, Версия);
	ВторойКлиент.Подключиться(Администратор.User, Администратор.Password, Администратор.Repository);
	Отказ = Ложь;
	Попытка
		ВторойКлиент.ЗахватитьОбъект(Объект);
	Исключение
		Отказ = Истина;
	КонецПопытки;
	Проверить(Отказ, "Чужой захват должен вызывать исключение");
	Проверить(ОбработкаXML.ОбъектЗахваченПользователем(Состояние(Адрес, Параметры),
		Объект.Идентификатор, Владелец.Идентификатор), "Второй клиент изменил владельца захвата");
	Сообщить("Отказ при захвате другим пользователем: успешно");
Исключение
	Ошибка = ОписаниеОшибки();
КонецПопытки;

// Освобождаем только захват тестового разработчика; чужой захват не снимаем.
ТекстСостояния = Состояние(Адрес, Параметры);
Если ОбработкаXML.ОбъектЗахваченПользователем(ТекстСостояния, Объект.Идентификатор, Владелец.Идентификатор) Тогда
	Ответ = КоннекторHTTP.Post(Адрес, МенеджерЗапросов.ТелоЗапросаНаИзменениеЗахвата(Параметры));
	Проверить(Ответ.КодСостояния = 200, "Не удалось освободить объект после теста");
	ОбработкаXML.ПроверитьОтветЗахвата(Ответ.Текст(), Объект.Идентификатор);
КонецЕсли;
Проверить(Не ЕстьЗахват(Состояние(Адрес, Параметры)), "После теста объект остался захваченным");
Если ЗначениеЗаполнено(Ошибка) Тогда
	ВызватьИсключение Ошибка;
КонецЕсли;
Сообщить("Объект освобожден; интеграционная проверка завершена успешно");
