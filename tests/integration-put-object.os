#Использовать ".."

Функция Настройки(Путь)
	Чтение = Новый ЧтениеJSON;
	Чтение.ОткрытьФайл(Путь);
	Результат = ПрочитатьJSON(Чтение);
	Чтение.Закрыть();
	Возврат Результат;
КонецФункции

Процедура Проверить(Условие, Сообщение)
	Если Не Условие Тогда
		ВызватьИсключение Сообщение;
	КонецЕсли;
КонецПроцедуры

Если АргументыКоманднойСтроки.Количество() <> 4 Тогда
	ВызватьИсключение "Укажите JSON владельца захвата, JSON другого пользователя, сохраненный запрос и каталог результата. Только ProtocolLab.";
КонецЕсли;
НастройкиВладельца = Настройки(АргументыКоманднойСтроки[0]);
ДругойПользователь = Настройки(АргументыКоманднойСтроки[1]);
ТекстЗапроса = Новый ЧтениеТекста(АргументыКоманднойСтроки[2], КодировкаТекста.UTF8);
ТекстXML = ТекстЗапроса.Прочитать();
ТекстЗапроса.Закрыть();
Пакет = Новый ПакетПомещенияОбъекта;
Пакет.ЗаполнитьИзЗапроса(ТекстXML);
Привязка = Неопределено;
Чтение = Новый ЧтениеXML;
Чтение.УстановитьСтроку(ТекстXML);
Пока Чтение.Прочитать() Цикл
	Если Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента И Чтение.ЛокальноеИмя = "bind" Тогда
		Привязка = Чтение.ЗначениеАтрибута("bindID");
	КонецЕсли;
КонецЦикла;
Чтение.Закрыть();
Проверить(Пакет.ИмяХранилища = "ProtocolLab", "Разрешен только тестовый ProtocolLab");
Адрес = "http://127.0.0.1:18088/repo/repo.1ccr";
Клиент = Новый КлиентХранилища(Адрес, Пакет.ВерсияПлатформы);
Клиент.Подключиться(НастройкиВладельца.User, НастройкиВладельца.Password, Пакет.ИмяХранилища);
Объект = Неопределено;
Для Каждого Кандидат Из Клиент.СписокОбъектовВерсии(0) Цикл
	Если Кандидат.Идентификатор = Пакет.ИдентификаторОбъекта Тогда
		Объект = Кандидат;
	КонецЕсли;
КонецЦикла;
Проверить(Объект <> Неопределено, "Объект должен входить в последнюю версию тестового хранилища");
Пакет.Проверить(Объект);
ДругойКлиент = Новый КлиентХранилища(Адрес, Пакет.ВерсияПлатформы);
ДругойКлиент.Подключиться(ДругойПользователь.User, ДругойПользователь.Password, Пакет.ИмяХранилища);
Отказ = Ложь;
Попытка
	ДругойКлиент.ПоместитьОбъект(Объект, Пакет, "Не должно быть помещено");
Исключение
	Отказ = СтрНайти(ОписаниеОшибки(), "другим пользователем") > 0;
КонецПопытки;
Проверить(Отказ, "Не запрещено помещение при чужом захвате");
ИсходныйНомер = Объект.НомерВерсии;
Объект.НомерВерсии = ИсходныйНомер - 1;
Отказ = Ложь;
Попытка
	Клиент.ПоместитьОбъект(Объект, Пакет, "Не должно быть помещено");
Исключение
	Отказ = СтрНайти(ОписаниеОшибки(), "устарело") > 0;
КонецПопытки;
Объект.НомерВерсии = ИсходныйНомер;
Проверить(Отказ, "Не запрещено помещение с устаревшим описанием");
НовыйОбъект = Клиент.ПоместитьОбъект(Объект, Пакет, "CRS API put test", Привязка);
Проверить(НовыйОбъект.НомерВерсии > ИсходныйНомер, "Номер версии не увеличился");
Снимок = Клиент.ПолучитьОбъект(НовыйОбъект);
СоздатьКаталог(АргументыКоманднойСтроки[3]);
Снимок.Данные.Записать(ОбъединитьПути(АргументыКоманднойСтроки[3], "committed-object.deflate"));
Снимок.ПакетСнимков.Записать(ОбъединитьПути(АргументыКоманднойСтроки[3], "committed-object.snapshot.bin"));
ПовторныйОтказ = Ложь;
Попытка
	Клиент.ПоместитьОбъект(НовыйОбъект, Пакет, "Не должно быть помещено повторно");
Исключение
	ПовторныйОтказ = Истина;
КонецПопытки;
Проверить(ПовторныйОтказ, "Повторное использование старого пакета не отклонено");
// Освобождаем собственный тестовый захват только после подтверждения новой версии.
Проверить(Клиент.ОтменитьЗахватОбъекта(НовыйОбъект, Привязка), "Не освобожден объект после теста помещения");
Сообщить("Помещение подтверждено: версия " + ИсходныйНомер + " -> " + НовыйОбъект.НомерВерсии);
Сообщить("Проверки помещения: чужой захват, устаревшее описание, новая версия, контрольная сумма, повторное получение, запрет повторного помещения — успешно");
