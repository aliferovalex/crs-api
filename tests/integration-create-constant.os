#Использовать ".."

Функция Настройки(Путь)
	Чтение = Новый ЧтениеJSON;
	Чтение.ОткрытьФайл(Путь);
	Результат = ПрочитатьJSON(Чтение);
	Чтение.Закрыть();
	Возврат Результат;
КонецФункции

Если АргументыКоманднойСтроки.Количество() < 3 Тогда
	ВызватьИсключение "Укажите JSON хранилища, JSON разработчика, Python и необязательный --commit. Только ProtocolLab.";
КонецЕсли;
Хранилище = Настройки(АргументыКоманднойСтроки[0]);
Разработчик = Настройки(АргументыКоманднойСтроки[1]);
Если Хранилище.Repository <> "ProtocolLab" Тогда ВызватьИсключение "Разрешен только ProtocolLab."; КонецЕсли;
Клиент = Новый КлиентХранилища("http://127.0.0.1:18088/repo/repo.1ccr", "8.5.4.1878");
Клиент.Подключиться(Разработчик.User, Разработчик.Password, Хранилище.Repository);
UUID = Строка(Новый УникальныйИдентификатор());
ИмяКонстанты = ?(АргументыКоманднойСтроки.Количество() = 4, "CRSAPI_OneScriptConstant", "CRSAPI_Prepare_" + Лев(UUID, 8));
XML = "<MetaDataObject xmlns=""http://v8.1c.ru/8.3/MDClasses"" xmlns:v8=""http://v8.1c.ru/8.1/data/core""><Constant uuid=""" + UUID + """><Properties>
|<Name>" + ИмяКонстанты + "</Name><Synonym><v8:item><v8:lang>ru</v8:lang><v8:content>Константа через OneScript</v8:content></v8:item></Synonym>
|<Comment>Создана сериализатором через API</Comment><Type><v8:Type>xs:string</v8:Type><v8:StringQualifiers><v8:Length>64</v8:Length><v8:AllowedLength>Variable</v8:AllowedLength></v8:StringQualifiers></Type>
|</Properties></Constant></MetaDataObject>";
ПутьXML = ПолучитьИмяВременногоФайла("xml");
Запись = Новый ЗаписьТекста(ПутьXML, КодировкаТекста.UTF8); Запись.Записать(XML); Запись.Закрыть();
Попытка
    Пакет = Клиент.ПодготовитьПакетИзВыгрузки(ПутьXML, Неопределено, АргументыКоманднойСтроки[2]);
Исключение
    УдалитьФайлы(ПутьXML); ВызватьИсключение;
КонецПопытки;
УдалитьФайлы(ПутьXML);
Если Строка(Пакет.ИдентификаторКонстанты) <> UUID Тогда ВызватьИсключение "UUID константы изменился."; КонецЕсли;
Сообщить("Подготовлен пакет из XML, существующих объектов: " + Пакет.СуществующиеОбъекты.Количество());
Если АргументыКоманднойСтроки.Количество() = 4 И АргументыКоманднойСтроки[3] = "--commit" Тогда
	// Отказ до захвата должен случиться до отправки помещения.
	Отказ = Ложь;
	Попытка
		Клиент.ПоместитьПакет(Пакет);
	Исключение
		Отказ = СтрНайти(ОписаниеОшибки(), "захвачены") > 0;
	КонецПопытки;
	Если Не Отказ Тогда ВызватьИсключение "Не проверено отсутствие захвата."; КонецЕсли;
	Захваченные = Новый Массив;
	Попытка
		Для Каждого Объект Из Пакет.СуществующиеОбъекты Цикл
			Клиент.ЗахватитьОбъект(Объект);
			Захваченные.Добавить(Объект);
		КонецЦикла;
		Константа = Клиент.ПоместитьПакет(Пакет, "Строковая константа из XML через OneScript");
		Захваченные.Добавить(Константа);
		Снимок = Клиент.ПолучитьОбъект(Константа);
		Если Снимок.Данные.Размер() = 0 Тогда ВызватьИсключение "Нет данных созданной константы."; КонецЕсли;
		Сообщить("Создана CRSAPI_OneScriptConstant, UUID " + UUID + ", версия " + Константа.НомерВерсии);
	Исключение
		// После ошибки не повторяем помещение. Освобождаем только тестовые захваты.
		Для Каждого Объект Из Захваченные Цикл
			Клиент.ОтменитьЗахватОбъекта(Клиент.ПолучитьОписаниеОбъекта(Объект.Идентификатор));
		КонецЦикла;
		ВызватьИсключение;
	КонецПопытки;
	Для Каждого Объект Из Захваченные Цикл
		Клиент.ОтменитьЗахватОбъекта(Клиент.ПолучитьОписаниеОбъекта(Объект.Идентификатор));
	КонецЦикла;
	Сообщить("Получение созданной константы и освобождение захватов: успешно.");
КонецЕсли;
