#Использовать ".."

Перем ИдентификаторОбъекта;
Перем ИдентификаторПользователя;

Процедура Проверить(Условие, Сообщение)
	Если Не Условие Тогда
		ВызватьИсключение Сообщение;
	КонецЕсли;
КонецПроцедуры

Функция Ответ(Содержимое)
	Возврат "<crs:call_return xmlns:crs=""http://v8.1c.ru/8.2/crs"">" + Содержимое + "</crs:call_return>";
КонецФункции

Процедура ДолженОтказать(Текст)
	Отказ = Ложь;
	Попытка
		ОбработкаXML.ПроверитьОтветЗахвата(Текст, ИдентификаторОбъекта);
	Исключение
		Отказ = Истина;
	КонецПопытки;
	Проверить(Отказ, "Ошибочный ответ не должен подтверждать захват");
КонецПроцедуры

ИдентификаторОбъекта = "11111111-1111-1111-1111-111111111111";
ИдентификаторПользователя = "22222222-2222-2222-2222-222222222222";
Запрошенный = "<crs:requested><crs:value><crs:first value=""" + ИдентификаторОбъекта
	+ """/><crs:second/></crs:value></crs:requested>";
ОбработкаXML.ПроверитьОтветЗахвата(Ответ("<crs:result>" + Запрошенный + "</crs:result><crs:exception/>"), ИдентификаторОбъекта);
ДолженОтказать(Ответ("<crs:result><crs:requested/></crs:result>"));
ДолженОтказать(Ответ("<crs:result><crs:requested><crs:value><crs:first value="""
	+ ИдентификаторПользователя + """/></crs:value></crs:requested></crs:result>"));
Для Каждого Раздел Из СтрРазделить("required,missing,changed,unprocessed,added,moved", ",") Цикл
	ДолженОтказать(Ответ("<crs:result>" + Запрошенный + "<crs:" + Раздел
		+ "><crs:value/></crs:" + Раздел + "></crs:result>"));
КонецЦикла;
Ошибка = Base64Строка(ПолучитьДвоичныеДанныеИзСтроки("Недостаточно прав", КодировкаТекста.UTF8, Ложь));
ДолженОтказать(Ответ("<crs:result>" + Запрошенный + "</crs:result><crs:exception>" + Ошибка + "</crs:exception>"));
ДолженОтказать("<call_return><result/></call_return>");

Статистика = "<crs:statMap><crs:value><crs:first value=""" + ИдентификаторОбъекта
	+ """/><crs:second><crs:revised value=""true""/><crs:revisorID value="""
	+ ИдентификаторПользователя + """/></crs:second></crs:value></crs:statMap>";
Проверить(ОбработкаXML.ОбъектЗахваченПользователем(Ответ(Статистика), ИдентификаторОбъекта,
	ИдентификаторПользователя), "Владелец захвата не определен");
Проверить(Не ОбработкаXML.ОбъектЗахваченПользователем(Ответ(Статистика), ИдентификаторОбъекта,
	ИдентификаторОбъекта), "Чужой захват принят за собственный");
Проверить(Не ОбработкаXML.ОбъектЗахваченПользователем(Ответ(СтрЗаменить(Статистика,
	"true", "false")), ИдентификаторОбъекта, ИдентификаторПользователя), "Свободный объект принят за захваченный");

Описание = "<crs:_super><crs:id value=""" + ИдентификаторОбъекта + """/><crs:classID value="""
	+ ИдентификаторПользователя + """/></crs:_super><crs:name value=""Объект &amp; &quot;тест&quot;""/>
	|<crs:pos value=""0""/><crs:verNum value=""2""/><crs:selfVerNum value=""1""/>
	|<crs:parentID value=""00000000-0000-0000-0000-000000000000""/>
	|<crs:ownerID value=""00000000-0000-0000-0000-000000000000""/>
	|<crs:version><crs:original value=""aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa""/>
	|<crs:local value=""bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb""/></crs:version><crs:removed value=""false""/>";
Объекты = ОбработкаXML.ПрочитатьОбъектыВерсии(Ответ("<crs:objects><crs:value><crs:first value=""2""/>
	|<crs:second><crs:info>" + Описание + "</crs:info></crs:second></crs:value>
	|<crs:value><crs:first value=""1""/><crs:second><crs:info>" + Описание + "</crs:info></crs:second></crs:value></crs:objects>"));
Проверить(Объекты.Количество() = 2, "Не прочитаны все описания объектов");
Объект = Объекты[0];
Объект.ПроверитьДляЗахвата();
Проверить(Объект.Имя = "Объект & ""тест""" И Объект.НомерВерсии = 2,
	"Неверно прочитано описание объекта");
Параметры = Новый Структура("ИмяХранилища,ВерсияПлатформы,ПользовательХранилища,ХешПользователяХранилища,ИдентификаторПодключения,Объект,Захватить",
	"Repo & ""test""", "8.5.4.1878", "User & ""test""", "hash", Новый УникальныйИдентификатор(), Объект, Истина);
Запрос = МенеджерЗапросов.ТелоЗапросаНаИзменениеЗахвата(Параметры);
Чтение = Новый ЧтениеXML;
Чтение.УстановитьСтроку(Запрос);
ПроверенКорень = Ложь;
ПровереноИмя = Ложь;
Пока Чтение.Прочитать() Цикл
	Если Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
		Если Чтение.ЛокальноеИмя = "call" Тогда
			Проверить(Чтение.ЗначениеАтрибута("alias") = Параметры.ИмяХранилища, "Имя хранилища повреждено при записи XML");
			ПроверенКорень = Истина;
		ИначеЕсли Чтение.ЛокальноеИмя = "name" Тогда
			Проверить(Чтение.ЗначениеАтрибута("value") = Объект.Имя, "Имя объекта повреждено при записи XML");
			ПровереноИмя = Истина;
		ИначеЕсли Чтение.ЛокальноеИмя = "pos" Тогда
			Проверить(Чтение.ЗначениеАтрибута("value") = "0", "Нулевая позиция должна передаваться как 0");
		КонецЕсли;
	КонецЕсли;
КонецЦикла;
Чтение.Закрыть();
Проверить(ПроверенКорень И ПровереноИмя, "Не проверена запись XML");

Отказ = Ложь;
Попытка
	Клиент = Новый КлиентХранилища("http://127.0.0.1:1", "8.5.4.1878");
	Клиент.ЗахватитьОбъект(Объект);
Исключение
	Отказ = СтрНайти(ОписаниеОшибки(), "сначала подключитесь") > 0;
КонецПопытки;
Проверить(Отказ, "Не запрещен захват без авторизации");
Сообщить("Проверки захвата: успешно (ответы сервера, владелец, описание, XML, авторизация)");
