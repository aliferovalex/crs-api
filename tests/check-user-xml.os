#Использовать ".."

Процедура ПроверитьXML(Текст, Параметры, ПроверятьИмя)
 Чтение = Новый ЧтениеXML; Чтение.УстановитьСтроку(Текст);
 ПроверенАдминистратор = Ложь; ПровереноИмя = Не ПроверятьИмя;
 Пока Чтение.Прочитать() Цикл
  Если Чтение.ТипУзла <> ТипУзлаXML.НачалоЭлемента Тогда Продолжить; КонецЕсли;
  Если Чтение.ЛокальноеИмя = "call" Тогда
   Если Чтение.ЗначениеАтрибута("alias") <> Параметры.ИмяХранилища Тогда ВызватьИсключение "Искажён alias."; КонецЕсли;
  ИначеЕсли Чтение.ЛокальноеИмя = "auth" Тогда
   Если Чтение.ЗначениеАтрибута("user") <> Параметры.ПользовательХранилища Тогда ВызватьИсключение "Искажён логин администратора."; КонецЕсли;
   ПроверенАдминистратор = Истина;
  ИначеЕсли Чтение.ЛокальноеИмя = "name" Тогда
   Если Чтение.ЗначениеАтрибута("value") <> Параметры.ИмяПользователя Тогда ВызватьИсключение "Искажён логин пользователя."; КонецЕсли;
   ПровереноИмя = Истина;
  ИначеЕсли Чтение.ЛокальноеИмя = "rights" Тогда
   Если Чтение.ЗначениеАтрибута("value") <> "0" Тогда ВызватьИсключение "Изменены права только чтения."; КонецЕсли;
  КонецЕсли;
 КонецЦикла;
 Чтение.Закрыть();
 Если Не ПроверенАдминистратор Или Не ПровереноИмя Тогда ВызватьИсключение "Не проверены обязательные поля."; КонецЕсли;
КонецПроцедуры

Параметры = Новый Структура;
Параметры.Вставить("ИмяХранилища", "Repo & <> ' ""quoted""");
Параметры.Вставить("ВерсияПлатформы", "8.3.27.1936");
Параметры.Вставить("ПользовательХранилища", "Admin & <> ' ""quoted""");
Параметры.Вставить("ИмяПользователя", "ci & <> ' ""quoted""" + Символы.Таб + Символы.ПС);
Параметры.Вставить("ХешПользователяХранилища", "00000000000000000000000000000000");
Параметры.Вставить("ХешПароляПользователя", Параметры.ХешПользователяХранилища);
Параметры.Вставить("ХешНовогоПароля", Вспомогательный.ХешированныйПароль("ci!$[]"));
Параметры.Вставить("ХешПароля", Параметры.ХешНовогоПароля);
Параметры.Вставить("Роль", "0");
Параметры.Вставить("ИдентификаторПодключения", Новый УникальныйИдентификатор());
Параметры.Вставить("ИдентификаторОперации", Новый УникальныйИдентификатор());
Параметры.Вставить("ИдентификаторПользователя", Параметры.ИдентификаторОперации);
ПроверитьXML(МенеджерЗапросов.ТелоЗапросаНаСозданиеПользователя(Параметры), Параметры, Истина);
ПроверитьXML(МенеджерЗапросов.ТелоЗапросаПоискаПользователя(Параметры), Параметры, Истина);
ПроверитьXML(МенеджерЗапросов.ТелоЗапросаНаОбновлениеРолиПользователя(Параметры), Параметры, Истина);
ПроверитьXML(МенеджерЗапросов.ТелоЗапросаНаПолучениеСпискаПользователей(Параметры), Параметры, Ложь);
ПроверитьXML(МенеджерЗапросов.ТелоЗапросаНаПодключение(Параметры), Параметры, Ложь);
Сообщить("XML пользователей: специальные символы, пароль и права 0 сохранены.");
