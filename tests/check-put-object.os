#Использовать ".."

Перем Идентификатор;
Перем Класс;
Перем Данные;
Перем Описание;

Процедура Проверить(Условие, Сообщение)
	Если Не Условие Тогда
		ВызватьИсключение Сообщение;
	КонецЕсли;
КонецПроцедуры

Функция Запрос(ДваОбъекта = Ложь, Удаление = "", Внешние = "")
	Запрошенный = "<crs:value><crs:first value=""" + Идентификатор
		+ """/><crs:second>" + Описание + "</crs:second></crs:value>";
	Возврат "<crs:call xmlns:crs=""http://v8.1c.ru/8.2/crs"" name=""DevDepot_commitObjects"" alias=""Repo"" version=""8.5.4.1878"">"
		+ "<crs:auth user=""native-user"" password=""native-secret""/><crs:params>"
		+ "<crs:clientVerID value=""33333333-3333-3333-3333-333333333333""/><crs:data>" + Данные + "</crs:data>"
		+ "<crs:requested>" + Запрошенный + ?(ДваОбъекта, Запрошенный, "") + "</crs:requested>"
		+ "<crs:changes><crs:value><crs:first value=""" + Идентификатор + """/><crs:second><crs:_super>"
		+ Описание + "</crs:_super><crs:externals>" + Внешние + "</crs:externals></crs:second></crs:value></crs:changes>"
		+ "<crs:objectsToRemove>" + Удаление + "</crs:objectsToRemove><crs:code value=""""/>"
		+ "<crs:features><crs:value><crs:first value=""" + Идентификатор
		+ """/><crs:second><crs:value value=""44444444-4444-4444-4444-444444444444""/></crs:second></crs:value></crs:features>"
		+ "</crs:params></crs:call>";
КонецФункции

Процедура ПакетДолженОтказать(Текст)
	Отказ = Ложь;
	Попытка
		Пакет = Новый ПакетПомещенияОбъекта;
		Пакет.ЗаполнитьИзЗапроса(Текст);
	Исключение
		Отказ = Истина;
	КонецПопытки;
	Проверить(Отказ, "Недопустимый пакет помещения принят");
КонецПроцедуры

Функция Ответ(Содержимое)
	Возврат "<crs:call_return xmlns:crs=""http://v8.1c.ru/8.2/crs"">" + Содержимое + "</crs:call_return>";
КонецФункции

Процедура ОтветДолженОтказать(Текст)
	Отказ = Ложь;
	Попытка
		ОбработкаXML.ПроверитьОтветПомещения(Текст);
	Исключение
		Отказ = Истина;
	КонецПопытки;
	Проверить(Отказ, "Ошибочный ответ помещения принят");
КонецПроцедуры

Идентификатор = "11111111-1111-1111-1111-111111111111";
Класс = "22222222-2222-2222-2222-222222222222";
// Синтетические данные для проверки конверта. В сервер не отправляются.
Данные = "AgFTS2/0iI3BTqDV67a9oKcNs2GAgPe791dXG9TqEIMNkEggrgUA";
Описание = "<crs:_super><crs:id value=""" + Идентификатор + """/><crs:classID value=""" + Класс + """/></crs:_super>"
	+ "<crs:name value=""Объект &amp; &quot;тест&quot;""/><crs:pos value=""0""/><crs:verNum value=""2""/><crs:selfVerNum value=""1""/>"
	+ "<crs:parentID value=""00000000-0000-0000-0000-000000000000""/><crs:ownerID value=""00000000-0000-0000-0000-000000000000""/>"
	+ "<crs:version><crs:original value=""aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa""/><crs:local value=""bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb""/></crs:version>"
	+ "<crs:removed value=""false""/>";
Объект = ОбработкаXML.ПрочитатьОбъектыВерсии(Ответ("<crs:objects><crs:value><crs:first value=""2""/><crs:second><crs:info>"
	+ Описание + "</crs:info></crs:second></crs:value></crs:objects>"))[0];
ТекстXML = Запрос();
Пакет = Новый ПакетПомещенияОбъекта;
Пакет.ЗаполнитьИзЗапроса(ТекстXML);
Пакет.Проверить(Объект);
Проверить(Пакет.СуществующиеОбъекты.Количество() = 1, "Исходный объект импортированного пакета потерян");
Проверить(Пакет.Особенности.Количество() = 1, "Особенности помещения потеряны");
ПакетДолженОтказать(Запрос(Истина));
ПакетДолженОтказать(Запрос(Ложь, "<crs:value/>"));
ПакетДолженОтказать(Запрос(Ложь, "", "<crs:value/>"));
Внешний = "<crs:value><crs:first value=""" + Идентификатор + ".0""/><crs:second><crs:_super><crs:name value=""" + Идентификатор
	+ ".0""/><crs:verID value=""aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa""/></crs:_super><crs:action value=""1""/></crs:second></crs:value>";
СВнешним = Новый ПакетПомещенияОбъекта; СВнешним.ЗаполнитьИзЗапроса(Запрос(Ложь, "", Внешний)); СВнешним.Проверить(Объект);
Проверить(СВнешним.ВнешниеДанные.Количество() = 1 И СВнешним.ВнешниеДанные[0].action = 1, "Описание внешнего потока потеряно");
ПакетДолженОтказать(Запрос(Ложь, "", Внешний + Внешний));
ПакетДолженОтказать(Запрос(Ложь, "", СтрЗаменить(Внешний, "action value=""1""", "action value=""2""")));
ПакетДолженОтказать(Запрос(Ложь, "", СтрЗаменить(Внешний, Идентификатор + ".0", "99999999-9999-4999-8999-999999999999.0")));
Владельцы = Новый Массив; Владельцы.Добавить("99999999-9999-4999-8999-999999999999");
СоВстроенным = Новый ПакетПомещенияОбъекта;
СоВстроенным.ЗаполнитьИзЗапроса(Запрос(Ложь, "", СтрЗаменить(Внешний, Идентификатор + ".0", Владельцы[0] + ".2")), Владельцы);
СоВстроенным.Проверить(Объект);
Проверить(СоВстроенным.ВнешниеДанные.Количество() = 1, "Проверенный встроенный поток потерян");
ПакетДолженОтказать(СтрЗаменить(ТекстXML, Данные, "AAAA"));
ПакетДолженОтказать(СтрЗаменить(ТекстXML, "DevDepot_commitObjects", "DevDepot_updateObjects"));
ПакетДолженОтказать(СтрЗаменить(ТекстXML, "http://v8.1c.ru/8.2/crs", "urn:wrong"));
ПакетДолженОтказать(СтрЗаменить(ТекстXML, "<crs:code value=""""/>", "<crs:code value=""unsupported""/>"));
ИсходнаяВерсия = Объект.ИсходнаяВерсия;
Объект.ИсходнаяВерсия = "cccccccccccccccccccccccccccccccccccccccc";
Отказ = Ложь;
Попытка
	Пакет.Проверить(Объект);
Исключение
	Отказ = Истина;
КонецПопытки;
Объект.ИсходнаяВерсия = ИсходнаяВерсия;
Проверить(Отказ, "Несовпадение исходной версии пакета не отклонено");
Объект.Удален = Истина;
Отказ = Ложь;
Попытка
	Пакет.Проверить(Объект);
Исключение
	Отказ = СтрНайти(ОписаниеОшибки(), "удаленный") > 0;
КонецПопытки;
Объект.Удален = Ложь;
Проверить(Отказ, "Помещение удаленного объекта не запрещено");
Параметры = Новый Структура("ИмяХранилища,ВерсияПлатформы,ПользовательХранилища,ХешПользователяХранилища,ИдентификаторПодключения,Объект,Пакет,Комментарий",
	"Repo", "8.5.4.1878", "current-user", "current-hash", Новый УникальныйИдентификатор(), Объект, Пакет, "Тест & ""помещение""");
Тело = МенеджерЗапросов.ТелоЗапросаНаПомещениеОбъекта(Параметры);
Проверить(СтрНайти(Тело, "native-secret") = 0 И СтрНайти(Тело, "current-hash") > 0, "Использована авторизация из захваченного запроса");
Чтение = Новый ЧтениеXML;
Чтение.УстановитьСтроку(Тело);
ПроверенныеВерсии = 0;
Пока Чтение.Прочитать() Цикл
	Если Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
		Если Чтение.ЛокальноеИмя = "verNum" Тогда
			Проверить(Чтение.ЗначениеАтрибута("value") = "-1", "Версия запроса помещения должна быть -1");
			ПроверенныеВерсии = ПроверенныеВерсии + 1;
		ИначеЕсли Чтение.ЛокальноеИмя = "local" Тогда
			Проверить(Чтение.ЗначениеАтрибута("value") = Пакет.ЛокальнаяВерсия, "Изменена контрольная сумма клиента");
		КонецЕсли;
	КонецЕсли;
КонецЦикла;
Чтение.Закрыть();
Проверить(ПроверенныеВерсии = 2 И Объект.НомерВерсии = 2, "Описание объекта изменено при записи запроса");
ОбработкаXML.ПроверитьОтветПомещения(Ответ("<crs:result><crs:unprocessed/></crs:result><crs:exc/>"));
ОбработкаXML.ПроверитьОтветПомещения(Ответ("<crs:result><crs:unprocessed><crs:value><crs:first value=""6""/><crs:second/></crs:value></crs:unprocessed></crs:result>"));
Для Каждого Раздел Из СтрРазделить("required,missing,added,changed,moved", ",") Цикл
	ОтветДолженОтказать(Ответ("<crs:result><crs:" + Раздел + "><crs:value/></crs:" + Раздел + "></crs:result>"));
КонецЦикла;
ОтветДолженОтказать(Ответ("<crs:result><crs:unprocessed><crs:value><crs:first value=""5""/><crs:second/></crs:value></crs:unprocessed></crs:result>"));
ОтветДолженОтказать(Ответ("<crs:result><crs:unprocessed><crs:value><crs:first value=""6""/><crs:second><crs:value/></crs:second></crs:value></crs:unprocessed></crs:result>"));
ОтветДолженОтказать(Ответ("<crs:result><crs:unprocessed><crs:value><crs:first value=""6""/><crs:second>Ошибка</crs:second></crs:value></crs:unprocessed></crs:result>"));
ОтветДолженОтказать(Ответ("<crs:result/><crs:result/>"));
ОтветДолженОтказать(Ответ("<result xmlns=""urn:wrong""/>"));
ОтветДолженОтказать(Ответ("<crs:exc/>"));
ОтветДолженОтказать("<call_return><result/></call_return>");
Ошибка = Base64Строка(ПолучитьДвоичныеДанныеИзСтроки("Ошибка помещения", КодировкаТекста.UTF8, Ложь));
ОтветДолженОтказать(Ответ("<crs:result/><crs:exc>" + Ошибка + "</crs:exc>"));
Отказ = Ложь;
Попытка
	Клиент = Новый КлиентХранилища("http://127.0.0.1:1", "8.5.4.1878");
	Клиент.ПоместитьОбъект(Объект, Пакет);
Исключение
	Отказ = СтрНайти(ОписаниеОшибки(), "сначала подключитесь") > 0;
КонецПопытки;
Проверить(Отказ, "Не запрещено помещение без авторизации");
Сообщить("Проверки помещения: успешно (пакет, версии, область изменений, XML, авторизация, ответы и код 6)");
