#Использовать ".."
#Использовать "support"
Процедура Проверить(Условие, Текст)
 Если Не Условие Тогда ВызватьИсключение Текст; КонецЕсли;
КонецПроцедуры
Функция Список(Объект)
 Массив = Новый Массив; Массив.Добавить(Объект); Возврат Массив;
КонецФункции
Функция ГотоваяПодготовка(Клиент)
 Объект = Клиент.Добавить("a"); Подготовка = Новый ПодготовкаПомещенияКонфигурации(Клиент, "owner");
 Подготовка.ЗахватитьОбъекты(Список(Объект));
 Пакет = Новый ИмитацияПакетаПодготовки(Список(Объект), "version"); Подготовка.УстановитьПакет(Пакет);
 Возврат Подготовка;
КонецФункции
Клиент = Новый ИмитацияКлиентаПодготовки;
Первый = Клиент.Добавить("a"); Прежний = Клиент.Добавить("b", Истина);
Подготовка = Новый ПодготовкаПомещенияКонфигурации(Клиент, "owner");
Подготовка.ЗахватитьОбъекты(Список(Первый)); Подготовка.ЗахватитьОбъекты(Список(Прежний));
Подготовка.ЗахватитьОбъекты(Список(Первый));
Проверить(Клиент.Захваты.Количество() = 1, "Повторный захват или захват прежнего объекта.");
Отмена = Подготовка.Отменить(); Проверить(Отмена.Ошибки.Количество() = 0 И Клиент.Освобождения.Количество() = 1, "Не снят новый захват.");
Проверить(Клиент.Состояния.Получить("b").Захвачен, "Снят прежний захват.");
Клиент = Новый ИмитацияКлиентаПодготовки; Подготовка = ГотоваяПодготовка(Клиент);
Клиент.Добавить("foreign", Истина, "other"); Отказ = Ложь;
Попытка Подготовка.ЗахватитьОбъекты(Список(Клиент.ПолучитьОписаниеОбъекта("foreign"))); Исключение Отказ = Истина; КонецПопытки;
Проверить(Отказ, "Захват после завершения подготовки разрешён.");
Клиент.Состояния.Получить("a").ДатаЗахвата = "another-lock";
Отмена = Подготовка.Отменить(); Проверить(Отмена.НеОсвобождены.Количество() = 1 И Клиент.Освобождения.Количество() = 0, "Снят заменённый захват.");
Клиент = Новый ИмитацияКлиентаПодготовки; Объект = Клиент.Добавить("a"); Клиент.ОшибкаЗахвата = "a";
Подготовка = Новый ПодготовкаПомещенияКонфигурации(Клиент, "owner"); Отказ = Ложь;
Попытка Подготовка.ЗахватитьОбъекты(Список(Объект)); Исключение Отказ = Истина; КонецПопытки;
Проверить(Отказ, "Потеря ответа захвата не замечена.");
Проверить(Подготовка.Отменить().Ошибки.Количество() = 0 И Не Клиент.Состояния.Получить("a").Захвачен, "Не снят захват после потерянного ответа.");
Клиент = Новый ИмитацияКлиентаПодготовки; Подготовка = ГотоваяПодготовка(Клиент); Клиент.Версия = "changed"; Отказ = Ложь;
Попытка Подготовка.Поместить(); Исключение Отказ = Истина; КонецПопытки;
Проверить(Отказ И Клиент.Отправки = 0, "Устаревший пакет отправлен."); Подготовка.Отменить();
Клиент = Новый ИмитацияКлиентаПодготовки; Подготовка = ГотоваяПодготовка(Клиент); Подготовка.Поместить();
Проверить(Подготовка.Состояние = "Помещено" И Клиент.Отправки = 1 И Клиент.Освобождения.Количество() = 1, "Не завершено помещение.");
Отказ = Ложь; Попытка Подготовка.Поместить(); Исключение Отказ = Истина; КонецПопытки;
Проверить(Отказ И Клиент.Отправки = 1, "Повторно отправлен пакет.");
Клиент = Новый ИмитацияКлиентаПодготовки; Подготовка = ГотоваяПодготовка(Клиент); Клиент.ПотерятьОтвет = Истина; Отказ = Ложь;
Попытка Подготовка.Поместить(); Исключение Отказ = Истина; КонецПопытки;
Проверить(Отказ И Подготовка.Состояние = "ИсходНеизвестен" И Клиент.Освобождения.Количество() = 0, "Захваты сняты при неизвестном помещении.");
Отказ = Ложь; Попытка Подготовка.Отменить(); Исключение Отказ = Истина; КонецПопытки;
Проверить(Отказ, "Разрешена отмена неизвестного помещения.");
Клиент.Подтверждено = Ложь; Проверить(Не Подготовка.ПодтвердитьПомещение().updated И Клиент.Освобождения.Количество() = 0, "Неподтверждённое помещение принято.");
Клиент.Подтверждено = Истина; Проверить(Подготовка.ПодтвердитьПомещение().updated И Клиент.Отправки = 1 И Клиент.Освобождения.Количество() = 1, "Восстановление повторило отправку.");
Клиент = Новый ИмитацияКлиентаПодготовки; Первый = Клиент.Добавить("a"); Второй = Клиент.Добавить("b", Истина, "other");
Подготовка = Новый ПодготовкаПомещенияКонфигурации(Клиент, "owner"); Подготовка.ЗахватитьОбъекты(Список(Первый)); Отказ = Ложь;
Попытка Подготовка.ЗахватитьОбъекты(Список(Второй)); Исключение Отказ = Истина; КонецПопытки;
Проверить(Отказ И Подготовка.Отменить().Ошибки.Количество() = 0 И Клиент.Состояния.Получить("b").Захвачен, "Чужой дополнительный захват не остановил подготовку.");
Клиент = Новый ИмитацияКлиентаПодготовки; Подготовка = ГотоваяПодготовка(Клиент); Клиент.ОсноваОбновлена = Ложь; Отказ = Ложь;
Попытка Подготовка.Поместить(); Исключение Отказ = Истина; КонецПопытки;
Проверить(Отказ И Подготовка.Состояние = "ПомещеноОсноваНеОбновлена" И Клиент.Освобождения.Количество() = 0, "Захваты сняты до обновления основы.");
Проверить(Подготовка.Отменить().Ошибки.Количество() = 0 И Подготовка.Состояние = "ПомещеноОсноваНеОбновлена", "Не сняты захваты подтверждённого помещения.");
Проверить(Подготовка.ПодтвердитьПомещение().updated И Клиент.Отправки = 1 И Клиент.Освобождения.Количество() = 1, "Повтор обновления основы повторил помещение.");
Клиент = Новый ИмитацияКлиентаПодготовки; Подготовка = ГотоваяПодготовка(Клиент);
Созданный = Клиент.Добавить("created", Истина); Подготовка.Пакет.НовыеОбъекты.Добавить(Созданный);
Подготовка.Поместить();
Проверить(Клиент.Освобождения.Найти("created") <> Неопределено И Не Клиент.Состояния.Получить("created").Захвачен, "Не снят автоматический захват созданного объекта.");
Клиент.Состояния.Получить("created").Захвачен = Истина; Клиент.Состояния.Получить("created").ДатаЗахвата = "manual-again";
Подготовка.Отменить(); Проверить(Клиент.Состояния.Получить("created").Захвачен, "Повторное завершение сняло новый ручной захват.");
Клиент = Новый ИмитацияКлиентаПодготовки; Подготовка = ГотоваяПодготовка(Клиент); Клиент.ОшибкаСнятия = "a";
Отмена = Подготовка.Отменить(); Проверить(Отмена.Ошибки.Количество() = 1 И Подготовка.Состояние = "ЗахватыНеОсвобождены", "Потеряна ошибка снятия захвата.");
Клиент.ОшибкаСнятия = ""; Проверить(Подготовка.Отменить().Ошибки.Количество() = 0, "Нельзя повторить только снятие захвата.");
Клиент = Новый ИмитацияКлиентаПодготовки; Подготовка = ГотоваяПодготовка(Клиент);
Подготовка.НовыеЗахваты.Очистить(); Подготовка.Пакет = Неопределено;
Подготовка.Поместить(); Проверить(Клиент.Отправки = 1 И Клиент.Освобождения.Количество() = 1, "Изменение отчётных полей повредило владение захватами.");
Клиент = Новый ИмитацияКлиентаПодготовки; Подготовка = ГотоваяПодготовка(Клиент); Отказ = Ложь;
Попытка Подготовка.Поместить(Неопределено); Исключение Отказ = Истина; КонецПопытки;
Проверить(Отказ И Подготовка.Состояние = "Готово" И Клиент.Отправки = 0, "Ошибка комментария помечена неизвестной отправкой.");
Подготовка.Пакет.Поврежден = Истина; Отказ = Ложь;
Попытка Подготовка.Поместить(); Исключение Отказ = Истина; КонецПопытки;
Проверить(Отказ И Подготовка.Состояние = "Готово" И Клиент.Отправки = 0, "Повреждённый пакет был отправлен."); Подготовка.Отменить();
Сообщить("Подготовка с захватом: успешно (прежние и новые захваты, метки, отмена, потеря ответов, версии, запрет повтора).");
