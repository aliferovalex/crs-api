#Использовать ".."

Если АргументыКоманднойСтроки.Количество() = 0 Тогда
 Сообщить("Исторический транспорт проверяется test_historical_object.py на синтетическом сервере.");
 ЗавершитьРаботу(0);
КонецЕсли;
Клиент = Новый КлиентХранилища(АргументыКоманднойСтроки[0], "8.5.1.1529");
Клиент.Подключиться("test", "test", "Repo");
Объекты = Клиент.СписокОбъектовВерсии(42);
Попытка
 Снимок = Клиент.ПолучитьИсторическийОбъект(Объекты[0], АргументыКоманднойСтроки[1]);
 Если АргументыКоманднойСтроки[2] <> "success" Тогда ВызватьИсключение "Повреждённый снимок принят"; КонецЕсли;
 Результат = СериализаторОбъектаХранилища.СравнитьСнимкиОбъекта(Объекты[0].Идентификатор, Неопределено, Снимок, АргументыКоманднойСтроки[1]);
 Если Результат.streams.Количество() <> 2 Тогда ВызватьИсключение "Потерян внешний поток"; КонецЕсли;
 Если Результат.streams[1].after.text <> "historical module" Тогда ВызватьИсключение "Получен неверный текст"; КонецЕсли;
Исключение
 Если АргументыКоманднойСтроки[2] = "success" Тогда ВызватьИсключение; КонецЕсли;
 Если АргументыКоманднойСтроки[2] = "hash" И СтрНайти(ОписаниеОшибки(), "хешам описания") = 0 Тогда ВызватьИсключение; КонецЕсли;
 Если АргументыКоманднойСтроки[2] = "missing" И СтрНайти(ОписаниеОшибки(), "External versions/manifest mismatch") = 0 Тогда ВызватьИсключение; КонецЕсли;
КонецПопытки;
