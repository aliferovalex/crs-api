#Использовать ".."

Функция Описание(UUID, Класс, Имя, Родитель, Версия)
	Возврат Новый Структура("id,class_id,name,pos,parent_id,owner_id,original,local", UUID, Класс, Имя, 0, Родитель,
		"00000000-0000-0000-0000-000000000000", Версия, Версия);
КонецФункции

Процедура Проверить(Условие, Сообщение)
	Если Не Условие Тогда ВызватьИсключение Сообщение; КонецЕсли;
КонецПроцедуры

Корень = Новый ОбъектХранилища;
Корень.Идентификатор = Новый УникальныйИдентификатор("11111111-1111-4111-8111-111111111111");
Корень.ИдентификаторКласса = ИдентификаторыМетаданных.ИдентификаторКласса("Catalog");
Корень.Имя = "Root";
Корень.Позиция = 0;
Корень.НомерВерсии = 1;
Корень.НомерСобственнойВерсии = 1;
Корень.ИдентификаторРодителя = "00000000-0000-0000-0000-000000000000";
Корень.ИдентификаторВладельца = Корень.ИдентификаторРодителя;
Корень.ИсходнаяВерсия = "1111111111111111111111111111111100000000";
Корень.ЛокальнаяВерсия = Корень.ИсходнаяВерсия;
Корень.Удален = Ложь;
Снимок = Новый СнимокОбъектаХранилища;
Снимок.Объект = Корень;
Снимок.ВерсияХранилища = "22222222-2222-4222-8222-222222222222";
Снимки = Новый Массив;
Снимки.Добавить(Снимок);
UUIDНового = "33333333-3333-4333-8333-333333333333";
Результат = Новый Структура("object_id,data,version_code,descriptions", UUIDНового,
	"AgFTS2/0iI3BTqDV67a9oKcNAA==", "1.0", Новый Массив);
Результат.descriptions.Добавить(Описание(UUIDНового, "fdf816d2-1ead-11d5-b975-0050bae0a95d", "NewForm",
	Строка(Корень.Идентификатор), "3333333333333333333333333333333300000000"));
Результат.descriptions.Добавить(Описание(Строка(Корень.Идентификатор), Корень.ИдентификаторКласса, Корень.Имя,
	Корень.ИдентификаторРодителя, Корень.ИсходнаяВерсия));
Внешние = Новый Массив;
Внешние.Добавить(Новый Структура("object_id,name,version,action", UUIDНового, UUIDНового + ".0", "3333333333333333333333333333333300000000", 0));
Результат.Вставить("externals", Внешние);
Пакет = Новый ПакетСозданияФормыСправочника(Результат, Снимки, "Repo", "8.5.1.1529");
Пакет.Проверить();
Параметры = Новый Структура("ИмяХранилища,ВерсияПлатформы,ПользовательХранилища,ХешПользователяХранилища,ИдентификаторПодключения,Пакет,Комментарий",
	"Repo", "8.5.1.1529", "test-user", "synthetic-hash", Новый УникальныйИдентификатор(), Пакет, "Тест & <XML>");
Текст = МенеджерЗапросов.ТелоЗапросаНаСозданиеКонстанты(Параметры);
Проверить(СтрНайти(Текст, "Тест &amp; &lt;XML&gt;") > 0, "Комментарий не экранирован");
Проверить(СтрНайти(Текст, "verNum value=""-1""") > 0, "Неверные номера версий запроса");
Проверить(СтрНайти(Текст, "code value=""1.0""") > 0, "Код версии не передан");
Проверить(СтрНайти(Текст, ИдентификаторыМетаданных.ИдентификаторПризнака("ConstantCollectionChanged")) = 0, "Признак константы в справочнике");
Проверить(СтрЧислоВхождений(Текст, "<crs:second/>") + СтрЧислоВхождений(Текст, "<crs:second />") + СтрЧислоВхождений(Текст, "<crs:second></crs:second>") = 1, "Нужны пустые признаки справочника");
Проверить(СтрНайти(Текст, "verID value=""3333333333333333333333333333333300000000""") > 0, "Версия внешнего текста потеряна");
Для Каждого Режим Из СтрРазделить("header,duplicate,version,parent,class,platform,external-name,external-version,external-action,external-missing", ",") Цикл
	Пакет = Новый ПакетСозданияФормыСправочника(Результат, Снимки, "Repo", "8.5.1.1529");
	Если Режим = "header" Тогда Пакет.Данные = Base64Значение("AAAAAAAAAAAAAAAAAAAAAAAAAA=="); КонецЕсли;
	Если Режим = "duplicate" Тогда Пакет.ОбъектыПакета.Добавить(Пакет.ОбъектыПакета[0]); КонецЕсли;
	Если Режим = "version" Тогда Пакет.ОбъектыПакета[0].ИсходнаяВерсия = Корень.ИсходнаяВерсия; КонецЕсли;
	Если Режим = "parent" Тогда Пакет.ОбъектыПакета[0].ИдентификаторРодителя = Корень.ИдентификаторРодителя; КонецЕсли;
	Если Режим = "class" Тогда Пакет.ОбъектыПакета[0].ИдентификаторКласса = ИдентификаторыМетаданных.КлассКонстанты(); КонецЕсли;
	Если Режим = "platform" Тогда Пакет.ВерсияПлатформы = "8.5.4.1878"; КонецЕсли;
	Если Режим = "external-name" Тогда Пакет.ВнешниеДанные[0].name = "other.0"; КонецЕсли;
	Если Режим = "external-version" Тогда Пакет.ВнешниеДанные[0].version = "not-hex"; КонецЕсли;
	Если Режим = "external-action" Тогда Пакет.ВнешниеДанные[0].action = 1; КонецЕсли;
	Если Режим = "external-missing" Тогда Пакет.ВнешниеДанные = Новый Массив; КонецЕсли;
	Отказ = Ложь;
	Попытка Пакет.Проверить(); Исключение Отказ = Истина; КонецПопытки;
	Проверить(Отказ, "Недопустимый пакет принят: " + Режим);
	Внешние[0].name = UUIDНового + ".0"; Внешние[0].version = "3333333333333333333333333333333300000000"; Внешние[0].action = 0;
КонецЦикла;
Для Каждого Версия Из СтрРазделить("8.5.1.1150,8.5.0.1,8.3.27.2342,8.2.19.1", ",") Цикл
	Пакет = Новый ПакетСозданияФормыСправочника(Результат, Снимки, "Repo", Версия);
	Пакет.Проверить();
КонецЦикла;
Сообщить("Пакет создания: UUID разных типов, описание, заголовок, версии, область объектов и XML — успешно.");
