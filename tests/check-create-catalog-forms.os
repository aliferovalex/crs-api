#Использовать ".."

Функция Описание(UUID, Класс, Имя, Родитель, Версия)
    Возврат Новый Структура("id,class_id,name,pos,parent_id,owner_id,original,local", UUID, Класс, Имя, 0, Родитель,
        "00000000-0000-0000-0000-000000000000", Версия, Версия);
КонецФункции

Корень = Новый ОбъектХранилища;
Корень.Идентификатор = "11111111-1111-4111-8111-111111111111";
Корень.ИдентификаторКласса = ИдентификаторыМетаданных.КлассКонфигурации(); Корень.Имя = "Root"; Корень.Позиция = 0;
Корень.НомерВерсии = 1; Корень.НомерСобственнойВерсии = 1;
Корень.ИдентификаторРодителя = "00000000-0000-0000-0000-000000000000"; Корень.ИдентификаторВладельца = Корень.ИдентификаторРодителя;
Корень.ИсходнаяВерсия = "1111111111111111111111111111111100000000"; Корень.ЛокальнаяВерсия = Корень.ИсходнаяВерсия; Корень.Удален = Ложь;
Снимок = Новый СнимокОбъектаХранилища; Снимок.Объект = Корень; Снимок.ВерсияХранилища = "22222222-2222-4222-8222-222222222222";
Снимки = Новый Массив; Снимки.Добавить(Снимок);
UUIDСправочника = "33333333-3333-4333-8333-333333333333"; UUIDФормы = "44444444-4444-4444-8444-444444444444";
Для Каждого Режим Из СтрРазделить("ok,parent,class,owner,version,position,missing-stream,action,extra-object", ",") Цикл
    Результат = Новый Структура("object_id,data,version_code,descriptions,externals", UUIDСправочника, "AgFTS2/0iI3BTqDV67a9oKcNAA==", "1.0", Новый Массив, Новый Массив);
    Результат.descriptions.Добавить(Описание(UUIDСправочника, ИдентификаторыМетаданных.ИдентификаторКласса("Catalog"), "NewCatalog", Корень.Идентификатор, "3333333333333333333333333333333300000000"));
    Результат.descriptions.Добавить(Описание(Корень.Идентификатор, Корень.ИдентификаторКласса, Корень.Имя, Корень.ИдентификаторРодителя, Корень.ИсходнаяВерсия));
    Форма = Описание(UUIDФормы, ИдентификаторыМетаданных.ИдентификаторКласса("CatalogForm"), "NewForm", UUIDСправочника, "4444444444444444444444444444444400000000"); Результат.descriptions.Добавить(Форма);
    Поток = Новый Структура("object_id,name,version,action", UUIDФормы, UUIDФормы + ".0", "5555555555555555555555555555555500000000", 0); Результат.externals.Добавить(Поток);
    Если Режим = "parent" Тогда Форма.parent_id = Корень.Идентификатор; КонецЕсли;
    Если Режим = "class" Тогда Форма.class_id = ИдентификаторыМетаданных.ИдентификаторКласса("DocumentForm"); КонецЕсли;
    Если Режим = "owner" Тогда Форма.owner_id = UUIDСправочника; КонецЕсли;
    Если Режим = "version" Тогда Форма.local = Корень.ИсходнаяВерсия; КонецЕсли;
    Если Режим = "position" Тогда Форма.pos = 1; КонецЕсли;
    Если Режим = "missing-stream" Тогда Результат.externals.Очистить(); КонецЕсли;
    Если Режим = "action" Тогда Поток.action = 1; КонецЕсли;
    Если Режим = "extra-object" Тогда Результат.descriptions.Добавить(Описание("66666666-6666-4666-8666-666666666666", ИдентификаторыМетаданных.ИдентификаторКласса("Constant"), "Foreign", UUIDСправочника, Корень.ИсходнаяВерсия)); КонецЕсли;
    Отказ = Ложь;
    Попытка Пакет = Новый ПакетСозданияСправочника(Результат, Снимки, "Repo", "8.5.1.1529"); Пакет.Проверить(); Исключение Отказ = Истина; КонецПопытки;
    Если Отказ <> (Режим <> "ok") Тогда ВызватьИсключение "Неверный результат проверки: " + Режим; КонецЕсли;
КонецЦикла;
Сообщить("Создание справочника с формами: состав, родитель, класс, владелец, версии, порядок и внешние потоки проверены.");
