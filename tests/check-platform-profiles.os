#Использовать ".."

Процедура Проверить(Условие, Сообщение)
	Если Не Условие Тогда ВызватьИсключение Сообщение; КонецЕсли;
КонецПроцедуры

Для Каждого Версия Из СтрРазделить("8.5.1.1529,8.5.1.1150,8.5.1.9999,8.5.0.1,8.3.27.2342,8.3.10.1,8.2.19.1", ",") Цикл
	Проверить(СовместимостьПлатформы.ИспользоватьПрофиль851(Версия), "Не выбран старый профиль: " + Версия);
	СовместимостьПлатформы.ПроверитьСериализацию(Версия);
	Параметры = Новый Структура("ИмяХранилища,ВерсияПлатформы,ПользовательХранилища,ХешПользователяХранилища,ИдентификаторПодключения,ИдентификаторОбъекта",
		"Repo", Версия, "test-user", "synthetic-hash", Новый УникальныйИдентификатор(), "11111111-1111-4111-8111-111111111111");
	Текст = МенеджерЗапросов.ТелоЗапросаСостоянияОбъекта(Параметры);
	Проверить(СтрНайти(Текст, "version=""" + Версия + """") > 0, "Изменен номер версии запроса");
	Проверить(СтрНайти(Текст, "<crs:objRefs/>") > 0, "Не запрошена полная статистика");
	Параметры.Вставить("ВыборкаВерсииЗахвата", Истина);
	Текст = МенеджерЗапросов.ТелоЗапросаСостоянияОбъекта(Параметры);
	Проверить(СтрНайти(Текст, Параметры.ИдентификаторОбъекта) > 0, "Не запрошена версия захвата");
КонецЦикла;
Проверить(Не СовместимостьПлатформы.ИспользоватьПрофиль851("8.5.4.1878"), "Выбран неверный профиль 8.5.4");
СовместимостьПлатформы.ПроверитьСериализацию("8.5.4.1878");
Для Каждого Версия Из СтрРазделить("8.5.2.1,8.5.4.2000,9.0.0.1,8.5.1,8.5.1.-1,garbage", ",") Цикл
	Отказ = Ложь;
	Попытка СовместимостьПлатформы.ПроверитьСериализацию(Версия); Исключение Отказ = Истина; КонецПопытки;
	Проверить(Отказ, "Неверная версия принята: " + Версия);
КонецЦикла;
Сообщить("Профили платформы и запросы старых версий: успешно.");
