#Использовать ".."
Функция Объект(UUID, Класс, Имя, Родитель, Версия)
 О = Новый ОбъектХранилища; О.Идентификатор = UUID; О.ИдентификаторКласса = ИдентификаторыМетаданных.ИдентификаторКласса(Класс);
 О.Имя = Имя; О.Позиция = 0; О.НомерВерсии = 18; О.НомерСобственнойВерсии = 18; О.ИдентификаторРодителя = Родитель;
 О.ИдентификаторВладельца = "00000000-0000-0000-0000-000000000000"; О.ИсходнаяВерсия = Версия; О.ЛокальнаяВерсия = Версия; О.Удален = Ложь;
 Возврат О;
КонецФункции
Процедура Проверить(Условие, Сообщение)
 Если Не Условие Тогда ВызватьИсключение Сообщение; КонецЕсли;
КонецПроцедуры
Родитель = Объект("11111111-1111-4111-8111-111111111111", "Catalog", "Catalog", "99999999-9999-4999-8999-999999999999", "1111111111111111111111111111111100000000");
Форма = Объект("22222222-2222-4222-8222-222222222222", "CatalogForm", "Form", Родитель.Идентификатор, "2222222222222222222222222222222200000000");
СР = Новый СнимокОбъектаХранилища; СР.Объект = Родитель; СР.ВерсияХранилища = "44444444-4444-4444-8444-444444444444";
СФ = Новый СнимокОбъектаХранилища; СФ.Объект = Форма; СФ.ВерсияХранилища = СР.ВерсияХранилища;
Описания = Новый Массив; Описания.Добавить(Новый Структура("id,class_id,name,pos,parent_id,owner_id,original,local",
 Родитель.Идентификатор, Родитель.ИдентификаторКласса, Родитель.Имя, 0, Родитель.ИдентификаторРодителя, Родитель.ИдентификаторВладельца,
 Родитель.ИсходнаяВерсия, "3333333333333333333333333333333300000000"));
Результат = Новый Структура("data,object_id,parent_id,descriptions,version_code", "AgFTS2/0iI3BTqDV67a9oKcNAA==", Форма.Идентификатор, Родитель.Идентификатор, Описания, "");
Пакет = Новый ПакетУдаленияФормы(Результат, СР, СФ, "Repo", "8.5.1.1529");
Параметры = Новый Структура("ИмяХранилища,ВерсияПлатформы,ПользовательХранилища,ХешПользователяХранилища,ИдентификаторПодключения,Пакет,Комментарий",
 "Repo", "8.5.1.1529", "test", "synthetic", Новый УникальныйИдентификатор(), Пакет, "Delete & verify");
XML = МенеджерЗапросов.ТелоЗапросаНаСозданиеОбъекта(Параметры);
Начало = СтрНайти(XML, "<crs:objectsToRemove>"); Конец = СтрНайти(XML, "</crs:objectsToRemove>"); Удаление = Сред(XML, Начало, Конец - Начало);
Проверить(СтрНайти(Удаление, Строка(Форма.Идентификатор)) > 0, "Удаляемая форма не передана");
Проверить(СтрНайти(Удаление, "verNum value=""18""") > 0, "Удаление должно использовать фактическую версию формы");
Проверить(СтрНайти(Удаление, "removed value=""false""") > 0, "Нужно исходное описание ещё существующей формы");
Проверить(СтрНайти(XML, "Delete &amp; verify") > 0, "Комментарий не экранирован");
Форма.ИдентификаторРодителя = "99999999-9999-4999-8999-999999999999"; Ошибка = Ложь;
Попытка Пакет.Проверить(); Исключение Ошибка = Истина; КонецПопытки;
Проверить(Ошибка, "Чужой родитель не отклонён");
Сообщить("Удаление формы: XML удаления, исходная версия и родитель — успешно.");
