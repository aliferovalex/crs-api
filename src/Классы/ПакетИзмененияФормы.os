// Замена единственного внешнего текста существующего формы.
Перем Данные Экспорт;
Перем ВерсияХранилища Экспорт;
Перем ЛокальнаяВерсия Экспорт;
Перем ИсходнаяВерсия Экспорт;
Перем ИдентификаторОбъекта Экспорт;
Перем ИдентификаторКласса Экспорт;
Перем ИмяХранилища Экспорт;
Перем ВерсияПлатформы Экспорт;
Перем Особенности Экспорт;
Перем ИмяВнешнегоТекста Экспорт;
Перем ВерсияВнешнегоТекста Экспорт;

Процедура ПриСозданииОбъекта(Результат, Снимок, Имя, Платформа)
	Данные = Base64Значение(Результат.data);
	ВерсияХранилища = Снимок.ВерсияХранилища;
	ЛокальнаяВерсия = Результат.local;
	ИсходнаяВерсия = Результат.original;
	ИдентификаторОбъекта = Результат.object_id;
	ИдентификаторКласса = Результат.class_id;
	ИмяВнешнегоТекста = Результат.external_name;
	ВерсияВнешнегоТекста = Результат.external_version;
	ИмяХранилища = Имя;
	ВерсияПлатформы = Платформа;
	Особенности = Новый Массив;
	Проверить(Снимок.Объект);
КонецПроцедуры

Процедура Проверить(Объект) Экспорт
	Объект.ПроверитьДляПомещения();
	Если Не СовместимостьПлатформы.ИспользоватьПрофиль851(ВерсияПлатформы)
		Или ТипЗнч(Данные) <> Тип("ДвоичныеДанные") Или Данные.Размер() < 19 Или Данные.Размер() > 32 * 1024 * 1024
		Или Лев(Base64Строка(Данные), 24) <> "AgFTS2/0iI3BTqDV67a9oKcN" Тогда
		ВызватьИсключение "Некорректный пакет изменения формы.";
	КонецЕсли;
	Проверка = Новый УникальныйИдентификатор(ВерсияХранилища);
	Если НРег(Строка(Объект.Идентификатор)) <> НРег(Строка(ИдентификаторОбъекта))
		Или НРег(Строка(Объект.ИдентификаторКласса)) <> ИдентификаторыМетаданных.ИдентификаторКласса("CatalogForm")
		Или НРег(Строка(ИдентификаторКласса)) <> ИдентификаторыМетаданных.ИдентификаторКласса("CatalogForm")
		Или НРег(Объект.ИсходнаяВерсия) <> НРег(ИсходнаяВерсия)
		Или ИмяВнешнегоТекста <> НРег(Строка(ИдентификаторОбъекта)) + ".0" Тогда
		ВызватьИсключение "Пакет не соответствует исходному общему модулю.";
	КонецЕсли;
	Шаблон = Новый РегулярноеВыражение("^[0-9a-fA-F]{40}$");
	Для Каждого Версия Из СтрРазделить(ИсходнаяВерсия + "," + ЛокальнаяВерсия + "," + ВерсияВнешнегоТекста, ",") Цикл
		Если Шаблон.НайтиСовпадения(Версия).Количество() <> 1 Тогда ВызватьИсключение "Некорректная версия текста модуля."; КонецЕсли;
	КонецЦикла;
	Если ЛокальнаяВерсия = ИсходнаяВерсия Или ТипЗнч(Особенности) <> Тип("Массив") Или Особенности.Количество() <> 0 Тогда
		ВызватьИсключение "Неподдерживаемый пакет изменения формы.";
	КонецЕсли;
КонецПроцедуры
