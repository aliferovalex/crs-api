#Использовать 1connector
#Использовать xml-parser

// Ссылка на сервер хранилищ 1С
Перем Адрес;
// Пользователь для авторизации
Перем Пользователь;
// Хеш пароля для авторизации, заполняется в методе "Подключиться"
Перем ХешПароля;
// Версия платформы 1С
Перем ВерсияПлатформы;
// Имя хранилища 1С. Например MyTrade
Перем ИмяХранилища;
Перем ИмяХранилищаАдреса;
Перем ИдентификаторПодключенияЗахвата;

// Событие при создании объекта
//
// Параметры:
//   АдресХранилища - Строка - HTTP(S)-публикация или tcp://сервер:порт[/имя]
//   ВерсияПлатформыХранилища - Строка - версия платформы 1С. Например: 8.3.15.1855
//
Процедура ПриСозданииОбъекта(Знач АдресХранилища, Знач ВерсияПлатформыХранилища)
	Адрес = АдресХранилища;
	ИмяХранилищаАдреса = "";
	Если НРег(Лев(Адрес, 6)) = "tcp://" Тогда
		ИмяХранилищаАдреса = ТранспортХранилища.ПараметрыTCP(Адрес).ИмяХранилища;
	КонецЕсли;
	ВерсияПлатформы = ВерсияПлатформыХранилища;
	ИдентификаторПодключенияЗахвата = Новый УникальныйИдентификатор();
КонецПроцедуры

// Подключение к хранилищу 1С, если оно существует
//
// Параметры:
//   ПользовательХранилища - Строка - пользователь хранилища
//   ПарольХранилища - Строка - пароль пользователя хранилища
//   пИмяХранилища - Строка - имя хранилища. Например: `MyTrade` или `Trade/MyRepo`.
//		По умолчанию имя из TCP-адреса либо `maincr`.
//
Процедура Подключиться(Знач ПользовательХранилища, Знач ПарольХранилища, Знач пИмяХранилища = Неопределено) Экспорт
	Если пИмяХранилища = Неопределено Тогда
		пИмяХранилища = ?(ПустаяСтрока(ИмяХранилищаАдреса), "maincr", ИмяХранилищаАдреса);
	ИначеЕсли Не ПустаяСтрока(ИмяХранилищаАдреса) И пИмяХранилища <> ИмяХранилищаАдреса Тогда
		ВызватьИсключение "Имя хранилища не совпадает с TCP-адресом.";
	КонецЕсли;
	Пользователь = Неопределено;
	ХешПароля = Неопределено;
	ИдентификаторПодключенияЗахвата = Новый УникальныйИдентификатор();
	
	Хеш = Вспомогательный.ХешированныйПароль(ПарольХранилища);
	
	Параметры = Новый Структура;
	Параметры.Вставить("ИмяХранилища", пИмяХранилища);
	Параметры.Вставить("ВерсияПлатформы", ВерсияПлатформы);
	Параметры.Вставить("ПользовательХранилища", ПользовательХранилища);
	Параметры.Вставить("ХешПароляПользователя", Хеш);
	
	ТелоЗапроса = МенеджерЗапросов.ТелоЗапросаНаПодключение(Параметры);
	
	Ответ = ТранспортХранилища.Отправить(Адрес, ТелоЗапроса);
	Если Ответ.КодСостояния = 200 Тогда
		ОтветСервиса = ОбработкаXML.ПрочитатьОтветИзТекста(Ответ.Текст());
		
		Если ОтветСервиса.ЕстьОшибка Тогда
			Сообщить(ОтветСервиса.СодержаниеОшибки);
			Возврат;
		КонецЕсли;
		
		Пользователь = ПользовательХранилища;
		ХешПароля = Хеш;
	Иначе
		ВызватьИсключение(Ответ.Текст());
	КонецЕсли;
	
	ИмяХранилища = пИмяХранилища;
	
КонецПроцедуры

// Возвращает значение, пройдена ли авторизация
//
//  Возвращаемое значение:
//   Булево - Истина или Ложь.
//
Функция АвторизацияПройдена() Экспорт
	Возврат ЗначениеЗаполнено(ХешПароля) И ЗначениеЗаполнено(ИмяХранилища);
КонецФункции

// Возвращает описания объектов, входящих в указанную версию (изменения этой версии).
// НомерВерсии - Число - номер версии; 0 соответствует последней версии на 8.5.4.
// Возвращаемое значение: Массив из ОбъектХранилища.
Функция СписокОбъектовВерсии(Знач НомерВерсии) Экспорт
	Если ТипЗнч(НомерВерсии) <> Тип("Число") Тогда
		ВызватьИсключение "Номер версии должен быть числом.";
	КонецЕсли;
	Если НомерВерсии < 0 Или НомерВерсии <> Цел(НомерВерсии) Тогда
		ВызватьИсключение "Номер версии должен быть целым неотрицательным числом.";
	КонецЕсли;
	Параметры = ПараметрыЗапросаОбъектов();
	Параметры.Вставить("НомерВерсии", НомерВерсии);
	Тело = МенеджерЗапросов.ТелоЗапросаОбъектовВерсии(Параметры);
	Ответ = ТранспортХранилища.Отправить(Адрес, Тело);
	ОбработатьБазовыйОтветСервиса(Ответ);
	Возврат ОбработкаXML.ПрочитатьОбъектыВерсии(Ответ.Текст());
КонецФункции

// Сравнение помещения для любого класса метаданных без получения всей конфигурации.
// До/После — описания, Свойства — изменения описания, Содержимое — нативный diff.
// ПолучатьСодержимое=Ложь оставляет только описания и не требует Python.
// ПутьIbcmd включает Представление: XML-свойства и BSL из выбранных снимков.
// Старые версии просматриваются до нахождения предыдущего состояния каждого UUID.
Функция ПолучитьИзмененияВерсии(Знач НомерВерсии, Знач ПолучатьСодержимое = Истина, Знач ПутьPython = "python", Знач ПутьIbcmd = Неопределено) Экспорт
 Если ТипЗнч(ПолучатьСодержимое) <> Тип("Булево") Тогда ВызватьИсключение "ПолучатьСодержимое должно быть булевым значением."; КонецЕсли;
 Если ТипЗнч(НомерВерсии) <> Тип("Число") Тогда ВызватьИсключение "Номер версии должен быть положительным целым числом."; КонецЕсли;
 Если НомерВерсии < 1 Или НомерВерсии <> Цел(НомерВерсии) Тогда ВызватьИсключение "Номер версии должен быть положительным целым числом."; КонецЕсли;
 Найдена = Ложь; История = СписокВерсий();
 Для Каждого Версия Из История Цикл Если Версия.Номер = НомерВерсии Тогда Найдена = Истина; КонецЕсли; КонецЦикла;
 Если Не Найдена Тогда ВызватьИсключение "Версия хранилища не найдена."; КонецЕсли;
 Объекты = СписокОбъектовВерсии(НомерВерсии); Ожидаются = Новый Соответствие; Предыдущие = Новый Соответствие;
 КэшОписаний = Новый Соответствие; КэшОписаний.Вставить(НомерВерсии, Объекты); КэшСнимков = Новый Соответствие; КэшПлановКонтекста = Новый Соответствие;
 Для Каждого Объект Из Объекты Цикл
  Ключ = НРег(Строка(Объект.Идентификатор));
  Если Ожидаются.Получить(Ключ) <> Неопределено Тогда ВызватьИсключение "Повторный UUID объекта в версии."; КонецЕсли;
  Ожидаются.Вставить(Ключ, Истина);
 КонецЦикла;
 // История сервера может быть выдана в любом порядке.
 Номера = Новый ТаблицаЗначений; Номера.Колонки.Добавить("Номер");
 Для Каждого Версия Из История Цикл
  Если Версия.Номер < НомерВерсии Тогда СтрокаВерсии = Номера.Добавить(); СтрокаВерсии.Номер = Версия.Номер; КонецЕсли;
 КонецЦикла;
 Номера.Сортировать("Номер Убыв");
 Для Каждого СтрокаВерсии Из Номера Цикл
  Если Ожидаются.Количество() = 0 Тогда Прервать; КонецЕсли;
  ОписанияВерсии = СписокОбъектовВерсии(СтрокаВерсии.Номер); КэшОписаний.Вставить(СтрокаВерсии.Номер, ОписанияВерсии);
  Для Каждого Объект Из ОписанияВерсии Цикл
   Ключ = НРег(Строка(Объект.Идентификатор));
   Если Ожидаются.Получить(Ключ) <> Неопределено Тогда Предыдущие.Вставить(Ключ, Объект); Ожидаются.Удалить(Ключ); КонецЕсли;
  КонецЦикла;
 КонецЦикла;
 Результат = Новый Массив;
 Для Каждого Объект Из Объекты Цикл
  Изменение = ИсторияИзменений.ИзменениеОбъекта(Объект, Предыдущие.Получить(НРег(Строка(Объект.Идентификатор))));
  Если ПолучатьСодержимое Тогда
   До = Неопределено; После = Неопределено;
   Если Изменение.До <> Неопределено И Не Изменение.До.Удален Тогда До = КэшированныйСнимокИстории(Изменение.До, КэшСнимков, ПутьPython); КонецЕсли;
   Если Не Объект.Удален Тогда После = КэшированныйСнимокИстории(Объект, КэшСнимков, ПутьPython); КонецЕсли;
   Изменение.Вставить("Содержимое", СериализаторОбъектаХранилища.СравнитьСнимкиОбъекта(Объект.Идентификатор, До, После, ПутьPython));
   Изменение.СодержимоеПолучено = Истина;
   Если ПутьIbcmd <> Неопределено Тогда
    ЗапросВида = Новый Структура("object_id,platform,executable", Строка(Объект.Идентификатор), ВерсияПлатформы, ПутьIbcmd);
    Если До <> Неопределено Тогда ЗапросВида.Вставить("before", КонтекстСнимкаИстории(Изменение.До, НомерВерсии - 1, История, КэшОписаний, КэшСнимков, ПутьPython, КэшПлановКонтекста)); КонецЕсли;
    Если После <> Неопределено Тогда ЗапросВида.Вставить("after", КонтекстСнимкаИстории(Объект, НомерВерсии, История, КэшОписаний, КэшСнимков, ПутьPython, КэшПлановКонтекста)); КонецЕсли;
    Изменение.Вставить("Представление", СериализаторОбъектаХранилища.ЧитаемоеСравнениеСнимков(ЗапросВида, ПутьPython));
   КонецЕсли;
  КонецЕсли;
  Результат.Добавить(Изменение);
 КонецЦикла;
 Возврат Результат;
КонецФункции

Функция КэшированныйСнимокИстории(Объект, Кэш, ПутьPython)
 Ключ = НРег(Строка(Объект.Идентификатор)) + "/" + Строка(Объект.НомерВерсии) + "/" + Строка(Объект.НомерСобственнойВерсии);
 Снимок = Кэш.Получить(Ключ);
 Если Снимок = Неопределено Тогда Снимок = ПолучитьИсторическийОбъект(Объект, ПутьPython); Кэш.Вставить(Ключ, Снимок); КонецЕсли;
 Возврат Снимок;
КонецФункции

Функция ОписаниеОбъектаНаМомент(Идентификатор, Граница, История, Кэш, Обязательное = Истина)
 Номера = Новый ТаблицаЗначений; Номера.Колонки.Добавить("Номер");
 Для Каждого Версия Из История Цикл Если Версия.Номер <= Граница Тогда СтрокаВерсии = Номера.Добавить(); СтрокаВерсии.Номер = Версия.Номер; КонецЕсли; КонецЦикла;
 Номера.Сортировать("Номер Убыв");
 Для Каждого СтрокаВерсии Из Номера Цикл
  Описания = Кэш.Получить(СтрокаВерсии.Номер);
  Если Описания = Неопределено Тогда Описания = СписокОбъектовВерсии(СтрокаВерсии.Номер); Кэш.Вставить(СтрокаВерсии.Номер, Описания); КонецЕсли;
  Для Каждого Описание Из Описания Цикл
   Если НРег(Строка(Описание.Идентификатор)) = НРег(Строка(Идентификатор)) Тогда
    Если Описание.Удален Тогда
     Если Не Обязательное Тогда Возврат Неопределено; КонецЕсли;
     ВызватьИсключение "Родитель исторического объекта удалён на выбранный момент.";
    КонецЕсли;
    Возврат Описание;
   КонецЕсли;
  КонецЦикла;
 КонецЦикла;
 Если Не Обязательное Тогда Возврат Неопределено; КонецЕсли;
 ВызватьИсключение "Не найдено историческое описание родителя объекта.";
КонецФункции

Процедура СохранитьОписаниеКонтекста(Описание, Состояние)
 Состояние.descriptions.Вставить(НРег(Строка(Описание.Идентификатор)), Новый Структура("class_id,parent_id,name", НРег(Строка(Описание.ИдентификаторКласса)), НРег(Строка(Описание.ИдентификаторРодителя)), Описание.Имя));
КонецПроцедуры

Процедура ДобавитьСнимокКонтекста(Описание, Граница, История, КэшОписаний, КэшСнимков, ПутьPython, Состояние)
 Текущий = Описание; Цепочка = Новый Соответствие;
 Пока Истина Цикл
  Ключ = НРег(Строка(Текущий.Идентификатор));
  Если Цепочка.Получить(Ключ) <> Неопределено Или Цепочка.Количество() >= 256 Тогда ВызватьИсключение "Циклическая или слишком глубокая цепочка родителей снимка."; КонецЕсли;
  Если Состояние.Добавлены.Получить(Ключ) <> Неопределено Тогда Прервать; КонецЕсли;
  Если Состояние.Добавлены.Количество() >= 4096 Тогда ВызватьИсключение "Слишком большой контекст исторического объекта."; КонецЕсли;
  Цепочка.Вставить(Ключ, Истина); Состояние.Добавлены.Вставить(Ключ, Истина);
  Состояние.Объекты.Добавить(Текущий); СохранитьОписаниеКонтекста(Текущий, Состояние);
  Состояние.snapshots.Добавить(Base64Строка(КэшированныйСнимокИстории(Текущий, КэшСнимков, ПутьPython).ПакетСнимков));
  Если Строка(Текущий.ИдентификаторРодителя) = "00000000-0000-0000-0000-000000000000" Тогда Прервать; КонецЕсли;
  Текущий = ОписаниеОбъектаНаМомент(Текущий.ИдентификаторРодителя, Граница, История, КэшОписаний);
 КонецЦикла;
КонецПроцедуры

Функция КонтекстСнимкаИстории(Объект, Граница, История, КэшОписаний, КэшСнимков, ПутьPython, КэшПланов)
 Состояние = Новый Структура("snapshots,descriptions,Добавлены,Объекты", Новый Массив, Новый Соответствие, Новый Соответствие, Новый Массив);
 Владельцы = Новый Соответствие; Владельцы.Вставить(НРег(Строка(Объект.Идентификатор)), Истина);
 ДобавитьСнимокКонтекста(Объект, Граница, История, КэшОписаний, КэшСнимков, ПутьPython, Состояние);
 Индекс = 0;
 Пока Индекс < Состояние.Объекты.Количество() Цикл
  Текущий = Состояние.Объекты[Индекс]; Индекс = Индекс + 1;
  Снимок = КэшированныйСнимокИстории(Текущий, КэшСнимков, ПутьPython);
  КлючПлана = НРег(Строка(Текущий.Идентификатор)) + "/" + Строка(Текущий.НомерВерсии) + "/" + Строка(Текущий.НомерСобственнойВерсии);
  План = КэшПланов.Получить(КлючПлана);
  Если План = Неопределено Тогда План = СериализаторОбъектаХранилища.КонтекстЧитаемогоСнимка(Снимок, ВерсияПлатформы, ПутьPython); КэшПланов.Вставить(КлючПлана, План); КонецЕсли;
  Для Каждого Коллекция Из План.collections Цикл
   Для Каждого ИдентификаторРебенка Из Коллекция.ids Цикл
    Ребенок = ОписаниеОбъектаНаМомент(ИдентификаторРебенка, Граница, История, КэшОписаний);
    Если НРег(Строка(Ребенок.ИдентификаторРодителя)) <> НРег(Строка(Текущий.Идентификатор)) Или НРег(Строка(Ребенок.ИдентификаторКласса)) <> Коллекция.class_id Тогда ВызватьИсключение "Дочерний объект не соответствует нативной коллекции."; КонецЕсли;
    СохранитьОписаниеКонтекста(Ребенок, Состояние);
    // Для корня достаточно исторических имён. Тела всей конфигурации не читаются.
    Если Владельцы.Получить(НРег(Строка(Текущий.Идентификатор))) <> Неопределено И Строка(Текущий.ИдентификаторРодителя) <> "00000000-0000-0000-0000-000000000000" Тогда
     Владельцы.Вставить(НРег(Строка(Ребенок.Идентификатор)), Истина);
     ДобавитьСнимокКонтекста(Ребенок, Граница, История, КэшОписаний, КэшСнимков, ПутьPython, Состояние);
    КонецЕсли;
   КонецЦикла;
  КонецЦикла;
  Для Каждого Ссылка Из План.references Цикл
   Если Состояние.Добавлены.Получить(Ссылка) <> Неопределено Тогда Продолжить; КонецЕсли;
   ОписаниеСсылки = ОписаниеОбъектаНаМомент(Ссылка, Граница, История, КэшОписаний, Ложь);
   Если ОписаниеСсылки <> Неопределено Тогда ДобавитьСнимокКонтекста(ОписаниеСсылки, Граница, История, КэшОписаний, КэшСнимков, ПутьPython, Состояние); КонецЕсли;
  КонецЦикла;
 КонецЦикла;
 Возврат Новый Структура("snapshots,descriptions", Состояние.snapshots, Состояние.descriptions);
КонецФункции

// Получает конкретное историческое описание, в том числе удалённого сегодня объекта.
// Объект берётся из СписокОбъектовВерсии; описание с Удален=Истина не имеет тела.
Функция ПолучитьИсторическийОбъект(Знач Объект, Знач ПутьPython = "python") Экспорт
 Возврат ПолучитьИсторическийСнимок(Объект, ПутьPython, Истина);
КонецФункции

// Частичный снимок используется только внутри клиента для свойств тела.
// Публичное получение объекта по-прежнему требует всех внешних потоков.
Функция ПолучитьИсторическийСнимок(Объект, ПутьPython, ПолучатьВнешниеПотоки)
 Если ТипЗнч(Объект) <> Тип("ОбъектХранилища") Тогда ВызватьИсключение "Для получения необходимо описание типа ОбъектХранилища."; КонецЕсли;
 Объект.ПроверитьДляПолучения();
 Параметры = ПараметрыЗапросаОбъектов();
 Ответ = ТранспортХранилища.Отправить(Адрес, МенеджерЗапросов.ТелоЗапросаПоследнейВерсии(Параметры));
 ОбработатьБазовыйОтветСервиса(Ответ); Версия = ОбработкаXML.ПрочитатьИдентификаторВерсии(Ответ.Текст());
 Параметры.Вставить("ВерсияХранилища", Версия); Параметры.Вставить("Объект", Объект);
 Ответ = ТранспортХранилища.Отправить(Адрес, МенеджерЗапросов.ТелоЗапросаНаПолучениеОбъекта(Параметры)); ОбработатьБазовыйОтветСервиса(Ответ);
 Снимок = ОбработкаXML.ПрочитатьОтветПолученияОбъекта(Ответ.Текст(), Объект, Версия);
 Потоки = СериализаторОбъектаХранилища.ПотокиСнимка(Снимок, ПутьPython);
 Если Не ПолучатьВнешниеПотоки Тогда Возврат Снимок; КонецЕсли;
 Если Потоки.Количество() > 0 Тогда
  Параметры.Вставить("ВнешниеПотоки", Потоки);
  Ответ = ТранспортХранилища.Отправить(Адрес, МенеджерЗапросов.ТелоЗапросаНаПолучениеОбъекта(Параметры)); ОбработатьБазовыйОтветСервиса(Ответ);
  Снимок = ОбработкаXML.ПрочитатьОтветПолученияОбъекта(Ответ.Текст(), Объект, Версия);
 КонецЕсли;
 // Полнота потоков проверяется общим читателем; даже частичный ответ — ошибка.
 СериализаторОбъектаХранилища.ПотокиСнимка(Снимок, ПутьPython, Истина);
 Возврат Снимок;
КонецФункции

// Актуальное описание существующего объекта по UUID, даже если он не менялся
// в последнем помещении. Отсутствие объекта и гонка версий — исключение.
Функция ПолучитьОписаниеОбъекта(Знач ИдентификаторОбъекта) Экспорт
	Если ТипЗнч(ИдентификаторОбъекта) <> Тип("Строка")
		И ТипЗнч(ИдентификаторОбъекта) <> Тип("УникальныйИдентификатор") Тогда
		ВызватьИсключение "UUID объекта должен быть строкой или УникальнымИдентификатором.";
	КонецЕсли;
	Идентификатор = НРег(Строка(Новый УникальныйИдентификатор(Строка(ИдентификаторОбъекта))));
	Если Идентификатор = "00000000-0000-0000-0000-000000000000" Тогда
		ВызватьИсключение "Не указан UUID объекта хранилища.";
	КонецЕсли;
	Параметры = ПараметрыЗапросаОбъектов();
	Параметры.Вставить("ИдентификаторОбъекта", Идентификатор);
	ТелоСостояния = МенеджерЗапросов.ТелоЗапросаСостоянияОбъекта(Параметры);
	Ответ = ТранспортХранилища.Отправить(Адрес, ТелоСостояния);
	ОбработатьБазовыйОтветСервиса(Ответ, Истина);
	НомерВерсии = ОбработкаXML.ПрочитатьНомерВерсииОбъекта(Ответ.Текст(), Идентификатор);
	Параметры.Вставить("НомерВерсии", НомерВерсии);
	Ответ = ТранспортХранилища.Отправить(Адрес, МенеджерЗапросов.ТелоЗапросаОбъектовВерсии(Параметры));
	ОбработатьБазовыйОтветСервиса(Ответ, Истина);
	Объект = ОбработкаXML.ПрочитатьОписаниеОбъекта(Ответ.Текст(), Идентификатор, НомерВерсии);
	Ответ = ТранспортХранилища.Отправить(Адрес, ТелоСостояния);
	ОбработатьБазовыйОтветСервиса(Ответ, Истина);
	Если ОбработкаXML.ПрочитатьНомерВерсииОбъекта(Ответ.Текст(), Идентификатор) <> НомерВерсии Тогда
		ВызватьИсключение "Версия объекта изменилась во время чтения описания. Получите описание заново.";
	КонецЕсли;
	Возврат Объект;
КонецФункции

// Состояние включает владельца и неизменённую строку reviseDate для сравнения захватов.
Функция ПолучитьСостоянияОбъектов() Экспорт
 Параметры = ПараметрыЗапросаОбъектов(); Параметры.Вставить("ПолнаяСтатистика", Истина);
 Ответ = ТранспортХранилища.Отправить(Адрес, МенеджерЗапросов.ТелоЗапросаСостоянияОбъекта(Параметры)); ОбработатьБазовыйОтветСервиса(Ответ, Истина);
 Возврат ОбработкаXML.СостоянияОбъектовИзОтвета(Ответ.Текст());
КонецФункции

// Один ответ versionObjects читается один раз для всех объектов этой версии.
// Возвращает соответствие нормализованный UUID -> ОбъектХранилища.
Функция ПолучитьОписанияОбъектов(Знач Идентификаторы) Экспорт
 Возврат СнимокОписанийОбъектов(Идентификаторы).Описания;
КонецФункции

Функция СнимокОписанийОбъектов(Знач Идентификаторы)
 Если ТипЗнч(Идентификаторы) <> Тип("Массив") Тогда ВызватьИсключение "Нужен массив UUID объектов."; КонецЕсли;
 Отбор = Новый Соответствие;
 Для Каждого Значение Из Идентификаторы Цикл
  Если ТипЗнч(Значение) <> Тип("Строка") И ТипЗнч(Значение) <> Тип("УникальныйИдентификатор") Тогда ВызватьИсключение "Нужен UUID объекта."; КонецЕсли;
  Ид = НРег(Строка(Новый УникальныйИдентификатор(Строка(Значение))));
  Если Ид = "00000000-0000-0000-0000-000000000000" Или Отбор.Получить(Ид) <> Неопределено Тогда ВызватьИсключение "Нулевой или повторный UUID объекта."; КонецЕсли;
  Отбор.Вставить(Ид, Истина);
 КонецЦикла;
 Описания = Новый Соответствие;
 Если Отбор.Количество() = 0 Тогда Возврат Новый Структура("Описания,Состояния", Описания, Новый Соответствие); КонецЕсли;
 ВерсияДо = ПолучитьВерсиюХранилища(); До = ПолучитьСостоянияОбъектов(); Группы = Новый Соответствие;
 Для Каждого Запись Из Отбор Цикл
  Состояние = До.Получить(Запись.Ключ);
  Если Состояние = Неопределено Тогда ВызватьИсключение "Объект не найден в хранилище: " + Запись.Ключ; КонецЕсли;
  Группа = Группы.Получить(Состояние.НомерВерсии);
  Если Группа = Неопределено Тогда Группа = Новый Соответствие; Группы.Вставить(Состояние.НомерВерсии, Группа); КонецЕсли;
  Группа.Вставить(Запись.Ключ, Истина);
 КонецЦикла;
 Параметры = ПараметрыЗапросаОбъектов();
 Для Каждого Группа Из Группы Цикл
  Параметры.Вставить("НомерВерсии", Группа.Ключ);
  Ответ = ТранспортХранилища.Отправить(Адрес, МенеджерЗапросов.ТелоЗапросаОбъектовВерсии(Параметры)); ОбработатьБазовыйОтветСервиса(Ответ);
  ОбработкаXML.ПроверитьОтветОписанияОбъекта(Ответ.Текст());
  Для Каждого Объект Из ОбработкаXML.ПрочитатьОбъектыВерсии(Ответ.Текст()) Цикл
   Ид = НРег(Строка(Объект.Идентификатор));
   Если Группа.Значение.Получить(Ид) = Неопределено Тогда Продолжить; КонецЕсли;
   Если Описания.Получить(Ид) <> Неопределено Тогда ВызватьИсключение "Повторное описание объекта в ответе сервера."; КонецЕсли;
   Объект.ПроверитьДляПолучения();
   Если Объект.НомерВерсии <> Группа.Ключ Тогда ВызватьИсключение "Номер версии описания не совпадает со статистикой."; КонецЕсли;
   Описания.Вставить(Ид, Объект);
  КонецЦикла;
 КонецЦикла;
 После = ПолучитьСостоянияОбъектов();
 Для Каждого Запись Из Отбор Цикл
  Текущее = После.Получить(Запись.Ключ);
  Если Описания.Получить(Запись.Ключ) = Неопределено Тогда ВызватьИсключение "Описание объекта не найдено в его последней версии хранилища: " + Запись.Ключ; КонецЕсли;
  Если Текущее = Неопределено Или Текущее.НомерВерсии <> До.Получить(Запись.Ключ).НомерВерсии Тогда ВызватьИсключение "Версия объекта изменилась во время пакетного чтения."; КонецЕсли;
 КонецЦикла;
 Если ПолучитьВерсиюХранилища() <> ВерсияДо Тогда ВызватьИсключение "Хранилище изменилось во время пакетного чтения."; КонецЕсли;
 Возврат Новый Структура("Описания,Состояния", Описания, После);
КонецФункции

Функция ПолучитьСостояниеОбъекта(Знач ИдентификаторОбъекта) Экспорт
 Параметры = ПараметрыЗапросаОбъектов(); Параметры.Вставить("ИдентификаторОбъекта", ИдентификаторОбъекта);
 Ответ = ТранспортХранилища.Отправить(Адрес, МенеджерЗапросов.ТелоЗапросаСостоянияОбъекта(Параметры)); ОбработатьБазовыйОтветСервиса(Ответ, Истина);
 Возврат ОбработкаXML.СостояниеОбъектаИзОтвета(Ответ.Текст(), Строка(ИдентификаторОбъекта));
КонецФункции

Функция ПолучитьВерсиюХранилища() Экспорт
 Параметры = ПараметрыЗапросаОбъектов();
 Ответ = ТранспортХранилища.Отправить(Адрес, МенеджерЗапросов.ТелоЗапросаПоследнейВерсии(Параметры)); ОбработатьБазовыйОтветСервиса(Ответ);
 Возврат ОбработкаXML.ПрочитатьИдентификаторВерсии(Ответ.Текст());
КонецФункции

// Новый двоичный файл проверенного полного контейнера; XML/base64 не читаются в строку.
// Путь должен отсутствовать. При смене версии результат удаляется, повторной загрузки нет.
Функция ПолучитьПакетТекущейВерсииВФайл(Знач Путь, Знач ПутьPython = "python") Экспорт
 Если ТипЗнч(Путь) <> Тип("Строка") Или Новый Файл(Путь).Существует() Тогда ВызватьИсключение "Нужен путь нового файла версии."; КонецЕсли;
 Параметры = ПараметрыЗапросаОбъектов(); ВерсияДо = ПолучитьВерсиюХранилища(); Скачан = Ложь;
 Попытка
  Результат = ТранспортХранилища.ОтправитьВФайл(Адрес, МенеджерЗапросов.ТелоЗапросаПакетаТекущейВерсии(Параметры), Путь, ПутьPython, Истина); Скачан = Истина;
  ПроверитьАктуальностьПакетаВерсии(Параметры, ВерсияДо);
 Исключение
  Если Скачан И Новый Файл(Путь).Существует() Тогда УдалитьФайлы(Путь); КонецЕсли;
  ВызватьИсключение;
 КонецПопытки;
 Результат.Вставить("repository_version", ВерсияДо); Возврат Результат;
КонецФункции

// Захватывает один существующий объект без дочерних объектов.
// Объект - ОбъектХранилища - актуальное описание из СписокОбъектовВерсии
//   или из рабочей конфигурации. Устаревшее описание требует обновления.
// ИдентификаторПодключения - Строка, УникальныйИдентификатор - необязательный
//   bindID; по умолчанию используется отдельный идентификатор этого клиента.
// Возвращает Истина только после проверки владельца захвата на сервере.
// При отказе, неполном результате или отсутствии авторизации вызывает исключение.
Функция ЗахватитьОбъект(Знач Объект, Знач ИдентификаторПодключения = Неопределено) Экспорт
	Параметры = ПараметрыЗапросаОбъектов(ИдентификаторПодключения);
	Если ТипЗнч(Объект) <> Тип("ОбъектХранилища") Тогда
		ВызватьИсключение "Для захвата необходимо описание типа ОбъектХранилища.";
	КонецЕсли;
	Объект.ПроверитьДляЗахвата();
	ТекущийПользователь = НайтиПользователя(Пользователь);
	Если ТекущийПользователь = Неопределено Тогда
		ВызватьИсключение "Не удалось определить пользователя для проверки захвата.";
	КонецЕсли;
	Параметры.Вставить("ИдентификаторОбъекта", Объект.Идентификатор);
	Тело = МенеджерЗапросов.ТелоЗапросаСостоянияОбъекта(Параметры);
	Ответ = ТранспортХранилища.Отправить(Адрес, Тело);
	ОбработатьБазовыйОтветСервиса(Ответ, Истина);
	Состояние = ОбработкаXML.СостояниеОбъектаИзОтвета(Ответ.Текст(), Строка(Объект.Идентификатор));
	Если Состояние = Неопределено Тогда
		ВызватьИсключение "Объект не найден в хранилище.";
	КонецЕсли;
	Если Состояние.НомерВерсии <> Объект.НомерВерсии Тогда
		ВызватьИсключение "Описание объекта устарело. Получите описание его последней версии.";
	КонецЕсли;
	Параметры.Вставить("Объект", Объект);
	Параметры.Вставить("Захватить", Истина);
	Тело = МенеджерЗапросов.ТелоЗапросаНаИзменениеЗахвата(Параметры);
	Ответ = ТранспортХранилища.Отправить(Адрес, Тело);
	ОбработатьБазовыйОтветСервиса(Ответ, Истина);
	ОбработкаXML.ПроверитьОтветЗахвата(Ответ.Текст(), Строка(Объект.Идентификатор));
	Тело = МенеджерЗапросов.ТелоЗапросаСостоянияОбъекта(Параметры);
	Ответ = ТранспортХранилища.Отправить(Адрес, Тело);
	ОбработатьБазовыйОтветСервиса(Ответ, Истина);
	Если Не ОбработкаXML.ОбъектЗахваченПользователем(Ответ.Текст(),
		Строка(Объект.Идентификатор), Строка(ТекущийПользователь.Идентификатор)) Тогда
		ВызватьИсключение "Сервер не подтвердил захват объекта текущим пользователем.";
	КонецЕсли;
	Возврат Истина;
КонецФункции

// Отменяет захват одного существующего объекта текущим пользователем.
// Объект - ОбъектХранилища - актуальное описание объекта.
// ИдентификаторПодключения - необязательный bindID, как в ЗахватитьОбъект.
// Возвращает Истина после проверки свободного состояния на сервере.
// Повторная отмена свободного объекта также возвращает Истина.
// Чужой захват и устаревшее описание вызывают исключение.
Функция ОтменитьЗахватОбъекта(Знач Объект, Знач ИдентификаторПодключения = Неопределено) Экспорт
	Параметры = ПараметрыЗапросаОбъектов(ИдентификаторПодключения);
	Если ТипЗнч(Объект) <> Тип("ОбъектХранилища") Тогда
		ВызватьИсключение "Для отмены захвата необходимо описание типа ОбъектХранилища.";
	КонецЕсли;
	Объект.ПроверитьДляОтменыЗахвата();
	Параметры.Вставить("ИдентификаторОбъекта", Объект.Идентификатор);
	Тело = МенеджерЗапросов.ТелоЗапросаСостоянияОбъекта(Параметры);
	Ответ = ТранспортХранилища.Отправить(Адрес, Тело);
	ОбработатьБазовыйОтветСервиса(Ответ, Истина);
	Состояние = ОбработкаXML.СостояниеОбъектаИзОтвета(Ответ.Текст(), Строка(Объект.Идентификатор));
	Если Состояние = Неопределено Тогда
		ВызватьИсключение "Объект не найден в хранилище.";
	КонецЕсли;
	Если Состояние.НомерВерсии <> Объект.НомерВерсии Тогда
		ВызватьИсключение "Описание объекта устарело. Получите описание его последней версии.";
	КонецЕсли;
	Если Не Состояние.Захвачен Тогда
		Возврат Истина;
	КонецЕсли;
	ТекущийПользователь = НайтиПользователя(Пользователь);
	Если ТекущийПользователь = Неопределено Тогда
		ВызватьИсключение "Не удалось определить пользователя для отмены захвата.";
	КонецЕсли;
	Если НРег(Строка(Состояние.Пользователь)) <> НРег(Строка(ТекущийПользователь.Идентификатор)) Тогда
		ВызватьИсключение "Нельзя отменить захват объекта другим пользователем.";
	КонецЕсли;
	Параметры.Вставить("Объект", Объект);
	Параметры.Вставить("Захватить", Ложь);
	Если СовместимостьПлатформы.ИспользоватьПрофиль851(ВерсияПлатформы) Тогда
		Параметры.Вставить("ВыборкаВерсииЗахвата", Истина);
		Ответ = ТранспортХранилища.Отправить(Адрес, МенеджерЗапросов.ТелоЗапросаСостоянияОбъекта(Параметры));
		ОбработатьБазовыйОтветСервиса(Ответ, Истина);
		Если Не ОбработкаXML.ОбъектЗахваченПользователем(Ответ.Текст(), Строка(Объект.Идентификатор), Строка(ТекущийПользователь.Идентификатор)) Тогда
			ВызватьИсключение "Собственный захват изменился перед отменой.";
		КонецЕсли;
		Параметры.Вставить("НомерВерсииЗахвата", ОбработкаXML.ПрочитатьНомерВерсииОбъекта(Ответ.Текст(), Строка(Объект.Идентификатор)));
		Параметры.Удалить("ВыборкаВерсииЗахвата");
	КонецЕсли;
	Тело = МенеджерЗапросов.ТелоЗапросаНаИзменениеЗахвата(Параметры);
	Ответ = ТранспортХранилища.Отправить(Адрес, Тело);
	ОбработатьБазовыйОтветСервиса(Ответ, Истина);
	ОбработкаXML.ПроверитьОтветЗахвата(Ответ.Текст(), Строка(Объект.Идентификатор));
	Ответ = ТранспортХранилища.Отправить(Адрес, МенеджерЗапросов.ТелоЗапросаСостоянияОбъекта(Параметры));
	ОбработатьБазовыйОтветСервиса(Ответ, Истина);
	Состояние = ОбработкаXML.СостояниеОбъектаИзОтвета(Ответ.Текст(), Строка(Объект.Идентификатор));
	Если Состояние = Неопределено Тогда
		ВызватьИсключение "Сервер не подтвердил состояние объекта после отмены захвата.";
	КонецЕсли;
	Если Состояние.Захвачен Тогда
		ВызватьИсключение "Сервер не подтвердил отмену захвата объекта.";
	КонецЕсли;
	Возврат Истина;
КонецФункции

// Получает снимок одного существующего объекта без изменения рабочей конфигурации.
// Объект - ОбъектХранилища - актуальное описание объекта.
// Возвращаемое значение: СнимокОбъектаХранилища (данные raw DEFLATE и полный пакет).
// Метод не захватывает объект. Исторические версии и формирование .cf не поддерживаются.
Функция ПолучитьОбъект(Знач Объект, Знач ИдентификаторПодключения = Неопределено, Знач ВнешниеПотоки = Неопределено) Экспорт
	Параметры = ПараметрыЗапросаОбъектов(ИдентификаторПодключения);
	Если ТипЗнч(Объект) <> Тип("ОбъектХранилища") Тогда
		ВызватьИсключение "Для получения необходимо описание типа ОбъектХранилища.";
	КонецЕсли;
	Объект.ПроверитьДляПолучения();
	Параметры.Вставить("ИдентификаторОбъекта", Объект.Идентификатор);
	Тело = МенеджерЗапросов.ТелоЗапросаСостоянияОбъекта(Параметры);
	Ответ = ТранспортХранилища.Отправить(Адрес, Тело);
	ОбработатьБазовыйОтветСервиса(Ответ);
	Состояние = ОбработкаXML.СостояниеОбъектаИзОтвета(Ответ.Текст(), Строка(Объект.Идентификатор));
	Если Состояние = Неопределено Тогда
		ВызватьИсключение "Объект не найден в хранилище.";
	КонецЕсли;
	Если Состояние.НомерВерсии <> Объект.НомерВерсии Тогда
		ВызватьИсключение "Описание объекта устарело. Получите описание его последней версии.";
	КонецЕсли;
	Ответ = ТранспортХранилища.Отправить(Адрес, МенеджерЗапросов.ТелоЗапросаПоследнейВерсии(Параметры));
	ОбработатьБазовыйОтветСервиса(Ответ);
	ВерсияХранилища = ОбработкаXML.ПрочитатьИдентификаторВерсии(Ответ.Текст());
	Параметры.Вставить("ВерсияХранилища", ВерсияХранилища);
	Параметры.Вставить("Объект", Объект);
	Если ВнешниеПотоки <> Неопределено Тогда Параметры.Вставить("ВнешниеПотоки", ВнешниеПотоки); КонецЕсли;
	Ответ = ТранспортХранилища.Отправить(Адрес, МенеджерЗапросов.ТелоЗапросаНаПолучениеОбъекта(Параметры));
	ОбработатьБазовыйОтветСервиса(Ответ);
	Возврат ОбработкаXML.ПрочитатьОтветПолученияОбъекта(Ответ.Текст(), Объект, ВерсияХранилища);
КонецФункции

// Читает только отличия от локального кэша. Исходный CF нужен при первом запуске.
Функция ОбновитьКэшКонфигурации(Знач КаталогКэша, Знач ИсходныйCF = Неопределено, Знач ПутьPython = "python") Экспорт
 Параметры = ПараметрыЗапросаОбъектов();
 Ответ = ТранспортХранилища.Отправить(Адрес, МенеджерЗапросов.ТелоЗапросаПоследнейВерсии(Параметры)); ОбработатьБазовыйОтветСервиса(Ответ);
 ВерсияДо = ОбработкаXML.ПрочитатьИдентификаторВерсии(Ответ.Текст());
 Ответ = ТранспортХранилища.Отправить(Адрес, МенеджерЗапросов.ТелоЗапросаИнформацииХранилища(Параметры)); ОбработатьБазовыйОтветСервиса(Ответ);
 Информация = Ответ.Текст();
 Ответ = ТранспортХранилища.Отправить(Адрес, МенеджерЗапросов.ТелоЗапросаКонтекстаСериализации(Параметры)); ОбработатьБазовыйОтветСервиса(Ответ);
 Контекст = ОбработкаXML.ПрочитатьКонтекстСериализации(Ответ.Текст());
 ПроверитьАктуальностьПакетаВерсии(Параметры, ВерсияДо);
 Запрос = Новый Структура("cache_directory,repository_info,platform,repository_version,context", КаталогКэша, Информация, ВерсияПлатформы, ВерсияДо, Base64Строка(Контекст));
 Если ИсходныйCF <> Неопределено Тогда
  Запрос.Вставить("mode", "initialize"); Запрос.Вставить("seed_cf", ИсходныйCF);
  Возврат СериализаторОбъектаХранилища.КэшКонфигурации(Запрос, ПутьPython);
 КонецЕсли;
 Указатель = Новый Файл(ОбъединитьПути(КаталогКэша, "current.json"));
 Если Не Указатель.Существует() Тогда
  ПутьВерсии = ПолучитьИмяВременногоФайла("bin"); Если Новый Файл(ПутьВерсии).Существует() Тогда УдалитьФайлы(ПутьВерсии); КонецЕсли;
  Попытка
   Загрузка = ПолучитьПакетТекущейВерсииВФайл(ПутьВерсии, ПутьPython);
   Если Загрузка.repository_version <> ВерсияДо Тогда ВызватьИсключение "Хранилище изменилось при первоначальной загрузке кэша."; КонецЕсли;
   ПроверитьАктуальностьПакетаВерсии(Параметры, ВерсияДо);
   Запрос.Вставить("mode", "bootstrap"); Запрос.Вставить("storage_file", ПутьВерсии);
   Запрос.Вставить("repository_version_after", ВерсияДо);
   Результат = СериализаторОбъектаХранилища.КэшКонфигурации(Запрос, ПутьPython);
  Исключение
   Если Новый Файл(ПутьВерсии).Существует() Тогда УдалитьФайлы(ПутьВерсии); КонецЕсли;
   ВызватьИсключение;
  КонецПопытки;
  Если Новый Файл(ПутьВерсии).Существует() Тогда УдалитьФайлы(ПутьВерсии); КонецЕсли;
  Возврат Результат;
 КонецЕсли;
 Запрос.Вставить("mode", "plan"); План = СериализаторОбъектаХранилища.КэшКонфигурации(Запрос, ПутьPython);
 Снимки = Новый Соответствие; ИдентификаторыПолучения = Новый Массив;
 Для Каждого Получение Из План.fetch Цикл ИдентификаторыПолучения.Добавить(Получение.object_id); КонецЦикла;
 ОписанияПолучения = ПолучитьОписанияОбъектов(ИдентификаторыПолучения);
 Для Каждого Получение Из План.fetch Цикл
  Объект = ОписанияПолучения.Получить(НРег(Получение.object_id));
  Снимок = ПолучитьОбъект(Объект, Неопределено, Получение.streams);
  Если Снимок.ВерсияХранилища <> ВерсияДо Тогда ВызватьИсключение "Хранилище изменилось при обновлении кэша."; КонецЕсли;
  Снимки.Вставить(Получение.object_id, Base64Строка(Снимок.ПакетСнимков));
 КонецЦикла;
 ПроверитьАктуальностьПакетаВерсии(Параметры, ВерсияДо);
 Запрос.Вставить("mode", "update"); Запрос.Вставить("snapshots", Снимки);
 Запрос.Вставить("generation", План.generation); Запрос.Вставить("context_sha256", План.context_sha256);
 Запрос.Вставить("repository_version_after", ВерсияДо);
 Возврат СериализаторОбъектаХранилища.КэшКонфигурации(Запрос, ПутьPython);
КонецФункции

// Каталог классов верхнего уровня из снимка корня, включая пустые коллекции.
// Корень - актуальное ОбъектХранилища. Возвращает classes, groups и scope.
// Вложенные классы и полный реестр типов платформы не перечисляются.
Функция ПолучитьКлассыМетаданных(Знач Корень, Знач ПутьPython = "python") Экспорт
	Если ТипЗнч(Корень) <> Тип("ОбъектХранилища") Тогда
		ВызватьИсключение "Необходимо описание корня конфигурации.";
	КонецЕсли;
	Если Корень.ИдентификаторКласса <> ИдентификаторыМетаданных.КлассКонфигурации() Тогда
		ВызватьИсключение "Каталог классов читается из корня конфигурации.";
	КонецЕсли;
	Снимок = ПолучитьОбъект(Корень);
	Возврат СериализаторОбъектаХранилища.КлассыМетаданных(Снимок, ВерсияПлатформы, ПутьPython);
КонецФункции

// Помещает подготовленный нативным клиентом пакет одного существующего объекта.
// Пакет - ПакетПомещенияОбъекта; не является бинарным снимком из ПолучитьОбъект.
// Возвращает актуальное ОбъектХранилища после проверки новой версии на сервере.
// Ошибки после отправки могут означать неопределенный результат: не повторяйте
// помещение автоматически, сначала проверьте историю и состояние объекта.
// Единый вход помещения: операция определяется неизменяемыми правилами пакета.
// Единственный исполнитель помещения: проверки, один RPC и подтверждение результата.
// Группа возвращает массив описаний, одиночный пакет — целевой объект/родителя удаления.
Функция ПоместитьПакет(Знач Пакет, Знач Комментарий = "", Знач ИдентификаторПодключения = Неопределено, Знач ПутьPython = "python") Экспорт
 Если Не ПравилаПакетовХранилища.ЭтоПакет(Пакет) Тогда ВызватьИсключение "Нужен пакет помещения хранилища."; КонецЕсли;
 Параметры = ПараметрыЗапросаОбъектов(ИдентификаторПодключения);
 Если ТипЗнч(Комментарий) <> Тип("Строка") Тогда ВызватьИсключение "Нужен строковый комментарий помещения."; КонецЕсли;
 Если Пакет.Корень = Неопределено И Пакет.ВидОперации() = "Изменение" Тогда
  Пакет.Проверить(ПолучитьОписаниеОбъекта(Пакет.ИдентификаторОбъекта));
 Иначе Пакет.Проверить();
 КонецЕсли;
 Если Пакет.ИмяХранилища <> ИмяХранилища Или Пакет.ВерсияПлатформы <> ВерсияПлатформы Тогда ВызватьИсключение "Пакет подготовлен для другого хранилища или платформы."; КонецЕсли;
 ТекущийПользователь = НайтиПользователя(Пользователь);
 Если ТекущийПользователь = Неопределено Тогда ВызватьИсключение "Не определён пользователь помещения."; КонецЕсли;
 Идентификаторы = Новый Массив;
 Для Каждого Объект Из Пакет.СуществующиеОбъекты Цикл Идентификаторы.Добавить(Объект.Идентификатор); КонецЦикла;
 Если Идентификаторы.Количество() = 0 Тогда ВызватьИсключение "У пакета нет исходных объектов."; КонецЕсли;
 До = СнимокОписанийОбъектов(Идентификаторы);
 Исходные = ПроверитьИсходныеОбъектыПомещения(Пакет, До, ТекущийПользователь.Идентификатор);
 Если ПутьPython = "python" И ЗначениеЗаполнено(ПолучитьПеременнуюСреды("CRS_IO_PYTHON")) Тогда ПутьPython = ПолучитьПеременнуюСреды("CRS_IO_PYTHON"); КонецЕсли;
 Параметры.Вставить("КодВерсии", КодВерсииДляПомещения(Пакет, ПутьPython));
 ПроверитьАктуальностьПакетаВерсии(Параметры, Пакет.ВерсияХранилища);
 Параметры.Вставить("Пакет", Пакет); Параметры.Вставить("Комментарий", Комментарий);
 // Потерянный ответ и ошибки подтверждения передаются вызывающему коду.
 // Повторной отправки здесь нет; составная подготовка сохранит ИсходНеизвестен.
 Ответ = ТранспортХранилища.Отправить(Адрес, МенеджерЗапросов.ТелоЗапросаНаПомещениеПакета(Параметры));
 ОбработатьБазовыйОтветСервиса(Ответ); ОбработкаXML.ПроверитьОтветПомещения(Ответ.Текст());
 Идентификаторы = Новый Массив;
 Для Каждого Объект Из Пакет.ОбъектыПакета Цикл Идентификаторы.Добавить(Объект.Идентификатор); КонецЦикла;
 После = СнимокОписанийОбъектов(Идентификаторы);
 Результат = ПодтвердитьОбъектыПомещения(Пакет, После, Исходные);
 Если Пакет.КонтекстОбновленияОсновы <> Неопределено Тогда
  Пакет.СостояниеОсновы = Новый Структура("updated,committed", Ложь, Истина);
  ОбновитьОсновуПослеПомещения(Пакет);
 КонецЕсли;
 Если Пакет.Групповой() Тогда Возврат Результат; КонецЕсли;
 ИдентификаторРезультата = ?(Пакет.ВидОперации() = "Удаление", Пакет.Корень.Идентификатор, Пакет.ИдентификаторОбъекта);
 Для Каждого Объект Из Результат Цикл
  Если НРег(Строка(Объект.Идентификатор)) = НРег(Строка(ИдентификаторРезультата)) Тогда Возврат Объект; КонецЕсли;
 КонецЦикла;
 ВызватьИсключение "Целевой объект не найден в подтверждённом результате помещения.";
КонецФункции

Функция КодВерсииДляПомещения(Пакет, ПутьPython) Экспорт
 Если ТипЗнч(Пакет.КодВерсииОпределен) <> Тип("Булево") Тогда ВызватьИсключение "Не определён источник версии конфигурации пакета."; КонецЕсли;
 Если Пакет.КодВерсииОпределен Тогда
  Если ТипЗнч(Пакет.КодВерсии) <> Тип("Строка") Тогда ВызватьИсключение "Нужна строковая версия конфигурации."; КонецЕсли;
  Возврат Пакет.КодВерсии;
 КонецЕсли;
 КлассКорня = ИдентификаторыМетаданных.ИдентификаторКласса("Configuration");
 Для Каждого Объект Из Пакет.ОбъектыПакета Цикл
  Если НРег(Строка(Объект.ИдентификаторКласса)) <> КлассКорня Тогда Продолжить; КонецЕсли;
  Запрос = Новый Структура("mode,object_id,platform,data", "packet", Строка(Объект.Идентификатор), ВерсияПлатформы, Base64Строка(Пакет.Данные));
  Возврат СериализаторОбъектаХранилища.ВерсияКонфигурацииПомещения(Запрос, ПутьPython);
 КонецЦикла;
 Корень = Пакет.СуществующиеОбъекты[0]; Посещенные = Новый Соответствие;
 Пока НРег(Строка(Корень.ИдентификаторРодителя)) <> "00000000-0000-0000-0000-000000000000" Цикл
  Ид = НРег(Строка(Корень.Идентификатор));
  Если Посещенные.Получить(Ид) <> Неопределено Тогда ВызватьИсключение "Цикл родителей объекта помещения."; КонецЕсли;
  Посещенные.Вставить(Ид, Истина); Корень = ПолучитьОписаниеОбъекта(Корень.ИдентификаторРодителя);
 КонецЦикла;
 Если НРег(Строка(Корень.ИдентификаторКласса)) <> КлассКорня Тогда ВызватьИсключение "Не найден корень конфигурации помещения."; КонецЕсли;
 // Version находится в теле корня. Его внешние потоки могут
 // занимать гигабайты и не участвуют в определении кода версии помещения.
 Снимок = ПолучитьИсторическийСнимок(Корень, ПутьPython, Ложь);
 Если НРег(Снимок.ВерсияХранилища) <> НРег(Пакет.ВерсияХранилища) Тогда ВызватьИсключение "Хранилище изменилось при чтении версии конфигурации."; КонецЕсли;
 Запрос = Новый Структура("mode,object_id,platform,data,original,local", "snapshot", Строка(Корень.Идентификатор), ВерсияПлатформы, Base64Строка(Снимок.ПакетСнимков), Корень.ИсходнаяВерсия, Корень.ЛокальнаяВерсия);
 Возврат СериализаторОбъектаХранилища.ВерсияКонфигурацииПомещения(Запрос, ПутьPython);
КонецФункции

Функция ПолучитьИдентификаторХранилища(ПутьPython = "python") Экспорт
 Параметры = ПараметрыЗапросаОбъектов();
 Ответ = ТранспортХранилища.Отправить(Адрес, МенеджерЗапросов.ТелоЗапросаИнформацииХранилища(Параметры));
 ОбработатьБазовыйОтветСервиса(Ответ, Истина);
 Возврат СериализаторОбъектаХранилища.АртефактыПомещения(Новый Структура("mode,repository_info", "identity", Ответ.Текст()), ПутьPython).repository_id;
КонецФункции

Функция ПроверитьИсходныеОбъектыПомещения(Пакет, Снимок, ПользовательПомещения)
 Исходные = Новый Соответствие;
 Для Каждого Объект Из Пакет.СуществующиеОбъекты Цикл
  Идентификатор = НРег(Строка(Объект.Идентификатор)); Описание = Снимок.Описания.Получить(Идентификатор);
  Если Описание = Неопределено Или Описание.НомерВерсии <> Объект.НомерВерсии Или НРег(Описание.ИсходнаяВерсия) <> НРег(Объект.ИсходнаяВерсия) Тогда ВызватьИсключение "Один из исходных объектов пакета устарел."; КонецЕсли;
  Состояние = Снимок.Состояния.Получить(Идентификатор);
  Если Состояние = Неопределено Или Не Состояние.Захвачен Тогда ВызватьИсключение "Все исходные объекты пакета должны быть захвачены."; КонецЕсли;
  Если НРег(Строка(Состояние.Пользователь)) <> НРег(Строка(ПользовательПомещения)) Тогда ВызватьИсключение "Исходный объект захвачен другим пользователем."; КонецЕсли;
  Исходные.Вставить(Идентификатор, Объект);
 КонецЦикла;
 Для Каждого Объект Из Пакет.ОбъектыПакета Цикл
  Идентификатор = НРег(Строка(Объект.Идентификатор));
  Если Исходные.Получить(Идентификатор) = Неопределено И Снимок.Состояния.Получить(Идентификатор) <> Неопределено Тогда ВызватьИсключение "UUID нового объекта пакета уже существует."; КонецЕсли;
 КонецЦикла;
 Возврат Исходные;
КонецФункции

Функция ПодтвердитьОбъектыПомещения(Пакет, Снимок, Исходные)
 Результат = Новый Массив; НомерВерсии = Неопределено;
 Для Каждого Ожидаемый Из Пакет.ОбъектыПакета Цикл
  Идентификатор = НРег(Строка(Ожидаемый.Идентификатор)); После = Снимок.Описания.Получить(Идентификатор); Исходный = Исходные.Получить(Идентификатор);
  Если После = Неопределено Тогда ВызватьИсключение "Сервер не подтвердил описание помещённого объекта."; КонецЕсли;
  Если (Исходный <> Неопределено И После.НомерВерсии <= Исходный.НомерВерсии)
   Или НРег(Лев(После.ЛокальнаяВерсия, 32)) <> НРег(Лев(Ожидаемый.ЛокальнаяВерсия, 32))
   Или После.Имя <> Ожидаемый.Имя Или После.Позиция <> Ожидаемый.Позиция
   Или НРег(Строка(После.ИдентификаторКласса)) <> НРег(Строка(Ожидаемый.ИдентификаторКласса))
   Или НРег(Строка(После.ИдентификаторРодителя)) <> НРег(Строка(Ожидаемый.ИдентификаторРодителя))
   Или НРег(Строка(После.ИдентификаторВладельца)) <> НРег(Строка(Ожидаемый.ИдентификаторВладельца)) Тогда
   ВызватьИсключение "Не подтверждена новая версия или описание помещённого объекта.";
  КонецЕсли;
  Если НомерВерсии <> Неопределено И После.НомерВерсии <> НомерВерсии Тогда ВызватьИсключение "Объекты пакета попали в разные версии."; КонецЕсли;
  НомерВерсии = После.НомерВерсии; Результат.Добавить(После);
 КонецЦикла;
 Для Каждого Удаляемый Из Пакет.УдаляемыеОбъекты Цикл
  Если Снимок.Состояния.Получить(НРег(Строка(Удаляемый.Идентификатор))) <> Неопределено Тогда ВызватьИсключение "Удаление объекта пакета не подтверждено."; КонецЕсли;
 КонецЦикла;
 Возврат Результат;
КонецФункции

Функция ПланИзмененийКонфигурацииИзВыгрузки(Знач Папка, Знач ИсходнаяПапка, Знач ПутьPython = "python") Экспорт
 Параметры = ПараметрыЗапросаОбъектов();
 Ответ = ТранспортХранилища.Отправить(Адрес, МенеджерЗапросов.ТелоЗапросаПоследнейВерсии(Параметры)); ОбработатьБазовыйОтветСервиса(Ответ);
 ВерсияДо = ОбработкаXML.ПрочитатьИдентификаторВерсии(Ответ.Текст());
 Ответ = ТранспортХранилища.Отправить(Адрес, МенеджерЗапросов.ТелоЗапросаКонтекстаСериализации(Параметры)); ОбработатьБазовыйОтветСервиса(Ответ);
 Контекст = ОбработкаXML.ПрочитатьКонтекстСериализации(Ответ.Текст());
 План = СериализаторОбъектаХранилища.ПланВыгрузкиКонфигурации(Папка, ИсходнаяПапка, Контекст, ПутьPython);
 ПроверитьАктуальностьПакетаВерсии(Параметры, ВерсияДо); План.Вставить("repository_version", ВерсияДо); Возврат План;
КонецФункции

Функция ПодготовитьКэшПоНастройкам(НастройкиПреобразователя, ПутьPython)
 КаталогКэша = Неопределено;
 Если Не НастройкиПреобразователя.Свойство("cache_directory", КаталогКэша) Тогда ВызватьИсключение "Нужен cache_directory."; КонецЕсли;
 Если НастройкиПреобразователя.backend <> "ibcmd" Тогда ВызватьИсключение "Нужен преобразователь ibcmd."; КонецЕсли;
 Для Каждого Поле Из НастройкиПреобразователя Цикл
  Если СтрНайти(",backend,executable,cache_directory,seed_cf,xml_repository,source_branch,use_git,", "," + Поле.Ключ + ",") = 0 Тогда ВызватьИсключение "Неизвестная настройка кэша: " + Поле.Ключ; КонецЕсли;
 КонецЦикла;
 ИспользоватьGit = Ложь;
 Если НастройкиПреобразователя.Свойство("use_git", ИспользоватьGit) И ТипЗнч(ИспользоватьGit) <> Тип("Булево") Тогда ВызватьИсключение "use_git должен быть булевым."; КонецЕсли;
 ИсходныйCF = Неопределено;
 Указатель = Новый Файл(ОбъединитьПути(КаталогКэша, "current.json"));
 Если Не Указатель.Существует() Тогда НастройкиПреобразователя.Свойство("seed_cf", ИсходныйCF); КонецЕсли;
 Возврат ОбновитьКэшКонфигурации(КаталогКэша, ИсходныйCF, ПутьPython);
КонецФункции

Функция ИнициализироватьОснову(Знач НастройкиПреобразователя, Знач ПапкаXML = Неопределено, Знач ПутьPython = "python", Знач РазрешитьЧастичную = Ложь) Экспорт
 Кэш = ПодготовитьКэшПоНастройкам(НастройкиПреобразователя, ПутьPython);
 Запрос = Новый Структура("mode,cache_directory,generation,executable", "initialize", НастройкиПреобразователя.cache_directory, Кэш.generation, НастройкиПреобразователя.executable);
 Если ПапкаXML <> Неопределено Тогда Запрос.Вставить("working_directory", ПапкаXML); КонецЕсли;
 Запрос.Вставить("allow_partial", РазрешитьЧастичную);
 Результат = СериализаторОбъектаХранилища.ОсноваКонфигурации(Запрос, ПутьPython);
 ИспользоватьGit = Ложь; Если Не НастройкиПреобразователя.Свойство("use_git", ИспользоватьGit) Тогда ИспользоватьGit = Ложь; КонецЕсли;
 Настройки = Новый Структура("backend,executable,cache_directory,use_git", "ibcmd", НастройкиПреобразователя.executable, НастройкиПреобразователя.cache_directory, ИспользоватьGit);
 ПеренестиНастройкиGit(НастройкиПреобразователя, Настройки);
 Результат.Вставить("compiler_settings", Настройки);
 Возврат Результат;
КонецФункции

Функция ПрочитатьОсновуИзНастроек(Настройки, Кэш, ПутьPython, ПапкаXML = Неопределено)
 Запрос = Новый Структура("mode,cache_directory", "read", Настройки.cache_directory);
 Если ПапкаXML <> Неопределено Тогда Запрос.Вставить("working_directory", ПапкаXML); КонецЕсли;
 Основа = СериализаторОбъектаХранилища.ОсноваКонфигурации(Запрос, ПутьPython);
 Если Основа.repository_id <> Кэш.repository_id Или Основа.platform <> ВерсияПлатформы Или Основа.root_id <> Кэш.root_id Тогда ВызватьИсключение "Основа относится к другому хранилищу или платформе."; КонецЕсли;
 Возврат Основа;
КонецФункции

Функция СогласоватьВыгрузкуСХранилищем(Знач Папка, Знач ИсходнаяПапка, Знач НастройкиПреобразователя, Знач ПутьPython = "python") Экспорт
 Кэш = ПодготовитьКэшПоНастройкам(НастройкиПреобразователя, ПутьPython);
 КаталогКэша = НастройкиПреобразователя.cache_directory;
 Если ИсходнаяПапка = Неопределено Тогда
  Основа = ПрочитатьОсновуИзНастроек(НастройкиПреобразователя, Кэш, ПутьPython, Папка); ИсходнаяПапка = Основа.baseline_directory;
 КонецЕсли;
 Запрос = Новый Структура("cache_directory,generation,directory,baseline_directory,executable", КаталогКэша, Кэш.generation, Папка, ИсходнаяПапка, НастройкиПреобразователя.executable);
 ПеренестиНастройкиGit(НастройкиПреобразователя, Запрос);
 Результат = СериализаторОбъектаХранилища.СогласоватьXMLЧерезGit(Запрос, ПутьPython);
 Результат.Вставить("cache", Кэш);
 Результат.Вставить("compiler", Новый Структура("backend,executable,base_cf", НастройкиПреобразователя.backend, НастройкиПреобразователя.executable, Кэш.base_cf));
 Возврат Результат;
КонецФункции

// Подготавливает один существующий codec=Module через ibcmd overlay.
// Захват и помещение не выполняются. Нет изменений — Неопределено.
// ОтчетПодготовки содержит diff, исходные версии и хеши, включая случай no-op.
Функция ПодготовитьМодульОбъекта(Знач Объект, Знач ПутьМодуля, Знач ТекстМодуля, Знач НастройкиКомпилятора, Знач ПутьPython = "python", ОтчетПодготовки = Неопределено, Знач ОжидаемыйХешМодуля = Неопределено) Экспорт
 Если ТипЗнч(Объект) <> Тип("ОбъектХранилища") Тогда ВызватьИсключение "Нужно описание существующего объекта."; КонецЕсли;
 Объект.ПроверитьДляПомещения();
 ПроверитьОписаниеПодготовкиМодуля(Объект, ПолучитьОписаниеОбъекта(Объект.Идентификатор));
 ВерсияДо = ПолучитьВерсиюХранилища();
 Снимок = ПолучитьИсторическийОбъект(Объект, ПутьPython);
 Если НРег(Снимок.ВерсияХранилища) <> НРег(ВерсияДо) Тогда ВызватьИсключение "Хранилище изменилось при чтении модуля."; КонецЕсли;
 Результат = СериализаторОбъектаХранилища.ПодготовитьМодуль(Снимок, ПутьМодуля, ТекстМодуля, ИмяХранилища, ВерсияПлатформы, НастройкиКомпилятора, ПутьPython, ОжидаемыйХешМодуля);
 ПроверитьОписаниеПодготовкиМодуля(Объект, ПолучитьОписаниеОбъекта(Объект.Идентификатор));
 ПроверитьАктуальностьПакетаВерсии(ПараметрыЗапросаОбъектов(), ВерсияДо);
 ОтчетПодготовки = Результат.review;
 Если Не Результат.has_changes Тогда Возврат Неопределено; КонецЕсли;
 Снимки = Новый Массив; Снимки.Добавить(Снимок);
 Пакет = Новый ПакетПомещенияОбъекта; Пакет.ЗаполнитьКонфигурацию(Результат, Снимки);
 Возврат Пакет;
КонецФункции

Процедура ПроверитьОписаниеПодготовкиМодуля(Ожидаемый, Текущий)
 Для Каждого Поле Из СтрРазделить("Идентификатор,ИдентификаторКласса,ИдентификаторРодителя,ИдентификаторВладельца,Имя,Позиция,ИсходнаяВерсия,ЛокальнаяВерсия,НомерВерсии,НомерСобственнойВерсии,Удален", ",") Цикл
  Если Строка(Ожидаемый[Поле]) <> Строка(Текущий[Поле]) Тогда ВызватьИсключение "Исходное описание модуля устарело: " + Поле; КонецЕсли;
 КонецЦикла;
КонецПроцедуры

Функция ПодготовитьКонфигурациюИзВыгрузки(Знач Папка, Знач ИсходнаяПапка = Неопределено, Знач ПутьPython = "python", Знач НастройкиПреобразователя = Неопределено) Экспорт
 Возврат ПодготовитьВыгрузку(Папка, ИсходнаяПапка, ПутьPython, НастройкиПреобразователя);
КонецФункции

// Получение и согласование XML, захват, компиляция и проверка актуальности.
// Результат владеет только захватами, полученными этой операцией.
Функция ПодготовитьПомещениеКонфигурации(Знач Папка, Знач ИсходнаяПапка = Неопределено, Знач ПутьPython = "python", Знач НастройкиПреобразователя = Неопределено) Экспорт
 Если НастройкиПреобразователя = Неопределено Или Не НастройкиПреобразователя.Свойство("cache_directory") Тогда ВызватьИсключение "Для составной подготовки нужен cache_directory."; КонецЕсли;
 ТекущийПользователь = НайтиПользователя(Пользователь);
 Если ТекущийПользователь = Неопределено Тогда ВызватьИсключение "Не определён пользователь подготовки."; КонецЕсли;
 Подготовка = Новый ПодготовкаПомещенияКонфигурации(ЭтотОбъект, ТекущийПользователь.Идентификатор, ИдентификаторПодключенияЗахвата, Новый Структура("cache_directory,python", НастройкиПреобразователя.cache_directory, ПутьPython));
 Попытка
  Пакет = ПодготовитьВыгрузку(Папка, ИсходнаяПапка, ПутьPython, НастройкиПреобразователя, Подготовка);
  Подготовка.УстановитьПакет(Пакет);
 Исключение
  Ошибка = ОписаниеОшибки();
  Попытка
   Отмена = Подготовка.Отменить();
  Исключение
   ВызватьИсключение Ошибка + Символы.ПС + "Не завершено снятие захватов; журнал: " + Строка(Подготовка.КаталогПодготовки) + Символы.ПС + ОписаниеОшибки();
  КонецПопытки;
  Если Отмена.Ошибки.Количество() > 0 Тогда Ошибка = Ошибка + Символы.ПС + "Не сняты захваты подготовки: " + СтрСоединить(Отмена.НеОсвобождены, ", "); КонецЕсли;
  ВызватьИсключение Ошибка + Символы.ПС + "Журнал подготовки: " + Строка(Подготовка.КаталогПодготовки);
 КонецПопытки;
 Возврат Подготовка;
КонецФункции

// Восстановление служит только подтверждению или отмене, без повторной отправки.
Функция ВосстановитьПодготовкуПомещения(Знач КаталогПодготовки, Знач ПутьPython = "python") Экспорт
 ТекущийПользователь = НайтиПользователя(Пользователь);
 Если ТекущийПользователь = Неопределено Тогда ВызватьИсключение "Не определён пользователь восстановления."; КонецЕсли;
 Параметры = ПараметрыЗапросаОбъектов();
 Ответ = ТранспортХранилища.Отправить(Адрес, МенеджерЗапросов.ТелоЗапросаИнформацииХранилища(Параметры)); ОбработатьБазовыйОтветСервиса(Ответ);
 Запрос = Новый Структура("mode,directory,user_id,repository_info,platform", "claim", КаталогПодготовки, Строка(ТекущийПользователь.Идентификатор), Ответ.Текст(), ВерсияПлатформы);
 Данные = СериализаторОбъектаХранилища.ЖурналПодготовки(Запрос, ПутьPython);
 Подготовка = Новый ПодготовкаПомещенияКонфигурации(ЭтотОбъект, ТекущийПользователь.Идентификатор);
 Подготовка.ВосстановитьИзЖурнала(Данные, ПутьPython); Возврат Подготовка;
КонецФункции

Функция ПодтвердитьСохраненноеПомещение(Знач Контекст, Знач Данные, Знач ПутьPython) Экспорт
 Кэш = ОбновитьКэшКонфигурации(Контекст.cache_directory, Неопределено, ПутьPython);
 Запрос = Новый Структура("mode,cache_directory,generation,receipt_id,receipt_sha256,packet,executable", "advance", Контекст.cache_directory, Кэш.generation, Контекст.receipt_id, Контекст.receipt_sha256, Base64Строка(Данные), Контекст.executable);
 Попытка Возврат СериализаторОбъектаХранилища.ОсноваКонфигурации(Запрос, ПутьPython);
 Исключение Возврат Новый Структура("updated,error", Ложь, ОписаниеОшибки()); КонецПопытки;
КонецФункции

Функция ПодготовитьВыгрузку(Папка, ИсходнаяПапка, ПутьPython, НастройкиПреобразователя, Подготовка = Неопределено)
 ПутьВерсии = ПолучитьИмяВременногоФайла("bin"); Если Новый Файл(ПутьВерсии).Существует() Тогда УдалитьФайлы(ПутьВерсии); КонецЕсли;
 Попытка Результат = ВыполнитьПодготовкуВыгрузки(Папка, ИсходнаяПапка, ПутьPython, НастройкиПреобразователя, Подготовка, ПутьВерсии);
 Исключение
  Если Новый Файл(ПутьВерсии).Существует() Тогда УдалитьФайлы(ПутьВерсии); КонецЕсли;
  ВызватьИсключение;
 КонецПопытки;
 Если Новый Файл(ПутьВерсии).Существует() Тогда УдалитьФайлы(ПутьВерсии); КонецЕсли;
 Возврат Результат;
КонецФункции

Функция ВыполнитьПодготовкуВыгрузки(Папка, ИсходнаяПапка, ПутьPython, НастройкиПреобразователя, Подготовка, ПутьВерсии)
 Если НастройкиПреобразователя = Неопределено Тогда ВызватьИсключение "Нужны настройки ibcmd-rs: backend, executable, base_cf."; КонецЕсли;
 НастройкиПроекта = НастройкиПреобразователя;
 КаталогКэша = Неопределено; Кэш = Неопределено;
 Если НастройкиПреобразователя.Свойство("cache_directory", КаталогКэша) Тогда
  ИспользоватьGit = Ложь; Если Не НастройкиПреобразователя.Свойство("use_git", ИспользоватьGit) Тогда ИспользоватьGit = Ложь; КонецЕсли;
  Если ИспользоватьGit Тогда
   Согласование = СогласоватьВыгрузкуСХранилищем(Папка, ИсходнаяПапка, НастройкиПреобразователя, ПутьPython);
   Если Не Согласование.merged Тогда ВызватьИсключение "Конфликт XML: " + Согласование.report_file; КонецЕсли;
   Кэш = Согласование.cache; НастройкиПреобразователя = Согласование.compiler;
   Папка = Согласование.directory; ИсходнаяПапка = Согласование.baseline_directory;
  Иначе
   Кэш = ПодготовитьКэшПоНастройкам(НастройкиПреобразователя, ПутьPython);
   Если ИсходнаяПапка = Неопределено Тогда
    Основа = ПрочитатьОсновуИзНастроек(НастройкиПреобразователя, Кэш, ПутьPython, Папка);
    Если Основа.repository_version <> Кэш.repository_version Тогда ВызватьИсключение "Основа устарела: согласуйте входящие изменения или явно инициализируйте новую основу."; КонецЕсли;
    ИсходнаяПапка = Основа.baseline_directory;
   КонецЕсли;
   НастройкиПреобразователя = Новый Структура("backend,executable,base_cf", "ibcmd", НастройкиПреобразователя.executable, Кэш.base_cf);
  КонецЕсли;
 КонецЕсли;
 Если ИсходнаяПапка = Неопределено Тогда ВызватьИсключение "Нужна исходная XML-папка или инициализированная основа."; КонецЕсли;
 Если Подготовка <> Неопределено И Не Новый Файл(ОбъединитьПути(КаталогКэша, "baseline.json")).Существует() Тогда ВызватьИсключение "Инициализируйте основу перед подготовкой с захватом."; КонецЕсли;
 План = ПланИзмененийКонфигурацииИзВыгрузки(Папка, ИсходнаяПапка, ПутьPython);
 Если Подготовка <> Неопределено Тогда Подготовка.УстановитьКонтекст(Папка, ИсходнаяПапка, План.repository_version); КонецЕсли;
 Если План.xml_paths.Количество() = 0 Тогда Возврат Неопределено; КонецЕсли;
 Параметры = ПараметрыЗапросаОбъектов(); Ответ = ТранспортХранилища.Отправить(Адрес, МенеджерЗапросов.ТелоЗапросаКонтекстаСериализации(Параметры)); ОбработатьБазовыйОтветСервиса(Ответ);
 Контекст = ОбработкаXML.ПрочитатьКонтекстСериализации(Ответ.Текст());
 ПланПакета = СериализаторОбъектаХранилища.ПланПакетаКонфигурации(Папка, ИсходнаяПапка, Контекст, ВерсияПлатформы, ПутьPython);
 Если Подготовка <> Неопределено Тогда
  ОбъектыЗахвата = Новый Массив;
  Для Каждого ИдентификаторОбъекта Из ПланПакета.capture_ids Цикл ОбъектыЗахвата.Добавить(ПолучитьОписаниеОбъекта(ИдентификаторОбъекта)); КонецЦикла;
  Подготовка.ЗахватитьОбъекты(ОбъектыЗахвата);
  ПроверитьАктуальностьПакетаВерсии(Параметры, План.repository_version);
 КонецЕсли;
 Снимки = Новый Массив;
 ПакетВерсии = Неопределено;
 Если Кэш <> Неопределено Тогда
  ЗапросИсточника = Новый Структура("mode,cache_directory,repository_id,platform,repository_version,context,snapshot_ids", "source", КаталогКэша, Кэш.repository_id, ВерсияПлатформы, План.repository_version, Base64Строка(Контекст), ПланПакета.snapshot_ids);
  ЗапросИсточника.Вставить("storage_output", ПутьВерсии);
  Источник = СериализаторОбъектаХранилища.КэшКонфигурации(ЗапросИсточника, ПутьPython);
  Для Каждого ЗаписьСнимка Из Источник.snapshots Цикл
   Объект = ПравилаПакетовХранилища.ОписаниеОбъекта(ЗаписьСнимка.description);
   Объект.НомерВерсии = ЗаписьСнимка.version_number; Объект.НомерСобственнойВерсии = ЗаписьСнимка.self_version_number;
   Снимок = Новый СнимокОбъектаХранилища; Снимок.Заполнить(Base64Значение(ЗаписьСнимка.snapshot), Объект, Источник.repository_version);
   Снимки.Добавить(Снимок);
  КонецЦикла;
  ПакетВерсии = Источник.storage_file;
 Иначе
  Для Каждого UUIDОбъекта Из ПланПакета.snapshot_ids Цикл Снимки.Добавить(ПолучитьОбъект(ПолучитьОписаниеОбъекта(UUIDОбъекта))); КонецЦикла;
  Если ПланПакета.needs_storage Тогда
   ПолучитьПакетТекущейВерсииВФайл(ПутьВерсии, ПутьPython); ПакетВерсии = ПутьВерсии;
  КонецЕсли;
 КонецЕсли;
 ОбновлениеОсновы = Неопределено;
 Если Кэш <> Неопределено Тогда
  Если Новый Файл(ОбъединитьПути(КаталогКэша, "baseline.json")).Существует() Тогда
   Основа = ПрочитатьОсновуИзНастроек(Новый Структура("cache_directory", КаталогКэша), Кэш, ПутьPython);
   ОбновлениеОсновы = Новый Структура("cache_directory,baseline_id,generation", КаталогКэша, Основа.baseline_id, Кэш.generation);
   ИспользоватьGit = Ложь; Если Не НастройкиПроекта.Свойство("use_git", ИспользоватьGit) Тогда ИспользоватьGit = Ложь; КонецЕсли;
   ОбновлениеОсновы.Вставить("use_git", ИспользоватьGit);
   ПеренестиНастройкиGit(НастройкиПроекта, ОбновлениеОсновы);
  КонецЕсли;
 КонецЕсли;
 Пакет = СериализаторОбъектаХранилища.ПакетКонфигурации(Снимки, Контекст, Папка, ИсходнаяПапка, ПланПакета, ИмяХранилища, ВерсияПлатформы, ПутьPython, ПакетВерсии, НастройкиПреобразователя, ОбновлениеОсновы);
 Если Пакет.ВерсияХранилища <> План.repository_version Тогда ВызватьИсключение "Хранилище изменилось после сравнения выгрузок."; КонецЕсли;
 Контроль = ПланИзмененийКонфигурацииИзВыгрузки(Папка, ИсходнаяПапка, ПутьPython);
 Если Контроль.target_fingerprint <> План.target_fingerprint Или Контроль.baseline_fingerprint <> План.baseline_fingerprint Или Контроль.repository_version <> План.repository_version Тогда ВызватьИсключение "Выгрузка или хранилище изменились во время подготовки."; КонецЕсли;
 Если Подготовка <> Неопределено Тогда
  Подготовка.ЗахватитьОбъекты(Пакет.СуществующиеОбъекты);
  Подготовка.ПроверитьЗахваты();
  ПроверитьАктуальностьПакетаВерсии(Параметры, Пакет.ВерсияХранилища);
 КонецЕсли;
 Возврат Пакет;
КонецФункции

// Повторяет только получение и обновление основы; повторной отправки пакета нет.
Функция ОбновитьОсновуПослеПомещения(Знач Пакет) Экспорт
 Если ТипЗнч(Пакет) <> Тип("ПакетПомещенияОбъекта") Тогда ВызватьИсключение "Нужен подготовленный пакет."; КонецЕсли;
 КонтекстОсновы = Пакет.КонтекстОбновленияОсновы;
 Если КонтекстОсновы = Неопределено Тогда ВызватьИсключение "У пакета нет контекста обновления основы."; КонецЕсли;
 Подтверждено = Ложь;
 Если Пакет.СостояниеОсновы <> Неопределено Тогда Подтверждено = Пакет.СостояниеОсновы.committed; КонецЕсли;
 Попытка
  Кэш = ОбновитьКэшКонфигурации(КонтекстОсновы.cache_directory, Неопределено, КонтекстОсновы.python);
  Запрос = Новый Структура("mode,cache_directory,generation,receipt_id,receipt_sha256,packet,executable", "advance", КонтекстОсновы.cache_directory, Кэш.generation, КонтекстОсновы.receipt_id, КонтекстОсновы.receipt_sha256, Base64Строка(Пакет.Данные), КонтекстОсновы.executable);
  Пакет.СостояниеОсновы = СериализаторОбъектаХранилища.ОсноваКонфигурации(Запрос, КонтекстОсновы.python);
 Исключение
  Пакет.СостояниеОсновы = Новый Структура("updated,committed,error,receipt_id", Ложь, Подтверждено, ОписаниеОшибки(), КонтекстОсновы.receipt_id);
 КонецПопытки;
 Возврат Пакет.СостояниеОсновы;
КонецФункции

Функция ПолучитьВнешниеДанныеОбъекта(Знач Объект, Знач ПутьPython = "python") Экспорт
	Объект.ПроверитьДляПолучения(); Параметры = ПараметрыЗапросаОбъектов();
	ВерсияДо = ПолучитьОбъект(Объект).ВерсияХранилища;
 ПутьВерсии = ПолучитьИмяВременногоФайла("bin"); Если Новый Файл(ПутьВерсии).Существует() Тогда УдалитьФайлы(ПутьВерсии); КонецЕсли;
 Попытка
  ПолучитьПакетТекущейВерсииВФайл(ПутьВерсии, ПутьPython);
  Результат = СериализаторОбъектаХранилища.ВнешниеДанныеИзВерсии(ПутьВерсии, Объект, ПутьPython);
 Исключение
  Если Новый Файл(ПутьВерсии).Существует() Тогда УдалитьФайлы(ПутьВерсии); КонецЕсли;
  ВызватьИсключение;
 КонецПопытки;
 Если Новый Файл(ПутьВерсии).Существует() Тогда УдалитьФайлы(ПутьВерсии); КонецЕсли;
	Если Результат.version_number <> Объект.НомерВерсии Или Результат.class_id <> Строка(Объект.ИдентификаторКласса)
		Или Результат.original <> НРег(Лев(Объект.ИсходнаяВерсия, 32)) Или Результат.local <> НРег(Лев(Объект.ЛокальнаяВерсия, 32)) Тогда ВызватьИсключение "Описание внешних данных устарело."; КонецЕсли;
	ПроверитьАктуальностьПакетаВерсии(Параметры, ВерсияДо);
	Возврат Результат;
КонецФункции


Процедура ПроверитьАктуальностьПакетаВерсии(Параметры, ВерсияДо)
	Ответ = ТранспортХранилища.Отправить(Адрес, МенеджерЗапросов.ТелоЗапросаПоследнейВерсии(Параметры)); ОбработатьБазовыйОтветСервиса(Ответ);
	Если НРег(ОбработкаXML.ПрочитатьИдентификаторВерсии(Ответ.Текст())) <> НРег(ВерсияДо) Тогда ВызватьИсключение "Хранилище изменилось при чтении внешних данных."; КонецЕсли;
КонецПроцедуры


Функция ПараметрыЗапросаОбъектов(ИдентификаторПодключения = Неопределено)
	Если Не АвторизацияПройдена() Тогда
		ВызватьИсключение "Для работы с объектами сначала подключитесь к хранилищу.";
	КонецЕсли;
	Если ИдентификаторПодключения = Неопределено Тогда
		ИдентификаторПодключения = ИдентификаторПодключенияЗахвата;
	Иначе
		ИдентификаторПодключения = Новый УникальныйИдентификатор(Строка(ИдентификаторПодключения));
	КонецЕсли;
	Возврат Новый Структура("ИмяХранилища,ВерсияПлатформы,ПользовательХранилища,ХешПользователяХранилища,ИдентификаторПодключения",
		ИмяХранилища, ВерсияПлатформы, Пользователь, ХешПароля, ИдентификаторПодключения);
КонецФункции

// Создать польльзователя хранилища. Работает только после подключения к хранилищу 
// (метод `Подключиться`)
//
// Параметры:
//   ИмяПользователя - Строка - имя пользователя хранилища
//   ПарольПользователя - Строка - пароль пользователя хранилища
//   Роль - РолиХранилища - роль пользовователя хранилища
//
Процедура СоздатьПользователя(Знач ИмяПользователя, Знач ПарольПользователя, Знач Роль) Экспорт
	
	ИдентификаторПодключения = Новый УникальныйИдентификатор();
	ИдентификаторОперации = Новый УникальныйИдентификатор();
	
	ХешНовогоПароля = Вспомогательный.ХешированныйПароль(ПарольПользователя);
	
	Параметры = Новый Структура;
	Параметры.Вставить("ИмяХранилища", ИмяХранилища);
	Параметры.Вставить("ВерсияПлатформы", ВерсияПлатформы);
	Параметры.Вставить("ПользовательХранилища", Пользователь);
	Параметры.Вставить("ХешПользователяХранилища", ХешПароля);
	Параметры.Вставить("ИдентификаторПодключения", ИдентификаторПодключения);
	Параметры.Вставить("ИдентификаторОперации", ИдентификаторОперации);
	Параметры.Вставить("ИмяПользователя", ИмяПользователя);
	Параметры.Вставить("ХешНовогоПароля", ХешНовогоПароля);
	Параметры.Вставить("Роль", Роль);
	
	ТелоЗапроса = МенеджерЗапросов.ТелоЗапросаНаСозданиеПользователя(Параметры);
	
	Ответ = ТранспортХранилища.Отправить(Адрес, ТелоЗапроса);
	ОбработатьБазовыйОтветСервиса(Ответ);
	
КонецПроцедуры

// Возвращает пользователя хранилища по его имени
//
// Параметры:
//   ИмяПользователя - Строка - имя пользователя хранилища
//
//  Возвращаемое значение:
//   ПользовательХранилища - объект пользователя хранилища
//   Неопределено - если пользователь не был найден
//
Функция НайтиПользователя(Знач ИмяПользователя) Экспорт
	
	ИдентификаторПодключения = Новый УникальныйИдентификатор();
	
	Параметры = Новый Структура;
	Параметры.Вставить("ИмяХранилища", ИмяХранилища);
	Параметры.Вставить("ВерсияПлатформы", ВерсияПлатформы);
	Параметры.Вставить("ПользовательХранилища", Пользователь);
	Параметры.Вставить("ХешПользователяХранилища", ХешПароля);
	Параметры.Вставить("ИдентификаторПодключения", ИдентификаторПодключения);
	Параметры.Вставить("ИмяПользователя", ИмяПользователя);
	
	ТелоЗапроса = МенеджерЗапросов.ТелоЗапросаПоискаПользователя(Параметры);
	
	Ответ = ТранспортХранилища.Отправить(Адрес, ТелоЗапроса);
	Результат = Ответ.Текст();
	
	Если Ответ.КодСостояния = 200 Тогда
		ОтветСервиса = ОбработкаXML.ПрочитатьОтветИзТекста(Результат);
		Если ОтветСервиса.ЕстьОшибка Тогда
			Сообщить(ОтветСервиса.СодержаниеОшибки);
			Возврат Неопределено;
		КонецЕсли;
		
		user = ОтветСервиса.РезультатЧтения["call_return"]["_Элементы"]["user"];
		НайденныйПользователь = Новый ПользовательХранилища();
		НайденныйПользователь.Заполнить(user);
		
		Возврат НайденныйПользователь;
		
	Иначе
		Сообщить(Результат);
		Возврат Неопределено;
	КонецЕсли;
	
	Попытка
		Структура = ОбработкаXML.ПрочитатьПользователяИзXML(Результат);
	Исключение
		// логировать
		Сообщить("Не удалось прочитать данные пользователя. Причина: " + ОписаниеОшибки());
		Структура = Неопределено;
	КонецПопытки;
	
	Возврат Структура;
	
КонецФункции

// Обновляет пользователя хранилища на основе объекта ПользовательХранилища.
// Обновляемые поля: имя пользователя, пароль, роль.
//
// Параметры:
//   ПользовательХранилища - ПользовательХранилища - объект пользователя хранилища
//
Процедура ОбновитьПользователяХранилища(ПользовательХранилища) Экспорт
	
	ИдентификаторПодключения = Новый УникальныйИдентификатор();
	
	Параметры = Новый Структура;
	Параметры.Вставить("ИмяХранилища", ИмяХранилища);
	Параметры.Вставить("ВерсияПлатформы", ВерсияПлатформы);
	Параметры.Вставить("ПользовательХранилища", Пользователь);
	Параметры.Вставить("ХешПользователяХранилища", ХешПароля);
	Параметры.Вставить("ИдентификаторПодключения", ИдентификаторПодключения);
	Параметры.Вставить("ИдентификаторПользователя", ПользовательХранилища.Идентификатор);
	Параметры.Вставить("ИмяПользователя", ПользовательХранилища.Имя);
	Если ПользовательХранилища.Пароль = Неопределено Тогда
		Параметры.Вставить("ХешПароля", ПользовательХранилища.ХешПароля);
	Иначе
		Параметры.Вставить("ХешПароля", Вспомогательный.ХешированныйПароль(ПользовательХранилища.Пароль));
	КонецЕсли;
	Параметры.Вставить("Роль", ПользовательХранилища.Роль);
	
	ТелоЗапроса = МенеджерЗапросов.ТелоЗапросаНаОбновлениеРолиПользователя(Параметры);
	
	Ответ = ТранспортХранилища.Отправить(Адрес, ТелоЗапроса);
	ОбработатьБазовыйОтветСервиса(Ответ);
	
КонецПроцедуры

// Удаляет (деактивирует) пользователя хранилища 1С.
// Для получения идентификатора пользователя хранилища, нужно воспользоваться
// методом `НайтиПользователя`.
//
// Параметры:
//   ИдентификаторПользователя - Строка - идентификатор пользователя хранилища
//
Процедура УдалитьПользователя(Знач ИдентификаторПользователя) Экспорт
	
	ИдентификаторПодключения = Новый УникальныйИдентификатор();
	
	Параметры = Новый Структура;
	Параметры.Вставить("ИмяХранилища", ИмяХранилища);
	Параметры.Вставить("ВерсияПлатформы", ВерсияПлатформы);
	Параметры.Вставить("ПользовательХранилища", Пользователь);
	Параметры.Вставить("ХешПользователяХранилища", ХешПароля);
	Параметры.Вставить("ИдентификаторПодключения", ИдентификаторПодключения);
	Параметры.Вставить("ИдентификаторПользователя", ИдентификаторПользователя);
	
	ТелоЗапроса = МенеджерЗапросов.ТелоЗапросаНаУдалениеПользователя(Параметры);
	
	Ответ = ТранспортХранилища.Отправить(Адрес, ТелоЗапроса);
	ОбработатьБазовыйОтветСервиса(Ответ);
	
КонецПроцедуры

// Восстанавливает (ранее удаленного) пользователя хранилища 1С.
// Для получения идентификатора пользователя хранилища, нужно воспользоваться
// методом `НайтиПользователя`.
//
// Параметры:
//   ИдентификаторПользователя - Строка - идентификатор пользователя хранилища
//
Процедура ВосстановитьПользователя(Знач ИдентификаторПользователя) Экспорт
	
	ИдентификаторПодключения = Новый УникальныйИдентификатор();
	
	Параметры = Новый Структура;
	Параметры.Вставить("ИмяХранилища", ИмяХранилища);
	Параметры.Вставить("ВерсияПлатформы", ВерсияПлатформы);
	Параметры.Вставить("ПользовательХранилища", Пользователь);
	Параметры.Вставить("ХешПользователяХранилища", ХешПароля);
	Параметры.Вставить("ИдентификаторПодключения", ИдентификаторПодключения);
	Параметры.Вставить("ИдентификаторПользователя", ИдентификаторПользователя);
	
	ТелоЗапроса = МенеджерЗапросов.ТелоЗапросаНаВосстановлениеПользователя(Параметры);
	
	Ответ = ТранспортХранилища.Отправить(Адрес, ТелоЗапроса);
	ОбработатьБазовыйОтветСервиса(Ответ);
	
КонецПроцедуры

// Возвращает список пользователей хранилища
//
//  Возвращаемое значение:
//   Массив - список объектов ПользовательХранилища
//
Функция СписокПользователей() Экспорт
	СписокПользователей = Новый Массив;
	
	ИдентификаторПодключения = Новый УникальныйИдентификатор();
	
	Параметры = Новый Структура;
	Параметры.Вставить("ИмяХранилища", ИмяХранилища);
	Параметры.Вставить("ВерсияПлатформы", ВерсияПлатформы);
	Параметры.Вставить("ПользовательХранилища", Пользователь);
	Параметры.Вставить("ХешПользователяХранилища", ХешПароля);
	Параметры.Вставить("ИдентификаторПодключения", ИдентификаторПодключения);
	
	ТелоЗапроса = МенеджерЗапросов.ТелоЗапросаНаПолучениеСпискаПользователей(Параметры);
	
	Ответ = ТранспортХранилища.Отправить(Адрес, ТелоЗапроса);
	ТекстОтвета = Ответ.Текст();
	Если Ответ.КодСостояния = 200 Тогда
		
		ОтветСервиса = ОбработкаXML.ПрочитатьОтветИзТекста(ТекстОтвета);
		Если ОтветСервиса.ЕстьОшибка Тогда
			Сообщить(ОтветСервиса.СодержаниеОшибки);
			Возврат СписокПользователей;
		КонецЕсли;
		
		call_return = ОтветСервиса.РезультатЧтения.Получить("call_return");
		users = call_return._Элементы.Получить("users");
		Для Каждого user Из users Цикл
			
			НайденныйПользователь = Новый ПользовательХранилища;
			НайденныйПользователь.Заполнить(user["value"]["second"]);
			
			СписокПользователей.Добавить(НайденныйПользователь);
			
		КонецЦикла;
		
	Иначе
		ВызватьИсключение(ТекстОтвета);
	КонецЕсли;
	
	Возврат СписокПользователей;
	
КонецФункции

// Возвращает список версий хранилища
//
//  Возвращаемое значение:
//   Массив - список объектов ВерсияХранилища
//
Функция СписокВерсий() Экспорт
	
	СписокВерсий = Новый Массив;
	
	ИдентификаторПодключения = Новый УникальныйИдентификатор();
	
	Параметры = Новый Структура;
	Параметры.Вставить("ИмяХранилища"            , ИмяХранилища);
	Параметры.Вставить("ВерсияПлатформы"         , ВерсияПлатформы);
	Параметры.Вставить("ПользовательХранилища"   , Пользователь);
	Параметры.Вставить("ХешПароляПользователя"   , ХешПароля);
	Параметры.Вставить("ИдентификаторПодключения", ИдентификаторПодключения);
	
	ТелоЗапроса = МенеджерЗапросов.ТелоЗапросаПолученияВерсийХранилища(Параметры);
	
	Ответ = ТранспортХранилища.Отправить(Адрес, ТелоЗапроса);
	ТекстОтвета = Ответ.Текст();
	ОбработатьБазовыйОтветСервиса(Ответ);
	ОтветСервиса = ОбработкаXML.ПрочитатьОтветИзТекста(ТекстОтвета);
	call_return = ОтветСервиса.РезультатЧтения.Получить("call_return");
	versions = call_return._Элементы.Получить("versions");
	Для Каждого version Из versions Цикл
		Версия = Новый ВерсияХранилища();
		Версия.Заполнить(version["value"]["second"]);
		СписокВерсий.Добавить(Версия);
	КонецЦикла;
	
	Возврат СписокВерсий;
	
КонецФункции // СписокВерсий()

Процедура ОбработатьБазовыйОтветСервиса(Ответ, ПотоковаяПроверка = Ложь)
	Результат = Ответ.Текст();
	
	Если Ответ.КодСостояния = 200 Тогда
		Если ПотоковаяПроверка Тогда
			ОбработкаXML.ПроверитьБазовыйОтветОбъектов(Результат);
			Возврат;
		КонецЕсли;
		ОтветСервиса = ОбработкаXML.ПрочитатьОтветИзТекста(Результат);
		Если ОтветСервиса.ЕстьОшибка Тогда
			ВызватьИсключение(ОтветСервиса.СодержаниеОшибки);
		КонецЕсли;
	Иначе
		ВызватьИсключение(Результат);
	КонецЕсли;
КонецПроцедуры

Процедура ПеренестиНастройкиGit(Источник, Приемник)
 Для Каждого ИмяНастройки Из СтрРазделить("xml_repository,source_branch", ",") Цикл
  ЗначениеНастройки = Неопределено;
  Если Источник.Свойство(ИмяНастройки, ЗначениеНастройки) Тогда Приемник.Вставить(ИмяНастройки, ЗначениеНастройки); КонецЕсли;
 КонецЦикла;
КонецПроцедуры
