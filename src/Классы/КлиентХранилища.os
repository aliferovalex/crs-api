#Использовать 1connector
#Использовать xml-parser

// Ссылка на сервер хранилищ 1С
Перем Адрес;
// Пользователь для авторизации
Перем Пользователь;
// Хеш пароля для авторизации, заполняется в методе "Подключиться"
Перем ХешПароля;
// Версия платформы 1С
Перем ВерсияПлатформы;
// Имя хранилища 1С. Например MyTrade
Перем ИмяХранилища;
Перем ИдентификаторПодключенияЗахвата;

// Событие при создании объекта
//
// Параметры:
//   АдресХранилища - Строка - URL-ссылка на сервер хранилищ 1С
//   ВерсияПлатформыХранилища - Строка - версия платформы 1С. Например: 8.3.15.1855
//
Процедура ПриСозданииОбъекта(Знач АдресХранилища, Знач ВерсияПлатформыХранилища)
	Адрес = АдресХранилища;
	ВерсияПлатформы = ВерсияПлатформыХранилища;
	ИдентификаторПодключенияЗахвата = Новый УникальныйИдентификатор();
КонецПроцедуры

// Подключение к хранилищу 1С, если оно существует
//
// Параметры:
//   ПользовательХранилища - Строка - пользователь хранилища
//   ПарольХранилища - Строка - пароль пользователя хранилища
//   пИмяХранилища - Строка - имя хранилища. Например: `MyTrade` или `Trade/MyRepo`.
//		По умолчанию `maincr`.
//
Процедура Подключиться(Знач ПользовательХранилища, Знач ПарольХранилища, Знач пИмяХранилища = "maincr") Экспорт
	Пользователь = Неопределено;
	ХешПароля = Неопределено;
	ИдентификаторПодключенияЗахвата = Новый УникальныйИдентификатор();
	
	Хеш = Вспомогательный.ХешированныйПароль(ПарольХранилища);
	
	Параметры = Новый Структура;
	Параметры.Вставить("ИмяХранилища", пИмяХранилища);
	Параметры.Вставить("ВерсияПлатформы", ВерсияПлатформы);
	Параметры.Вставить("ПользовательХранилища", ПользовательХранилища);
	Параметры.Вставить("ХешПароляПользователя", Хеш);
	
	ТелоЗапроса = МенеджерЗапросов.ТелоЗапросаНаПодключение(Параметры);
	
	Ответ = КоннекторHTTP.Post(Адрес, ТелоЗапроса);
	Если Ответ.КодСостояния = 200 Тогда
		ОтветСервиса = ОбработкаXML.ПрочитатьОтветИзТекста(Ответ.Текст());
		
		Если ОтветСервиса.ЕстьОшибка Тогда
			Сообщить(ОтветСервиса.СодержаниеОшибки);
			Возврат;
		КонецЕсли;
		
		Пользователь = ПользовательХранилища;
		ХешПароля = Хеш;
	Иначе
		ВызватьИсключение(Ответ.Текст());
	КонецЕсли;
	
	ИмяХранилища = пИмяХранилища;
	
КонецПроцедуры

// Возвращает значение, пройдена ли авторизация
//
//  Возвращаемое значение:
//   Булево - Истина или Ложь.
//
Функция АвторизацияПройдена() Экспорт
	Возврат ЗначениеЗаполнено(ХешПароля) И ЗначениеЗаполнено(ИмяХранилища);
КонецФункции

// Возвращает описания объектов, входящих в указанную версию (изменения этой версии).
// НомерВерсии - Число - номер версии; 0 соответствует последней версии на 8.5.4.
// Возвращаемое значение: Массив из ОбъектХранилища.
Функция СписокОбъектовВерсии(Знач НомерВерсии) Экспорт
	Если ТипЗнч(НомерВерсии) <> Тип("Число") Тогда
		ВызватьИсключение "Номер версии должен быть числом.";
	КонецЕсли;
	Если НомерВерсии < 0 Или НомерВерсии <> Цел(НомерВерсии) Тогда
		ВызватьИсключение "Номер версии должен быть целым неотрицательным числом.";
	КонецЕсли;
	Параметры = ПараметрыЗапросаОбъектов();
	Параметры.Вставить("НомерВерсии", НомерВерсии);
	Тело = МенеджерЗапросов.ТелоЗапросаОбъектовВерсии(Параметры);
	Ответ = КоннекторHTTP.Post(Адрес, Тело);
	ОбработатьБазовыйОтветСервиса(Ответ);
	Возврат ОбработкаXML.ПрочитатьОбъектыВерсии(Ответ.Текст());
КонецФункции

// Получает актуальное описание существующего объекта по UUID независимо от
// того, входит ли объект в изменения последней версии хранилища.
// ИдентификаторОбъекта - Строка или УникальныйИдентификатор.
// Отсутствующий/удаленный объект и изменение версии во время чтения - исключение.
Функция ПолучитьОписаниеОбъекта(Знач ИдентификаторОбъекта) Экспорт
	Если ТипЗнч(ИдентификаторОбъекта) <> Тип("Строка")
		И ТипЗнч(ИдентификаторОбъекта) <> Тип("УникальныйИдентификатор") Тогда
		ВызватьИсключение "UUID объекта должен быть строкой или УникальнымИдентификатором.";
	КонецЕсли;
	Идентификатор = НРег(Строка(Новый УникальныйИдентификатор(Строка(ИдентификаторОбъекта))));
	Если Идентификатор = "00000000-0000-0000-0000-000000000000" Тогда
		ВызватьИсключение "Не указан UUID объекта хранилища.";
	КонецЕсли;
	Параметры = ПараметрыЗапросаОбъектов();
	Параметры.Вставить("ИдентификаторОбъекта", Идентификатор);
	ТелоСостояния = МенеджерЗапросов.ТелоЗапросаСостоянияОбъекта(Параметры);
	Ответ = КоннекторHTTP.Post(Адрес, ТелоСостояния);
	ОбработатьБазовыйОтветСервиса(Ответ);
	НомерВерсии = ОбработкаXML.ПрочитатьНомерВерсииОбъекта(Ответ.Текст(), Идентификатор);
	Параметры.Вставить("НомерВерсии", НомерВерсии);
	Ответ = КоннекторHTTP.Post(Адрес, МенеджерЗапросов.ТелоЗапросаОбъектовВерсии(Параметры));
	ОбработатьБазовыйОтветСервиса(Ответ);
	Объект = ОбработкаXML.ПрочитатьОписаниеОбъекта(Ответ.Текст(), Идентификатор, НомерВерсии);
	Ответ = КоннекторHTTP.Post(Адрес, ТелоСостояния);
	ОбработатьБазовыйОтветСервиса(Ответ);
	Если ОбработкаXML.ПрочитатьНомерВерсииОбъекта(Ответ.Текст(), Идентификатор) <> НомерВерсии Тогда
		ВызватьИсключение "Версия объекта изменилась во время чтения описания. Получите описание заново.";
	КонецЕсли;
	Возврат Объект;
КонецФункции

// Захватывает один существующий объект без дочерних объектов.
// Объект - ОбъектХранилища - актуальное описание из СписокОбъектовВерсии
//   или из рабочей конфигурации. Устаревшее описание требует обновления.
// ИдентификаторПодключения - Строка, УникальныйИдентификатор - необязательный
//   bindID; по умолчанию используется отдельный идентификатор этого клиента.
// Возвращает Истина только после проверки владельца захвата на сервере.
// При отказе, неполном результате или отсутствии авторизации вызывает исключение.
Функция ЗахватитьОбъект(Знач Объект, Знач ИдентификаторПодключения = Неопределено) Экспорт
	Параметры = ПараметрыЗапросаОбъектов(ИдентификаторПодключения);
	Если ТипЗнч(Объект) <> Тип("ОбъектХранилища") Тогда
		ВызватьИсключение "Для захвата необходимо описание типа ОбъектХранилища.";
	КонецЕсли;
	Объект.ПроверитьДляЗахвата();
	ТекущийПользователь = НайтиПользователя(Пользователь);
	Если ТекущийПользователь = Неопределено Тогда
		ВызватьИсключение "Не удалось определить пользователя для проверки захвата.";
	КонецЕсли;
	Параметры.Вставить("ИдентификаторОбъекта", Объект.Идентификатор);
	Тело = МенеджерЗапросов.ТелоЗапросаСостоянияОбъекта(Параметры);
	Ответ = КоннекторHTTP.Post(Адрес, Тело);
	ОбработатьБазовыйОтветСервиса(Ответ);
	Состояние = ОбработкаXML.СостояниеОбъектаИзОтвета(Ответ.Текст(), Строка(Объект.Идентификатор));
	Если Состояние = Неопределено Тогда
		ВызватьИсключение "Объект не найден в хранилище.";
	КонецЕсли;
	Если Состояние.НомерВерсии <> Объект.НомерВерсии Тогда
		ВызватьИсключение "Описание объекта устарело. Получите описание его последней версии.";
	КонецЕсли;
	Параметры.Вставить("Объект", Объект);
	Параметры.Вставить("Захватить", Истина);
	Тело = МенеджерЗапросов.ТелоЗапросаНаИзменениеЗахвата(Параметры);
	Ответ = КоннекторHTTP.Post(Адрес, Тело);
	ОбработатьБазовыйОтветСервиса(Ответ);
	ОбработкаXML.ПроверитьОтветЗахвата(Ответ.Текст(), Строка(Объект.Идентификатор));
	Тело = МенеджерЗапросов.ТелоЗапросаСостоянияОбъекта(Параметры);
	Ответ = КоннекторHTTP.Post(Адрес, Тело);
	ОбработатьБазовыйОтветСервиса(Ответ);
	Если Не ОбработкаXML.ОбъектЗахваченПользователем(Ответ.Текст(),
		Строка(Объект.Идентификатор), Строка(ТекущийПользователь.Идентификатор)) Тогда
		ВызватьИсключение "Сервер не подтвердил захват объекта текущим пользователем.";
	КонецЕсли;
	Возврат Истина;
КонецФункции

// Отменяет захват одного существующего объекта текущим пользователем.
// Объект - ОбъектХранилища - актуальное описание объекта.
// ИдентификаторПодключения - необязательный bindID, как в ЗахватитьОбъект.
// Возвращает Истина после проверки свободного состояния на сервере.
// Повторная отмена свободного объекта также возвращает Истина.
// Чужой захват и устаревшее описание вызывают исключение.
Функция ОтменитьЗахватОбъекта(Знач Объект, Знач ИдентификаторПодключения = Неопределено) Экспорт
	Параметры = ПараметрыЗапросаОбъектов(ИдентификаторПодключения);
	Если ТипЗнч(Объект) <> Тип("ОбъектХранилища") Тогда
		ВызватьИсключение "Для отмены захвата необходимо описание типа ОбъектХранилища.";
	КонецЕсли;
	Объект.ПроверитьДляОтменыЗахвата();
	Параметры.Вставить("ИдентификаторОбъекта", Объект.Идентификатор);
	Тело = МенеджерЗапросов.ТелоЗапросаСостоянияОбъекта(Параметры);
	Ответ = КоннекторHTTP.Post(Адрес, Тело);
	ОбработатьБазовыйОтветСервиса(Ответ);
	Состояние = ОбработкаXML.СостояниеОбъектаИзОтвета(Ответ.Текст(), Строка(Объект.Идентификатор));
	Если Состояние = Неопределено Тогда
		ВызватьИсключение "Объект не найден в хранилище.";
	КонецЕсли;
	Если Состояние.НомерВерсии <> Объект.НомерВерсии Тогда
		ВызватьИсключение "Описание объекта устарело. Получите описание его последней версии.";
	КонецЕсли;
	Если Не Состояние.Захвачен Тогда
		Возврат Истина;
	КонецЕсли;
	ТекущийПользователь = НайтиПользователя(Пользователь);
	Если ТекущийПользователь = Неопределено Тогда
		ВызватьИсключение "Не удалось определить пользователя для отмены захвата.";
	КонецЕсли;
	Если НРег(Строка(Состояние.Пользователь)) <> НРег(Строка(ТекущийПользователь.Идентификатор)) Тогда
		ВызватьИсключение "Нельзя отменить захват объекта другим пользователем.";
	КонецЕсли;
	Параметры.Вставить("Объект", Объект);
	Параметры.Вставить("Захватить", Ложь);
	Если СовместимостьПлатформы.ИспользоватьПрофиль851(ВерсияПлатформы) Тогда
		Параметры.Вставить("ВыборкаВерсииЗахвата", Истина);
		Ответ = КоннекторHTTP.Post(Адрес, МенеджерЗапросов.ТелоЗапросаСостоянияОбъекта(Параметры));
		ОбработатьБазовыйОтветСервиса(Ответ);
		Если Не ОбработкаXML.ОбъектЗахваченПользователем(Ответ.Текст(), Строка(Объект.Идентификатор), Строка(ТекущийПользователь.Идентификатор)) Тогда
			ВызватьИсключение "Собственный захват изменился перед отменой.";
		КонецЕсли;
		Параметры.Вставить("НомерВерсииЗахвата", ОбработкаXML.ПрочитатьНомерВерсииОбъекта(Ответ.Текст(), Строка(Объект.Идентификатор)));
		Параметры.Удалить("ВыборкаВерсииЗахвата");
	КонецЕсли;
	Тело = МенеджерЗапросов.ТелоЗапросаНаИзменениеЗахвата(Параметры);
	Ответ = КоннекторHTTP.Post(Адрес, Тело);
	ОбработатьБазовыйОтветСервиса(Ответ);
	ОбработкаXML.ПроверитьОтветЗахвата(Ответ.Текст(), Строка(Объект.Идентификатор));
	Ответ = КоннекторHTTP.Post(Адрес, МенеджерЗапросов.ТелоЗапросаСостоянияОбъекта(Параметры));
	ОбработатьБазовыйОтветСервиса(Ответ);
	Состояние = ОбработкаXML.СостояниеОбъектаИзОтвета(Ответ.Текст(), Строка(Объект.Идентификатор));
	Если Состояние = Неопределено Тогда
		ВызватьИсключение "Сервер не подтвердил состояние объекта после отмены захвата.";
	КонецЕсли;
	Если Состояние.Захвачен Тогда
		ВызватьИсключение "Сервер не подтвердил отмену захвата объекта.";
	КонецЕсли;
	Возврат Истина;
КонецФункции

// Получает снимок одного существующего объекта без изменения рабочей конфигурации.
// Объект - ОбъектХранилища - актуальное описание объекта.
// Возвращаемое значение: СнимокОбъектаХранилища (данные raw DEFLATE и полный пакет).
// Метод не захватывает объект. Исторические версии и формирование .cf не поддерживаются.
Функция ПолучитьОбъект(Знач Объект, Знач ИдентификаторПодключения = Неопределено) Экспорт
	Параметры = ПараметрыЗапросаОбъектов(ИдентификаторПодключения);
	Если ТипЗнч(Объект) <> Тип("ОбъектХранилища") Тогда
		ВызватьИсключение "Для получения необходимо описание типа ОбъектХранилища.";
	КонецЕсли;
	Объект.ПроверитьДляПолучения();
	Параметры.Вставить("ИдентификаторОбъекта", Объект.Идентификатор);
	Тело = МенеджерЗапросов.ТелоЗапросаСостоянияОбъекта(Параметры);
	Ответ = КоннекторHTTP.Post(Адрес, Тело);
	ОбработатьБазовыйОтветСервиса(Ответ);
	Состояние = ОбработкаXML.СостояниеОбъектаИзОтвета(Ответ.Текст(), Строка(Объект.Идентификатор));
	Если Состояние = Неопределено Тогда
		ВызватьИсключение "Объект не найден в хранилище.";
	КонецЕсли;
	Если Состояние.НомерВерсии <> Объект.НомерВерсии Тогда
		ВызватьИсключение "Описание объекта устарело. Получите описание его последней версии.";
	КонецЕсли;
	Ответ = КоннекторHTTP.Post(Адрес, МенеджерЗапросов.ТелоЗапросаПоследнейВерсии(Параметры));
	ОбработатьБазовыйОтветСервиса(Ответ);
	ВерсияХранилища = ОбработкаXML.ПрочитатьИдентификаторВерсии(Ответ.Текст());
	Параметры.Вставить("ВерсияХранилища", ВерсияХранилища);
	Параметры.Вставить("Объект", Объект);
	Ответ = КоннекторHTTP.Post(Адрес, МенеджерЗапросов.ТелоЗапросаНаПолучениеОбъекта(Параметры));
	ОбработатьБазовыйОтветСервиса(Ответ);
	Возврат ОбработкаXML.ПрочитатьОтветПолученияОбъекта(Ответ.Текст(), Объект, ВерсияХранилища);
КонецФункции

// Каталог классов верхнего уровня из снимка корня, включая пустые коллекции.
// Корень - актуальное ОбъектХранилища. Возвращает classes, groups и scope.
// Вложенные классы и полный реестр типов платформы не перечисляются.
Функция ПолучитьКлассыМетаданных(Знач Корень, Знач ПутьPython = "python") Экспорт
	Если ТипЗнч(Корень) <> Тип("ОбъектХранилища") Тогда
		ВызватьИсключение "Необходимо описание корня конфигурации.";
	КонецЕсли;
	Если Корень.ИдентификаторКласса <> ИдентификаторыМетаданных.КлассКонфигурации() Тогда
		ВызватьИсключение "Каталог классов читается из корня конфигурации.";
	КонецЕсли;
	Снимок = ПолучитьОбъект(Корень);
	Возврат СериализаторОбъектаХранилища.КлассыМетаданных(Снимок, ВерсияПлатформы, ПутьPython);
КонецФункции

// Помещает подготовленный нативным клиентом пакет одного существующего объекта.
// Пакет - ПакетПомещенияОбъекта; не является бинарным снимком из ПолучитьОбъект.
// Возвращает актуальное ОбъектХранилища после проверки новой версии на сервере.
// Ошибки после отправки могут означать неопределенный результат: не повторяйте
// помещение автоматически, сначала проверьте историю и состояние объекта.
// Единый вход помещения: операция определяется неизменяемыми правилами пакета.
Функция ПоместитьПакет(Знач Пакет, Знач Комментарий = "", Знач ИдентификаторПодключения = Неопределено) Экспорт
	Если Не ПравилаПакетовХранилища.ЭтоПакет(Пакет) Тогда ВызватьИсключение "Нужен пакет помещения хранилища."; КонецЕсли;
 Если Пакет.Групповой() Тогда Возврат ПоместитьГруппуИзменений(Пакет, Комментарий, ИдентификаторПодключения); КонецЕсли;
	Если Пакет.ВидОперации() = "Создание" Тогда Возврат ПоместитьСозданиеОбъекта(Пакет, Комментарий, ИдентификаторПодключения); КонецЕсли;
	Если Пакет.ВидОперации() = "Удаление" Тогда Возврат ПоместитьУдалениеОбъекта(Пакет, Комментарий, ИдентификаторПодключения); КонецЕсли;
	Объект = Пакет.Корень;
	Если Объект = Неопределено Тогда Объект = ПолучитьОписаниеОбъекта(Пакет.ИдентификаторОбъекта); КонецЕсли;
	Возврат ПоместитьОбъект(Объект, Пакет, Комментарий, ИдентификаторПодключения);
КонецФункции

Функция ПоместитьОбъект(Знач Объект, Знач Пакет, Знач Комментарий = "", Знач ИдентификаторПодключения = Неопределено) Экспорт
	Параметры = ПараметрыЗапросаОбъектов(ИдентификаторПодключения);
	Если ТипЗнч(Объект) <> Тип("ОбъектХранилища") Или Не ПравилаПакетовХранилища.ЭтоПакет(Пакет, "Изменение") Тогда
		ВызватьИсключение "Для помещения необходимы ОбъектХранилища и пакет помещения или изменения общего модуля.";
	КонецЕсли;
	Если ТипЗнч(Комментарий) <> Тип("Строка") Тогда
		ВызватьИсключение "Комментарий помещения должен быть строкой.";
	КонецЕсли;
	Пакет.Проверить(Объект);
 Если Пакет.Групповой() Тогда Возврат ПоместитьГруппуИзменений(Пакет, Комментарий, ИдентификаторПодключения); КонецЕсли;
	Если Пакет.ИмяХранилища <> ИмяХранилища Или Пакет.ВерсияПлатформы <> ВерсияПлатформы Тогда
		ВызватьИсключение "Пакет подготовлен для другого хранилища или версии платформы.";
	КонецЕсли;
	Параметры.Вставить("ИдентификаторОбъекта", Объект.Идентификатор);
	Ответ = КоннекторHTTP.Post(Адрес, МенеджерЗапросов.ТелоЗапросаСостоянияОбъекта(Параметры));
	ОбработатьБазовыйОтветСервиса(Ответ);
	До = ОбработкаXML.СостояниеОбъектаИзОтвета(Ответ.Текст(), Строка(Объект.Идентификатор));
	Если До = Неопределено Тогда
		ВызватьИсключение "Объект не найден в хранилище.";
	КонецЕсли;
	Если До.НомерВерсии <> Объект.НомерВерсии Тогда
		ВызватьИсключение "Описание объекта устарело. Получите описание его последней версии.";
	КонецЕсли;
	Если Не До.Захвачен Тогда
		ВызватьИсключение "Для помещения объект должен быть захвачен текущим пользователем.";
	КонецЕсли;
	ТекущийПользователь = НайтиПользователя(Пользователь);
	Если ТекущийПользователь = Неопределено Тогда
		ВызватьИсключение "Не удалось определить пользователя для помещения.";
	КонецЕсли;
	Если НРег(Строка(До.Пользователь)) <> НРег(Строка(ТекущийПользователь.Идентификатор)) Тогда
		ВызватьИсключение "Объект захвачен другим пользователем.";
	КонецЕсли;
	Ответ = КоннекторHTTP.Post(Адрес, МенеджерЗапросов.ТелоЗапросаПоследнейВерсии(Параметры));
	ОбработатьБазовыйОтветСервиса(Ответ);
	Если НРег(ОбработкаXML.ПрочитатьИдентификаторВерсии(Ответ.Текст())) <> НРег(Пакет.ВерсияХранилища) Тогда
		ВызватьИсключение "Пакет помещения устарел: изменилась версия хранилища.";
	КонецЕсли;
	Параметры.Вставить("Объект", Объект);
	Параметры.Вставить("Пакет", Пакет);
	Параметры.Вставить("Комментарий", Комментарий);
	Ответ = КоннекторHTTP.Post(Адрес, МенеджерЗапросов.ТелоЗапросаНаПомещениеОбъекта(Параметры));
	ОбработатьБазовыйОтветСервиса(Ответ);
	ОбработкаXML.ПроверитьОтветПомещения(Ответ.Текст());
	Ответ = КоннекторHTTP.Post(Адрес, МенеджерЗапросов.ТелоЗапросаСостоянияОбъекта(Параметры));
	ОбработатьБазовыйОтветСервиса(Ответ);
	После = ОбработкаXML.СостояниеОбъектаИзОтвета(Ответ.Текст(), Строка(Объект.Идентификатор));
	Если После = Неопределено Тогда
		ВызватьИсключение "Сервер не подтвердил состояние объекта после помещения. Проверьте историю хранилища.";
	КонецЕсли;
	Если После.НомерВерсии <= До.НомерВерсии Тогда
		ВызватьИсключение "Сервер не подтвердил новую версию объекта после помещения. Проверьте историю хранилища.";
	КонецЕсли;
	Для Каждого НовыйОбъект Из СписокОбъектовВерсии(После.НомерВерсии) Цикл
		Если НРег(Строка(НовыйОбъект.Идентификатор)) = НРег(Строка(Объект.Идентификатор)) Тогда
			// В истории сервер хранит UUID (первые 16 байт), обнуляя последние
			// 4 байта клиентской контрольной суммы. Проверено на 8.5.4.1878.
			Если НРег(Лев(НовыйОбъект.ЛокальнаяВерсия, 32)) <> НРег(Лев(Пакет.ЛокальнаяВерсия, 32)) Тогда
				ВызватьИсключение "Контрольная сумма помещенной версии не подтверждена. Проверьте историю хранилища.";
			КонецЕсли;
			Возврат НовыйОбъект;
		КонецЕсли;
	КонецЦикла;
	ВызватьИсключение "Новая версия объекта не найдена в истории после помещения.";
КонецФункции

// Общий вход: один файл описания объекта из XML-выгрузки, без захвата и помещения.
Функция ПодготовитьПакетИзВыгрузок(Знач ПутиXML, Знач ПутьPython = "python") Экспорт
 Если ТипЗнч(ПутиXML) <> Тип("Массив") Или ПутиXML.Количество() = 0 Или ПутиXML.Количество() > 256 Тогда ВызватьИсключение "Нужны 1..256 файлов выгрузки."; КонецЕсли;
 Пакеты = Новый Массив;
 Для Каждого ПутьXML Из ПутиXML Цикл Пакеты.Добавить(ПодготовитьПакетИзВыгрузки(ПутьXML, Неопределено, ПутьPython)); КонецЦикла;
 Пакет = СериализаторОбъектаХранилища.ОбъединитьПакетыИзменений(Пакеты, ПутьPython);
 ПроверитьАктуальностьПакетаВерсии(ПараметрыЗапросаОбъектов(), Пакет.ВерсияХранилища); Возврат Пакет;
КонецФункции

Функция ПланИзмененийКонфигурацииИзВыгрузки(Знач Папка, Знач ИсходнаяПапка, Знач ПутьPython = "python") Экспорт
 Параметры = ПараметрыЗапросаОбъектов();
 Ответ = КоннекторHTTP.Post(Адрес, МенеджерЗапросов.ТелоЗапросаПоследнейВерсии(Параметры)); ОбработатьБазовыйОтветСервиса(Ответ);
 ВерсияДо = ОбработкаXML.ПрочитатьИдентификаторВерсии(Ответ.Текст());
 Ответ = КоннекторHTTP.Post(Адрес, МенеджерЗапросов.ТелоЗапросаКонтекстаСериализации(Параметры)); ОбработатьБазовыйОтветСервиса(Ответ);
 Контекст = ОбработкаXML.ПрочитатьКонтекстСериализации(Ответ.Текст());
 План = СериализаторОбъектаХранилища.ПланВыгрузкиКонфигурации(Папка, ИсходнаяПапка, Контекст, ПутьPython);
 ПроверитьАктуальностьПакетаВерсии(Параметры, ВерсияДо); План.Вставить("repository_version", ВерсияДо); Возврат План;
КонецФункции

Функция ПодготовитьКонфигурациюИзВыгрузки(Знач Папка, Знач ИсходнаяПапка, Знач ПутьPython = "python") Экспорт
 План = ПланИзмененийКонфигурацииИзВыгрузки(Папка, ИсходнаяПапка, ПутьPython);
 Если План.xml_paths.Количество() = 0 Тогда Возврат Неопределено; КонецЕсли;
 Параметры = ПараметрыЗапросаОбъектов(); Ответ = КоннекторHTTP.Post(Адрес, МенеджерЗапросов.ТелоЗапросаКонтекстаСериализации(Параметры)); ОбработатьБазовыйОтветСервиса(Ответ);
 Контекст = ОбработкаXML.ПрочитатьКонтекстСериализации(Ответ.Текст());
 ПланПакета = СериализаторОбъектаХранилища.ПланПакетаКонфигурации(Папка, ИсходнаяПапка, Контекст, ВерсияПлатформы, ПутьPython);
 Снимки = Новый Массив;
 Для Каждого UUIDОбъекта Из ПланПакета.snapshot_ids Цикл Снимки.Добавить(ПолучитьОбъект(ПолучитьОписаниеОбъекта(UUIDОбъекта))); КонецЦикла;
 ПакетВерсии = Неопределено;
 Если ПланПакета.needs_storage Тогда
  Ответ = КоннекторHTTP.Post(Адрес, МенеджерЗапросов.ТелоЗапросаПакетаТекущейВерсии(Параметры)); ОбработатьБазовыйОтветСервиса(Ответ);
  ПакетВерсии = ОбработкаXML.ПрочитатьПакетТекущейВерсии(Ответ.Текст());
 КонецЕсли;
 Пакет = СериализаторОбъектаХранилища.ПакетКонфигурации(Снимки, Контекст, Папка, ИсходнаяПапка, ПланПакета, ИмяХранилища, ВерсияПлатформы, ПутьPython, ПакетВерсии);
 Если Пакет.ВерсияХранилища <> План.repository_version Тогда ВызватьИсключение "Хранилище изменилось после сравнения выгрузок."; КонецЕсли;
 Контроль = ПланИзмененийКонфигурацииИзВыгрузки(Папка, ИсходнаяПапка, ПутьPython);
 Если Контроль.target_fingerprint <> План.target_fingerprint Или Контроль.baseline_fingerprint <> План.baseline_fingerprint Или Контроль.repository_version <> План.repository_version Тогда ВызватьИсключение "Выгрузка или хранилище изменились во время подготовки."; КонецЕсли;
 Возврат Пакет;
КонецФункции

Функция ПоместитьГруппуИзменений(Пакет, Комментарий, ИдентификаторПодключения)
 Если ТипЗнч(Комментарий) <> Тип("Строка") Тогда ВызватьИсключение "Нужен строковый комментарий помещения."; КонецЕсли;
 Пакет.Проверить();
 Если Пакет.ИмяХранилища <> ИмяХранилища Или Пакет.ВерсияПлатформы <> ВерсияПлатформы Тогда ВызватьИсключение "Группа подготовлена для другого хранилища или платформы."; КонецЕсли;
 Параметры = ПараметрыЗапросаОбъектов(ИдентификаторПодключения); ТекущийПользователь = НайтиПользователя(Пользователь);
 Если ТекущийПользователь = Неопределено Тогда ВызватьИсключение "Не определён пользователь помещения."; КонецЕсли;
 Для Каждого Объект Из Пакет.СуществующиеОбъекты Цикл
  Описание = ПолучитьОписаниеОбъекта(Объект.Идентификатор);
  Если Описание.НомерВерсии <> Объект.НомерВерсии Или НРег(Описание.ИсходнаяВерсия) <> НРег(Объект.ИсходнаяВерсия) Тогда ВызватьИсключение "Один из объектов группы устарел."; КонецЕсли;
  Параметры.Вставить("ИдентификаторОбъекта", Объект.Идентификатор);
  Ответ = КоннекторHTTP.Post(Адрес, МенеджерЗапросов.ТелоЗапросаСостоянияОбъекта(Параметры)); ОбработатьБазовыйОтветСервиса(Ответ);
  Состояние = ОбработкаXML.СостояниеОбъектаИзОтвета(Ответ.Текст(), Строка(Объект.Идентификатор));
  Если Состояние = Неопределено Или Не Состояние.Захвачен Тогда ВызватьИсключение "Все объекты группы должны быть захвачены."; КонецЕсли;
  Если НРег(Строка(Состояние.Пользователь)) <> НРег(Строка(ТекущийПользователь.Идентификатор)) Тогда ВызватьИсключение "Объект группы захвачен другим пользователем."; КонецЕсли;
 КонецЦикла;
 Для Каждого НовыйОбъект Из Пакет.НовыеОбъекты Цикл
  Параметры.Вставить("ИдентификаторОбъекта", НовыйОбъект.Идентификатор);
  Ответ = КоннекторHTTP.Post(Адрес, МенеджерЗапросов.ТелоЗапросаСостоянияОбъекта(Параметры)); ОбработатьБазовыйОтветСервиса(Ответ);
  Если ОбработкаXML.СостояниеОбъектаИзОтвета(Ответ.Текст(), Строка(НовыйОбъект.Идентификатор)) <> Неопределено Тогда ВызватьИсключение "UUID нового объекта группы уже существует."; КонецЕсли;
 КонецЦикла;
 ПроверитьАктуальностьПакетаВерсии(Параметры, Пакет.ВерсияХранилища);
 Параметры.Вставить("Пакет", Пакет); Параметры.Вставить("Комментарий", Комментарий);
 Ответ = КоннекторHTTP.Post(Адрес, МенеджерЗапросов.ТелоЗапросаНаПомещениеПакета(Параметры)); ОбработатьБазовыйОтветСервиса(Ответ); ОбработкаXML.ПроверитьОтветПомещения(Ответ.Текст());
 Результат = Новый Массив; НомерВерсии = Неопределено;
 Для Индекс = 0 По Пакет.ОбъектыПакета.Количество() - 1 Цикл
  Ожидаемый = Пакет.ОбъектыПакета[Индекс]; Исходный = Неопределено;
  Для Каждого Кандидат Из Пакет.СуществующиеОбъекты Цикл Если НРег(Строка(Кандидат.Идентификатор)) = НРег(Строка(Ожидаемый.Идентификатор)) Тогда Исходный = Кандидат; Прервать; КонецЕсли; КонецЦикла;
  После = ПолучитьОписаниеОбъекта(Ожидаемый.Идентификатор);
  Если (Исходный <> Неопределено И После.НомерВерсии <= Исходный.НомерВерсии) Или НРег(Лев(После.ЛокальнаяВерсия, 32)) <> НРег(Лев(Ожидаемый.ЛокальнаяВерсия, 32)) Или После.Имя <> Ожидаемый.Имя Или НРег(Строка(После.ИдентификаторКласса)) <> НРег(Строка(Ожидаемый.ИдентификаторКласса)) Или НРег(Строка(После.ИдентификаторРодителя)) <> НРег(Строка(Ожидаемый.ИдентификаторРодителя)) Тогда ВызватьИсключение "Не подтверждена новая версия или описание объекта группы. Проверьте историю."; КонецЕсли;
  Если НомерВерсии <> Неопределено И После.НомерВерсии <> НомерВерсии Тогда ВызватьИсключение "Объекты группы попали в разные версии. Проверьте историю."; КонецЕсли;
  НомерВерсии = После.НомерВерсии; Результат.Добавить(После);
 КонецЦикла;
 Для Каждого Удаляемый Из Пакет.УдаляемыеОбъекты Цикл
  Параметры.Вставить("ИдентификаторОбъекта", Удаляемый.Идентификатор);
  Ответ = КоннекторHTTP.Post(Адрес, МенеджерЗапросов.ТелоЗапросаСостоянияОбъекта(Параметры)); ОбработатьБазовыйОтветСервиса(Ответ);
  Если ОбработкаXML.СостояниеОбъектаИзОтвета(Ответ.Текст(), Строка(Удаляемый.Идентификатор)) <> Неопределено Тогда ВызватьИсключение "Удаление объекта группы не подтверждено. Проверьте историю."; КонецЕсли;
 КонецЦикла;
 Возврат Результат;
КонецФункции

Функция ПодготовитьПакетИзВыгрузки(Знач ПутьXMLОбъекта, Знач Настройки = Неопределено, Знач ПутьPython = "python") Экспорт
	Параметры = ПараметрыЗапросаОбъектов();
	СовместимостьПлатформы.ПроверитьСериализацию(ВерсияПлатформы);
	Ответ = КоннекторHTTP.Post(Адрес, МенеджерЗапросов.ТелоЗапросаПоследнейВерсии(Параметры)); ОбработатьБазовыйОтветСервиса(Ответ);
	ВерсияДо = ОбработкаXML.ПрочитатьИдентификаторВерсии(Ответ.Текст());
	Ответ = КоннекторHTTP.Post(Адрес, МенеджерЗапросов.ТелоЗапросаКонтекстаСериализации(Параметры)); ОбработатьБазовыйОтветСервиса(Ответ);
	Контекст = ОбработкаXML.ПрочитатьКонтекстСериализации(Ответ.Текст());
	ПроверитьАктуальностьПакетаВерсии(Параметры, ВерсияДо);
	План = СериализаторОбъектаХранилища.ПланПодготовкиИзВыгрузки(ПутьXMLОбъекта, Контекст, Настройки, ПутьPython);
	Удаления = Новый Массив;
	Если План.Свойство("removed_ids", Удаления) И Удаления.Количество() > 0 Тогда
		Снимки = Новый Массив; Снимки.Добавить(ПолучитьОбъект(ПолучитьОписаниеОбъекта(План.object_id)));
		Для Каждого UUIDУдаления Из Удаления Цикл Снимки.Добавить(ПолучитьОбъект(ПолучитьОписаниеОбъекта(UUIDУдаления))); КонецЦикла;
		ПакетВерсии = Неопределено;
		Если План.needs_storage Тогда
			Ответ = КоннекторHTTP.Post(Адрес, МенеджерЗапросов.ТелоЗапросаПакетаТекущейВерсии(Параметры)); ОбработатьБазовыйОтветСервиса(Ответ);
			ПакетВерсии = ОбработкаXML.ПрочитатьПакетТекущейВерсии(Ответ.Текст());
			ПроверитьАктуальностьПакетаВерсии(Параметры, Снимки[0].ВерсияХранилища);
		КонецЕсли;
		Пакет = СериализаторОбъектаХранилища.ИзменениеСУдалениями(Снимки, Контекст, План, ИмяХранилища, ВерсияПлатформы, ПутьPython, ПакетВерсии);
	ИначеЕсли (План.kind = "Template" Или План.kind = "CommonTemplate") И План.operation = "Создание" Тогда
		Основание = ПолучитьОписаниеОбъекта(План.parent_id);
		Снимок = ПолучитьОбъект(Основание); ПакетВерсии = Неопределено;
		Ответ = КоннекторHTTP.Post(Адрес, МенеджерЗапросов.ТелоЗапросаПакетаТекущейВерсии(Параметры)); ОбработатьБазовыйОтветСервиса(Ответ);
		ПакетВерсии = ОбработкаXML.ПрочитатьПакетТекущейВерсии(Ответ.Текст());
		Пакет = СериализаторОбъектаХранилища.МакетСКДИзXML(Снимок, Контекст, ПакетВерсии, План, ИмяХранилища, ВерсияПлатформы, ПутьPython);
	ИначеЕсли План.operation = "Создание" Тогда
		Родитель = ПолучитьОписаниеОбъекта(План.parent_id);
		Если ПравилаПакетовХранилища.ЭтоФорма(План.kind) Тогда
			Пакет = ПодготовитьСозданиеФормыПоПлану(Родитель, План, Контекст, ПутьPython);
		Иначе
			Пакет = ПодготовитьСозданиеПоПлану(Родитель, План, Контекст, ПутьPython);
		КонецЕсли;
	Иначе
		Объект = ПолучитьОписаниеОбъекта(План.object_id);
		Если План.operation = "Удаление" Тогда
			Пакет = ПодготовитьУдалениеОбъектаXML(Объект, План.object_xml, ПутьPython);
		Иначе
			Пакет = ПодготовитьИзменениеПоПлану(Объект, План, Контекст, ПутьPython);
		КонецЕсли;
	КонецЕсли;
	Если НРег(Пакет.ВерсияХранилища) <> НРег(ВерсияДо) Тогда ВызватьИсключение "Хранилище изменилось после определения операции. Повторите подготовку."; КонецЕсли;
	ПроверитьАктуальностьПакетаВерсии(Параметры, ВерсияДо);
	Возврат Пакет;
КонецФункции

Функция ПолучитьВнешниеДанныеОбъекта(Знач Объект, Знач ПутьPython = "python") Экспорт
	Объект.ПроверитьДляПолучения(); Параметры = ПараметрыЗапросаОбъектов();
	ВерсияДо = ПолучитьОбъект(Объект).ВерсияХранилища;
	Ответ = КоннекторHTTP.Post(Адрес, МенеджерЗапросов.ТелоЗапросаПакетаТекущейВерсии(Параметры));
	ОбработатьБазовыйОтветСервиса(Ответ); Данные = ОбработкаXML.ПрочитатьПакетТекущейВерсии(Ответ.Текст());
	Результат = СериализаторОбъектаХранилища.ВнешниеДанныеИзВерсии(Данные, Объект, ПутьPython);
	Если Результат.version_number <> Объект.НомерВерсии Или Результат.class_id <> Строка(Объект.ИдентификаторКласса)
		Или Результат.original <> НРег(Лев(Объект.ИсходнаяВерсия, 32)) Или Результат.local <> НРег(Лев(Объект.ЛокальнаяВерсия, 32)) Тогда ВызватьИсключение "Описание внешних данных устарело."; КонецЕсли;
	ПроверитьАктуальностьПакетаВерсии(Параметры, ВерсияДо);
	Возврат Результат;
КонецФункции

Функция ПодготовитьУдалениеОбъекта(Знач Объект, Знач ПутьXMLРодителя, Знач ПутьPython = "python") Экспорт
	Возврат ПодготовитьУдалениеОбъектаXML(Объект, ПрочитатьФайлВыгрузки(ПутьXMLРодителя), ПутьPython);
КонецФункции

Функция ПодготовитьУдалениеОбъектаXML(Объект, XMLРодителя, ПутьPython)
	Объект.ПроверитьДляПомещения();
	Вид = ПравилаПакетовХранилища.ВидПоКлассу(Объект.ИдентификаторКласса);
	Правила = ПравилаПакетовХранилища.Параметры("Удаление", Вид);
	Родитель = ПолучитьОписаниеОбъекта(Объект.ИдентификаторРодителя); СнимокРодителя = ПолучитьОбъект(Родитель); СнимокОбъекта = ПолучитьОбъект(Объект);
	Если СнимокРодителя.ВерсияХранилища <> СнимокОбъекта.ВерсияХранилища Тогда ВызватьИсключение "Хранилище изменилось при чтении снимков удаления."; КонецЕсли;
	Параметры = ПараметрыЗапросаОбъектов();
	Ответ = КоннекторHTTP.Post(Адрес, МенеджерЗапросов.ТелоЗапросаКонтекстаСериализации(Параметры)); ОбработатьБазовыйОтветСервиса(Ответ);
	Контекст = ОбработкаXML.ПрочитатьКонтекстСериализации(Ответ.Текст()); ПроверитьАктуальностьПакетаВерсии(Параметры, СнимокРодителя.ВерсияХранилища);
	Ответ = КоннекторHTTP.Post(Адрес, МенеджерЗапросов.ТелоЗапросаПакетаТекущейВерсии(Параметры)); ОбработатьБазовыйОтветСервиса(Ответ);
	ПакетВерсии = ОбработкаXML.ПрочитатьПакетТекущейВерсии(Ответ.Текст());
	ПроверитьАктуальностьПакетаВерсии(Параметры, СнимокРодителя.ВерсияХранилища);
	Возврат СериализаторОбъектаХранилища.УдалениеОбъекта(СнимокРодителя, СнимокОбъекта, Контекст, XMLРодителя, ИмяХранилища, ВерсияПлатформы, ПутьPython, ПакетВерсии);
КонецФункции

Функция ПоместитьУдалениеОбъекта(Знач Пакет, Знач Комментарий = "", Знач ИдентификаторПодключения = Неопределено) Экспорт
	Если Не ПравилаПакетовХранилища.ЭтоПакет(Пакет, "Удаление") Или ТипЗнч(Комментарий) <> Тип("Строка") Тогда ВызватьИсключение "Нужен пакет удаления объекта и комментарий."; КонецЕсли;
	Пакет.Проверить();
	Если Пакет.ИмяХранилища <> ИмяХранилища Или Пакет.ВерсияПлатформы <> ВерсияПлатформы Тогда ВызватьИсключение "Пакет подготовлен для другого хранилища."; КонецЕсли;
	Параметры = ПараметрыЗапросаОбъектов(ИдентификаторПодключения); ТекущийПользователь = НайтиПользователя(Пользователь);
	Если ТекущийПользователь = Неопределено Тогда ВызватьИсключение "Не определён пользователь удаления."; КонецЕсли;
	Для Каждого Объект Из Пакет.СуществующиеОбъекты Цикл
		Описание = ПолучитьОписаниеОбъекта(Объект.Идентификатор);
		Если Описание.НомерВерсии <> Объект.НомерВерсии Или Описание.ИсходнаяВерсия <> Объект.ИсходнаяВерсия Тогда ВызватьИсключение "Пакет удаления устарел."; КонецЕсли;
		Параметры.Вставить("ИдентификаторОбъекта", Объект.Идентификатор);
		Ответ = КоннекторHTTP.Post(Адрес, МенеджерЗапросов.ТелоЗапросаСостоянияОбъекта(Параметры)); ОбработатьБазовыйОтветСервиса(Ответ);
		Состояние = ОбработкаXML.СостояниеОбъектаИзОтвета(Ответ.Текст(), Строка(Объект.Идентификатор));
		Если Состояние = Неопределено Или Не Состояние.Захвачен Тогда ВызватьИсключение "Удаляемый объект и родитель должны быть захвачены."; КонецЕсли;
		Если НРег(Строка(Состояние.Пользователь)) <> НРег(Строка(ТекущийПользователь.Идентификатор)) Тогда ВызватьИсключение "Объект захвачен другим пользователем."; КонецЕсли;
	КонецЦикла;
	ПроверитьАктуальностьПакетаВерсии(Параметры, Пакет.ВерсияХранилища);
	Параметры.Вставить("Пакет", Пакет); Параметры.Вставить("Комментарий", Комментарий);
	Ответ = КоннекторHTTP.Post(Адрес, МенеджерЗапросов.ТелоЗапросаНаСозданиеОбъекта(Параметры)); ОбработатьБазовыйОтветСервиса(Ответ); ОбработкаXML.ПроверитьОтветПомещения(Ответ.Текст());
	Родитель = ПолучитьОписаниеОбъекта(Пакет.Корень.Идентификатор);
	Если Родитель.НомерВерсии <= Пакет.Корень.НомерВерсии Или НРег(Лев(Родитель.ЛокальнаяВерсия, 32)) <> НРег(Лев(Пакет.ОбъектыПакета[0].ЛокальнаяВерсия, 32)) Тогда ВызватьИсключение "Версия родителя после удаления не подтверждена. Проверьте историю."; КонецЕсли;
	Для Каждого Удаляемый Из Пакет.УдаляемыеОбъекты Цикл
		Параметры.Вставить("ИдентификаторОбъекта", Удаляемый.Идентификатор);
		Ответ = КоннекторHTTP.Post(Адрес, МенеджерЗапросов.ТелоЗапросаСостоянияОбъекта(Параметры)); ОбработатьБазовыйОтветСервиса(Ответ);
		Если ОбработкаXML.СостояниеОбъектаИзОтвета(Ответ.Текст(), Строка(Удаляемый.Идентификатор)) <> Неопределено Тогда ВызватьИсключение "Удаляемый объект всё ещё доступен после помещения. Проверьте историю."; КонецЕсли;
	КонецЦикла;
	Возврат Родитель;
КонецФункции

Функция ПрочитатьФайлВыгрузки(Путь)
	Документ = Новый ТекстовыйДокумент; Документ.Прочитать(Путь, КодировкаТекста.UTF8);
	Возврат Документ.ПолучитьТекст();
КонецФункции

Функция ПодготовитьИзменениеПоПлану(Объект, План, Контекст, ПутьPython)
	Объект.ПроверитьДляПомещения();
	Снимок = ПолучитьОбъект(Объект);
	Данные = Неопределено;
	НужныТипы = Ложь; План.Свойство("needs_storage", НужныТипы);
	Если ПравилаПакетовХранилища.ЭтоФорма(План.kind) Или План.kind = "Template" Или План.kind = "CommonTemplate" Или НужныТипы Тогда
		Параметры = ПараметрыЗапросаОбъектов();
		Ответ = КоннекторHTTP.Post(Адрес, МенеджерЗапросов.ТелоЗапросаПакетаТекущейВерсии(Параметры)); ОбработатьБазовыйОтветСервиса(Ответ);
		Данные = ОбработкаXML.ПрочитатьПакетТекущейВерсии(Ответ.Текст());
		ПроверитьАктуальностьПакетаВерсии(Параметры, Снимок.ВерсияХранилища);
	КонецЕсли;
	Возврат СериализаторОбъектаХранилища.ИзменениеПоПлану(Снимок, Контекст, План, ИмяХранилища, ВерсияПлатформы, ПутьPython, Данные);
КонецФункции

Процедура ПроверитьАктуальностьПакетаВерсии(Параметры, ВерсияДо)
	Ответ = КоннекторHTTP.Post(Адрес, МенеджерЗапросов.ТелоЗапросаПоследнейВерсии(Параметры)); ОбработатьБазовыйОтветСервиса(Ответ);
	Если НРег(ОбработкаXML.ПрочитатьИдентификаторВерсии(Ответ.Текст())) <> НРег(ВерсияДо) Тогда ВызватьИсключение "Хранилище изменилось при чтении внешних данных."; КонецЕсли;
КонецПроцедуры

Функция ПодготовитьСозданиеФормыПоПлану(Родитель, План, Контекст, ПутьPython)
	ВидФормы = ?(План.kind = "CommonForm", "CommonForm", СтрЗаменить(План.kind, "Form", ""));
	ИмяФормы = План.name; XMLФормы = План.form_xml; ТекстМодуля = План.module_text; XMLОписания = План.object_xml;
	Параметры = ПараметрыЗапросаОбъектов();
	Если ТипЗнч(Родитель) <> Тип("ОбъектХранилища") Или ТипЗнч(ИмяФормы) <> Тип("Строка") Тогда ВызватьИсключение "Нужны описание родителя и имя формы."; КонецЕсли;
	Родитель.ПроверитьДляПомещения();
	Если НРег(Строка(Родитель.ИдентификаторКласса)) <> ИдентификаторыМетаданных.ИдентификаторКласса(?(ВидФормы = "CommonForm", "Configuration", ВидФормы)) Тогда ВызватьИсключение "Класс родителя не соответствует виду формы."; КонецЕсли;
	СовместимостьПлатформы.ПроверитьСериализацию(ВерсияПлатформы);
	Снимок = ПолучитьОбъект(Родитель);
	Ответ = КоннекторHTTP.Post(Адрес, МенеджерЗапросов.ТелоЗапросаПоследнейВерсии(Параметры));
	ОбработатьБазовыйОтветСервиса(Ответ);
	Если НРег(ОбработкаXML.ПрочитатьИдентификаторВерсии(Ответ.Текст())) <> НРег(Снимок.ВерсияХранилища) Тогда ВызватьИсключение "Хранилище изменилось во время подготовки формы."; КонецЕсли;
	СнимкиСсылок = Новый Соответствие;
	Если XMLФормы <> Неопределено Тогда
		ПланСсылок = СериализаторОбъектаХранилища.ОбъектыСсылокФормы(XMLФормы, Контекст, ПутьPython);
		Для Каждого Ссылка Из ПланСсылок.objects Цикл
			ОписаниеСсылки = ПолучитьОписаниеОбъекта(Новый УникальныйИдентификатор(Ссылка.object_id));
			СнимокСсылки = ПолучитьОбъект(ОписаниеСсылки);
			Если НРег(СнимокСсылки.ВерсияХранилища) <> НРег(Снимок.ВерсияХранилища) Тогда ВызватьИсключение "Хранилище изменилось при получении ссылок формы."; КонецЕсли;
			СнимкиСсылок.Вставить(Ссылка.object_id, Base64Строка(СнимокСсылки.ПакетСнимков));
		КонецЦикла;
		Если ПланСсылок.objects.Количество() > 0 Тогда ПроверитьАктуальностьПакетаВерсии(Параметры, Снимок.ВерсияХранилища); КонецЕсли;
	КонецЕсли;
	Ответ = КоннекторHTTP.Post(Адрес, МенеджерЗапросов.ТелоЗапросаПакетаТекущейВерсии(Параметры)); ОбработатьБазовыйОтветСервиса(Ответ);
	ПакетВерсии = ОбработкаXML.ПрочитатьПакетТекущейВерсии(Ответ.Текст());
	ПроверитьАктуальностьПакетаВерсии(Параметры, Снимок.ВерсияХранилища);
	Возврат СериализаторОбъектаХранилища.СозданиеУправляемойФормы(Снимок, Контекст, ИмяФормы, ИмяХранилища, ВерсияПлатформы, ПутьPython, ВидФормы, XMLФормы, ТекстМодуля, XMLОписания, СнимкиСсылок, ПакетВерсии);
КонецФункции

Функция ПодготовитьСозданиеПоПлану(Корень, План, Контекст, ПутьPython)
	XMLОбъекта = План.object_xml; ВидОбъекта = План.kind; ТекстМодуля = План.module_text;
	Формы = План.forms; Модули = План.modules; СвязанныеОбъекты = План.related_objects; МодулиКоманд = План.inline_modules;
	Параметры = ПараметрыЗапросаОбъектов();
	Если Не СовместимостьПлатформы.ПоддерживаетсяСериализация(ВерсияПлатформы) Или ТипЗнч(XMLОбъекта) <> Тип("Строка") Тогда
		ВызватьИсключение "Нужен XML объекта и поддерживаемая версия платформы.";
	КонецЕсли;
	Снимки = Новый Массив;
	СнимокКорня = ПолучитьОбъект(Корень);
	Снимки.Добавить(СнимокКорня);
	Для Каждого Идентификатор Из СериализаторОбъектаХранилища.ДочерниеОбъектыДляСоздания(Контекст, Корень, ПутьPython) Цикл
		Снимки.Добавить(ПолучитьОбъект(ПолучитьОписаниеОбъекта(Идентификатор)));
	КонецЦикла;
	Ответ = КоннекторHTTP.Post(Адрес, МенеджерЗапросов.ТелоЗапросаПоследнейВерсии(Параметры));
	ОбработатьБазовыйОтветСервиса(Ответ);
	Если ОбработкаXML.ПрочитатьИдентификаторВерсии(Ответ.Текст()) <> СнимокКорня.ВерсияХранилища Тогда
		ВызватьИсключение "Хранилище изменилось во время подготовки пакета создания.";
	КонецЕсли;
	ПакетВерсии = Неопределено;
	Если План.templates.Количество() > 0 Или План.needs_storage Тогда
		Ответ = КоннекторHTTP.Post(Адрес, МенеджерЗапросов.ТелоЗапросаПакетаТекущейВерсии(Параметры)); ОбработатьБазовыйОтветСервиса(Ответ);
		ПакетВерсии = ОбработкаXML.ПрочитатьПакетТекущейВерсии(Ответ.Текст());
	КонецЕсли;
	ОпределенияМетаданных = Неопределено;
	План.Свойство("metadata_definitions", ОпределенияМетаданных);
	Возврат СериализаторОбъектаХранилища.СозданиеОбъектаИзXML(Снимки, Контекст, XMLОбъекта,
		ИмяХранилища, ВерсияПлатформы, ПутьPython, ВидОбъекта, ТекстМодуля, Формы, Модули, СвязанныеОбъекты, МодулиКоманд, План.templates, ПакетВерсии, План.file_data, ОпределенияМетаданных);
КонецФункции

Функция ПоместитьСозданиеОбъекта(Знач Пакет, Знач Комментарий, Знач ИдентификаторПодключения)
	Параметры = ПараметрыЗапросаОбъектов(ИдентификаторПодключения);
	Если Не ПравилаПакетовХранилища.ЭтоПакет(Пакет, "Создание") Или ТипЗнч(Комментарий) <> Тип("Строка") Тогда
		ВызватьИсключение "Нужны пакет создания объекта и строка комментария.";
	КонецЕсли;
	Пакет.Проверить();
	Если Пакет.ИмяХранилища <> ИмяХранилища Или Пакет.ВерсияПлатформы <> ВерсияПлатформы Тогда
		ВызватьИсключение "Пакет подготовлен для другого хранилища или платформы.";
	КонецЕсли;
	ТекущийПользователь = НайтиПользователя(Пользователь);
	Если ТекущийПользователь = Неопределено Тогда ВызватьИсключение "Не определен пользователь помещения."; КонецЕсли;
	Для Каждого Объект Из Пакет.СуществующиеОбъекты Цикл
		Описание = ПолучитьОписаниеОбъекта(Объект.Идентификатор);
		Если Описание.НомерВерсии <> Объект.НомерВерсии Или Описание.ИсходнаяВерсия <> Объект.ИсходнаяВерсия Тогда
			ВызватьИсключение "Исходные объекты пакета создания устарели.";
		КонецЕсли;
		Параметры.Вставить("ИдентификаторОбъекта", Объект.Идентификатор);
		Ответ = КоннекторHTTP.Post(Адрес, МенеджерЗапросов.ТелоЗапросаСостоянияОбъекта(Параметры));
		ОбработатьБазовыйОтветСервиса(Ответ);
		Состояние = ОбработкаXML.СостояниеОбъектаИзОтвета(Ответ.Текст(), Строка(Объект.Идентификатор));
		Если Состояние = Неопределено Тогда ВызватьИсключение "Исходный объект отсутствует."; КонецЕсли;
		Если Не Состояние.Захвачен Или НРег(Строка(Состояние.Пользователь)) <> НРег(Строка(ТекущийПользователь.Идентификатор)) Тогда
			ВызватьИсключение "Все исходные объекты должны быть захвачены текущим пользователем.";
		КонецЕсли;
	КонецЦикла;
	Параметры.Вставить("ИдентификаторОбъекта", Пакет.ИдентификаторОбъекта);
	Ответ = КоннекторHTTP.Post(Адрес, МенеджерЗапросов.ТелоЗапросаСостоянияОбъекта(Параметры));
	ОбработатьБазовыйОтветСервиса(Ответ);
	Если ОбработкаXML.СостояниеОбъектаИзОтвета(Ответ.Текст(), Строка(Пакет.ИдентификаторОбъекта)) <> Неопределено Тогда
		ВызватьИсключение "UUID нового объекта уже существует.";
	КонецЕсли;
	Ответ = КоннекторHTTP.Post(Адрес, МенеджерЗапросов.ТелоЗапросаПоследнейВерсии(Параметры));
	ОбработатьБазовыйОтветСервиса(Ответ);
	Если ОбработкаXML.ПрочитатьИдентификаторВерсии(Ответ.Текст()) <> Пакет.ВерсияХранилища Тогда
		ВызватьИсключение "Пакет создания устарел: изменилась версия хранилища.";
	КонецЕсли;
	Параметры.Вставить("Пакет", Пакет);
	Параметры.Вставить("Комментарий", Комментарий);
	Ответ = КоннекторHTTP.Post(Адрес, МенеджерЗапросов.ТелоЗапросаНаСозданиеОбъекта(Параметры));
	ОбработатьБазовыйОтветСервиса(Ответ);
	ОбработкаXML.ПроверитьОтветПомещения(Ответ.Текст());
	НовыйОбъект = Неопределено;
	Для Каждого ОписаниеПакета Из Пакет.ОбъектыПакета Цикл
		Описание = ПолучитьОписаниеОбъекта(ОписаниеПакета.Идентификатор);
		Если Описание.Имя <> ОписаниеПакета.Имя Или Описание.ИдентификаторКласса <> ОписаниеПакета.ИдентификаторКласса
			Или Описание.ИдентификаторРодителя <> ОписаниеПакета.ИдентификаторРодителя Тогда
			ВызватьИсключение "Описание помещенного объекта не подтверждено. Проверьте историю.";
		КонецЕсли;
		Если НРег(Лев(Описание.ЛокальнаяВерсия, 32)) <> НРег(Лев(ОписаниеПакета.ЛокальнаяВерсия, 32)) Тогда
			ВызватьИсключение "Версия помещенного объекта не подтверждена. Проверьте историю.";
		КонецЕсли;
		Для Каждого Исходный Из Пакет.СуществующиеОбъекты Цикл
			Если НРег(Строка(Описание.Идентификатор)) = НРег(Строка(Исходный.Идентификатор)) И Описание.НомерВерсии <= Исходный.НомерВерсии Тогда
				ВызватьИсключение "Новая версия исходного объекта не подтверждена. Проверьте историю.";
			КонецЕсли;
		КонецЦикла;
		Если НРег(Строка(Описание.Идентификатор)) = НРег(Строка(Пакет.ИдентификаторОбъекта)) Тогда НовыйОбъект = Описание; КонецЕсли;
	КонецЦикла;
	Если НовыйОбъект = Неопределено Тогда ВызватьИсключение "Новый объект не подтвержден."; КонецЕсли;
	Возврат НовыйОбъект;
КонецФункции

Функция ПараметрыЗапросаОбъектов(ИдентификаторПодключения = Неопределено)
	Если Не АвторизацияПройдена() Тогда
		ВызватьИсключение "Для работы с объектами сначала подключитесь к хранилищу.";
	КонецЕсли;
	Если ИдентификаторПодключения = Неопределено Тогда
		ИдентификаторПодключения = ИдентификаторПодключенияЗахвата;
	Иначе
		ИдентификаторПодключения = Новый УникальныйИдентификатор(Строка(ИдентификаторПодключения));
	КонецЕсли;
	Возврат Новый Структура("ИмяХранилища,ВерсияПлатформы,ПользовательХранилища,ХешПользователяХранилища,ИдентификаторПодключения",
		ИмяХранилища, ВерсияПлатформы, Пользователь, ХешПароля, ИдентификаторПодключения);
КонецФункции

// Создать польльзователя хранилища. Работает только после подключения к хранилищу 
// (метод `Подключиться`)
//
// Параметры:
//   ИмяПользователя - Строка - имя пользователя хранилища
//   ПарольПользователя - Строка - пароль пользователя хранилища
//   Роль - РолиХранилища - роль пользовователя хранилища
//
Процедура СоздатьПользователя(Знач ИмяПользователя, Знач ПарольПользователя, Знач Роль) Экспорт
	
	ИдентификаторПодключения = Новый УникальныйИдентификатор();
	ИдентификаторОперации = Новый УникальныйИдентификатор();
	
	ХешНовогоПароля = Вспомогательный.ХешированныйПароль(ПарольПользователя);
	
	Параметры = Новый Структура;
	Параметры.Вставить("ИмяХранилища", ИмяХранилища);
	Параметры.Вставить("ВерсияПлатформы", ВерсияПлатформы);
	Параметры.Вставить("ПользовательХранилища", Пользователь);
	Параметры.Вставить("ХешПользователяХранилища", ХешПароля);
	Параметры.Вставить("ИдентификаторПодключения", ИдентификаторПодключения);
	Параметры.Вставить("ИдентификаторОперации", ИдентификаторОперации);
	Параметры.Вставить("ИмяПользователя", ИмяПользователя);
	Параметры.Вставить("ХешНовогоПароля", ХешНовогоПароля);
	Параметры.Вставить("Роль", Роль);
	
	ТелоЗапроса = МенеджерЗапросов.ТелоЗапросаНаСозданиеПользователя(Параметры);
	
	Ответ = КоннекторHTTP.Post(Адрес, ТелоЗапроса);
	ОбработатьБазовыйОтветСервиса(Ответ);
	
КонецПроцедуры

// Возвращает пользователя хранилища по его имени
//
// Параметры:
//   ИмяПользователя - Строка - имя пользователя хранилища
//
//  Возвращаемое значение:
//   ПользовательХранилища - объект пользователя хранилища
//   Неопределено - если пользователь не был найден
//
Функция НайтиПользователя(Знач ИмяПользователя) Экспорт
	
	ИдентификаторПодключения = Новый УникальныйИдентификатор();
	
	Параметры = Новый Структура;
	Параметры.Вставить("ИмяХранилища", ИмяХранилища);
	Параметры.Вставить("ВерсияПлатформы", ВерсияПлатформы);
	Параметры.Вставить("ПользовательХранилища", Пользователь);
	Параметры.Вставить("ХешПользователяХранилища", ХешПароля);
	Параметры.Вставить("ИдентификаторПодключения", ИдентификаторПодключения);
	Параметры.Вставить("ИмяПользователя", ИмяПользователя);
	
	ТелоЗапроса = МенеджерЗапросов.ТелоЗапросаПоискаПользователя(Параметры);
	
	Ответ = КоннекторHTTP.Post(Адрес, ТелоЗапроса);
	Результат = Ответ.Текст();
	
	Если Ответ.КодСостояния = 200 Тогда
		ОтветСервиса = ОбработкаXML.ПрочитатьОтветИзТекста(Результат);
		Если ОтветСервиса.ЕстьОшибка Тогда
			Сообщить(ОтветСервиса.СодержаниеОшибки);
			Возврат Неопределено;
		КонецЕсли;
		
		user = ОтветСервиса.РезультатЧтения["call_return"]["_Элементы"]["user"];
		НайденныйПользователь = Новый ПользовательХранилища();
		НайденныйПользователь.Заполнить(user);
		
		Возврат НайденныйПользователь;
		
	Иначе
		Сообщить(Результат);
		Возврат Неопределено;
	КонецЕсли;
	
	Попытка
		Структура = ОбработкаXML.ПрочитатьПользователяИзXML(Результат);
	Исключение
		// логировать
		Сообщить("Не удалось прочитать данные пользователя. Причина: " + ОписаниеОшибки());
		Структура = Неопределено;
	КонецПопытки;
	
	Возврат Структура;
	
КонецФункции

// Обновляет пользователя хранилища на основе объекта ПользовательХранилища.
// Обновляемые поля: имя пользователя, пароль, роль.
//
// Параметры:
//   ПользовательХранилища - ПользовательХранилища - объект пользователя хранилища
//
Процедура ОбновитьПользователяХранилища(ПользовательХранилища) Экспорт
	
	ИдентификаторПодключения = Новый УникальныйИдентификатор();
	
	Параметры = Новый Структура;
	Параметры.Вставить("ИмяХранилища", ИмяХранилища);
	Параметры.Вставить("ВерсияПлатформы", ВерсияПлатформы);
	Параметры.Вставить("ПользовательХранилища", Пользователь);
	Параметры.Вставить("ХешПользователяХранилища", ХешПароля);
	Параметры.Вставить("ИдентификаторПодключения", ИдентификаторПодключения);
	Параметры.Вставить("ИдентификаторПользователя", ПользовательХранилища.Идентификатор);
	Параметры.Вставить("ИмяПользователя", ПользовательХранилища.Имя);
	Если ПользовательХранилища.Пароль = Неопределено Тогда
		Параметры.Вставить("ХешПароля", ПользовательХранилища.ХешПароля);
	Иначе
		Параметры.Вставить("ХешПароля", Вспомогательный.ХешированныйПароль(ПользовательХранилища.Пароль));
	КонецЕсли;
	Параметры.Вставить("Роль", ПользовательХранилища.Роль);
	
	ТелоЗапроса = МенеджерЗапросов.ТелоЗапросаНаОбновлениеРолиПользователя(Параметры);
	
	Ответ = КоннекторHTTP.Post(Адрес, ТелоЗапроса);
	ОбработатьБазовыйОтветСервиса(Ответ);
	
КонецПроцедуры

// Удаляет (деактивирует) пользователя хранилища 1С.
// Для получения идентификатора пользователя хранилища, нужно воспользоваться
// методом `НайтиПользователя`.
//
// Параметры:
//   ИдентификаторПользователя - Строка - идентификатор пользователя хранилища
//
Процедура УдалитьПользователя(Знач ИдентификаторПользователя) Экспорт
	
	ИдентификаторПодключения = Новый УникальныйИдентификатор();
	
	Параметры = Новый Структура;
	Параметры.Вставить("ИмяХранилища", ИмяХранилища);
	Параметры.Вставить("ВерсияПлатформы", ВерсияПлатформы);
	Параметры.Вставить("ПользовательХранилища", Пользователь);
	Параметры.Вставить("ХешПользователяХранилища", ХешПароля);
	Параметры.Вставить("ИдентификаторПодключения", ИдентификаторПодключения);
	Параметры.Вставить("ИдентификаторПользователя", ИдентификаторПользователя);
	
	ТелоЗапроса = МенеджерЗапросов.ТелоЗапросаНаУдалениеПользователя(Параметры);
	
	Ответ = КоннекторHTTP.Post(Адрес, ТелоЗапроса);
	ОбработатьБазовыйОтветСервиса(Ответ);
	
КонецПроцедуры

// Восстанавливает (ранее удаленного) пользователя хранилища 1С.
// Для получения идентификатора пользователя хранилища, нужно воспользоваться
// методом `НайтиПользователя`.
//
// Параметры:
//   ИдентификаторПользователя - Строка - идентификатор пользователя хранилища
//
Процедура ВосстановитьПользователя(Знач ИдентификаторПользователя) Экспорт
	
	ИдентификаторПодключения = Новый УникальныйИдентификатор();
	
	Параметры = Новый Структура;
	Параметры.Вставить("ИмяХранилища", ИмяХранилища);
	Параметры.Вставить("ВерсияПлатформы", ВерсияПлатформы);
	Параметры.Вставить("ПользовательХранилища", Пользователь);
	Параметры.Вставить("ХешПользователяХранилища", ХешПароля);
	Параметры.Вставить("ИдентификаторПодключения", ИдентификаторПодключения);
	Параметры.Вставить("ИдентификаторПользователя", ИдентификаторПользователя);
	
	ТелоЗапроса = МенеджерЗапросов.ТелоЗапросаНаВосстановлениеПользователя(Параметры);
	
	Ответ = КоннекторHTTP.Post(Адрес, ТелоЗапроса);
	ОбработатьБазовыйОтветСервиса(Ответ);
	
КонецПроцедуры

// Возвращает список пользователей хранилища
//
//  Возвращаемое значение:
//   Массив - список объектов ПользовательХранилища
//
Функция СписокПользователей() Экспорт
	СписокПользователей = Новый Массив;
	
	ИдентификаторПодключения = Новый УникальныйИдентификатор();
	
	Параметры = Новый Структура;
	Параметры.Вставить("ИмяХранилища", ИмяХранилища);
	Параметры.Вставить("ВерсияПлатформы", ВерсияПлатформы);
	Параметры.Вставить("ПользовательХранилища", Пользователь);
	Параметры.Вставить("ХешПользователяХранилища", ХешПароля);
	Параметры.Вставить("ИдентификаторПодключения", ИдентификаторПодключения);
	
	ТелоЗапроса = МенеджерЗапросов.ТелоЗапросаНаПолучениеСпискаПользователей(Параметры);
	
	Ответ = КоннекторHTTP.Post(Адрес, ТелоЗапроса);
	ТекстОтвета = Ответ.Текст();
	Если Ответ.КодСостояния = 200 Тогда
		
		ОтветСервиса = ОбработкаXML.ПрочитатьОтветИзТекста(ТекстОтвета);
		Если ОтветСервиса.ЕстьОшибка Тогда
			Сообщить(ОтветСервиса.СодержаниеОшибки);
			Возврат СписокПользователей;
		КонецЕсли;
		
		call_return = ОтветСервиса.РезультатЧтения.Получить("call_return");
		users = call_return._Элементы.Получить("users");
		Для Каждого user Из users Цикл
			
			НайденныйПользователь = Новый ПользовательХранилища;
			НайденныйПользователь.Заполнить(user["value"]["second"]);
			
			СписокПользователей.Добавить(НайденныйПользователь);
			
		КонецЦикла;
		
	Иначе
		ВызватьИсключение(ТекстОтвета);
	КонецЕсли;
	
	Возврат СписокПользователей;
	
КонецФункции

// Возвращает список версий хранилища
//
//  Возвращаемое значение:
//   Массив - список объектов ВерсияХранилища
//
Функция СписокВерсий() Экспорт
	
	СписокВерсий = Новый Массив;
	
	ИдентификаторПодключения = Новый УникальныйИдентификатор();
	
	Параметры = Новый Структура;
	Параметры.Вставить("ИмяХранилища"            , ИмяХранилища);
	Параметры.Вставить("ВерсияПлатформы"         , ВерсияПлатформы);
	Параметры.Вставить("ПользовательХранилища"   , Пользователь);
	Параметры.Вставить("ХешПароляПользователя"   , ХешПароля);
	Параметры.Вставить("ИдентификаторПодключения", ИдентификаторПодключения);
	
	ТелоЗапроса = МенеджерЗапросов.ТелоЗапросаПолученияВерсийХранилища(Параметры);
	
	Ответ = КоннекторHTTP.Post(Адрес, ТелоЗапроса);
	ТекстОтвета = Ответ.Текст();
	Если Ответ.КодСостояния = 200 Тогда
		
		ОтветСервиса = ОбработкаXML.ПрочитатьОтветИзТекста(ТекстОтвета);
		Если ОтветСервиса.ЕстьОшибка Тогда
			Сообщить(ОтветСервиса.СодержаниеОшибки);
			Возврат СписокВерсий;
		КонецЕсли;
		
		call_return = ОтветСервиса.РезультатЧтения.Получить("call_return");
		versions = call_return._Элементы.Получить("versions");
		Для Каждого version Из versions Цикл
			
			Версия = Новый ВерсияХранилища();
			Версия.Заполнить(version["value"]["second"]);
			
			СписокВерсий.Добавить(Версия);
			
		КонецЦикла;
		
	Иначе
		ВызватьИсключение(ТекстОтвета);
	КонецЕсли;
	
	Возврат СписокВерсий;
	
КонецФункции // СписокВерсий()

Процедура ОбработатьБазовыйОтветСервиса(Ответ)
	Результат = Ответ.Текст();
	
	Если Ответ.КодСостояния = 200 Тогда
		ОтветСервиса = ОбработкаXML.ПрочитатьОтветИзТекста(Результат);
		Если ОтветСервиса.ЕстьОшибка Тогда
			ВызватьИсключение(ОтветСервиса.СодержаниеОшибки);
		КонецЕсли;
	Иначе
		ВызватьИсключение(Результат);
	КонецЕсли;
КонецПроцедуры
