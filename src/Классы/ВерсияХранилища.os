// Идентификатор версии хранилища (GUID)
Перем Идентификатор Экспорт;
// Порядковый номер версии хранилища
Перем Номер Экспорт;
// Дата версии хранилища
Перем Дата Экспорт;
// Внутренняя версия конфигурации
Перем ВнутренняяВерсия Экспорт;
// Версия конфигурации
Перем Версия Экспорт;
// Автор версии в хранилище
Перем Пользователь Экспорт;
// Номер версии платформы 1С
Перем Версия1С Экспорт;
// Комментарий к версии хранилища
Перем Комментарий Экспорт;
// Реальные метки: массив структур Имя, Комментарий, Дата, Пользователь, НомерВерсии.
// info/code (Версия) и комментарий помещения не являются метками.
Перем Метки Экспорт;
// Данные файла конфигурации
Перем Данные Экспорт;

Процедура ПриСозданииОбъекта()
 Метки = Новый Массив;
КонецПроцедуры

// Повторяющийся label превращает весь second в массив одноимённых фрагментов
// xml-parser. При одном label или без меток second остаётся соответствием.
Функция УзлыИстории(ВходящиеДанные, ИмяУзла)
 Результат = Новый Массив;
 Если ТипЗнч(ВходящиеДанные) = Тип("Массив") Тогда
  Для Каждого Фрагмент Из ВходящиеДанные Цикл
   Для Каждого Узел Из УзлыИстории(Фрагмент, ИмяУзла) Цикл Результат.Добавить(Узел); КонецЦикла;
  КонецЦикла;
 Иначе
  Для Каждого Пара Из ВходящиеДанные Цикл
   Если Пара.Ключ <> ИмяУзла Тогда Продолжить; КонецЕсли;
   Если ТипЗнч(Пара.Значение) = Тип("Массив") Тогда
    Для Каждого Узел Из Пара.Значение Цикл Результат.Добавить(Узел); КонецЦикла;
   Иначе Результат.Добавить(Пара.Значение);
   КонецЕсли;
  КонецЦикла;
 КонецЕсли;
 Возврат Результат;
КонецФункции

// Заполняет объект на основе входящих данных
//
// Параметры:
//   ВходящиеДанные - Соответствие - результат разбора XML с помощью библиотеки xmp-parser
//
Процедура Заполнить(ВходящиеДанные) Экспорт
	
 Метки = Новый Массив;
 УзлыИнформации = УзлыИстории(ВходящиеДанные, "info");
 Если УзлыИнформации.Количество() <> 1 Тогда ВызватьИсключение "В записи истории нужен один элемент info версии."; КонецЕсли;
	info = УзлыИнформации[0];

	Идентификатор    = Вспомогательный.ЗначениеСвойства(info, "versionID");
	Номер            = Число(Вспомогательный.ЗначениеСвойства(info, "verNum"));
	Дата             = Вспомогательный.ВычислитьДату(Вспомогательный.ЗначениеСвойства(info, "date"));
	Пользователь     = Вспомогательный.ЗначениеСвойства(info, "userID");
	Версия           = Вспомогательный.ЗначениеСвойства(info, "code");
	ВнутренняяВерсия = СтрШаблон("%1.%2",
	                             Вспомогательный.ЗначениеСвойства(info, "cvermajor"),
	                             Вспомогательный.ЗначениеСвойства(info, "cverminor"));
	Версия1С         = СтрШаблон("%1.%2.%3.%4",
	                             Вспомогательный.ЗначениеСвойства(info, "pvermajor"),
	                             Вспомогательный.ЗначениеСвойства(info, "pverminor"),
	                             Вспомогательный.ЗначениеСвойства(info, "pverbuild"),
	                             Вспомогательный.ЗначениеСвойства(info, "pverrevis"));
	Комментарий      = info["comment"];
	Данные           = info["file"];

 Для Каждого УзелМетки Из УзлыИстории(ВходящиеДанные, "label") Цикл
  КомментарийМетки = УзелМетки["comment"];
  Если КомментарийМетки = Неопределено Тогда КомментарийМетки = ""; КонецЕсли;
  Метки.Добавить(Новый Структура("Имя,Комментарий,Дата,Пользователь,НомерВерсии",
   Вспомогательный.ЗначениеСвойства(УзелМетки, "name"), КомментарийМетки,
   Вспомогательный.ВычислитьДату(Вспомогательный.ЗначениеСвойства(УзелМетки, "date")),
   Вспомогательный.ЗначениеСвойства(УзелМетки, "userID"),
   Число(Вспомогательный.ЗначениеСвойства(УзелМетки, "verNum"))));
 КонецЦикла;

КонецПроцедуры
