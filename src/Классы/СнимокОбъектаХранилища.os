// ОбъектХранилища - описание запрошенного объекта.
Перем Объект Экспорт;
// ДвоичныеДанные - содержимое объекта в формате сервера (raw DEFLATE).
Перем Данные Экспорт;
// Строка - сериализованные метаданные снимка, полученные от сервера.
Перем Метаданные Экспорт;
// ДвоичныеДанные - полный пакет snapshots/data, включая дополнительные данные.
Перем ПакетСнимков Экспорт;
// Строка - UUID версии хранилища, использованный для запроса.
Перем ВерсияХранилища Экспорт;

// Разбирает пары «описание, содержимое» пакета снимков 8.5.4.
// Остальные разделы пакета сохраняются без преобразования в ПакетСнимков.
Процедура Заполнить(Пакет, ОписаниеОбъекта, ИдентификаторВерсии) Экспорт
	Буфер = ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(Пакет);
	Если Буфер.Размер < 12 Или ПрочитатьЧисло(Буфер, 0, 4) <> 287454020
		Или ПрочитатьЧисло(Буфер, 4, 4) <> 2 Или ПрочитатьЧисло(Буфер, 8, 4) <> 3 Тогда
		ВызватьИсключение "Неподдерживаемый формат пакета снимков объекта.";
	КонецЕсли;
	Позиция = 12;
	Найден = Ложь;
	Пока Позиция < Буфер.Размер Цикл
		Описание = ПрочитатьЗапись(Буфер, Позиция);
		Текст = ПолучитьСтрокуИзБуфераДвоичныхДанных(Описание, КодировкаТекста.UTF8);
		Если Лев(Текст, 1) = Символ(65279) Тогда
			Текст = Сред(Текст, 2);
		КонецЕсли;
		Если Лев(Текст, 3) <> "{5," Тогда
			// Завершение списка объектов: далее находятся индексы и дополнительные данные.
			Прервать;
		КонецЕсли;
		Поля = СтрРазделить(Текст, ",");
		Если Поля.Количество() < 7 Тогда
			ВызватьИсключение "Повреждено описание объекта в пакете снимков.";
		КонецЕсли;
		Содержимое = ПрочитатьЗапись(Буфер, Позиция);
		Если НРег(Поля[1]) = НРег(Строка(ОписаниеОбъекта.Идентификатор)) Тогда
			Если Найден Или Содержимое.Размер = 0 Тогда
				ВызватьИсключение "Пустое или повторное содержимое объекта в пакете снимков.";
			КонецЕсли;
			Если НРег(Поля[2]) <> НРег(Строка(ОписаниеОбъекта.ИдентификаторКласса))
				Или Число(Поля[5]) <> ОписаниеОбъекта.НомерВерсии
				Или Число(Поля[6]) <> ОписаниеОбъекта.НомерСобственнойВерсии Тогда
				ВызватьИсключение "Снимок не соответствует классу или версии запрошенного объекта.";
			КонецЕсли;
			Объект = ОписаниеОбъекта;
			Метаданные = Текст;
			Данные = ПолучитьДвоичныеДанныеИзБуфераДвоичныхДанных(Содержимое);
			Найден = Истина;
		КонецЕсли;
	КонецЦикла;
	Если Не Найден Тогда
		ВызватьИсключение "Сервер не вернул снимок запрошенного объекта.";
	КонецЕсли;
	ПакетСнимков = Пакет;
	ВерсияХранилища = ИдентификаторВерсии;
КонецПроцедуры

Функция ПрочитатьЧисло(Буфер, Позиция, Количество)
	Если Позиция < 0 Или Позиция + Количество > Буфер.Размер Тогда
		ВызватьИсключение "Обрезан пакет снимков объекта.";
	КонецЕсли;
	Результат = 0;
	Множитель = 1;
	Для Индекс = 0 По Количество - 1 Цикл
		Результат = Результат + Буфер[Позиция + Индекс] * Множитель;
		Множитель = Множитель * 256;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ПрочитатьЗапись(Буфер, Позиция)
	Размер = ПрочитатьЧисло(Буфер, Позиция, 8);
	Позиция = Позиция + 8;
	Если Размер > Буфер.Размер - Позиция Тогда
		ВызватьИсключение "Неверная длина записи в пакете снимков объекта.";
	КонецЕсли;
	Результат = Буфер.Прочитать(Позиция, Размер);
	Позиция = Позиция + Размер;
	Возврат Результат;
КонецФункции
