#Использовать ".."

Функция Значение(Узел, Имя, ПоУмолчанию = Неопределено)
 Результат = Неопределено;
 Если Узел.Свойство(Имя, Результат) Тогда Возврат Результат; КонецЕсли;
 Возврат ПоУмолчанию;
КонецФункции

Процедура Записать(Путь, Данные)
 Запись = Новый ЗаписьJSON; Запись.ОткрытьФайл(Путь); ЗаписатьJSON(Запись, Данные); Запись.Закрыть();
КонецПроцедуры

Функция Описание(Объект)
 Возврат Новый Структура("id,class_id,name,parent_id,owner_id,version,own_version,deleted", НРег(Строка(Объект.Идентификатор)), НРег(Строка(Объект.ИдентификаторКласса)), Объект.Имя, НРег(Строка(Объект.ИдентификаторРодителя)), НРег(Строка(Объект.ИдентификаторВладельца)), Объект.НомерВерсии, Объект.НомерСобственнойВерсии, Объект.Удален);
КонецФункции

Функция Описания(Клиент)
 Идентификаторы = Новый Массив;
 Для Каждого Пара Из Клиент.ПолучитьСостоянияОбъектов() Цикл Идентификаторы.Добавить(Пара.Ключ); КонецЦикла;
 Возврат Клиент.ПолучитьОписанияОбъектов(Идентификаторы);
КонецФункции

Функция Роль(Имя)
 Если Имя = "read_only" Тогда Возврат РолиХранилища.ТолькоПросмотр;
 ИначеЕсли Имя = "developer" Тогда Возврат РолиХранилища.Разработчик;
 ИначеЕсли Имя = "developer_extended" Тогда Возврат РолиХранилища.РазработчикРасширенный;
 ИначеЕсли Имя = "admin" Тогда Возврат РолиХранилища.Администратор;
 КонецЕсли;
 ВызватьИсключение "Unsupported role";
КонецФункции

Функция ПользовательJSON(Пользователь)
 ИмяРоли = "unknown";
 Для Каждого Имя Из СтрРазделить("read_only,developer,developer_extended,admin", ",") Цикл
  Если Строка(Пользователь.Роль) = Роль(Имя) Тогда ИмяРоли = Имя; КонецЕсли;
 КонецЦикла;
 Если Строка(Пользователь.Роль) = "65535" Тогда ИмяРоли = "admin"; КонецЕсли;
 Возврат Новый Структура("id,name,role,rights,deleted", НРег(Строка(Пользователь.Идентификатор)), Пользователь.Имя, ИмяРоли, Строка(Пользователь.Роль), Пользователь.Удален);
КонецФункции

Функция Пользователи(Клиент, Действие, Параметры, КодОшибки)
 Все = Клиент.СписокПользователей(); Список = Новый Массив; Текущий = Неопределено;
 Для Каждого Пользователь Из Все Цикл
  Список.Добавить(ПользовательJSON(Пользователь));
  Если НРег(Строка(Пользователь.Идентификатор)) = Значение(Параметры, "user_id", "") Тогда Текущий = Пользователь; КонецЕсли;
 КонецЦикла;
 Если Действие = "users.list" Тогда Возврат Новый Структура("users", Список); КонецЕсли;
 Операция = Параметры.operation;
 Если Операция <> "create" И Текущий = Неопределено Тогда КодОшибки = "user_not_found"; ВызватьИсключение "User not found"; КонецЕсли;
 До = Неопределено;
 Если Текущий <> Неопределено Тогда До = ПользовательJSON(Текущий); КонецЕсли;
 Если Операция = "create" Тогда После = Новый Структура("name,role,rights,deleted", Параметры.name, Параметры.role, Роль(Параметры.role), Ложь);
 Иначе После = Новый Структура("id,name,role,rights,deleted", До.id, Значение(Параметры, "name", До.name), Значение(Параметры, "role", До.role), До.rights, До.deleted);
 КонецЕсли;
 Если Значение(Параметры, "role") <> Неопределено Тогда После.rights = Роль(Параметры.role); КонецЕсли;
 Если Операция = "delete" Тогда После.deleted = Истина; ИначеЕсли Операция = "restore" Тогда После.deleted = Ложь; КонецЕсли;
 Если Операция = "update" И До.deleted Тогда КодОшибки = "user_conflict"; ВызватьИсключение "Restore user first"; КонецЕсли;
 Для Каждого Пользователь Из Все Цикл
  Если НРег(Пользователь.Имя) = НРег(После.name) И (Текущий = Неопределено Или Пользователь.Идентификатор <> Текущий.Идентификатор) Тогда
   КодОшибки = "user_exists"; ВызватьИсключение "Duplicate user";
  КонецЕсли;
 КонецЦикла;
 МенятьПароль = Значение(Параметры, "password_env") <> Неопределено;
 Если Действие = "users.plan" Тогда Возврат Новый Структура("operation,before,after,password_change,executed", Операция, До, После, МенятьПароль, Ложь); КонецЕсли;
 Если Значение(Параметры, "execute", Ложь) <> Истина Тогда ВызватьИсключение "Explicit execution required"; КонецЕсли;
 Если Операция <> "create" Тогда
  Ожидание = Параметры.expected;
  Если Ожидание.id <> До.id Или Ожидание.name <> До.name Или Ожидание.role <> До.role Или Ожидание.rights <> До.rights Или Ожидание.deleted <> До.deleted Тогда КодОшибки = "user_conflict"; ВызватьИсключение "Concurrent user change"; КонецЕсли;
 КонецЕсли;
 Пароль = Неопределено;
 Если МенятьПароль Тогда Пароль = ПолучитьПеременнуюСреды(Параметры.password_env); Если Пароль = Неопределено Тогда ВызватьИсключение "Missing password variable"; КонецЕсли; КонецЕсли;
 КодОшибки = "outcome_unknown";
 Если Операция = "create" Тогда Клиент.СоздатьПользователя(После.name, Пароль, Роль(После.role));
 ИначеЕсли Операция = "update" Тогда
  Текущий.Имя = После.name; Текущий.Роль = После.rights; Текущий.Пароль = Пароль; Клиент.ОбновитьПользователяХранилища(Текущий);
 ИначеЕсли Операция = "delete" Тогда Клиент.УдалитьПользователя(Параметры.user_id);
 ИначеЕсли Операция = "restore" Тогда Клиент.ВосстановитьПользователя(Параметры.user_id);
 КонецЕсли;
 Для Каждого Пользователь Из Клиент.СписокПользователей() Цикл
  Данные = ПользовательJSON(Пользователь);
  Если Данные.name = После.name И (Операция = "create" Или Данные.id = После.id) Тогда
   Если Данные.rights <> После.rights Или Данные.deleted <> После.deleted Тогда ВызватьИсключение "User postcondition failed"; КонецЕсли;
   Если МенятьПароль И НРег(Строка(Пользователь.ХешПароля)) <> Вспомогательный.ХешированныйПароль(Пароль) Тогда ВызватьИсключение "Password postcondition failed"; КонецЕсли;
   Возврат Новый Структура("operation,user,executed,password_changed", Операция, Данные, Истина, МенятьПароль);
  КонецЕсли;
 КонецЦикла;
 ВызватьИсключение "User postcondition missing";
КонецФункции

Функция ПрочитатьОбъект(Клиент, Параметры, Подключение)
 Версия = Клиент.ПолучитьВерсиюХранилища();
 Снимки = Новый Массив; Имена = Новый Соответствие; КонтекстНедоступен = Ложь;
 Если Параметры.format = "native" Тогда
  Объект = Клиент.ПолучитьОписаниеОбъекта(Параметры.object_id);
  Снимки.Добавить(Base64Строка(Клиент.ПолучитьИсторическийОбъект(Объект, Подключение.python).ПакетСнимков));
 Иначе
  Все = Описания(Клиент); Объект = Все.Получить(Параметры.object_id);
  Если Объект = Неопределено Тогда ВызватьИсключение "Object not found"; КонецЕсли;
  Для Каждого Пара Из Все Цикл
   СтрокаОписания = Описание(Пара.Значение);
   Имена.Вставить(Пара.Ключ, Новый Структура("class_id,parent_id,name", СтрокаОписания.class_id, СтрокаОписания.parent_id, СтрокаОписания.name));
  КонецЦикла;
  Очередь = Новый Массив; Очередь.Добавить(Параметры.object_id); Добавлены = Новый Соответствие; Дочерние = Новый Соответствие; Дочерние.Вставить(Параметры.object_id, Истина); Индекс = 0;
  Пока Индекс < Очередь.Количество() Цикл
   Ид = Очередь[Индекс]; Индекс = Индекс + 1;
   Если Добавлены.Получить(Ид) <> Неопределено Тогда Продолжить; КонецЕсли;
   Если Добавлены.Количество() >= 256 Тогда КонтекстНедоступен = Истина; Прервать; КонецЕсли;
   ОписаниеУзла = Все.Получить(Ид); Если ОписаниеУзла = Неопределено Тогда ВызватьИсключение "Missing ancestor"; КонецЕсли;
   Снимок = Клиент.ПолучитьИсторическийОбъект(ОписаниеУзла, Подключение.python); Снимки.Добавить(Base64Строка(Снимок.ПакетСнимков)); Добавлены.Вставить(Ид, Истина);
   Родитель = НРег(Строка(ОписаниеУзла.ИдентификаторРодителя));
   Если Родитель <> "00000000-0000-0000-0000-000000000000" Тогда Очередь.Добавить(Родитель); КонецЕсли;
   Попытка План = СериализаторОбъектаХранилища.КонтекстЧитаемогоСнимка(Снимок, Подключение.platform, Подключение.python);
   Исключение КонтекстНедоступен = Истина; Прервать; КонецПопытки;
   Для Каждого Ссылка Из План.references Цикл Если Все.Получить(Ссылка) <> Неопределено Тогда Очередь.Добавить(Ссылка); КонецЕсли; КонецЦикла;
   Если Родитель <> "00000000-0000-0000-0000-000000000000" И Дочерние.Получить(Ид) <> Неопределено Тогда
    Для Каждого Коллекция Из План.collections Цикл Для Каждого Ребенок Из Коллекция.ids Цикл Дочерние.Вставить(Ребенок, Истина); Очередь.Добавить(Ребенок); КонецЦикла; КонецЦикла;
   КонецЕсли;
  КонецЦикла;
 КонецЕсли;
 Если Клиент.ПолучитьВерсиюХранилища() <> Версия Тогда ВызватьИсключение "Repository changed during read"; КонецЕсли;
 Возврат Новый Структура("description,repository_version,snapshots,descriptions,context_unavailable", Описание(Объект), Версия, Снимки, Имена, КонтекстНедоступен);
КонецФункции

Функция ВыполнитьЗапрос(Запрос, КодОшибки)
 Действие = Запрос.action; Параметры = Запрос.params; Подключение = Запрос.connection;
 Если Действие = "commit.execute" Тогда КодОшибки = "outcome_unknown"; КонецЕсли;
 Клиент = Новый КлиентХранилища(Подключение.url, Подключение.platform);
 Пароль = ПолучитьПеременнуюСреды(Подключение.password_env); Если Пароль = Неопределено Тогда ВызватьИсключение "Missing credentials"; КонецЕсли;
 Клиент.Подключиться(Подключение.username, Пароль, Значение(Подключение, "repository"));
 Если Не Клиент.АвторизацияПройдена() Тогда КодОшибки = "authentication_failed"; ВызватьИсключение "Authentication failed"; КонецЕсли;
 Если Лев(Действие, 7) = "commit." Тогда Возврат ПомещениеАгента.Обработать(Клиент, Действие, Параметры, Подключение); КонецЕсли;
 Если Действие = "connect" Тогда Возврат Новый Структура("connected,repository_version,platform", Истина, Клиент.ПолучитьВерсиюХранилища(), Подключение.platform); КонецЕсли;
 Если Лев(Действие, 6) = "users." Тогда Возврат Пользователи(Клиент, Действие, Параметры, КодОшибки); КонецЕсли;
 Если Действие = "objects.read" Тогда Возврат ПрочитатьОбъект(Клиент, Параметры, Подключение); КонецЕсли;
 Если Действие = "objects.search" Тогда
  Версия = Клиент.ПолучитьВерсиюХранилища(); Список = Новый Массив;
  Для Каждого Пара Из Описания(Клиент) Цикл Список.Добавить(Описание(Пара.Значение)); КонецЦикла;
  Если Клиент.ПолучитьВерсиюХранилища() <> Версия Тогда ВызватьИсключение "Repository changed during search"; КонецЕсли;
  Возврат Новый Структура("objects,repository_version", Список, Версия);
 КонецЕсли;
 Если Действие = "modules.prepare" Тогда
  Объект = Клиент.ПолучитьОписаниеОбъекта(Параметры.object_id); Отчет = Неопределено;
  НастройкиМодуля = Новый Структура("backend,executable", "ibcmd", Подключение.ibcmd);
  Пакет = Клиент.ПодготовитьМодульОбъекта(Объект, Параметры.module_path, Параметры.module_text, НастройкиМодуля, Подключение.python, Отчет, Параметры.expected_source_sha256);
  ПутьПакета = ОбъединитьПути(Параметры.output_directory, "packet.bin");
  Если Пакет <> Неопределено Тогда Пакет.Данные.Записать(ПутьПакета); Иначе ПутьПакета = Неопределено; КонецЕсли;
  Если Пакет <> Неопределено Тогда ПомещениеАгента.СохранитьПакет(Клиент, Пакет, Параметры.output_directory, Подключение); КонецЕсли;
  Возврат Новый Структура("plan,packet_file,has_changes,captured,committed", Отчет, ПутьПакета, Пакет <> Неопределено, Ложь, Ложь);
 КонецЕсли;
 Настройки = Новый Структура("backend,executable,cache_directory,use_git", "ibcmd", Подключение.ibcmd, Подключение.cache_directory, Ложь);
 Если Действие = "workspace.init" Тогда
  РазрешитьЧастичную = Ложь; Параметры.Свойство("allow_partial", РазрешитьЧастичную);
  Возврат Клиент.ИнициализироватьОснову(Настройки, Параметры.directory, Подключение.python, РазрешитьЧастичную);
 КонецЕсли;
 Если Действие = "changes.prepare" Тогда
  База = Значение(Параметры, "baseline_directory");
  Если База = Неопределено Тогда База = СериализаторОбъектаХранилища.ОсноваКонфигурации(Новый Структура("mode,cache_directory", "read", Подключение.cache_directory), Подключение.python).baseline_directory; КонецЕсли;
  ПланДо = Клиент.ПланИзмененийКонфигурацииИзВыгрузки(Параметры.directory, База, Подключение.python);
  Пакет = Клиент.ПодготовитьКонфигурациюИзВыгрузки(Параметры.directory, Значение(Параметры, "baseline_directory"), Подключение.python, Настройки);
  План = Клиент.ПланИзмененийКонфигурацииИзВыгрузки(Параметры.directory, База, Подключение.python);
  Если ПланДо.target_fingerprint <> План.target_fingerprint Или ПланДо.baseline_fingerprint <> План.baseline_fingerprint Или ПланДо.repository_version <> План.repository_version Тогда ВызватьИсключение "Sources changed during preparation"; КонецЕсли;
  ПутьПакета = ОбъединитьПути(Параметры.output_directory, "packet.bin");
  Если Пакет <> Неопределено Тогда Пакет.Данные.Записать(ПутьПакета); Иначе ПутьПакета = Неопределено; КонецЕсли;
  Если Пакет <> Неопределено Тогда ПомещениеАгента.СохранитьПакет(Клиент, Пакет, Параметры.output_directory, Подключение); КонецЕсли;
  Возврат Новый Структура("plan,packet_file,baseline_directory,has_changes,captured,committed", План, ПутьПакета, База, Пакет <> Неопределено, Ложь, Ложь);
 КонецЕсли;
 ВызватьИсключение "Unsupported action";
КонецФункции

КодОшибки = "backend_error";
Попытка
 Чтение = Новый ЧтениеJSON; Чтение.ОткрытьФайл(АргументыКоманднойСтроки[0]); Запрос = ПрочитатьJSON(Чтение); Чтение.Закрыть();
 Результат = ВыполнитьЗапрос(Запрос, КодОшибки); Записать(АргументыКоманднойСтроки[1], Новый Структура("ok,result", Истина, Результат));
Исключение
 // Server errors may contain user XML and password hashes. Never serialize them.
 Записать(АргументыКоманднойСтроки[1], Новый Структура("ok,error", Ложь, Новый Структура("code", КодОшибки)));
 ЗавершитьРаботу(1);
КонецПопытки;
