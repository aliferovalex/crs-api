#Использовать 1connector

// XML и ответы CRS одинаковы для обоих транспортов. Каждый TCP-запрос
// использует отдельное соединение; повторной отправки при ошибке нет.
Функция Отправить(Знач Адрес, Знач Тело) Экспорт
 Данные = ПолучитьДвоичныеДанныеИзСтроки(Тело, КодировкаТекста.UTF8, Ложь);
 ПроверитьРазмерСообщения(Данные.Размер());
	Если НРег(Лев(Адрес, 6)) = "tcp://" Тогда
		Возврат ОтправитьTCP(Адрес, Данные);
	КонецЕсли;
	Возврат КоннекторHTTP.Post(Адрес, Тело);
КонецФункции

Функция МаксимальныйРазмерСообщения() Экспорт
 Возврат 256 * 1024 * 1024;
КонецФункции

Процедура ПроверитьРазмерСообщения(Знач Размер) Экспорт
 Если Размер < 0 Или Размер > МаксимальныйРазмерСообщения() Тогда ВызватьИсключение "Слишком большое сообщение хранилища: предел 256 МиБ с учётом XML и base64."; КонецЕсли;
КонецПроцедуры

Функция ПараметрыTCP(Знач Адрес) Экспорт
	Если НРег(Лев(Адрес, 6)) <> "tcp://" Тогда ВызватьИсключение "Ожидается адрес tcp://сервер:порт."; КонецЕсли;
	Выражение = Новый РегулярноеВыражение("^(\[[0-9a-fA-F:.]+\]|[^:/\s?#@]+)(?::([0-9]{1,5}))?(?:/([^\s?#]*))?$");
	Совпадения = Выражение.НайтиСовпадения(Сред(Адрес, 7));
	Если Совпадения.Количество() <> 1 Тогда ВызватьИсключение "Некорректный TCP-адрес хранилища."; КонецЕсли;
	Группы = Совпадения[0].Группы;
	Хост = Группы[1].Значение;
	Если Лев(Хост, 1) = "[" Тогда Хост = Сред(Хост, 2, СтрДлина(Хост) - 2); КонецЕсли;
	Порт = ?(ПустаяСтрока(Группы[2].Значение), 1542, Число(Группы[2].Значение));
	Если Порт < 1 Или Порт > 65535 Тогда ВызватьИсключение "TCP-порт должен быть от 1 до 65535."; КонецЕсли;
	Имя = Группы[3].Значение;
	Если СтрНайти(Имя, """") > 0 Или СтрНайти(Имя, "<") > 0 Или СтрНайти(Имя, "&") > 0 Тогда
		ВызватьИсключение "Некорректное имя хранилища в TCP-адресе.";
	КонецЕсли;
	Возврат Новый Структура("Хост,Порт,ИмяХранилища", Хост, Порт, Имя);
КонецФункции

Процедура ОбеспечитьБуфер(Чтение)
	Если Чтение.Позиция < Чтение.Буфер.Размер Тогда Возврат; КонецЕсли;
	// OneScript 1.8.2 зависает при ограниченном чтении, если в сокете
	// доступно больше указанного числа байтов. Читаем доступный блок целиком.
	Часть = Чтение.Соединение.ПрочитатьДвоичныеДанные();
	Если Часть.Размер() = 0 Тогда ВызватьИсключение "TCP-сервер закрыл соединение до конца ответа."; КонецЕсли;
	Если Часть.Размер() > 268500992 Тогда ВызватьИсключение "Слишком большой блок TCP-ответа."; КонецЕсли;
	Чтение.Буфер = ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(Часть);
	Чтение.Позиция = 0;
КонецПроцедуры

Функция ПрочитатьТочно(Чтение, Размер)
	Поток = Новый ПотокВПамяти;
	Осталось = Размер;
	Пока Осталось > 0 Цикл
		ОбеспечитьБуфер(Чтение);
		Длина = Мин(Осталось, Чтение.Буфер.Размер - Чтение.Позиция);
		Поток.Записать(Чтение.Буфер, Чтение.Позиция, Длина);
		Чтение.Позиция = Чтение.Позиция + Длина;
		Осталось = Осталось - Длина;
	КонецЦикла;
	Возврат Поток.ЗакрытьИПолучитьДвоичныеДанные();
КонецФункции

Функция ПрочитатьЗаголовок(Чтение)
	Заголовок = "";
	КонецЗаголовка = Символы.ВК + Символы.ПС + Символы.ВК + Символы.ПС;
	Пока Прав(Заголовок, 4) <> КонецЗаголовка Цикл
		Если СтрДлина(Заголовок) >= 65536 Тогда ВызватьИсключение "Слишком большой заголовок TCP-ответа."; КонецЕсли;
		ОбеспечитьБуфер(Чтение);
		Заголовок = Заголовок + Символ(Чтение.Буфер[Чтение.Позиция]);
		Чтение.Позиция = Чтение.Позиция + 1;
	КонецЦикла;
	Возврат Заголовок;
КонецФункции

Функция РазобратьЗаголовок(Знач Заголовок) Экспорт
	Строки = СтрРазделить(СтрЗаменить(Заголовок, Символы.ВК, ""), Символы.ПС, Ложь);
	Если Строки.Количество() = 0 Тогда ВызватьИсключение "Пустой заголовок TCP-ответа."; КонецЕсли;
	Коды = Новый РегулярноеВыражение("^HTTP/1\.[01] ([0-9]{3})(?: .*)?$");
	Совпадения = Коды.НайтиСовпадения(Строки[0]);
	Если Совпадения.Количество() <> 1 Тогда ВызватьИсключение "Некорректный заголовок TCP-ответа."; КонецЕсли;
	Код = Число(Совпадения[0].Группы[1].Значение);
	Длина = Неопределено;
	Для Индекс = 1 По Строки.Количество() - 1 Цикл
		СтрокаЗаголовка = Строки[Индекс];
		Если ПустаяСтрока(СтрокаЗаголовка) Тогда Продолжить; КонецЕсли;
		Двоеточие = СтрНайти(СтрокаЗаголовка, ":");
		Если Двоеточие = 0 Тогда ВызватьИсключение "Некорректное поле TCP-заголовка."; КонецЕсли;
		Имя = НРег(СокрЛП(Лев(СтрокаЗаголовка, Двоеточие - 1)));
		Значение = СокрЛП(Сред(СтрокаЗаголовка, Двоеточие + 1));
		Если Имя = "content-length" Тогда
			Цифры = Новый РегулярноеВыражение("^[0-9]{1,10}$");
			Если Длина <> Неопределено Или Цифры.НайтиСовпадения(Значение).Количество() <> 1 Тогда
				ВызватьИсключение "Некорректный Content-Length TCP-ответа.";
			КонецЕсли;
			Длина = Число(Значение);
		ИначеЕсли Имя = "transfer-encoding" Или Имя = "content-encoding" И НРег(Значение) <> "identity" Тогда
			ВызватьИсключение "Неподдерживаемая кодировка TCP-ответа.";
		КонецЕсли;
	КонецЦикла;
	Если Длина = Неопределено Тогда ВызватьИсключение "TCP-ответ не содержит Content-Length."; КонецЕсли;
	ПроверитьРазмерСообщения(Длина);
	Возврат Новый Структура("Код,Длина", Код, Длина);
КонецФункции

Функция ОтправитьTCP(Адрес, Данные)
	Параметры = ПараметрыTCP(Адрес);
	Соединение = Новый TCPСоединение(Параметры.Хост, Параметры.Порт);
	Чтение = Новый Структура("Соединение,Буфер,Позиция", Соединение, Новый БуферДвоичныхДанных(0), 0);
	Попытка
		Соединение.ТаймаутЧтения = 60000;
		Соединение.ТаймаутОтправки = 60000;
		Если ПолучитьHexСтрокуИзДвоичныхДанных(ПрочитатьТочно(Чтение, 5)) <> "53F5C61A7B" Тогда
			ВызватьИсключение "Неизвестное приветствие TCP-сервера хранилища.";
		КонецЕсли;
		Перенос = Символы.ВК + Символы.ПС;
		Заголовок = "POST / HTTP/1.1" + Перенос + "Content-Type: application/xml" + Перенос
			+ "Content-Length: " + Формат(Данные.Размер(), "ЧГ=0") + Перенос + Перенос;
		Соединение.ОтправитьДвоичныеДанные(ПолучитьДвоичныеДанныеИзСтроки(Заголовок, КодировкаТекста.UTF8, Ложь));
		Соединение.ОтправитьДвоичныеДанные(Данные);
		Соединение.ОтправитьДвоичныеДанные(ПолучитьДвоичныеДанныеИзHexСтроки("6653B2A6"));
		Поля = РазобратьЗаголовок(ПрочитатьЗаголовок(Чтение));
		ТелоОтвета = ПрочитатьТочно(Чтение, Поля.Длина);
		Если ПолучитьHexСтрокуИзДвоичныхДанных(ПрочитатьТочно(Чтение, 4)) <> "6653B2A6" Тогда
			ВызватьИсключение "Повреждён конец TCP-ответа хранилища.";
		КонецЕсли;
		Ответ = Новый ОтветТранспортаХранилища(Поля.Код, ТелоОтвета);
	Исключение
		Соединение.Закрыть();
		ВызватьИсключение;
	КонецПопытки;
	Соединение.Закрыть();
	Возврат Ответ;
КонецФункции
