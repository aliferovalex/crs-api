// Общий справочник UUID для OneScript и Python. Значения возвращаются строками.
Перем Справочник;

Функция КлассКонфигурации() Экспорт
	Возврат ИдентификаторКласса("Configuration");
КонецФункции

Функция КлассКонстанты() Экспорт
	Возврат ИдентификаторКласса("Constant");
КонецФункции

Функция КлассЯзыка() Экспорт
	Возврат ИдентификаторКласса("Language");
КонецФункции

Функция ИдентификаторКласса(Знач ИмяКласса) Экспорт
	Для Каждого Запись Из ПолучитьСправочник().Получить("names") Цикл
		Если Запись.Значение = ИмяКласса Тогда Возврат Запись.Ключ; КонецЕсли;
	КонецЦикла;
	ВызватьИсключение "Неизвестный класс метаданных: " + Строка(ИмяКласса);
КонецФункции

Функция ИдентификаторГруппы(Знач ИмяГруппы) Экспорт
	Возврат ПолучитьИдентификатор("groups", ИмяГруппы);
КонецФункции

Функция ИдентификаторПризнака(Знач ИмяПризнака) Экспорт
	Возврат ПолучитьИдентификатор("features", ИмяПризнака);
КонецФункции

Функция ПолучитьИдентификатор(Раздел, Имя)
	Значение = ПолучитьСправочник().Получить(Раздел).Получить(Имя);
	Если Значение = Неопределено Тогда
		ВызватьИсключение "Неизвестный идентификатор метаданных: " + Строка(Имя);
	КонецЕсли;
	Возврат Значение;
КонецФункции

Функция ПолучитьСправочник()
	Если Справочник = Неопределено Тогда
		Путь = ОбъединитьПути(ТекущийСценарий().Каталог, "..", "Сериализация", "metadata_class_names.json");
		Чтение = Новый ЧтениеJSON;
		Чтение.ОткрытьФайл(Путь);
		Попытка
			Данные = ПрочитатьJSON(Чтение, Истина);
		Исключение
			Чтение.Закрыть();
			ВызватьИсключение;
		КонецПопытки;
		Чтение.Закрыть();
		Справочник = Данные;
	КонецЕсли;
	Возврат Справочник;
КонецФункции
