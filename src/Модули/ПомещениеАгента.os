// MCP/CLI glue: immutable artifacts, existing capture lifecycle, one commit.
Функция Значение(Узел, Имя, ПоУмолчанию = Неопределено)
 Результат = Неопределено; Если Узел.Свойство(Имя, Результат) Тогда Возврат Результат; КонецЕсли;
 Возврат ПоУмолчанию;
КонецФункции

Функция Хеш(Данные)
 Вычисление = Новый ХешированиеДанных(ХешФункция.SHA256); Вычисление.Добавить(Данные);
 Возврат НРег(ПолучитьHexСтрокуИзДвоичныхДанных(Вычисление.ХешСумма));
КонецФункции

Функция ПрочитатьОдобренныйJSON(Путь, ОжидаемыйХеш)
 Данные = Новый ДвоичныеДанные(Путь);
 Если Хеш(Данные) <> ОжидаемыйХеш Тогда ВызватьИсключение "Approved artifact changed"; КонецЕсли;
 Чтение = Новый ЧтениеJSON; Чтение.УстановитьСтроку(ПолучитьСтрокуИзДвоичныхДанных(Данные, КодировкаТекста.UTF8));
 Возврат ПрочитатьJSON(Чтение).data;
КонецФункции

Функция ОписаниеПакета(Объект)
 Возврат Новый Структура("id,class_id,name,pos,parent_id,owner_id,original,local,version,own_version,deleted", НРег(Строка(Объект.Идентификатор)), НРег(Строка(Объект.ИдентификаторКласса)), Объект.Имя, Объект.Позиция, НРег(Строка(Объект.ИдентификаторРодителя)), НРег(Строка(Объект.ИдентификаторВладельца)), НРег(Объект.ИсходнаяВерсия), НРег(Объект.ЛокальнаяВерсия), Объект.НомерВерсии, Объект.НомерСобственнойВерсии, Объект.Удален);
КонецФункции

Функция ОбъектИзОписания(Описание)
 Объект = ПравилаПакетовХранилища.ОписаниеОбъекта(Описание);
 Объект.НомерВерсии = Описание.version; Объект.НомерСобственнойВерсии = Описание.own_version; Объект.Удален = Описание.deleted;
 Возврат Объект;
КонецФункции

Функция СохранитьПакет(Клиент, Пакет, Каталог, Подключение) Экспорт
 Если Пакет.ПроверкаСодержимого = Неопределено Тогда ВызватьИсключение "Prepared packet has no readback proof"; КонецЕсли;
 Исходные = Новый Массив; Измененные = Новый Массив; Новые = Новый Массив; Удаленные = Новый Массив; Описания = Новый Массив; Запрошенные = Новый Массив;
 Для Каждого Объект Из Пакет.УдаляемыеОбъекты Цикл Удаленные.Добавить(НРег(Строка(Объект.Идентификатор))); КонецЦикла;
 Для Каждого Объект Из Пакет.НовыеОбъекты Цикл Новые.Добавить(НРег(Строка(Объект.Идентификатор))); КонецЦикла;
 Для Каждого Объект Из Пакет.СуществующиеОбъекты Цикл
  Исходные.Добавить(ОписаниеПакета(Объект)); Ид = НРег(Строка(Объект.Идентификатор));
  Если Удаленные.Найти(Ид) = Неопределено Тогда Измененные.Добавить(Ид); КонецЕсли;
 КонецЦикла;
 Для Каждого Объект Из Пакет.ОбъектыПакета Цикл Описания.Добавить(ОписаниеПакета(Объект)); КонецЦикла;
 Для Каждого Объект Из Пакет.ЗапрошенныеОбъекты Цикл Запрошенные.Добавить(ОписаниеПакета(Объект)); КонецЦикла;
 Данные = Новый Структура("repository_version,repository,platform,version_code,version_code_resolved,changed_ids,new_ids,removed_ids,descriptions,requested,externals,verification", Пакет.ВерсияХранилища, Пакет.ИмяХранилища, Пакет.ВерсияПлатформы, Пакет.КодВерсии, Пакет.КодВерсииОпределен, Измененные, Новые, Удаленные, Описания, Запрошенные, Пакет.ВнешниеДанные, Пакет.ПроверкаСодержимого);
 Привязка = Новый Структура("url,repository,platform,repository_id", Подключение.url, Пакет.ИмяХранилища, Пакет.ВерсияПлатформы, Клиент.ПолучитьИдентификаторХранилища(Подключение.python));
 Возврат СериализаторОбъектаХранилища.АртефактыПомещения(Новый Структура("mode,directory,binding,packet,sources,baseline_update", "save", Каталог, Привязка, Данные, Исходные, Пакет.КонтекстОбновленияОсновы), Подключение.python);
КонецФункции

Функция ЗагрузитьПакет(Параметры)
 Данные = ПрочитатьОдобренныйJSON(ОбъединитьПути(Параметры.prepared_directory, "prepared.json"), Параметры.prepared_sha256);
 ДвоичныйПакет = Новый ДвоичныеДанные(ОбъединитьПути(Параметры.prepared_directory, "packet.bin"));
 Если Хеш(ДвоичныйПакет) <> Данные.packet_sha256 Тогда ВызватьИсключение "Prepared packet changed"; КонецЕсли;
 Снимки = Новый Массив;
 Для Каждого Описание Из Данные.sources Цикл
  Снимок = Новый СнимокОбъектаХранилища; Снимок.Объект = ОбъектИзОписания(Описание); Снимок.ВерсияХранилища = Данные.packet.repository_version; Снимки.Добавить(Снимок);
 КонецЦикла;
 Пакет = Новый ПакетПомещенияОбъекта; Пакет.ЗаполнитьКонфигурацию(Данные.packet, Снимки, ДвоичныйПакет);
 Возврат Новый Структура("artifact,packet", Данные, Пакет);
КонецФункции

Функция ПроверитьИсточники(Клиент, Загружено, Подключение, Строго = Истина)
 Данные = Загружено.artifact; Пакет = Загружено.packet;
 Версия = Клиент.ПолучитьВерсиюХранилища(); Идентификатор = Клиент.ПолучитьИдентификаторХранилища(Подключение.python);
 Если Идентификатор <> Данные.binding.repository_id Тогда ВызватьИсключение "Repository identity changed"; КонецЕсли;
 Пользователь = Клиент.НайтиПользователя(Подключение.username);
 Если Пользователь = Неопределено Тогда ВызватьИсключение "Unknown commit user"; КонецЕсли;
 Состояния = Клиент.ПолучитьСостоянияОбъектов(); Иды = Новый Массив; Захваты = Новый Массив; Конфликты = Новый Массив; Наблюдаемые = Новый Массив;
 Для Каждого Описание Из Данные.sources Цикл
  Состояние = Состояния.Получить(Описание.id);
  Если Состояние = Неопределено Тогда Конфликты.Добавить(Описание.id); Продолжить; КонецЕсли;
  Иды.Добавить(Описание.id);
  Захваты.Добавить(Новый Структура("id,captured,user_id,date_token,version", Описание.id, Состояние.Захвачен, НРег(Строка(Состояние.Пользователь)), "@" + Строка(Состояние.ДатаЗахвата), Состояние.НомерВерсии));
  Если Строго И Состояние.Захвачен И НРег(Строка(Состояние.Пользователь)) <> НРег(Строка(Пользователь.Идентификатор)) Тогда Конфликты.Добавить(Описание.id); КонецЕсли;
 КонецЦикла;
 Описания = Новый Соответствие;
 Если Иды.Количество() > 0 Тогда Описания = Клиент.ПолучитьОписанияОбъектов(Иды); КонецЕсли;
 Для Каждого Описание Из Данные.sources Цикл
  Текущее = Описания.Получить(Описание.id); Если Текущее = Неопределено Тогда Продолжить; КонецЕсли;
  Видимое = ОписаниеПакета(Текущее); Наблюдаемые.Добавить(Видимое);
  Если Строго И (Видимое.original <> Описание.original Или Видимое.local <> Описание.local Или Видимое.version <> Описание.version Или Видимое.own_version <> Описание.own_version Или Видимое.class_id <> Описание.class_id Или Видимое.parent_id <> Описание.parent_id Или Видимое.owner_id <> Описание.owner_id Или Видимое.name <> Описание.name Или Видимое.pos <> Описание.pos) Тогда Конфликты.Добавить(Описание.id); КонецЕсли;
 КонецЦикла;
 Для Каждого Ид Из Данные.packet.new_ids Цикл Если Строго И Состояния.Получить(Ид) <> Неопределено Тогда Конфликты.Добавить(Ид); КонецЕсли; КонецЦикла;
 Если Строго И (Версия <> Данные.packet.repository_version Или Строка(Пользователь.Роль) = "0") Тогда Конфликты.Добавить("repository_version_or_permissions"); КонецЕсли;
 Код = Неопределено;
 Если Строго И Конфликты.Количество() = 0 Тогда Код = Клиент.КодВерсииДляПомещения(Пакет, Подключение.python); КонецЕсли;
 Если Клиент.ПолучитьВерсиюХранилища() <> Версия Тогда ВызватьИсключение "Repository changed during commit inspection"; КонецЕсли;
 Возврат Новый Структура("repository_id,user_id,configuration_version,captures,descriptions,ready,conflicts", Идентификатор, НРег(Строка(Пользователь.Идентификатор)), Код, Захваты, Наблюдаемые, Конфликты.Количество() = 0, Конфликты);
КонецФункции

Функция Исполнить(Клиент, Параметры, Подключение)
 План = ПрочитатьОдобренныйJSON(Параметры.plan_file, Параметры.plan_sha256);
 Загружено = ЗагрузитьПакет(План); Пакет = Загружено.packet;
 Результат = Новый Структура("committed,outcome_unknown,readback_verified,version,phase,operation_directory,label,baseline_updated,capture_cleanup", Ложь, Ложь, Ложь, Неопределено, "preflight_failed", План.operation_directory, План.label, Неопределено, Неопределено);
 Подготовка = Неопределено;
 Результат.Вставить("fully_completed", Ложь);
 Попытка
  Сейчас = ПроверитьИсточники(Клиент, Загружено, Подключение);
  Если Не Сейчас.ready Или Сейчас.user_id <> План.target.user_id Или Сейчас.configuration_version <> План.configuration_version Тогда ВызватьИсключение "Commit preflight changed"; КонецЕсли;
  Для Индекс = 0 По План.captures.Количество() - 1 Цикл
   До = План.captures[Индекс]; После = Сейчас.captures[Индекс];
   Если До.id <> После.id Или До.captured <> После.captured Или До.user_id <> После.user_id Или До.date_token <> После.date_token Тогда ВызватьИсключение "Capture state changed since approval"; КонецЕсли;
  КонецЦикла;
  Настройки = Новый Структура("kind,directory,plan_sha256,python", "commit", План.operation_directory, Параметры.plan_sha256, Подключение.python);
  Подготовка = Новый ПодготовкаПомещенияКонфигурации(Клиент, Сейчас.user_id, Неопределено, Настройки, Истина);
  Подготовка.УстановитьКонтекст(План.prepared_directory, План.prepared_directory, Пакет.ВерсияХранилища);
  Результат.phase = "capturing"; Подготовка.ЗахватитьОбъекты(Пакет.СуществующиеОбъекты); Подготовка.УстановитьПакет(Пакет);
  Пакет.КодВерсии = План.configuration_version; Пакет.КодВерсииОпределен = Истина;
  Результат.phase = "sending"; Помещенные = Подготовка.Поместить(План.comment);
  Если ТипЗнч(Помещенные) <> Тип("Массив") Тогда Массив = Новый Массив; Массив.Добавить(Помещенные); Помещенные = Массив; КонецЕсли;
  Результат.committed = Истина; Результат.version = Помещенные[0].НомерВерсии; Результат.phase = "verifying";
  Для Каждого Объект Из Помещенные Цикл
   Если Объект.НомерВерсии <> Результат.version Тогда ВызватьИсключение "Mixed commit versions"; КонецЕсли;
   Снимок = Клиент.ПолучитьИсторическийОбъект(Объект, Подключение.python);
   Путь = ОбъединитьПути(План.operation_directory, "readback-" + Строка(Объект.Идентификатор) + ".bin"); Снимок.ПакетСнимков.Записать(Путь);
   Запрос = Новый Структура("mode,plan_file,plan_sha256,object_id,snapshot_file", "verify_snapshot", Параметры.plan_file, Параметры.plan_sha256, НРег(Строка(Объект.Идентификатор)), Путь);
   СериализаторОбъектаХранилища.АртефактыПомещения(Запрос, Подключение.python); УдалитьФайлы(Путь);
  КонецЦикла;
  Результат.readback_verified = Истина; Результат.phase = "cleanup";
  Очистка = Подготовка.ЗавершитьПомещение(); Результат.capture_cleanup = Новый Структура("released,retained", Очистка.Освобождены, Очистка.НеОсвобождены);
  Если Очистка.НеОсвобождены.Количество() > 0 Тогда ВызватьИсключение "Capture cleanup incomplete"; КонецЕсли;
  КонтекстОсновы = Значение(Загружено.artifact, "baseline_update");
  Если КонтекстОсновы <> Неопределено И ТипЗнч(КонтекстОсновы) <> Тип("Null") Тогда
   Пакет.КонтекстОбновленияОсновы = КонтекстОсновы; Результат.phase = "baseline_update";
   Обновление = Клиент.ОбновитьОсновуПослеПомещения(Пакет); Результат.baseline_updated = Обновление.updated;
  КонецЕсли;
  Результат.phase = "completed";
  Результат.fully_completed = План.label.status <> "not_supported";
 Исключение
  Результат.Вставить("failure_code", Результат.phase + "_failed");
  Если Подготовка <> Неопределено Тогда
   Если Подготовка.Состояние = "ИсходНеизвестен" Или Подготовка.Состояние = "Отправка" Тогда
    Результат.committed = Неопределено; Результат.outcome_unknown = Истина; Результат.phase = "outcome_unknown";
   ИначеЕсли Не Результат.committed Тогда
    Попытка Очистка = Подготовка.Отменить(); Результат.capture_cleanup = Новый Структура("released,retained", Очистка.Освобождены, Очистка.НеОсвобождены); Исключение КонецПопытки;
   КонецЕсли;
  КонецЕсли;
 КонецПопытки;
 Возврат Результат;
КонецФункции

Функция Обработать(Клиент, Действие, Параметры, Подключение) Экспорт
 Если Действие = "commit.execute" Тогда Возврат Исполнить(Клиент, Параметры, Подключение); КонецЕсли;
 Возврат ПроверитьИсточники(Клиент, ЗагрузитьПакет(Параметры), Подключение, Значение(Параметры, "strict_source", Истина));
КонецФункции
