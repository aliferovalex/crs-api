// Единая политика процесса. Значения — положительные целые бюджеты.
Перем Политика;

Функция Значение(Имя, ПоУмолчанию) Экспорт
 Если Политика = Неопределено Тогда
  НоваяПолитика = Новый Соответствие;
  Текст = ПолучитьПеременнуюСреды("CRS_LIMITS_JSON");
  Путь = ПолучитьПеременнуюСреды("CRS_LIMITS_FILE");
  Если Текст <> Неопределено Или Путь <> Неопределено Тогда
   Чтение = Новый ЧтениеJSON;
   Если Текст <> Неопределено Тогда
    Если СтрДлина(Текст) > 65536 Тогда ВызватьИсключение "Слишком большая политика ограничений."; КонецЕсли;
    Чтение.УстановитьСтроку(Текст);
   Иначе
    Если Не Новый Файл(Путь).Существует() Или Новый Файл(Путь).Размер() > 65536 Тогда ВызватьИсключение "Не найден или слишком велик файл ограничений."; КонецЕсли;
    Чтение.ОткрытьФайл(Путь);
   КонецЕсли;
   Попытка Данные = ПрочитатьJSON(Чтение, Истина); Исключение Чтение.Закрыть(); ВызватьИсключение; КонецПопытки;
   Чтение.Закрыть();
   Если ТипЗнч(Данные) <> Тип("Соответствие") Тогда ВызватьИсключение "Ограничения должны быть JSON-объектом."; КонецЕсли;
   Для Каждого Запись Из Данные Цикл
    Если СтрНайти(",message_bytes,storage_bytes,record_bytes,cf_bytes,image_bytes,export_file_bytes,export_total_bytes,export_files,packet_bytes,module_bytes,", "," + Запись.Ключ + ",") = 0 Тогда ВызватьИсключение "Неизвестное ограничение данных."; КонецЕсли;
    Если ТипЗнч(Запись.Значение) <> Тип("Число") Или Запись.Значение <= 0 Или Запись.Значение > 9223372036854775807 Или Цел(Запись.Значение) <> Запись.Значение Тогда ВызватьИсключение "Ограничения задаются положительными целыми числами."; КонецЕсли;
   КонецЦикла;
   НоваяПолитика = Данные;
  КонецЕсли;
  Политика = НоваяПолитика;
 КонецЕсли;
 Результат = Политика.Получить(Имя);
 Возврат ?(Результат = Неопределено, ПоУмолчанию, Результат);
КонецФункции
