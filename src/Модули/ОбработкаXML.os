#Использовать xml-parser

#Область СлужебныйПрограммныйИнтерфейс

Функция ПрочитатьОбъектыВерсии(ТекстXML) Экспорт
	Чтение = ЧтениеОтветаОбъектов(ТекстXML);
	Объекты = Новый Массив;
	Объект = Неопределено;
	Глубина = 1;
	Пока Чтение.Прочитать() Цикл
		ТекущаяГлубина = ГлубинаУзла(Чтение, Глубина);
		Если Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			Имя = Чтение.ЛокальноеИмя;
			Если Имя = "info" И ТекущаяГлубина = 4 Тогда
				Объект = Новый ОбъектХранилища;
			ИначеЕсли Объект <> Неопределено Тогда
				Значение = Чтение.ЗначениеАтрибута("value");
				Если Имя = "id" Тогда
					Объект.Идентификатор = Значение;
				ИначеЕсли Имя = "classID" Тогда
					Объект.ИдентификаторКласса = Значение;
				ИначеЕсли Имя = "name" Тогда
					Объект.Имя = Значение;
				ИначеЕсли Имя = "pos" Тогда
					Объект.Позиция = Число(Значение);
				ИначеЕсли Имя = "verNum" Тогда
					Объект.НомерВерсии = Число(Значение);
				ИначеЕсли Имя = "selfVerNum" Тогда
					Объект.НомерСобственнойВерсии = Число(Значение);
				ИначеЕсли Имя = "parentID" Тогда
					Объект.ИдентификаторРодителя = Значение;
				ИначеЕсли Имя = "ownerID" Тогда
					Объект.ИдентификаторВладельца = Значение;
				ИначеЕсли Имя = "original" Тогда
					Объект.ИсходнаяВерсия = Значение;
				ИначеЕсли Имя = "local" Тогда
					Объект.ЛокальнаяВерсия = Значение;
				ИначеЕсли Имя = "removed" Тогда
					Объект.Удален = Вспомогательный.ВычислитьБулево(Значение);
				КонецЕсли;
			КонецЕсли;
		ИначеЕсли Чтение.ТипУзла = ТипУзлаXML.КонецЭлемента
			И Чтение.ЛокальноеИмя = "info" И ТекущаяГлубина = 4 Тогда
			Объекты.Добавить(Объект);
			Объект = Неопределено;
		КонецЕсли;
	КонецЦикла;
	Чтение.Закрыть();
	Возврат Объекты;
КонецФункции

Процедура ПроверитьОтветЗахвата(ТекстXML, ИдентификаторОбъекта) Экспорт
	Чтение = ЧтениеОтветаОбъектов(ТекстXML);
	ЗапрошенныйОбъект = Ложь;
	Раздел = "";
	Глубина = 1;
	Пока Чтение.Прочитать() Цикл
		ТекущаяГлубина = ГлубинаУзла(Чтение, Глубина);
		Если Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			Имя = Чтение.ЛокальноеИмя;
			Если Имя = "exception" Или Имя = "exc" Тогда
				ТекстОшибки = ПрочитатьТекстЭлемента(Чтение);
				Глубина = Глубина - 1;
				Если ЗначениеЗаполнено(СокрЛП(ТекстОшибки)) Тогда
					ВызватьИсключение СодержимоеИзBase64(ТекстОшибки);
				КонецЕсли;
			ИначеЕсли ТекущаяГлубина = 2 Тогда
				Раздел = Имя;
			ИначеЕсли Раздел = "requested" И Имя = "first" И ТекущаяГлубина = 4 Тогда
				ЗапрошенныйОбъект = ЗапрошенныйОбъект
					Или НРег(Чтение.ЗначениеАтрибута("value")) = НРег(ИдентификаторОбъекта);
			ИначеЕсли Имя = "value" И ТекущаяГлубина = 3
				И (Раздел = "required" Или Раздел = "missing" Или Раздел = "changed"
					Или Раздел = "unprocessed" Или Раздел = "added" Или Раздел = "moved") Тогда
				ВызватьИсключение "Захват не выполнен полностью: раздел ответа " + Раздел + ". Обновите описание объекта.";
			КонецЕсли;
		ИначеЕсли Чтение.ТипУзла = ТипУзлаXML.КонецЭлемента И ТекущаяГлубина = 2 Тогда
			Раздел = "";
		КонецЕсли;
	КонецЦикла;
	Чтение.Закрыть();
	Если Не ЗапрошенныйОбъект Тогда
		ВызватьИсключение "Сервер не вернул запрошенный объект в результате захвата.";
	КонецЕсли;
КонецПроцедуры

Функция ОбъектЗахваченПользователем(ТекстXML, ИдентификаторОбъекта, ИдентификаторПользователя) Экспорт
	Состояние = СостояниеОбъектаИзОтвета(ТекстXML, ИдентификаторОбъекта);
	Возврат Состояние <> Неопределено И Состояние.Захвачен
		И НРег(Состояние.Пользователь) = НРег(ИдентификаторПользователя);
КонецФункции

Функция СостояниеОбъектаИзОтвета(ТекстXML, ИдентификаторОбъекта) Экспорт
	Чтение = ЧтениеОтветаОбъектов(ТекстXML);
	ВСтатистике = Ложь;
	Идентификатор = "";
	Захвачен = Ложь;
	Владелец = "";
	НомерВерсии = Неопределено;
	Результат = Неопределено;
	Глубина = 1;
	Пока Чтение.Прочитать() Цикл
		ТекущаяГлубина = ГлубинаУзла(Чтение, Глубина);
		Если Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			Имя = Чтение.ЛокальноеИмя;
			Если Имя = "statMap" И ТекущаяГлубина = 1 Тогда
				ВСтатистике = Истина;
			ИначеЕсли ВСтатистике Тогда
				Если Имя = "value" И ТекущаяГлубина = 2 Тогда
					Идентификатор = "";
					Захвачен = Ложь;
					Владелец = "";
					НомерВерсии = Неопределено;
				ИначеЕсли Имя = "first" И ТекущаяГлубина = 3 Тогда
					Идентификатор = Чтение.ЗначениеАтрибута("value");
				ИначеЕсли Имя = "revised" И ТекущаяГлубина = 4 Тогда
					Захвачен = Вспомогательный.ВычислитьБулево(Чтение.ЗначениеАтрибута("value"));
				ИначеЕсли Имя = "revisorID" И ТекущаяГлубина = 4 Тогда
					Владелец = Чтение.ЗначениеАтрибута("value");
				ИначеЕсли Имя = "verNum" И ТекущаяГлубина = 4 Тогда
					НомерВерсии = Число(Чтение.ЗначениеАтрибута("value"));
				КонецЕсли;
			КонецЕсли;
		ИначеЕсли Чтение.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда
			Если Чтение.ЛокальноеИмя = "statMap" И ТекущаяГлубина = 1 Тогда
				ВСтатистике = Ложь;
			ИначеЕсли ВСтатистике И Чтение.ЛокальноеИмя = "value" И ТекущаяГлубина = 2 Тогда
				Если НРег(Идентификатор) = НРег(ИдентификаторОбъекта) Тогда
					Результат = Новый Структура("НомерВерсии,Захвачен,Пользователь", НомерВерсии, Захвачен, Владелец);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Чтение.Закрыть();
	Возврат Результат;
КонецФункции

Функция ЧтениеОтветаОбъектов(ТекстXML)
	Чтение = Новый ЧтениеXML;
	Чтение.УстановитьСтроку(ТекстXML);
	Глубина = 1;
	Пока Чтение.Прочитать() Цикл
		ТекущаяГлубина = ГлубинаУзла(Чтение, Глубина);
		Если Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			Если Чтение.ЛокальноеИмя <> "call_return"
				Или Чтение.URIПространстваИмен <> "http://v8.1c.ru/8.2/crs" Тогда
				ВызватьИсключение "Ожидался ответ call_return сервера хранилища.";
			КонецЕсли;
			Возврат Чтение;
		КонецЕсли;
	КонецЦикла;
	ВызватьИсключение "Пустой ответ сервера хранилища.";
КонецФункции

Функция ПрочитатьТекстЭлемента(Чтение)
	Текст = "";
	Глубина = 1;
	Пока Чтение.Прочитать() Цикл
		ТекущаяГлубина = ГлубинаУзла(Чтение, Глубина);
		Если Чтение.ТипУзла = ТипУзлаXML.КонецЭлемента И ТекущаяГлубина = 0 Тогда
			Прервать;
		ИначеЕсли Чтение.ТипУзла = ТипУзлаXML.Текст Или Чтение.ТипУзла = ТипУзлаXML.СекцияCDATA Тогда
			Текст = Текст + Чтение.Значение;
		КонецЕсли;
	КонецЦикла;
	Возврат Текст;
КонецФункции

Функция ГлубинаУзла(Чтение, Глубина)
	// ЧтениеXML OneScript возвращает КонецЭлемента также для записи <tag/>.
	Если Чтение.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда
		Глубина = Глубина - 1;
	КонецЕсли;
	Результат = Глубина;
	Если Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
		Глубина = Глубина + 1;
	КонецЕсли;
	Возврат Результат;
КонецФункции

Функция ПрочитатьОтветИзТекста(Тест) Экспорт
	
	ПутьКФайлу = ВременныйФайлXML(Тест);
	Результат = ПрочитатьОтчетИзФайла(ПутьКФайлу);
	УдалитьФайлы(ПутьКФайлу);

	Возврат Результат;

КонецФункции

Функция ПрочитатьОтчетИзФайла(ПутьКФайлу) Экспорт
	
	ПроцессорXML = Новый СериализацияДанныхXML();
	РезультатЧтения = ПроцессорXML.ПрочитатьИзФайла(ПутьКФайлу);
	
	Если ЭтоОтветСОшибкой(РезультатЧтения) Тогда
		Возврат ОбработаннаяОшибка(РезультатЧтения);
	КонецЕсли;

	Ответ = Новый ОтветСервиса();
	Ответ.РезультатЧтения = РезультатЧтения;
	
	Возврат Ответ;
	
КонецФункции

Функция ПрочитатьПользователяИзXML(Данные) Экспорт
	
	Структура = Новый Структура;
	
	ИмяФайла = ПолучитьИмяВременногоФайла("xml");
	
	ТД = Новый ТекстовыйДокумент();
	ТД.УстановитьТекст(Данные);
	ТД.Записать(ИмяФайла, "UTF-8");
	
	ПроцессорXML = Новый СериализацияДанныхXML();
	РезультатЧтения = ПроцессорXML.ПрочитатьИзФайла(ИмяФайла);
	ПользовательXML = РезультатЧтения["call_return"]["_Элементы"]["user"];
	Информация = ПользовательXML["info"];
	Для Каждого КлючЗначение Из Информация Цикл
		Если КлючЗначение.Ключ = "id" Тогда
			Структура.Вставить("Идентификатор", КлючЗначение.Значение["_Атрибуты"]["value"]);
		ИначеЕсли КлючЗначение.Ключ = "name" Тогда
			Структура.Вставить("Имя", КлючЗначение.Значение["_Атрибуты"]["value"]);
		ИначеЕсли КлючЗначение.Ключ = "password" Тогда
			Структура.Вставить("ХешПароля", КлючЗначение.Значение["_Атрибуты"]["value"]);
		ИначеЕсли КлючЗначение.Ключ = "rights" Тогда
			Структура.Вставить("Права", КлючЗначение.Значение["_Атрибуты"]["value"]);
		КонецЕсли;
	КонецЦикла;
	
	УдалитьФайлы(ИмяФайла);

	Возврат Структура;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ОбработаннаяОшибка(РезультатЧтения)
	Значение = РезультатЧтения.Получить("call_exception");
	Содержимое = СокрЛП(Значение._Значение);
	Ошибка = СодержимоеИзBase64(Содержимое);

	Ответ = Новый ОтветСервиса;
	Ответ.ЕстьОшибка = Истина;
	Ответ.СодержаниеОшибки = Ошибка;

	Возврат Ответ;
КонецФункции

Функция ЭтоОтветСОшибкой(РезультатЧтения)
	Значение = РезультатЧтения.Получить("call_exception");
	Возврат Не Значение = Неопределено;
КонецФункции

Функция ВременныйФайлXML(Текст)
	Путь = ПолучитьИмяВременногоФайла("xml");
	ТекстовыйДокумент = Новый ТекстовыйДокумент();
	ТекстовыйДокумент.УстановитьТекст(Текст);
	ТекстовыйДокумент.Записать(Путь, КодировкаТекста.UTF8);
	ТекстовыйДокумент = Неопределено;
	Возврат Путь;
КонецФункции

Функция СодержимоеИзBase64(ВходящиеДанные)
	ДД = Base64Значение(ВходящиеДанные);
	ВременныйФайл = ПолучитьИмяВременногоФайла("txt");
	ДД.Записать(ВременныйФайл);
	ТекстовыйДокумент = Новый ТекстовыйДокумент;
	ТекстовыйДокумент.Прочитать(ВременныйФайл, КодировкаТекста.UTF8);
	Содержимое = ТекстовыйДокумент.ПолучитьТекст();
	ТекстовыйДокумент = Неопределено;
	УдалитьФайлы(ВременныйФайл);
	Возврат Содержимое; 
КонецФункции

#КонецОбласти
