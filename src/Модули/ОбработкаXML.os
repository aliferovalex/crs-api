#Использовать xml-parser

#Область СлужебныйПрограммныйИнтерфейс

// Пустой requested допустим при успешном помещении. Проверяем весь ответ,
// в том числе exc после result. Код 6 с пустым second наблюдался на 8.5.4
// при успешном помещении: он допустим только с последующей проверкой новой версии.
Процедура ПроверитьОтветПомещения(ТекстXML) Экспорт
	Чтение = ЧтениеОтветаОбъектов(ТекстXML);
	Глубина = 1;
	Раздел = "";
	ЕстьРезультат = Ложь;
	Код = "";
	Пока Чтение.Прочитать() Цикл
		ТекущаяГлубина = ГлубинаУзла(Чтение, Глубина);
		Если Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			Имя = Чтение.ЛокальноеИмя;
			Если Чтение.URIПространстваИмен <> "http://v8.1c.ru/8.2/crs" Тогда
				ВызватьИсключение "Некорректное пространство имен ответа помещения.";
			КонецЕсли;
			Если Имя = "exc" Или Имя = "exception" Тогда
				Ошибка = ПрочитатьТекстЭлемента(Чтение);
				Глубина = Глубина - 1;
				Если ЗначениеЗаполнено(СокрЛП(Ошибка)) Тогда
					ВызватьИсключение СодержимоеИзBase64(Ошибка);
				КонецЕсли;
			ИначеЕсли Имя = "result" И ТекущаяГлубина = 1 Тогда
				Если ЕстьРезультат Тогда
					ВызватьИсключение "Повторный результат помещения.";
				КонецЕсли;
				ЕстьРезультат = Истина;
			ИначеЕсли ТекущаяГлубина = 2 Тогда
				Раздел = Имя;
			ИначеЕсли Имя = "value" И ТекущаяГлубина = 3
				И (Раздел = "required" Или Раздел = "missing" Или Раздел = "added"
					Или Раздел = "changed" Или Раздел = "moved") Тогда
				ВызватьИсключение "Помещение не подтверждено: непустой раздел " + Раздел + ".";
			ИначеЕсли Раздел = "unprocessed" И Имя = "value" И ТекущаяГлубина = 3 Тогда
				Код = "";
			ИначеЕсли Раздел = "unprocessed" И Имя = "first" И ТекущаяГлубина = 4 Тогда
				Код = Чтение.ЗначениеАтрибута("value");
			ИначеЕсли Раздел = "unprocessed" И Имя = "second" И ТекущаяГлубина = 4
				И ЗначениеЗаполнено(Чтение.ЗначениеАтрибута("value")) Тогда
				ВызватьИсключение "Помещение не подтверждено: есть необработанные объекты.";
			ИначеЕсли Раздел = "unprocessed" И ТекущаяГлубина >= 5 Тогда
				ВызватьИсключение "Помещение не подтверждено: есть необработанные объекты.";
			КонецЕсли;
		ИначеЕсли (Чтение.ТипУзла = ТипУзлаXML.Текст Или Чтение.ТипУзла = ТипУзлаXML.СекцияCDATA)
			И Раздел = "unprocessed" И ТекущаяГлубина >= 5 И ЗначениеЗаполнено(СокрЛП(Чтение.Значение)) Тогда
			ВызватьИсключение "Помещение не подтверждено: непустые данные unprocessed.";
		ИначеЕсли Чтение.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда
			Если Раздел = "unprocessed" И Чтение.ЛокальноеИмя = "value" И ТекущаяГлубина = 3 И Код <> "6" Тогда
				ВызватьИсключение "Помещение не подтверждено: код unprocessed " + Строка(Код) + ".";
			ИначеЕсли ТекущаяГлубина = 2 Тогда
				Раздел = "";
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Чтение.Закрыть();
	Если Не ЕстьРезультат Тогда
		ВызватьИсключение "Сервер не вернул результат помещения.";
	КонецЕсли;
КонецПроцедуры

Функция ПрочитатьКонтекстСериализации(ТекстXML) Экспорт
	Чтение = ЧтениеОтветаОбъектов(ТекстXML);
	Контекст = Неопределено;
	Глубина = 1;
	Пока Чтение.Прочитать() Цикл
		ТекущаяГлубина = ГлубинаУзла(Чтение, Глубина);
		Если Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			Если Чтение.URIПространстваИмен <> "http://v8.1c.ru/8.2/crs" Тогда
				ВызватьИсключение "Некорректное пространство имен контекста сериализации.";
			КонецЕсли;
			Если Чтение.ЛокальноеИмя = "exc" Или Чтение.ЛокальноеИмя = "exception" Тогда
				Ошибка = ПрочитатьТекстЭлемента(Чтение);
				Глубина = Глубина - 1;
				Если ЗначениеЗаполнено(СокрЛП(Ошибка)) Тогда
					ВызватьИсключение СодержимоеИзBase64(Ошибка);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		Если Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента И Чтение.ЛокальноеИмя = "file" И ТекущаяГлубина = 1 Тогда
			Если Контекст <> Неопределено Тогда
				ВызватьИсключение "Повторный контекст сериализации.";
			КонецЕсли;
			Контекст = Base64Значение(ПрочитатьТекстЭлемента(Чтение));
			Глубина = Глубина - 1;
		КонецЕсли;
	КонецЦикла;
	Чтение.Закрыть();
	Если Контекст = Неопределено Тогда
		ВызватьИсключение "Сервер не вернул контекст сериализации.";
	КонецЕсли;
	Возврат Контекст;
КонецФункции

Функция ПрочитатьИдентификаторВерсии(ТекстXML) Экспорт
	Чтение = ЧтениеОтветаОбъектов(ТекстXML);
	Идентификатор = Неопределено;
	Пока Чтение.Прочитать() Цикл
		Если Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента И Чтение.ЛокальноеИмя = "verID" Тогда
			Идентификатор = Строка(Новый УникальныйИдентификатор(Чтение.ЗначениеАтрибута("value")));
		КонецЕсли;
	КонецЦикла;
	Чтение.Закрыть();
	Если Идентификатор = Неопределено Тогда
		ВызватьИсключение "Сервер не вернул идентификатор версии хранилища.";
	КонецЕсли;
	Возврат Идентификатор;
КонецФункции

Функция ПрочитатьОтветПолученияОбъекта(ТекстXML, Объект, ВерсияХранилища) Экспорт
	Чтение = ЧтениеОтветаОбъектов(ТекстXML);
	Глубина = 1;
	Раздел = "";
	ВПакете = Ложь;
	Данные = Неопределено;
	Пока Чтение.Прочитать() Цикл
		ТекущаяГлубина = ГлубинаУзла(Чтение, Глубина);
		Если Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			Имя = Чтение.ЛокальноеИмя;
			Если Имя = "exc" Или Имя = "exception" Тогда
				Ошибка = ПрочитатьТекстЭлемента(Чтение);
				Глубина = Глубина - 1;
				Если ЗначениеЗаполнено(СокрЛП(Ошибка)) Тогда
					ВызватьИсключение СодержимоеИзBase64(Ошибка);
				КонецЕсли;
			ИначеЕсли Имя = "snapshots" И ТекущаяГлубина = 1 Тогда
				ВПакете = Истина;
			ИначеЕсли ВПакете И Имя = "data" И ТекущаяГлубина = 2 Тогда
				Если Данные <> Неопределено Тогда
					ВызватьИсключение "Сервер вернул несколько пакетов снимков.";
				КонецЕсли;
				Данные = Base64Значение(ПрочитатьТекстЭлемента(Чтение));
				Глубина = Глубина - 1;
			ИначеЕсли Не ВПакете И ТекущаяГлубина = 2 Тогда
				Раздел = Имя;
			ИначеЕсли Имя = "value" И ТекущаяГлубина = 3
				И (Раздел = "required" Или Раздел = "missing" Или Раздел = "changed"
					Или Раздел = "unprocessed" Или Раздел = "added" Или Раздел = "moved") Тогда
				ВызватьИсключение "Объект не получен полностью: раздел ответа " + Раздел + ". Обновите описание объекта.";
			КонецЕсли;
		ИначеЕсли Чтение.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда
			Если Чтение.ЛокальноеИмя = "snapshots" И ТекущаяГлубина = 1 Тогда
				ВПакете = Ложь;
			ИначеЕсли ТекущаяГлубина = 2 Тогда
				Раздел = "";
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Чтение.Закрыть();
	Если Данные = Неопределено Тогда
		ВызватьИсключение "Сервер не вернул данные объекта.";
	КонецЕсли;
	Снимок = Новый СнимокОбъектаХранилища;
	Снимок.Заполнить(Данные, Объект, ВерсияХранилища);
	Возврат Снимок;
КонецФункции

// Проверка полного XML нужна также для исключений, идущих после полезных данных.
Процедура ПроверитьОтветОписанияОбъекта(ТекстXML)
	Чтение = ЧтениеОтветаОбъектов(ТекстXML);
	Пока Чтение.Прочитать() Цикл
		Если Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			Если Чтение.URIПространстваИмен <> "http://v8.1c.ru/8.2/crs" Тогда
				ВызватьИсключение "Некорректное пространство имен ответа описания объекта.";
			КонецЕсли;
			Если Чтение.ЛокальноеИмя = "exc" Или Чтение.ЛокальноеИмя = "exception" Тогда
				Ошибка = ПрочитатьТекстЭлемента(Чтение);
				Если ЗначениеЗаполнено(СокрЛП(Ошибка)) Тогда
					ВызватьИсключение СодержимоеИзBase64(Ошибка);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Чтение.Закрыть();
КонецПроцедуры

Функция ПрочитатьНомерВерсииОбъекта(ТекстXML, ИдентификаторОбъекта) Экспорт
	ПроверитьОтветОписанияОбъекта(ТекстXML);
	Чтение = ЧтениеОтветаОбъектов(ТекстXML);
	Глубина = 1;
	ВСтатистике = Ложь;
	Совпадения = 0;
	Пока Чтение.Прочитать() Цикл
		ТекущаяГлубина = ГлубинаУзла(Чтение, Глубина);
		Если Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			Если Чтение.ЛокальноеИмя = "statMap" И ТекущаяГлубина = 1 Тогда
				ВСтатистике = Истина;
			ИначеЕсли ВСтатистике И Чтение.ЛокальноеИмя = "first" И ТекущаяГлубина = 3
				И НРег(Чтение.ЗначениеАтрибута("value")) = НРег(Строка(ИдентификаторОбъекта)) Тогда
				Совпадения = Совпадения + 1;
			КонецЕсли;
		ИначеЕсли Чтение.ТипУзла = ТипУзлаXML.КонецЭлемента И Чтение.ЛокальноеИмя = "statMap" И ТекущаяГлубина = 1 Тогда
			ВСтатистике = Ложь;
		КонецЕсли;
	КонецЦикла;
	Чтение.Закрыть();
	Если Совпадения = 0 Тогда
		ВызватьИсключение "Объект не найден в хранилище или удален.";
	ИначеЕсли Совпадения <> 1 Тогда
		ВызватьИсключение "Повторное состояние объекта в ответе сервера.";
	КонецЕсли;
	Состояние = СостояниеОбъектаИзОтвета(ТекстXML, Строка(ИдентификаторОбъекта));
	Если Состояние = Неопределено Тогда
		ВызватьИсключение "Сервер не вернул состояние объекта.";
	КонецЕсли;
	Номер = Состояние.НомерВерсии;
	Если ТипЗнч(Номер) <> Тип("Число") Тогда
		ВызватьИсключение "Сервер не вернул номер версии объекта.";
	КонецЕсли;
	Если Номер <= 0 Или Номер <> Цел(Номер) Тогда
		ВызватьИсключение "Некорректный номер версии объекта в ответе сервера.";
	КонецЕсли;
	Возврат Номер;
КонецФункции

Функция ПрочитатьОписаниеОбъекта(ТекстXML, ИдентификаторОбъекта, НомерВерсии) Экспорт
	ПроверитьОтветОписанияОбъекта(ТекстXML);
	Результат = Неопределено;
	Для Каждого Объект Из ПрочитатьОбъектыВерсии(ТекстXML) Цикл
		Если НРег(Строка(Объект.Идентификатор)) = НРег(Строка(ИдентификаторОбъекта)) Тогда
			Если Результат <> Неопределено Тогда
				ВызватьИсключение "Повторное описание объекта в ответе сервера.";
			КонецЕсли;
			Результат = Объект;
		КонецЕсли;
	КонецЦикла;
	Если Результат = Неопределено Тогда
		ВызватьИсключение "Описание объекта не найдено в его последней версии хранилища.";
	КонецЕсли;
	Результат.ПроверитьДляПолучения();
	Если Результат.НомерВерсии <> НомерВерсии Тогда
		ВызватьИсключение "Номер версии в описании объекта не совпадает с состоянием хранилища.";
	КонецЕсли;
	Возврат Результат;
КонецФункции

Функция ПрочитатьОбъектыВерсии(ТекстXML) Экспорт
	Чтение = ЧтениеОтветаОбъектов(ТекстXML);
	Объекты = Новый Массив;
	Объект = Неопределено;
	Глубина = 1;
	Пока Чтение.Прочитать() Цикл
		ТекущаяГлубина = ГлубинаУзла(Чтение, Глубина);
		Если Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			Имя = Чтение.ЛокальноеИмя;
			Если Имя = "info" И ТекущаяГлубина = 4 Тогда
				Объект = Новый ОбъектХранилища;
			ИначеЕсли Объект <> Неопределено Тогда
				Значение = Чтение.ЗначениеАтрибута("value");
				Если Имя = "id" Тогда
					Объект.Идентификатор = Значение;
				ИначеЕсли Имя = "classID" Тогда
					Объект.ИдентификаторКласса = Значение;
				ИначеЕсли Имя = "name" Тогда
					Объект.Имя = Значение;
				ИначеЕсли Имя = "pos" Тогда
					Объект.Позиция = Число(Значение);
				ИначеЕсли Имя = "verNum" Тогда
					Объект.НомерВерсии = Число(Значение);
				ИначеЕсли Имя = "selfVerNum" Тогда
					Объект.НомерСобственнойВерсии = Число(Значение);
				ИначеЕсли Имя = "parentID" Тогда
					Объект.ИдентификаторРодителя = Значение;
				ИначеЕсли Имя = "ownerID" Тогда
					Объект.ИдентификаторВладельца = Значение;
				ИначеЕсли Имя = "original" Тогда
					Объект.ИсходнаяВерсия = Значение;
				ИначеЕсли Имя = "local" Тогда
					Объект.ЛокальнаяВерсия = Значение;
				ИначеЕсли Имя = "removed" Тогда
					Объект.Удален = Вспомогательный.ВычислитьБулево(Значение);
				КонецЕсли;
			КонецЕсли;
		ИначеЕсли Чтение.ТипУзла = ТипУзлаXML.КонецЭлемента
			И Чтение.ЛокальноеИмя = "info" И ТекущаяГлубина = 4 Тогда
			Объекты.Добавить(Объект);
			Объект = Неопределено;
		КонецЕсли;
	КонецЦикла;
	Чтение.Закрыть();
	Возврат Объекты;
КонецФункции

Процедура ПроверитьОтветЗахвата(ТекстXML, ИдентификаторОбъекта) Экспорт
	Чтение = ЧтениеОтветаОбъектов(ТекстXML);
	ЗапрошенныйОбъект = Ложь;
	Раздел = "";
	Глубина = 1;
	Пока Чтение.Прочитать() Цикл
		ТекущаяГлубина = ГлубинаУзла(Чтение, Глубина);
		Если Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			Имя = Чтение.ЛокальноеИмя;
			Если Имя = "exception" Или Имя = "exc" Тогда
				ТекстОшибки = ПрочитатьТекстЭлемента(Чтение);
				Глубина = Глубина - 1;
				Если ЗначениеЗаполнено(СокрЛП(ТекстОшибки)) Тогда
					ВызватьИсключение СодержимоеИзBase64(ТекстОшибки);
				КонецЕсли;
			ИначеЕсли ТекущаяГлубина = 2 Тогда
				Раздел = Имя;
			ИначеЕсли Раздел = "requested" И Имя = "first" И ТекущаяГлубина = 4 Тогда
				ЗапрошенныйОбъект = ЗапрошенныйОбъект
					Или НРег(Чтение.ЗначениеАтрибута("value")) = НРег(ИдентификаторОбъекта);
			ИначеЕсли Имя = "value" И ТекущаяГлубина = 3
				И (Раздел = "required" Или Раздел = "missing" Или Раздел = "changed"
					Или Раздел = "unprocessed" Или Раздел = "added" Или Раздел = "moved") Тогда
				ВызватьИсключение "Захват не выполнен полностью: раздел ответа " + Раздел + ". Обновите описание объекта.";
			КонецЕсли;
		ИначеЕсли Чтение.ТипУзла = ТипУзлаXML.КонецЭлемента И ТекущаяГлубина = 2 Тогда
			Раздел = "";
		КонецЕсли;
	КонецЦикла;
	Чтение.Закрыть();
	Если Не ЗапрошенныйОбъект Тогда
		ВызватьИсключение "Сервер не вернул запрошенный объект в результате захвата.";
	КонецЕсли;
КонецПроцедуры

Функция ОбъектЗахваченПользователем(ТекстXML, ИдентификаторОбъекта, ИдентификаторПользователя) Экспорт
	Состояние = СостояниеОбъектаИзОтвета(ТекстXML, ИдентификаторОбъекта);
	Возврат Состояние <> Неопределено И Состояние.Захвачен
		И НРег(Состояние.Пользователь) = НРег(ИдентификаторПользователя);
КонецФункции

Функция СостояниеОбъектаИзОтвета(ТекстXML, ИдентификаторОбъекта) Экспорт
	Чтение = ЧтениеОтветаОбъектов(ТекстXML);
	ВСтатистике = Ложь;
	Идентификатор = "";
	Захвачен = Ложь;
	Владелец = "";
	НомерВерсии = Неопределено;
	Результат = Неопределено;
	Глубина = 1;
	Пока Чтение.Прочитать() Цикл
		ТекущаяГлубина = ГлубинаУзла(Чтение, Глубина);
		Если Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			Имя = Чтение.ЛокальноеИмя;
			Если Имя = "statMap" И ТекущаяГлубина = 1 Тогда
				ВСтатистике = Истина;
			ИначеЕсли ВСтатистике Тогда
				Если Имя = "value" И ТекущаяГлубина = 2 Тогда
					Идентификатор = "";
					Захвачен = Ложь;
					Владелец = "";
					НомерВерсии = Неопределено;
				ИначеЕсли Имя = "first" И ТекущаяГлубина = 3 Тогда
					Идентификатор = Чтение.ЗначениеАтрибута("value");
				ИначеЕсли Имя = "revised" И ТекущаяГлубина = 4 Тогда
					Захвачен = Вспомогательный.ВычислитьБулево(Чтение.ЗначениеАтрибута("value"));
				ИначеЕсли Имя = "revisorID" И ТекущаяГлубина = 4 Тогда
					Владелец = Чтение.ЗначениеАтрибута("value");
				ИначеЕсли Имя = "verNum" И ТекущаяГлубина = 4 Тогда
					НомерВерсии = Число(Чтение.ЗначениеАтрибута("value"));
				КонецЕсли;
			КонецЕсли;
		ИначеЕсли Чтение.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда
			Если Чтение.ЛокальноеИмя = "statMap" И ТекущаяГлубина = 1 Тогда
				ВСтатистике = Ложь;
			ИначеЕсли ВСтатистике И Чтение.ЛокальноеИмя = "value" И ТекущаяГлубина = 2 Тогда
				Если НРег(Идентификатор) = НРег(ИдентификаторОбъекта) Тогда
					Результат = Новый Структура("НомерВерсии,Захвачен,Пользователь", НомерВерсии, Захвачен, Владелец);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Чтение.Закрыть();
	Возврат Результат;
КонецФункции

Функция ЧтениеОтветаОбъектов(ТекстXML)
	Чтение = Новый ЧтениеXML;
	Чтение.УстановитьСтроку(ТекстXML);
	Глубина = 1;
	Пока Чтение.Прочитать() Цикл
		ТекущаяГлубина = ГлубинаУзла(Чтение, Глубина);
		Если Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			Если Чтение.ЛокальноеИмя <> "call_return"
				Или Чтение.URIПространстваИмен <> "http://v8.1c.ru/8.2/crs" Тогда
				ВызватьИсключение "Ожидался ответ call_return сервера хранилища.";
			КонецЕсли;
			Возврат Чтение;
		КонецЕсли;
	КонецЦикла;
	ВызватьИсключение "Пустой ответ сервера хранилища.";
КонецФункции

Функция ПрочитатьТекстЭлемента(Чтение)
	Текст = "";
	Глубина = 1;
	Пока Чтение.Прочитать() Цикл
		ТекущаяГлубина = ГлубинаУзла(Чтение, Глубина);
		Если Чтение.ТипУзла = ТипУзлаXML.КонецЭлемента И ТекущаяГлубина = 0 Тогда
			Прервать;
		ИначеЕсли Чтение.ТипУзла = ТипУзлаXML.Текст Или Чтение.ТипУзла = ТипУзлаXML.СекцияCDATA Тогда
			Текст = Текст + Чтение.Значение;
		КонецЕсли;
	КонецЦикла;
	Возврат Текст;
КонецФункции

Функция ГлубинаУзла(Чтение, Глубина)
	// ЧтениеXML OneScript возвращает КонецЭлемента также для записи <tag/>.
	Если Чтение.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда
		Глубина = Глубина - 1;
	КонецЕсли;
	Результат = Глубина;
	Если Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
		Глубина = Глубина + 1;
	КонецЕсли;
	Возврат Результат;
КонецФункции

Функция ПрочитатьОтветИзТекста(Тест) Экспорт
	
	ПутьКФайлу = ВременныйФайлXML(Тест);
	Результат = ПрочитатьОтчетИзФайла(ПутьКФайлу);
	УдалитьФайлы(ПутьКФайлу);

	Возврат Результат;

КонецФункции

Функция ПрочитатьОтчетИзФайла(ПутьКФайлу) Экспорт
	
	ПроцессорXML = Новый СериализацияДанныхXML();
	РезультатЧтения = ПроцессорXML.ПрочитатьИзФайла(ПутьКФайлу);
	
	Если ЭтоОтветСОшибкой(РезультатЧтения) Тогда
		Возврат ОбработаннаяОшибка(РезультатЧтения);
	КонецЕсли;

	Ответ = Новый ОтветСервиса();
	Ответ.РезультатЧтения = РезультатЧтения;
	
	Возврат Ответ;
	
КонецФункции

Функция ПрочитатьПользователяИзXML(Данные) Экспорт
	
	Структура = Новый Структура;
	
	ИмяФайла = ПолучитьИмяВременногоФайла("xml");
	
	ТД = Новый ТекстовыйДокумент();
	ТД.УстановитьТекст(Данные);
	ТД.Записать(ИмяФайла, "UTF-8");
	
	ПроцессорXML = Новый СериализацияДанныхXML();
	РезультатЧтения = ПроцессорXML.ПрочитатьИзФайла(ИмяФайла);
	ПользовательXML = РезультатЧтения["call_return"]["_Элементы"]["user"];
	Информация = ПользовательXML["info"];
	Для Каждого КлючЗначение Из Информация Цикл
		Если КлючЗначение.Ключ = "id" Тогда
			Структура.Вставить("Идентификатор", КлючЗначение.Значение["_Атрибуты"]["value"]);
		ИначеЕсли КлючЗначение.Ключ = "name" Тогда
			Структура.Вставить("Имя", КлючЗначение.Значение["_Атрибуты"]["value"]);
		ИначеЕсли КлючЗначение.Ключ = "password" Тогда
			Структура.Вставить("ХешПароля", КлючЗначение.Значение["_Атрибуты"]["value"]);
		ИначеЕсли КлючЗначение.Ключ = "rights" Тогда
			Структура.Вставить("Права", КлючЗначение.Значение["_Атрибуты"]["value"]);
		КонецЕсли;
	КонецЦикла;
	
	УдалитьФайлы(ИмяФайла);

	Возврат Структура;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ОбработаннаяОшибка(РезультатЧтения)
	Значение = РезультатЧтения.Получить("call_exception");
	Содержимое = СокрЛП(Значение._Значение);
	Ошибка = СодержимоеИзBase64(Содержимое);

	Ответ = Новый ОтветСервиса;
	Ответ.ЕстьОшибка = Истина;
	Ответ.СодержаниеОшибки = Ошибка;

	Возврат Ответ;
КонецФункции

Функция ЭтоОтветСОшибкой(РезультатЧтения)
	Значение = РезультатЧтения.Получить("call_exception");
	Возврат Не Значение = Неопределено;
КонецФункции

Функция ВременныйФайлXML(Текст)
	Путь = ПолучитьИмяВременногоФайла("xml");
	ТекстовыйДокумент = Новый ТекстовыйДокумент();
	ТекстовыйДокумент.УстановитьТекст(Текст);
	ТекстовыйДокумент.Записать(Путь, КодировкаТекста.UTF8);
	ТекстовыйДокумент = Неопределено;
	Возврат Путь;
КонецФункции

Функция СодержимоеИзBase64(ВходящиеДанные)
	ДД = Base64Значение(ВходящиеДанные);
	ВременныйФайл = ПолучитьИмяВременногоФайла("txt");
	ДД.Записать(ВременныйФайл);
	ТекстовыйДокумент = Новый ТекстовыйДокумент;
	ТекстовыйДокумент.Прочитать(ВременныйФайл, КодировкаТекста.UTF8);
	Содержимое = ТекстовыйДокумент.ПолучитьТекст();
	ТекстовыйДокумент = Неопределено;
	УдалитьФайлы(ВременныйФайл);
	Возврат Содержимое; 
КонецФункции

#КонецОбласти
