#Область СлужебныйПрограммныйИнтерфейс

Функция ТелоЗапросаОбъектовВерсии(Параметры) Экспорт
	Запись = НачатьЗапросОбъектов(Параметры, "DevDepot_versionObjects");
	ЗаписатьЗначениеОбъекта(Запись, "verNum", Параметры.НомерВерсии);
	Возврат ЗакончитьЗапросОбъектов(Запись);
КонецФункции

Функция ТелоЗапросаНаИзменениеЗахвата(Параметры) Экспорт
	Объект = Параметры.Объект;
	Объект.ПроверитьДляЗахвата();
	Запись = НачатьЗапросОбъектов(Параметры, "DevDepot_reviseDevObjects");
	ЗаписатьЗначениеОбъекта(Запись, "revise", Параметры.Захватить);
	Запись.ЗаписатьНачалоЭлемента("crs:objects");
	Запись.ЗаписатьНачалоЭлемента("crs:value");
	ЗаписатьЗначениеОбъекта(Запись, "first", Объект.Идентификатор);
	Запись.ЗаписатьНачалоЭлемента("crs:second");
	ЗаписатьОписаниеОбъекта(Запись, Объект);
	Запись.ЗаписатьКонецЭлемента();
	Запись.ЗаписатьКонецЭлемента();
	Запись.ЗаписатьКонецЭлемента();
	Возврат ЗакончитьЗапросОбъектов(Запись);
КонецФункции

Функция ТелоЗапросаПоследнейВерсии(Параметры) Экспорт
	Возврат ЗакончитьЗапросОбъектов(НачатьЗапросОбъектов(Параметры, "DevDepot_latestVerID"));
КонецФункции

Функция ТелоЗапросаНаПолучениеОбъекта(Параметры) Экспорт
	Объект = Параметры.Объект;
	Объект.ПроверитьДляПолучения();
	Запись = НачатьЗапросОбъектов(Параметры, "DevDepot_updateObjects");
	ЗаписатьЗначениеОбъекта(Запись, "clientVerID", Параметры.ВерсияХранилища);
	Запись.ЗаписатьНачалоЭлемента("crs:data");
	// Пустой граф клиентской конфигурации: десять пустых коллекций, 0,
	// пустая коллекция, 0, две пустые коллекции. Сериализация с raw DEFLATE;
	// заголовок 0201 + UUID типа сериализатора. Проверено на 8.5.4.1878.
	Запись.ЗаписатьТекст("AgFTS2/0iI3BTqDV67a9oKcNs2GAgPe791dXG9TqEIMNkEggrgUA");
	Запись.ЗаписатьКонецЭлемента();
	Запись.ЗаписатьНачалоЭлемента("crs:requested");
	Запись.ЗаписатьНачалоЭлемента("crs:value");
	ЗаписатьЗначениеОбъекта(Запись, "first", Объект.Идентификатор);
	Запись.ЗаписатьНачалоЭлемента("crs:second");
	ЗаписатьОписаниеОбъекта(Запись, Объект, Истина);
	Запись.ЗаписатьКонецЭлемента();
	Запись.ЗаписатьКонецЭлемента();
	Запись.ЗаписатьКонецЭлемента();
	Запись.ЗаписатьНачалоЭлемента("crs:changes");
	Запись.ЗаписатьНачалоЭлемента("crs:value");
	ЗаписатьЗначениеОбъекта(Запись, "first", Объект.Идентификатор);
	Запись.ЗаписатьНачалоЭлемента("crs:second");
	Запись.ЗаписатьНачалоЭлемента("crs:_super");
	ЗаписатьОписаниеОбъекта(Запись, Объект);
	Запись.ЗаписатьКонецЭлемента();
	Запись.ЗаписатьНачалоЭлемента("crs:externals");
	Запись.ЗаписатьКонецЭлемента();
	Запись.ЗаписатьКонецЭлемента();
	Запись.ЗаписатьКонецЭлемента();
	Запись.ЗаписатьКонецЭлемента();
	Возврат ЗакончитьЗапросОбъектов(Запись);
КонецФункции

Процедура ЗаписатьОписаниеОбъекта(Запись, Объект, ДляПолучения = Ложь)
	Запись.ЗаписатьНачалоЭлемента("crs:_super");
	ЗаписатьЗначениеОбъекта(Запись, "id", Объект.Идентификатор);
	ЗаписатьЗначениеОбъекта(Запись, "classID", Объект.ИдентификаторКласса);
	Запись.ЗаписатьКонецЭлемента();
	ЗаписатьЗначениеОбъекта(Запись, "name", Объект.Имя);
	ЗаписатьЗначениеОбъекта(Запись, "pos", Объект.Позиция);
	ЗаписатьЗначениеОбъекта(Запись, "verNum", ?(ДляПолучения, -1, Объект.НомерВерсии));
	ЗаписатьЗначениеОбъекта(Запись, "selfVerNum", ?(ДляПолучения, 0, Объект.НомерСобственнойВерсии));
	ЗаписатьЗначениеОбъекта(Запись, "parentID", Объект.ИдентификаторРодителя);
	ЗаписатьЗначениеОбъекта(Запись, "ownerID", Объект.ИдентификаторВладельца);
	Запись.ЗаписатьНачалоЭлемента("crs:version");
	ЗаписатьЗначениеОбъекта(Запись, "original", Объект.ИсходнаяВерсия);
	ЗаписатьЗначениеОбъекта(Запись, "local", ?(ДляПолучения, "0000000000000000000000000000000000000000", Объект.ЛокальнаяВерсия));
	Запись.ЗаписатьКонецЭлемента();
	ЗаписатьЗначениеОбъекта(Запись, "removed", Объект.Удален);
КонецПроцедуры

Функция ТелоЗапросаСостоянияОбъекта(Параметры) Экспорт
	Запись = НачатьЗапросОбъектов(Параметры, "DevDepot_devObjectsStatistic");
	Запись.ЗаписатьНачалоЭлемента("crs:objRefs");
	ЗаписатьЗначениеОбъекта(Запись, "value", Параметры.ИдентификаторОбъекта);
	Запись.ЗаписатьКонецЭлемента();
	ЗаписатьЗначениеОбъекта(Запись, "removed", Ложь);
	Возврат ЗакончитьЗапросОбъектов(Запись);
КонецФункции

Функция НачатьЗапросОбъектов(Параметры, ИмяМетода)
	Запись = Новый ЗаписьXML;
	Запись.УстановитьСтроку();
	Запись.ЗаписатьОбъявлениеXML();
	Запись.ЗаписатьНачалоЭлемента("crs:call");
	Запись.ЗаписатьАтрибут("xmlns:crs", "http://v8.1c.ru/8.2/crs");
	Запись.ЗаписатьАтрибут("alias", Параметры.ИмяХранилища);
	Запись.ЗаписатьАтрибут("name", ИмяМетода);
	Запись.ЗаписатьАтрибут("version", Параметры.ВерсияПлатформы);
	Запись.ЗаписатьНачалоЭлемента("crs:auth");
	Запись.ЗаписатьАтрибут("user", Параметры.ПользовательХранилища);
	Запись.ЗаписатьАтрибут("password", Параметры.ХешПользователяХранилища);
	Запись.ЗаписатьКонецЭлемента();
	Запись.ЗаписатьНачалоЭлемента("crs:bind");
	Запись.ЗаписатьАтрибут("bindID", Строка(Параметры.ИдентификаторПодключения));
	Запись.ЗаписатьКонецЭлемента();
	Запись.ЗаписатьНачалоЭлемента("crs:params");
	Возврат Запись;
КонецФункции

Процедура ЗаписатьЗначениеОбъекта(Запись, Имя, Значение)
	Если ТипЗнч(Значение) = Тип("Булево") Тогда
		Текст = ?(Значение, "true", "false");
	ИначеЕсли ТипЗнч(Значение) = Тип("Число") Тогда
		Текст = Формат(Значение, "ЧГ=0;ЧДЦ=0;ЧН=0");
	Иначе
		Текст = Строка(Значение);
	КонецЕсли;
	Запись.ЗаписатьНачалоЭлемента("crs:" + Имя);
	Запись.ЗаписатьАтрибут("value", Текст);
	Запись.ЗаписатьКонецЭлемента();
КонецПроцедуры

Функция ЗакончитьЗапросОбъектов(Запись)
	Запись.ЗаписатьКонецЭлемента();
	Запись.ЗаписатьКонецЭлемента();
	Возврат Запись.Закрыть();
КонецФункции

Функция ТелоЗапросаНаОткрытиеХранилища(Параметры) Экспорт
	ТелоЗапроса = "<?xml version=""1.0"" encoding=""UTF-8""?>
		|<crs:call xmlns:crs=""http://v8.1c.ru/8.2/crs"" alias=""" + Параметры.ИмяХранилища + """ name=""DevDepotAdmin_openDevDepot"" version=""" + Параметры.ВерсияПлатформы + """>
		|<crs:params>
		|<crs:alias value=""" + Параметры.ИмяХранилища + """/>
		|<crs:convert value=""false""/>
		|</crs:params>
		|</crs:call>";
	Возврат ТелоЗапроса;
КонецФункции

Функция ТелоЗапросаНаСозданиеХранилища(Параметры) Экспорт
	ТелоЗапроса = "<?xml version=""1.0"" encoding=""UTF-8""?>
		|<crs:call xmlns:crs=""http://v8.1c.ru/8.2/crs"" alias=""" + Параметры.ИмяХранилища + """ name=""DevDepotAdmin_createDevDepot"" version=""" + Параметры.ВерсияПлатформы + """>
		|<crs:params>
		|<crs:alias value=""" + Параметры.ИмяХранилища + """/>
		|<crs:rootID value=""" + КорневойИдентификаторКонфигурации() + """/>
		|<crs:adminName value=""" + Параметры.ИмяПользователя + """/>
		|<crs:adminPassword value=""" + Параметры.ХешПароляПользователя + """/>
		|<crs:code value=""""/>
		|<crs:features/>
		|<crs:snapshots>
		|<crs:data>" + Параметры.ШаблонКонфигурации + "</crs:data>
		|</crs:snapshots>
		|<crs:hashedVersionID value=""false""/>
		|</crs:params>
		|</crs:call>";
	Возврат ТелоЗапроса;
КонецФункции

Функция ТелоЗапросаНаПодключение(Параметры) Экспорт
	ТелоЗапроса = "<?xml version=""1.0"" encoding=""UTF-8""?>
		|<crs:call xmlns:crs=""http://v8.1c.ru/8.2/crs"" alias=""" + Параметры.ИмяХранилища + """ name=""DevDepot_depotInfo"" 
		|version=""" + Параметры.ВерсияПлатформы + """>
		|<crs:auth user=""" + Параметры.ПользовательХранилища + """ password=""" + Параметры.ХешПароляПользователя + """/>
		|<crs:params/>
		|</crs:call>";
	Возврат ТелоЗапроса;
КонецФункции

Функция ТелоЗапросаПолученияВерсийХранилища(Параметры) Экспорт
	ТелоЗапроса = "<?xml version=""1.0"" encoding=""UTF-8""?>
		|<crs:call xmlns:crs=""http://v8.1c.ru/8.2/crs"" alias=""" + Параметры.ИмяХранилища + """ name=""DevDepot_devDepotVersions"" version=""" + Параметры.ВерсияПлатформы + """>
		|<crs:auth user=""" + Параметры.ПользовательХранилища + """ password=""" + Параметры.ХешПароляПользователя + """/>
		|<crs:params>
		|<crs:filter>
		|<crs:mask value=""0""/>
		|<crs:beginDate value=""0001-01-01T00:00:00""/>
		|<crs:endDate value=""0001-01-01T00:00:00""/>
		|<crs:beginVerNum>4294967295</crs:beginVerNum>
		|<crs:endVerNum>4294967295</crs:endVerNum>
		|<crs:userIDs/>
		|<crs:objRefs/>
		|<crs:recursive value=""false""/>
		|<crs:labels value=""true""/>
		|<crs:onlyLabels value=""false""/>
		|<crs:configVersion value=""""/>
		|<crs:externals/>
		|<crs:noExternals/>
		|</crs:filter></crs:params>
		|</crs:call>";
	Возврат ТелоЗапроса;
КонецФункции

Функция ТелоЗапросаНаСозданиеПользователя(Параметры) Экспорт
	ТелоЗапроса = "<?xml version=""1.0"" encoding=""UTF-8""?>
		|<crs:call xmlns:crs=""http://v8.1c.ru/8.2/crs"" alias=""" + Параметры.ИмяХранилища + """ name=""UserManager_addUser"" version=""" + Параметры.ВерсияПлатформы + """>
		|<crs:auth user=""" + Параметры.ПользовательХранилища + """ password=""" + Параметры.ХешПользователяХранилища + """ />
		|<crs:bind bindID=""" + Параметры.ИдентификаторПодключения + """ />
		|<crs:params>
		|<crs:user>
		|<crs:id value=""" + Параметры.ИдентификаторОперации + """ />
		|<crs:name value=""" + Параметры.ИмяПользователя + """ />
		|<crs:password value=""" + Параметры.ХешНовогоПароля + """ />
		|<crs:rights value=""" + Параметры.Роль + """ />
		|</crs:user>
		|</crs:params>
		|</crs:call>";
	Возврат ТелоЗапроса;
КонецФункции

Функция ТелоЗапросаПоискаПользователя(Параметры) Экспорт
	ТелоЗапроса = "<?xml version=""1.0"" encoding=""UTF-8""?>
		|<crs:call xmlns:crs=""http://v8.1c.ru/8.2/crs"" alias=""" + Параметры.ИмяХранилища + """ name=""UserManager_depotUserByName"" version=""" + Параметры.ВерсияПлатформы + """>
		|<crs:auth user=""" + Параметры.ПользовательХранилища + """ password=""" + Параметры.ХешПользователяХранилища + """ />
