// Операция и класс объекта задают правила; имена старых типов служат алиасами.
Перем КартаМетаданных;
Перем ПрофилиФорм;

Функция КлассыФорм() Экспорт
 Если ПрофилиФорм = Неопределено Тогда
  Чтение = Новый ЧтениеJSON;
  Чтение.ОткрытьФайл(ОбъединитьПути(ТекущийСценарий().Каталог, "..", "Сериализация", "managed_form_owner_profiles_851.json"));
  Попытка ПрофилиФорм = ПрочитатьJSON(Чтение); Исключение Чтение.Закрыть(); ВызватьИсключение; КонецПопытки;
  Чтение.Закрыть();
 КонецЕсли;
 Результат = "CommonForm";
 Для Каждого Владелец Из ПрофилиФорм Цикл Результат = Результат + "," + Владелец.Ключ + "Form"; КонецЦикла;
 Возврат Результат;
КонецФункции

Функция ЭтоФорма(Вид) Экспорт
 Возврат СтрНайти("," + КлассыФорм() + ",", "," + Вид + ",") > 0;
КонецФункции


Функция РодителиУдаления(ВидОбъекта)
 Если КартаМетаданных = Неопределено Тогда
  Чтение = Новый ЧтениеJSON;
  Чтение.ОткрытьФайл(ОбъединитьПути(ТекущийСценарий().Каталог, "..", "Сериализация", "metadata_structure_221.json"));
  Попытка КартаМетаданных = ПрочитатьJSON(Чтение, Истина); Исключение Чтение.Закрыть(); ВызватьИсключение; КонецПопытки;
  Чтение.Закрыть();
 КонецЕсли;
 Результат = Новый Массив;
 Для Каждого Запись Из КартаМетаданных.Получить("classes") Цикл
  Владелец = Запись.Значение;
  Если Не Владелец.Получить("automatic_deletion_supported") Тогда Продолжить; КонецЕсли;
  Для Каждого Коллекция Из Владелец.Получить("collections") Цикл
   Если Коллекция.Получить("runtime_item_kind") <> ВидОбъекта Или Коллекция.Получить("storage") <> "stored_name" Тогда Продолжить; КонецЕсли;
   Если Коллекция.Получить("native").Получить("status") = "unmapped" Тогда Продолжить; КонецЕсли;
   Имя = Владелец.Получить("runtime_name");
   Если Результат.Найти(Имя) = Неопределено Тогда Результат.Добавить(Имя); КонецЕсли;
  КонецЦикла;
 КонецЦикла;
 Если Результат.Количество() = 0 Тогда ВызватьИсключение "Не сопоставлена коллекция родителя удаления."; КонецЕсли;
 Возврат СтрСоединить(Результат, ",");
КонецФункции

Функция ПрофилиСозданияОбъектов() Экспорт
 Чтение = Новый ЧтениеJSON;
 Чтение.ОткрытьФайл(ОбъединитьПути(ТекущийСценарий().Каталог, "..", "Сериализация", "object_xml_profiles.json"));
 Попытка Профили = ПрочитатьJSON(Чтение); Исключение Чтение.Закрыть(); ВызватьИсключение; КонецПопытки;
 Чтение.Закрыть(); Возврат Профили;
КонецФункции

Функция КлассыСозданияОбъектов() Экспорт
 Виды = Новый Массив;
 Для Каждого Профиль Из ПрофилиСозданияОбъектов() Цикл Виды.Добавить(Профиль.Ключ); КонецЦикла;
 Возврат СтрСоединить(Виды, ",");
КонецФункции

Функция Параметры(Операция, ВидОбъекта) Экспорт
 Родитель = "Configuration"; ОдинСнимок = Ложь; ТолькоLegacy = Истина;
 Если Операция = "Создание" Тогда
  Если СтрНайти("," + КлассыСозданияОбъектов() + "," + КлассыФорм() + ",Template,CommonTemplate,", "," + ВидОбъекта + ",") = 0 Тогда ВызватьИсключение "Неподдерживаемый класс создания."; КонецЕсли;
  Если ВидОбъекта = "Template" Тогда Родитель = РодителиУдаления(ВидОбъекта); ОдинСнимок = Истина; КонецЕсли;
  Если ЭтоФорма(ВидОбъекта) Тогда Родитель = ?(ВидОбъекта = "CommonForm", "Configuration", Лев(ВидОбъекта, СтрДлина(ВидОбъекта) - 4)); ОдинСнимок = Истина; КонецЕсли;
  Если ВидОбъекта = "CommonTemplate" Тогда ОдинСнимок = Истина; КонецЕсли;
  ТолькоLegacy = ВидОбъекта <> "Constant";
 ИначеЕсли Операция = "Изменение" Тогда
  Если СтрНайти(",CommonModule," + КлассыФорм() + ",Template,CommonTemplate,", "," + ВидОбъекта + ",") = 0 Тогда ВызватьИсключение "Неподдерживаемый класс изменения внешнего потока."; КонецЕсли;
 ИначеЕсли Операция = "Удаление" Тогда
  Если ВидОбъекта = "" Или ВидОбъекта = "Configuration" Тогда ВызватьИсключение "Неподдерживаемый класс удаления."; КонецЕсли;
  ПроверкаКласса = ИдентификаторыМетаданных.ИдентификаторКласса(ВидОбъекта);
  Родитель = РодителиУдаления(ВидОбъекта);
 ИначеЕсли Операция = "Импорт" Тогда ТолькоLegacy = Ложь;
 Иначе ВызватьИсключение "Неподдерживаемая операция пакета.";
 КонецЕсли;
 ПризнакиНового = Операция = "Создание" И ВидОбъекта <> "Constant" И СтрНайти("," + КлассыСозданияОбъектов() + ",", "," + ВидОбъекта + ",") > 0;
 Возврат Новый Структура("Операция,ВидОбъекта,ВидРодителя,ОдинСнимок,ТолькоLegacy,ПризнакиНового", Операция, ВидОбъекта, Родитель, ОдинСнимок, ТолькоLegacy, ПризнакиНового);
КонецФункции

Функция РодительДопустим(Правила, Класс) Экспорт
 Для Каждого Вид Из СтрРазделить(Правила.ВидРодителя, ",") Цикл
  Если НРег(Строка(Класс)) = ИдентификаторыМетаданных.ИдентификаторКласса(Вид) Тогда Возврат Истина; КонецЕсли;
 КонецЦикла;
 Возврат Ложь;
КонецФункции

Функция Алиасы() Экспорт
 Таблица = Новый Соответствие;
 Таблица.Вставить("ПакетПомещенияОбъекта", Параметры("Импорт", ""));
 Для Каждого Пара Из СтрРазделить("Константы:Constant,Справочника:Catalog,Документа:Document,Перечисления:Enum,ОбщегоМодуля:CommonModule,ФормыСправочника:CatalogForm,ФормыДокумента:DocumentForm,ОбщейФормы:CommonForm", ",") Цикл
  Части = СтрРазделить(Пара, ":"); Таблица.Вставить("ПакетСоздания" + Части[0], Параметры("Создание", Части[1]));
 КонецЦикла;
 Таблица.Вставить("ПакетИзмененияФормы", Параметры("Изменение", "CatalogForm"));
 Таблица.Вставить("ПакетИзмененияОбщегоМодуля", Параметры("Изменение", "CommonModule"));
 Таблица.Вставить("ПакетУдаленияФормы", Параметры("Удаление", "CatalogForm"));
 Возврат Таблица;
КонецФункции

Функция ЭтоПакет(Кандидат, Операция = Неопределено, Вид = Неопределено) Экспорт
 Если Алиасы().Получить(Строка(ТипЗнч(Кандидат))) = Неопределено Тогда Возврат Ложь; КонецЕсли;
 Возврат (Операция = Неопределено Или Кандидат.ВидОперации() = Операция) И (Вид = Неопределено Или Кандидат.ВидМетаданных() = Вид);
КонецФункции

Функция ОписаниеОбъекта(Описание) Экспорт
 Объект = Новый ОбъектХранилища;
 Объект.Идентификатор = Описание.id; Объект.ИдентификаторКласса = Описание.class_id; Объект.Имя = Описание.name; Объект.Позиция = Описание.pos;
 Объект.НомерВерсии = 0; Объект.НомерСобственнойВерсии = 0; Объект.ИдентификаторРодителя = Описание.parent_id; Объект.ИдентификаторВладельца = Описание.owner_id;
 Объект.ИсходнаяВерсия = Описание.original; Объект.ЛокальнаяВерсия = Описание.local; Объект.Удален = Ложь;
 Возврат Объект;
КонецФункции

Функция ВидПоКлассу(Класс) Экспорт
 Возврат ИдентификаторыМетаданных.ИмяКласса(Класс);
КонецФункции
