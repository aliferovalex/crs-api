// Старые версии используют профиль 8.5.1; бинарная структура проверяется отдельно.
Функция ИспользоватьПрофиль851(Знач Версия) Экспорт
	Части = ЧастиВерсии(Версия);
	Возврат Части[1] < 5 Или (Части[1] = 5 И Части[2] <= 1);
КонецФункции

Функция ПоддерживаетсяСериализация(Знач Версия) Экспорт
	Возврат ИспользоватьПрофиль851(Версия) Или Версия = "8.5.4.1878";
КонецФункции

Процедура ПроверитьСериализацию(Знач Версия) Экспорт
	Если Не ПоддерживаетсяСериализация(Версия) Тогда
		ВызватьИсключение "Нет профиля сериализации для платформы " + Версия;
	КонецЕсли;
КонецПроцедуры

Функция ЧастиВерсии(Знач Версия)
	Если ТипЗнч(Версия) <> Тип("Строка") Тогда ВызватьИсключение "Неверная версия платформы."; КонецЕсли;
	Части = СтрРазделить(Версия, ".", Истина);
	Если Части.Количество() <> 4 Тогда ВызватьИсключение "Нужна версия платформы из четырех чисел."; КонецЕсли;
	Для Индекс = 0 По 3 Цикл
		Часть = Части[Индекс];
		Если СтрДлина(Часть) = 0 Тогда ВызватьИсключение "Пустая часть версии платформы."; КонецЕсли;
		Для Позиция = 1 По СтрДлина(Часть) Цикл
			Если СтрНайти("0123456789", Сред(Часть, Позиция, 1)) = 0 Тогда ВызватьИсключение "Неверная версия платформы."; КонецЕсли;
		КонецЦикла;
		Части[Индекс] = Число(Часть);
	КонецЦикла;
	Если Части[0] <> 8 Тогда ВызватьИсключение "Нужна версия платформы 8.x."; КонецЕсли;
	Возврат Части;
КонецФункции
