// Экспериментальный сериализатор свойств корня; профиль выбирается централизованно.
// Python 3.9+ со стандартной библиотекой; Конфигуратор не запускается.
Функция КомментарийИзXML(Снимок, Контекст, ИсходныйXML, ИзмененныйXML, ИмяХранилища, ВерсияПлатформы, ПутьPython = "python") Экспорт
	Возврат СвойстваИзXML(Снимок, Контекст, ИсходныйXML, ИзмененныйXML, ИмяХранилища, ВерсияПлатформы, ПутьPython, "comment");
КонецФункции

Функция СвойстваИзXML(Снимок, Контекст, ИсходныйXML, ИзмененныйXML, ИмяХранилища, ВерсияПлатформы, ПутьPython = "python", Режим = "properties") Экспорт
	Если ТипЗнч(Снимок) <> Тип("СнимокОбъектаХранилища") Или ТипЗнч(Контекст) <> Тип("ДвоичныеДанные") Тогда
		ВызватьИсключение "Нужны снимок объекта и бинарный контекст updateInfo.";
	КонецЕсли;
	Снимок.Объект.ПроверитьДляПомещения();
	Параметры = Новый Структура;
	Параметры.Вставить("mode", Режим);
	Параметры.Вставить("platform", ВерсияПлатформы);
	Параметры.Вставить("repository", ИмяХранилища);
	Параметры.Вставить("repository_version", Снимок.ВерсияХранилища);
	Параметры.Вставить("object_id", Строка(Снимок.Объект.Идентификатор));
	Параметры.Вставить("original_version", Снимок.Объект.ИсходнаяВерсия);
	Параметры.Вставить("snapshot", Base64Строка(Снимок.ПакетСнимков));
	Параметры.Вставить("context", Base64Строка(Контекст));
	Параметры.Вставить("before_xml", ИсходныйXML);
	Параметры.Вставить("after_xml", ИзмененныйXML);
	Результат = ВыполнитьPython(Параметры, ПутьPython, "metadata_serializer.py");
	Пакет = Новый ПакетПомещенияОбъекта;
	Пакет.ЗаполнитьИзЗапроса(Результат.request_xml);
	Пакет.Проверить(Снимок.Объект);
	Возврат Пакет;
КонецФункции

Функция ИзменениеОбщегоМодуля(Снимок, Контекст, ТекстМодуля, ИмяХранилища, ВерсияПлатформы, ПутьPython, XMLОбъекта = Неопределено) Экспорт
	Параметры = Новый Структура;
	Параметры.Вставить("platform", ВерсияПлатформы);
	Параметры.Вставить("object_id", Строка(Снимок.Объект.Идентификатор));
	Параметры.Вставить("original_version", Снимок.Объект.ИсходнаяВерсия);
	Параметры.Вставить("snapshot", Base64Строка(Снимок.ПакетСнимков));
	Параметры.Вставить("context", Base64Строка(Контекст));
	Параметры.Вставить("source_text", ТекстМодуля);
	Если XMLОбъекта <> Неопределено Тогда Параметры.Вставить("object_xml", XMLОбъекта); КонецЕсли;
	Результат = ВыполнитьPython(Параметры, ПутьPython, "commonmodule_serializer.py");
	Возврат Новый ПакетИзмененияОбщегоМодуля(Результат, Снимок, ИмяХранилища, ВерсияПлатформы);
КонецФункции

Функция ВнешниеДанныеИзВерсии(ПакетВерсии, Объект, ПутьPython) Экспорт
	Параметры = Новый Структура("storage,object_id", Base64Строка(ПакетВерсии), Строка(Объект.Идентификатор));
	Возврат ВыполнитьPython(Параметры, ПутьPython, "external_data.py");
КонецФункции

Функция ПолеРеквизитаНаФорме(Снимок, Контекст, ПакетВерсии, ИмяРеквизита, ИмяХранилища, ВерсияПлатформы, ПутьPython, XMLФормы = Неопределено, ТекстМодуля = Неопределено, XMLОписания = Неопределено) Экспорт
	Параметры = Новый Структура;
	Параметры.Вставить("platform", ВерсияПлатформы);
	Параметры.Вставить("object_id", Строка(Снимок.Объект.Идентификатор));
	Параметры.Вставить("original_version", Снимок.Объект.ИсходнаяВерсия);
	Параметры.Вставить("snapshot", Base64Строка(Снимок.ПакетСнимков));
	Параметры.Вставить("context", Base64Строка(Контекст));
	Параметры.Вставить("storage", Base64Строка(ПакетВерсии));
	Параметры.Вставить("attribute_name", ИмяРеквизита);
	Если XMLФормы <> Неопределено Тогда Параметры.Вставить("form_xml", XMLФормы); КонецЕсли;
	Если XMLОписания <> Неопределено Тогда Параметры.Вставить("definition_xml", XMLОписания); КонецЕсли;
	Если ТекстМодуля <> Неопределено Тогда Параметры.Вставить("module_text", ТекстМодуля); КонецЕсли;
	Результат = ВыполнитьPython(Параметры, ПутьPython, "managed_form_change.py");
	Возврат Новый ПакетИзмененияФормы(Результат, Снимок, ИмяХранилища, ВерсияПлатформы);
КонецФункции

Функция СозданиеРеквизитаСправочника(Снимок, Контекст, ИмяРеквизита, ДлинаСтроки, ИмяХранилища, ВерсияПлатформы, ПутьPython, XMLОбъекта = Неопределено) Экспорт
	Параметры = Новый Структура;
	Параметры.Вставить("platform", ВерсияПлатформы); Параметры.Вставить("repository", ИмяХранилища);
	Параметры.Вставить("repository_version", Снимок.ВерсияХранилища);
	Параметры.Вставить("object_id", Строка(Снимок.Объект.Идентификатор));
	Параметры.Вставить("original_version", Снимок.Объект.ИсходнаяВерсия);
	Параметры.Вставить("snapshot", Base64Строка(Снимок.ПакетСнимков));
	Параметры.Вставить("context", Base64Строка(Контекст));
	Параметры.Вставить("name", ИмяРеквизита); Параметры.Вставить("length", ДлинаСтроки);
	Если XMLОбъекта <> Неопределено Тогда Параметры.Вставить("object_xml", XMLОбъекта); КонецЕсли;
	Результат = ВыполнитьPython(Параметры, ПутьPython, "catalog_attribute_serializer.py");
	Пакет = Новый ПакетПомещенияОбъекта; Пакет.ЗаполнитьИзЗапроса(Результат.request_xml);
	Пакет.Проверить(Снимок.Объект);
	Если Результат.Свойство("attribute_id") Тогда Пакет.ИдентификаторРеквизита = Результат.attribute_id; КонецЕсли;
	Возврат Пакет;
КонецФункции

Функция СозданиеФормыСправочника(Снимок, Контекст, ИмяФормы, ИмяХранилища, ВерсияПлатформы, ПутьPython) Экспорт
	Возврат СозданиеУправляемойФормы(Снимок, Контекст, ИмяФормы, ИмяХранилища, ВерсияПлатформы, ПутьPython, "Catalog");
КонецФункции

Функция СозданиеУправляемойФормы(Снимок, Контекст, ИмяФормы, ИмяХранилища, ВерсияПлатформы, ПутьPython, ВидФормы = "Catalog", XMLФормы = Неопределено, ТекстМодуля = Неопределено, XMLОписания = Неопределено) Экспорт
	Параметры = Новый Структура;
	Параметры.Вставить("form_kind", ВидФормы);
	Параметры.Вставить("platform", ВерсияПлатформы);
	Параметры.Вставить("object_id", Строка(Снимок.Объект.Идентификатор));
	Параметры.Вставить("original_version", Снимок.Объект.ИсходнаяВерсия);
	Параметры.Вставить("snapshot", Base64Строка(Снимок.ПакетСнимков));
	Параметры.Вставить("context", Base64Строка(Контекст));
	Параметры.Вставить("name", ИмяФормы);
	Если XMLФормы <> Неопределено Тогда Параметры.Вставить("form_xml", XMLФормы); КонецЕсли;
	Если XMLОписания <> Неопределено Тогда Параметры.Вставить("definition_xml", XMLОписания); КонецЕсли;
	Если ТекстМодуля <> Неопределено Тогда Параметры.Вставить("module_text", ТекстМодуля); КонецЕсли;
	Результат = ВыполнитьPython(Параметры, ПутьPython, "managed_form_serializer.py");
	Снимки = Новый Массив; Снимки.Добавить(Снимок);
	Если ВидФормы = "Document" Тогда Возврат Новый ПакетСозданияФормыДокумента(Результат, Снимки, ИмяХранилища, ВерсияПлатформы); КонецЕсли;
	Если ВидФормы = "CommonForm" Тогда Возврат Новый ПакетСозданияОбщейФормы(Результат, Снимки, ИмяХранилища, ВерсияПлатформы); КонецЕсли;
	Возврат Новый ПакетСозданияФормыСправочника(Результат, Снимки, ИмяХранилища, ВерсияПлатформы);
КонецФункции

Функция ДочерниеОбъектыДляСоздания(Контекст, Корень, ПутьPython) Экспорт
	Параметры = Новый Структура("mode,context,object_id", "inspect", Base64Строка(Контекст), Строка(Корень.Идентификатор));
	Возврат ВыполнитьPython(Параметры, ПутьPython, "constant_serializer.py").children;
КонецФункции

Функция СозданиеКонстантыИзXML(Снимки, Контекст, XMLКонстанты, ИмяХранилища, ВерсияПлатформы, ПутьPython) Экспорт
	Возврат СозданиеОбъектаИзXML(Снимки, Контекст, XMLКонстанты, ИмяХранилища, ВерсияПлатформы, ПутьPython, "Constant");
КонецФункции

Функция СозданиеОбъектаИзXML(Снимки, Контекст, XMLОбъекта, ИмяХранилища, ВерсияПлатформы, ПутьPython, ВидОбъекта, ТекстМодуля = Неопределено) Экспорт
	Корень = Снимки[0];
	Параметры = Новый Структура;
	Параметры.Вставить("platform", ВерсияПлатформы);
	Параметры.Вставить("repository", ИмяХранилища);
	Параметры.Вставить("repository_version", Корень.ВерсияХранилища);
	Параметры.Вставить("object_id", Строка(Корень.Объект.Идентификатор));
	Параметры.Вставить("context", Base64Строка(Контекст));
	Параметры.Вставить("object_type", ВидОбъекта);
	Если ВидОбъекта = "CommonModule" Тогда Параметры.Вставить("source_text", ТекстМодуля); КонецЕсли;
	Параметры.Вставить(НРег(ВидОбъекта) + "_xml", XMLОбъекта);
	ДанныеСнимков = Новый Соответствие;
	Для Каждого Снимок Из Снимки Цикл
		Если Снимок.ВерсияХранилища <> Корень.ВерсияХранилища Тогда
			ВызватьИсключение "Версия хранилища изменилась во время чтения снимков.";
		КонецЕсли;
		ДанныеСнимков.Вставить(Строка(Снимок.Объект.Идентификатор), Base64Строка(Снимок.ПакетСнимков));
	КонецЦикла;
	Параметры.Вставить("snapshots", ДанныеСнимков);
	Результат = ВыполнитьPython(Параметры, ПутьPython, "constant_serializer.py");
	Если ВидОбъекта = "CommonModule" Тогда
		Возврат Новый ПакетСозданияОбщегоМодуля(Результат, Снимки, ИмяХранилища, ВерсияПлатформы);
	КонецЕсли;
	Если ВидОбъекта = "Enum" Тогда
		Возврат Новый ПакетСозданияПеречисления(Результат, Снимки, ИмяХранилища, ВерсияПлатформы);
	КонецЕсли;
	Если ВидОбъекта = "Document" Тогда
		Возврат Новый ПакетСозданияДокумента(Результат, Снимки, ИмяХранилища, ВерсияПлатформы);
	КонецЕсли;
	Если ВидОбъекта = "Catalog" Тогда
		Возврат Новый ПакетСозданияСправочника(Результат, Снимки, ИмяХранилища, ВерсияПлатформы);
	КонецЕсли;
	Возврат Новый ПакетСозданияКонстанты(Результат, Снимки, ИмяХранилища, ВерсияПлатформы);
КонецФункции

// Проверяет версии внешнего текста перед формированием запроса помещения.
Процедура ПроверитьВнешниеДанныеСоздания(Пакет) Экспорт
	Если ТипЗнч(Пакет.ВнешниеДанные) <> Тип("Массив") Тогда ВызватьИсключение "Нужен массив внешних данных."; КонецЕсли;
	Имена = Новый Соответствие;
	ЕстьНовый = Ложь;
	Для Каждого Внешний Из Пакет.ВнешниеДанные Цикл
		Объект = Неопределено;
		Для Каждого Кандидат Из Пакет.ОбъектыПакета Цикл
			Если Строка(Кандидат.Идентификатор) = Внешний.object_id Тогда Объект = Кандидат; Прервать; КонецЕсли;
		КонецЦикла;
		ЭтоНовый = Внешний.object_id = Строка(Пакет.ИдентификаторОбъекта);
		ЭтоФорма = ТипЗнч(Пакет) = Тип("ПакетСозданияФормыСправочника") Или ТипЗнч(Пакет) = Тип("ПакетСозданияФормыДокумента") Или ТипЗнч(Пакет) = Тип("ПакетСозданияОбщейФормы");
		ОжидаемоеДействие = ?(ЭтоФорма, 0, 1);
		Если Объект = Неопределено Или (НРег(Строка(Объект.ИдентификаторКласса)) <> ИдентификаторыМетаданных.ИдентификаторКласса("CommonModule")
			И (Не ЭтоФорма Или НРег(Строка(Объект.ИдентификаторКласса)) <> ИдентификаторыМетаданных.ИдентификаторКласса("CatalogForm")
			И НРег(Строка(Объект.ИдентификаторКласса)) <> ИдентификаторыМетаданных.ИдентификаторКласса("DocumentForm")
			И НРег(Строка(Объект.ИдентификаторКласса)) <> ИдентификаторыМетаданных.ИдентификаторКласса("CommonForm")))
			Или Внешний.name <> Внешний.object_id + ".0" Или ТипЗнч(Внешний.version) <> Тип("Строка") Или СтрДлина(Внешний.version) <> 40
			Или (ЭтоНовый И Внешний.action <> ОжидаемоеДействие) Или (Не ЭтоНовый И Внешний.action <> 0) Или Имена.Получить(Внешний.name) <> Неопределено Тогда
			ВызватьИсключение "Некорректное описание внешнего потока объекта.";
		КонецЕсли;
		Для Индекс = 1 По 40 Цикл
			Если СтрНайти("0123456789abcdef", Сред(Внешний.version, Индекс, 1)) = 0 Тогда ВызватьИсключение "Неверная версия внешнего текста."; КонецЕсли;
		КонецЦикла;
		Имена.Вставить(Внешний.name, Истина);
		ЕстьНовый = ЕстьНовый Или ЭтоНовый;
	КонецЦикла;
	Если (ТипЗнч(Пакет) = Тип("ПакетСозданияОбщегоМодуля") Или ТипЗнч(Пакет) = Тип("ПакетСозданияФормыСправочника") Или ТипЗнч(Пакет) = Тип("ПакетСозданияФормыДокумента") Или ТипЗнч(Пакет) = Тип("ПакетСозданияОбщейФормы")) И Не ЕстьНовый Тогда ВызватьИсключение "Отсутствуют внешние данные нового объекта."; КонецЕсли;
КонецПроцедуры

// Читает UUID классов из снимка, включая пустые коллекции.
Функция КлассыМетаданных(Снимок, ВерсияПлатформы, ПутьPython = "python") Экспорт
	Параметры = Новый Структура;
	Параметры.Вставить("snapshot", Base64Строка(Снимок.ПакетСнимков));
	Параметры.Вставить("object_id", Строка(Снимок.Объект.Идентификатор));
	Параметры.Вставить("repository_version", Снимок.ВерсияХранилища);
	Параметры.Вставить("platform", ВерсияПлатформы);
	Возврат ВыполнитьPython(Параметры, ПутьPython, "metadata_classes.py");
КонецФункции

Функция ВыполнитьPython(Параметры, ПутьPython, ИмяСкрипта)
	ПутьЗапроса = ПолучитьИмяВременногоФайла("json");
	ПутьОтвета = ПолучитьИмяВременногоФайла("json");
	Попытка
		Запись = Новый ЗаписьJSON;
		Запись.ОткрытьФайл(ПутьЗапроса);
		ЗаписатьJSON(Запись, Параметры);
		Запись.Закрыть();
		Скрипт = ОбъединитьПути(ТекущийСценарий().Каталог, "..", "Сериализация", ИмяСкрипта);
		Команда = Аргумент(ПутьPython) + " " + Аргумент(Скрипт) + " " + Аргумент(ПутьЗапроса) + " " + Аргумент(ПутьОтвета);
		// Пути пользователя и XML содержатся в JSON, не в командной строке.
		Процесс = СоздатьПроцесс(Команда);
		Процесс.Запустить();
		Если Не Процесс.ОжидатьЗавершения(30000) Тогда
			Процесс.Завершить();
			ВызватьИсключение "Превышено время работы сериализатора.";
		КонецЕсли;
		Если Процесс.КодВозврата <> 0 Тогда
			ВызватьИсключение "Не удалось выполнить Python-сериализатор. Проверьте Python 3.9+ и путь к нему.";
		КонецЕсли;
		Чтение = Новый ЧтениеJSON;
		Чтение.ОткрытьФайл(ПутьОтвета);
		Результат = ПрочитатьJSON(Чтение);
		Чтение.Закрыть();
		Если Не Результат.ok Тогда
			Если ИмяСкрипта = "metadata_classes.py" Тогда
				ВызватьИсключение "Каталог классов не прочитан: " + Результат.error;
			КонецЕсли;
			ВызватьИсключение "Сериализация XML не выполнена: " + Результат.error;
		КонецЕсли;
	Исключение
		УдалитьВременныеФайлы(ПутьЗапроса, ПутьОтвета);
		ВызватьИсключение;
	КонецПопытки;
	УдалитьВременныеФайлы(ПутьЗапроса, ПутьОтвета);
	Возврат Результат;
КонецФункции

Функция Аргумент(Путь)
	Если ТипЗнч(Путь) <> Тип("Строка") Или Не ЗначениеЗаполнено(Путь)
		Или СтрНайти(Путь, """") > 0 Или СтрНайти(Путь, Символы.ПС) > 0 Или СтрНайти(Путь, Символы.ВК) > 0 Тогда
		ВызватьИсключение "Некорректный путь запуска сериализатора.";
	КонецЕсли;
	Возврат """" + Путь + """";
КонецФункции

Процедура УдалитьВременныеФайлы(ПутьЗапроса, ПутьОтвета)
	// Только два созданных файла, без рекурсивного удаления каталога.
	Для Каждого Путь Из СтрРазделить(ПутьЗапроса + Символы.ПС + ПутьОтвета, Символы.ПС) Цикл
		Если Новый Файл(Путь).Существует() Тогда
			УдалитьФайлы(Путь);
		КонецЕсли;
