// Подготовка планов и пакетов по XML-выгрузке; профиль выбирается централизованно.
// Python 3.9+ со стандартной библиотекой; Конфигуратор не запускается.
Функция ПланВыгрузкиКонфигурации(Папка, ИсходнаяПапка, Контекст, ПутьPython = "python") Экспорт
 Возврат ВыполнитьPython(Новый Структура("directory,baseline_directory,context", Папка, ИсходнаяПапка, Base64Строка(Контекст)), ПутьPython, "configuration_export.py");
КонецФункции

Функция ПланПакетаКонфигурации(Папка, ИсходнаяПапка, Контекст, ВерсияПлатформы, ПутьPython) Экспорт
 Возврат ВыполнитьPython(Новый Структура("mode,directory,baseline_directory,context,platform", "plan", Папка, ИсходнаяПапка, Base64Строка(Контекст), ВерсияПлатформы), ПутьPython, "configuration_commit.py");
КонецФункции

Функция ПакетКонфигурации(Снимки, Контекст, Папка, ИсходнаяПапка, План, ИмяХранилища, ВерсияПлатформы, ПутьPython, ПакетВерсии = Неопределено) Экспорт
 СнимкиОбъектов = Новый Соответствие; ИсходныеВерсии = Новый Соответствие;
 Для Каждого Снимок Из Снимки Цикл
  Если Снимок.ВерсияХранилища <> Снимки[0].ВерсияХранилища Тогда ВызватьИсключение "Снимки конфигурации разных версий."; КонецЕсли;
  UUIDОбъекта = Строка(Снимок.Объект.Идентификатор); СнимкиОбъектов.Вставить(UUIDОбъекта, Base64Строка(Снимок.ПакетСнимков)); ИсходныеВерсии.Вставить(UUIDОбъекта, Снимок.Объект.ИсходнаяВерсия);
 КонецЦикла;
 Запрос = Новый Структура("directory,baseline_directory,context,platform,repository,repository_version,snapshots,originals,target_fingerprint,baseline_fingerprint", Папка, ИсходнаяПапка, Base64Строка(Контекст), ВерсияПлатформы, ИмяХранилища, Снимки[0].ВерсияХранилища, СнимкиОбъектов, ИсходныеВерсии, План.target_fingerprint, План.baseline_fingerprint);
 Если ПакетВерсии <> Неопределено Тогда Запрос.Вставить("storage", Base64Строка(ПакетВерсии)); КонецЕсли;
 Результат = ВыполнитьPython(Запрос, ПутьPython, "configuration_commit.py", 600000);
 Пакет = Новый ПакетПомещенияОбъекта; Пакет.ЗаполнитьКонфигурацию(Результат, Снимки); Возврат Пакет;
КонецФункции

Функция ОбъединитьПакетыИзменений(Пакеты, ПутьPython = "python") Экспорт
 Если ТипЗнч(Пакеты) <> Тип("Массив") Или Пакеты.Количество() = 0 Или Пакеты.Количество() > 256 Тогда ВызватьИсключение "Нужны 1..256 пакетов изменений."; КонецЕсли;
 Основа = Пакеты[0]; ДанныеПакетов = Новый Массив;
 Для Каждого Пакет Из Пакеты Цикл
  Если Не ПравилаПакетовХранилища.ЭтоПакет(Пакет, "Изменение") Или Пакет.Групповой() Тогда ВызватьИсключение "Можно объединить отдельные изменения существующих объектов."; КонецЕсли;
  Пакет.Проверить();
  Если Пакет.ИмяХранилища <> Основа.ИмяХранилища Или Пакет.ВерсияПлатформы <> Основа.ВерсияПлатформы Или Пакет.ВерсияХранилища <> Основа.ВерсияХранилища Тогда ВызватьИсключение "Пакеты относятся к разным хранилищам или версиям."; КонецЕсли;
  Описания = Новый Массив;
  Для Каждого Объект Из Пакет.ОбъектыПакета Цикл
   Описания.Добавить(Новый Структура("id,class_id,name,pos,parent_id,owner_id,original,local", Строка(Объект.Идентификатор), Строка(Объект.ИдентификаторКласса), Объект.Имя, Объект.Позиция, Строка(Объект.ИдентификаторРодителя), Строка(Объект.ИдентификаторВладельца), Объект.ИсходнаяВерсия, Объект.ЛокальнаяВерсия));
  КонецЦикла;
  ДанныеПакетов.Добавить(Новый Структура("data,descriptions,externals", Base64Строка(Пакет.Данные), Описания, Пакет.ВнешниеДанные));
 КонецЦикла;
 Запрос = Новый Структура("repository,platform,repository_version,packets", Основа.ИмяХранилища, Основа.ВерсияПлатформы, Основа.ВерсияХранилища, ДанныеПакетов);
 Результат = ВыполнитьPython(Запрос, ПутьPython, "configuration_batch.py");
 Группа = Новый ПакетПомещенияОбъекта; Группа.ЗаполнитьГруппу(Результат, Пакеты); Возврат Группа;
КонецФункции

Функция ПланПодготовкиИзВыгрузки(ПутьXML, Контекст, Параметры, ПутьPython = "python") Экспорт
	Настройки = Новый Структура;
	Если Параметры <> Неопределено Тогда
		Если ТипЗнч(Параметры) <> Тип("Структура") Тогда ВызватьИсключение "Параметры подготовки должны быть структурой."; КонецЕсли;
		Для Каждого Поле Из Параметры Цикл
			Ключ = Поле.Ключ;
			Если Ключ = "Операция" Тогда Настройки.Вставить("operation", Поле.Значение);
			ИначеЕсли Ключ = "ИдентификаторОбъекта" Тогда Настройки.Вставить("object_id", Строка(Поле.Значение));
			ИначеЕсли Ключ = "ИдентификаторРодителя" Тогда Настройки.Вставить("parent_id", Строка(Поле.Значение));
			ИначеЕсли Ключ = "ПутьИсходногоXML" Тогда Настройки.Вставить("before_xml_path", Поле.Значение);
			ИначеЕсли Ключ = "СвязанныеXML" Тогда Настройки.Вставить("related_xml_paths", Поле.Значение);
			Иначе ВызватьИсключение "Неизвестный параметр подготовки: " + Ключ;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат ВыполнитьPython(Новый Структура("xml_path,context,options", ПутьXML, Base64Строка(Контекст), Настройки), ПутьPython, "preparation_plan.py");
КонецФункции

// Общая точка сериализации корня; исходный XML необязателен.
Функция КореньИзXML(Снимок, Контекст, XMLКорня, ИмяХранилища, ВерсияПлатформы, ПутьPython = "python", ИсходныйXML = Неопределено, Режим = "properties") Экспорт
	Если ТипЗнч(Снимок) <> Тип("СнимокОбъектаХранилища") Или ТипЗнч(Контекст) <> Тип("ДвоичныеДанные") Тогда
		ВызватьИсключение "Нужны снимок объекта и бинарный контекст updateInfo.";
	КонецЕсли;
	Снимок.Объект.ПроверитьДляПомещения();
	Параметры = Новый Структура;
	Параметры.Вставить("mode", Режим);
	Параметры.Вставить("platform", ВерсияПлатформы);
	Параметры.Вставить("repository", ИмяХранилища);
	Параметры.Вставить("repository_version", Снимок.ВерсияХранилища);
	Параметры.Вставить("object_id", Строка(Снимок.Объект.Идентификатор));
	Параметры.Вставить("original_version", Снимок.Объект.ИсходнаяВерсия);
	Параметры.Вставить("snapshot", Base64Строка(Снимок.ПакетСнимков));
	Параметры.Вставить("context", Base64Строка(Контекст));
	Если ИсходныйXML <> Неопределено Тогда Параметры.Вставить("before_xml", ИсходныйXML); КонецЕсли;
	Параметры.Вставить("after_xml", XMLКорня);
	Результат = ВыполнитьPython(Параметры, ПутьPython, "configuration_serializer.py");
	Пакет = Новый ПакетПомещенияОбъекта;
	Пакет.ЗаполнитьИзЗапроса(Результат.request_xml);
	Пакет.Проверить(Снимок.Объект);
	Возврат Пакет;
КонецФункции

Функция ИзменениеОбщегоМодуля(Снимок, Контекст, ТекстМодуля, ИмяХранилища, ВерсияПлатформы, ПутьPython, XMLОбъекта = Неопределено) Экспорт
	Параметры = Новый Структура;
	Параметры.Вставить("platform", ВерсияПлатформы);
	Параметры.Вставить("object_id", Строка(Снимок.Объект.Идентификатор));
	Параметры.Вставить("original_version", Снимок.Объект.ИсходнаяВерсия);
	Параметры.Вставить("snapshot", Base64Строка(Снимок.ПакетСнимков));
	Параметры.Вставить("context", Base64Строка(Контекст));
	Параметры.Вставить("source_text", ТекстМодуля);
	Если XMLОбъекта <> Неопределено Тогда Параметры.Вставить("object_xml", XMLОбъекта); КонецЕсли;
	Результат = ВыполнитьPython(Параметры, ПутьPython, "commonmodule_serializer.py");
	Возврат Новый ПакетПомещенияОбъекта(Результат, Снимок, ИмяХранилища, ВерсияПлатформы, ПравилаПакетовХранилища.Параметры("Изменение", "CommonModule"));
КонецФункции

Функция ИзменениеСУдалениями(Снимки, Контекст, План, ИмяХранилища, ВерсияПлатформы, ПутьPython, ПакетВерсии = Неопределено) Экспорт
	Параметры = Новый Структура("platform,repository,repository_version,parent_id,original_version,snapshot,context,object_xml,removed_ids,modules,inline_modules", ВерсияПлатформы, ИмяХранилища, Снимки[0].ВерсияХранилища, Строка(Снимки[0].Объект.Идентификатор), Снимки[0].Объект.ИсходнаяВерсия, Base64Строка(Снимки[0].ПакетСнимков), Base64Строка(Контекст), План.object_xml, План.removed_ids, План.modules, План.inline_modules);
	СнимкиУдаления = Новый Соответствие;
	Параметры.Вставить("file_data", План.file_data);
	Если План.before_xml <> Неопределено Тогда Параметры.Вставить("before_xml", План.before_xml); КонецЕсли;
	Для Индекс = 1 По Снимки.Количество() - 1 Цикл СнимкиУдаления.Вставить(Строка(Снимки[Индекс].Объект.Идентификатор), Base64Строка(Снимки[Индекс].ПакетСнимков)); КонецЦикла;
	Параметры.Вставить("snapshots", СнимкиУдаления);
	Если ПакетВерсии <> Неопределено Тогда Параметры.Вставить("storage", Base64Строка(ПакетВерсии)); КонецЕсли;
	Результат = ВыполнитьPython(Параметры, ПутьPython, "automatic_deletion.py");
	Возврат Новый ПакетПомещенияОбъекта(Результат, Снимки, ИмяХранилища, ВерсияПлатформы, ПравилаПакетовХранилища.Параметры("Удаление", ПравилаПакетовХранилища.ВидПоКлассу(Снимки[1].Объект.ИдентификаторКласса)));
КонецФункции

Функция УдалениеОбъекта(СнимокРодителя, СнимокОбъекта, Контекст, XMLРодителя, ИмяХранилища, ВерсияПлатформы, ПутьPython, ПакетВерсии = Неопределено) Экспорт
	Параметры = Новый Структура;
	Параметры.Вставить("platform", ВерсияПлатформы); Параметры.Вставить("object_id", Строка(СнимокОбъекта.Объект.Идентификатор));
	Параметры.Вставить("original_version", СнимокРодителя.Объект.ИсходнаяВерсия); Параметры.Вставить("object_original_version", СнимокОбъекта.Объект.ИсходнаяВерсия);
	Параметры.Вставить("snapshot", Base64Строка(СнимокРодителя.ПакетСнимков)); Параметры.Вставить("object_snapshot", Base64Строка(СнимокОбъекта.ПакетСнимков));
	Параметры.Вставить("context", Base64Строка(Контекст)); Параметры.Вставить("object_xml", XMLРодителя);
	Если ПакетВерсии <> Неопределено Тогда Параметры.Вставить("storage", Base64Строка(ПакетВерсии)); КонецЕсли;
	Результат = ВыполнитьPython(Параметры, ПутьPython, "delete_object_serializer.py");
	Снимки = Новый Массив; Снимки.Добавить(СнимокРодителя); Снимки.Добавить(СнимокОбъекта);
	Возврат Новый ПакетПомещенияОбъекта(Результат, Снимки, ИмяХранилища, ВерсияПлатформы, ПравилаПакетовХранилища.Параметры("Удаление", ПравилаПакетовХранилища.ВидПоКлассу(Строка(СнимокОбъекта.Объект.ИдентификаторКласса))));
КонецФункции

Функция МакетСКДИзXML(Снимок, Контекст, ПакетВерсии, План, ИмяХранилища, ВерсияПлатформы, ПутьPython) Экспорт
	Параметры = Новый Структура("platform,operation,object_id,original_version,snapshot,context,definition_xml", ВерсияПлатформы, План.operation, Строка(Снимок.Объект.Идентификатор), Снимок.Объект.ИсходнаяВерсия, Base64Строка(Снимок.ПакетСнимков), Base64Строка(Контекст), План.object_xml);
	Содержимое = Неопределено;
	Если План.Свойство("template_xml", Содержимое) Тогда Параметры.Вставить("template_xml", Содержимое); КонецЕсли;
	Если План.Свойство("template_data", Содержимое) Тогда Параметры.Вставить("template_data", Содержимое); КонецЕсли;
	Если ПакетВерсии <> Неопределено Тогда Параметры.Вставить("storage", Base64Строка(ПакетВерсии)); КонецЕсли;
	Результат = ВыполнитьPython(Параметры, ПутьPython, "template_serializer.py");
	Возврат Новый ПакетПомещенияОбъекта(Результат, Снимок, ИмяХранилища, ВерсияПлатформы, ПравилаПакетовХранилища.Параметры(План.operation, План.kind));
КонецФункции

Функция ВнешниеДанныеИзВерсии(ПакетВерсии, Объект, ПутьPython) Экспорт
	Параметры = Новый Структура("storage,object_id", Base64Строка(ПакетВерсии), Строка(Объект.Идентификатор));
	Возврат ВыполнитьPython(Параметры, ПутьPython, "external_data.py");
КонецФункции

Функция ИзменениеПоПлану(Снимок, Контекст, План, ИмяХранилища, ВерсияПлатформы, ПутьPython, ПакетВерсии = Неопределено) Экспорт
	ОпределенияМетаданных = Неопределено;
	План.Свойство("metadata_definitions", ОпределенияМетаданных);
	Если План.operation <> "Изменение" Или План.kind <> ПравилаПакетовХранилища.ВидПоКлассу(Строка(Снимок.Объект.ИдентификаторКласса)) Тогда
		ВызватьИсключение "План изменения не соответствует классу объекта.";
	КонецЕсли;
	Если План.kind = "Configuration" Тогда
		Возврат КореньИзXML(Снимок, Контекст, План.object_xml, ИмяХранилища, ВерсияПлатформы, ПутьPython, План.before_xml);
	ИначеЕсли План.kind = "CommonModule" Тогда
		Возврат ИзменениеОбщегоМодуля(Снимок, Контекст, План.module_text, ИмяХранилища, ВерсияПлатформы, ПутьPython, План.object_xml);
	ИначеЕсли План.kind = "Template" Или План.kind = "CommonTemplate" Тогда
		Возврат МакетСКДИзXML(Снимок, Контекст, ПакетВерсии, План, ИмяХранилища, ВерсияПлатформы, ПутьPython);
	ИначеЕсли Не ПравилаПакетовХранилища.ЭтоФорма(План.kind) Тогда
		Возврат ИзменениеОбъектаИзXML(Снимок, Контекст, План.object_xml, План.modules, ИмяХранилища, ВерсияПлатформы, ПутьPython, План.inline_modules, План.before_xml, ПакетВерсии, План.file_data, ОпределенияМетаданных);
	КонецЕсли;
	Если ТипЗнч(ПакетВерсии) <> Тип("ДвоичныеДанные") Тогда ВызватьИсключение "Для изменения формы нужен пакет текущей версии."; КонецЕсли;
	Параметры = Новый Структура;
	Параметры.Вставить("platform", ВерсияПлатформы);
	Параметры.Вставить("object_id", Строка(Снимок.Объект.Идентификатор));
	Параметры.Вставить("original_version", Снимок.Объект.ИсходнаяВерсия);
	Параметры.Вставить("snapshot", Base64Строка(Снимок.ПакетСнимков));
	Параметры.Вставить("context", Base64Строка(Контекст));
	Параметры.Вставить("storage", Base64Строка(ПакетВерсии));
	Если План.form_xml <> Неопределено Тогда Параметры.Вставить("form_xml", План.form_xml); КонецЕсли;
	Если План.object_xml <> Неопределено Тогда Параметры.Вставить("definition_xml", План.object_xml); КонецЕсли;
	Если План.module_text <> Неопределено Тогда Параметры.Вставить("module_text", План.module_text); КонецЕсли;
	Параметры.Вставить("operation", "Изменение");
	Результат = ВыполнитьPython(Параметры, ПутьPython, "managed_form_operations.py");
	Возврат Новый ПакетПомещенияОбъекта(Результат, Снимок, ИмяХранилища, ВерсияПлатформы, ПравилаПакетовХранилища.Параметры("Изменение", ПравилаПакетовХранилища.ВидПоКлассу(Строка(Снимок.Объект.ИдентификаторКласса))));
КонецФункции

Функция ИзменениеОбъектаИзXML(Снимок, Контекст, XMLОбъекта, Модули, ИмяХранилища, ВерсияПлатформы, ПутьPython, МодулиКоманд = Неопределено, ИсходныйXML = Неопределено, ПакетВерсии = Неопределено, ДанныеФайлов = Неопределено, ОпределенияМетаданных = Неопределено) Экспорт
	Параметры = Новый Структура;
	Параметры.Вставить("platform", ВерсияПлатформы); Параметры.Вставить("repository", ИмяХранилища);
	Параметры.Вставить("repository_version", Снимок.ВерсияХранилища);
	Параметры.Вставить("object_id", Строка(Снимок.Объект.Идентификатор));
	Параметры.Вставить("object_type", ПравилаПакетовХранилища.ВидПоКлассу(Строка(Снимок.Объект.ИдентификаторКласса)));
	Параметры.Вставить("original_version", Снимок.Объект.ИсходнаяВерсия);
	Параметры.Вставить("snapshot", Base64Строка(Снимок.ПакетСнимков));
	Параметры.Вставить("context", Base64Строка(Контекст));
	Параметры.Вставить("object_xml", XMLОбъекта); Параметры.Вставить("modules", Модули);
	Если ДанныеФайлов <> Неопределено Тогда Параметры.Вставить("file_data", ДанныеФайлов); КонецЕсли;
	Если ОпределенияМетаданных <> Неопределено Тогда Параметры.Вставить("metadata_definitions", ОпределенияМетаданных); КонецЕсли;
	Если МодулиКоманд <> Неопределено Тогда Параметры.Вставить("inline_modules", МодулиКоманд); КонецЕсли;
	Если ИсходныйXML <> Неопределено Тогда Параметры.Вставить("before_xml", ИсходныйXML); КонецЕсли;
	Если ПакетВерсии <> Неопределено Тогда Параметры.Вставить("storage", Base64Строка(ПакетВерсии)); КонецЕсли;
	Результат = ВыполнитьPython(Параметры, ПутьPython, "object_change_serializer.py");
	Пакет = Новый ПакетПомещенияОбъекта; Пакет.ЗаполнитьИзЗапроса(Результат.request_xml, Результат.external_owners);
	Пакет.Проверить(Снимок.Объект);
	Возврат Пакет;
КонецФункции

Функция ОбъектыСсылокФормы(XMLФормы, Контекст, ПутьPython) Экспорт
	Возврат ВыполнитьPython(Новый Структура("xml,context", XMLФормы, Base64Строка(Контекст)), ПутьPython, "metadata_references.py");
КонецФункции

Функция СозданиеУправляемойФормы(Снимок, Контекст, ИмяФормы, ИмяХранилища, ВерсияПлатформы, ПутьPython, ВидФормы = "Catalog", XMLФормы = Неопределено, ТекстМодуля = Неопределено, XMLОписания = Неопределено, СнимкиСсылок = Неопределено, ПакетВерсии = Неопределено) Экспорт
	Параметры = Новый Структура;
	Параметры.Вставить("form_kind", ВидФормы);
	Параметры.Вставить("platform", ВерсияПлатформы);
	Параметры.Вставить("object_id", Строка(Снимок.Объект.Идентификатор));
	Параметры.Вставить("original_version", Снимок.Объект.ИсходнаяВерсия);
	Параметры.Вставить("snapshot", Base64Строка(Снимок.ПакетСнимков));
	Параметры.Вставить("context", Base64Строка(Контекст));
	Параметры.Вставить("name", ИмяФормы);
	Если XMLФормы <> Неопределено Тогда Параметры.Вставить("form_xml", XMLФормы); КонецЕсли;
	Если XMLОписания <> Неопределено Тогда Параметры.Вставить("definition_xml", XMLОписания); КонецЕсли;
	Если ТекстМодуля <> Неопределено Тогда Параметры.Вставить("module_text", ТекстМодуля); КонецЕсли;
	Если СнимкиСсылок <> Неопределено Тогда Параметры.Вставить("reference_snapshots", СнимкиСсылок); КонецЕсли;
	Если ПакетВерсии <> Неопределено Тогда Параметры.Вставить("storage", Base64Строка(ПакетВерсии)); КонецЕсли;
	Параметры.Вставить("operation", "Создание");
	Результат = ВыполнитьPython(Параметры, ПутьPython, "managed_form_operations.py");
	Снимки = Новый Массив; Снимки.Добавить(Снимок);
	Класс = ?(ВидФормы = "CommonForm", "CommonForm", ВидФормы + "Form");
	Возврат Новый ПакетПомещенияОбъекта(Результат, Снимки, ИмяХранилища, ВерсияПлатформы, ПравилаПакетовХранилища.Параметры("Создание", Класс));
КонецФункции

Функция ДочерниеОбъектыДляСоздания(Контекст, Корень, ПутьPython) Экспорт
	Параметры = Новый Структура("mode,context,object_id", "inspect", Base64Строка(Контекст), Строка(Корень.Идентификатор));
	Возврат ВыполнитьPython(Параметры, ПутьPython, "object_creation_serializer.py").children;
КонецФункции

Функция СозданиеОбъектаИзXML(Снимки, Контекст, XMLОбъекта, ИмяХранилища, ВерсияПлатформы, ПутьPython, ВидОбъекта, ТекстМодуля = Неопределено, Формы = Неопределено, Модули = Неопределено, СвязанныеОбъекты = Неопределено, МодулиКоманд = Неопределено, Макеты = Неопределено, ПакетВерсии = Неопределено, ДанныеФайлов = Неопределено, ОпределенияМетаданных = Неопределено) Экспорт
	Корень = Снимки[0];
	Параметры = Новый Структура;
	Параметры.Вставить("platform", ВерсияПлатформы);
	Параметры.Вставить("repository", ИмяХранилища);
	Параметры.Вставить("repository_version", Корень.ВерсияХранилища);
	Параметры.Вставить("object_id", Строка(Корень.Объект.Идентификатор));
	Параметры.Вставить("context", Base64Строка(Контекст));
	Параметры.Вставить("object_type", ВидОбъекта);
	Если Формы <> Неопределено Тогда Параметры.Вставить("forms", Формы); КонецЕсли;
	Если Макеты <> Неопределено Тогда Параметры.Вставить("templates", Макеты); КонецЕсли;
	Если ПакетВерсии <> Неопределено Тогда Параметры.Вставить("storage", Base64Строка(ПакетВерсии)); КонецЕсли;
	Если Модули <> Неопределено Тогда Параметры.Вставить("modules", Модули); КонецЕсли;
	Если ДанныеФайлов <> Неопределено Тогда Параметры.Вставить("file_data", ДанныеФайлов); КонецЕсли;
	Если ОпределенияМетаданных <> Неопределено Тогда Параметры.Вставить("metadata_definitions", ОпределенияМетаданных); КонецЕсли;
	Если СвязанныеОбъекты <> Неопределено Тогда Параметры.Вставить("related_objects", СвязанныеОбъекты); КонецЕсли;
	Если МодулиКоманд <> Неопределено Тогда Параметры.Вставить("inline_modules", МодулиКоманд); КонецЕсли;
	Если ВидОбъекта = "CommonModule" Тогда Параметры.Вставить("source_text", ТекстМодуля); КонецЕсли;
	Параметры.Вставить("object_xml", XMLОбъекта);
	ДанныеСнимков = Новый Соответствие;
	Для Каждого Снимок Из Снимки Цикл
		Если Снимок.ВерсияХранилища <> Корень.ВерсияХранилища Тогда
			ВызватьИсключение "Версия хранилища изменилась во время чтения снимков.";
		КонецЕсли;
		ДанныеСнимков.Вставить(Строка(Снимок.Объект.Идентификатор), Base64Строка(Снимок.ПакетСнимков));
	КонецЦикла;
	Параметры.Вставить("snapshots", ДанныеСнимков);
	Результат = ВыполнитьPython(Параметры, ПутьPython, "object_creation_serializer.py");
	Возврат Новый ПакетПомещенияОбъекта(Результат, Снимки, ИмяХранилища, ВерсияПлатформы, ПравилаПакетовХранилища.Параметры("Создание", ВидОбъекта));
КонецФункции

// Проверяет версии внешнего текста перед формированием запроса помещения.
Процедура ПроверитьВнешниеДанныеСоздания(Пакет, НуженНовый = Истина) Экспорт
	Если ТипЗнч(Пакет.ВнешниеДанные) <> Тип("Массив") Тогда ВызватьИсключение "Нужен массив внешних данных."; КонецЕсли;
	Имена = Новый Соответствие;
	ЕстьНовый = Ложь;
	Для Каждого Внешний Из Пакет.ВнешниеДанные Цикл
		Объект = Неопределено;
		Для Каждого Кандидат Из Пакет.ОбъектыПакета Цикл
			Если Строка(Кандидат.Идентификатор) = Внешний.object_id Тогда Объект = Кандидат; Прервать; КонецЕсли;
		КонецЦикла;
		ЭтоВложенныйОбъект = Объект <> Неопределено
			И (ПравилаПакетовХранилища.ЭтоФорма(ПравилаПакетовХранилища.ВидПоКлассу(Объект.ИдентификаторКласса)) Или НРег(Строка(Объект.ИдентификаторКласса)) = ИдентификаторыМетаданных.ИдентификаторКласса("Template"))
			И Строка(Объект.ИдентификаторРодителя) = Строка(Пакет.ИдентификаторОбъекта);
		ЭтоНовый = Внешний.object_id = Строка(Пакет.ИдентификаторОбъекта) Или ЭтоВложенныйОбъект;
		ЭтоФормаИлиМакет = ЭтоВложенныйОбъект Или СтрНайти("," + ПравилаПакетовХранилища.КлассыФорм() + ",Template,CommonTemplate,", "," + Пакет.ВидМетаданных() + ",") > 0;
		ОжидаемоеДействие = ?(ЭтоФормаИлиМакет, 0, 1);
		ПоддержанПоток = Ложь;
		Профиль = Неопределено; Модули = Неопределено;
		Для Каждого Исходный Из Пакет.СуществующиеОбъекты Цикл
			Если Строка(Исходный.Идентификатор) = Внешний.object_id И Лев(Внешний.name, СтрДлина(Внешний.object_id) + 1) = Внешний.object_id + "." Тогда ПоддержанПоток = Истина; КонецЕсли;
		КонецЦикла;
		Если Объект <> Неопределено Тогда
			Вид = ПравилаПакетовХранилища.ВидПоКлассу(Объект.ИдентификаторКласса);
			Если Вид = "CommonModule" Или (ЭтоФормаИлиМакет И СтрНайти("," + ПравилаПакетовХранилища.КлассыФорм() + ",Template,CommonTemplate,", "," + Вид + ",") > 0) Тогда ПоддержанПоток = ПоддержанПоток Или Внешний.name = Внешний.object_id + ".0";
			ИначеЕсли ПравилаПакетовХранилища.ПрофилиСозданияОбъектов().Свойство(Вид, Профиль) И Профиль.Свойство("modules", Модули) Тогда
				Для Каждого Модуль Из Модули Цикл Если Внешний.name = Внешний.object_id + Модуль.Значение Тогда ПоддержанПоток = Истина; КонецЕсли; КонецЦикла;
				Файлы = Неопределено;
				Если Профиль.Свойство("files", Файлы) Тогда
					Для Каждого Файл Из Файлы Цикл
						Если Внешний.name = Внешний.object_id + Файл.Значение.suffix Тогда ПоддержанПоток = Истина; КонецЕсли;
					КонецЦикла;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		Для Каждого Встроенный Из Пакет.ПотокиВстроенныхОбъектов Цикл
			Если Встроенный.object_id = Внешний.object_id И Встроенный.name = Внешний.name И Объект <> Неопределено Тогда
				Вид = ПравилаПакетовХранилища.ВидПоКлассу(Объект.ИдентификаторКласса);
				Профиль = Неопределено; Суффиксы = Неопределено;
				Если ПравилаПакетовХранилища.ПрофилиСозданияОбъектов().Свойство(Вид, Профиль) И Профиль.Свойство("inline_module_suffixes", Суффиксы) Тогда
					ПроверкаUUID = Новый УникальныйИдентификатор(Лев(Внешний.name, 36));
					Для Каждого Суффикс Из Суффиксы Цикл Если Сред(Внешний.name, 37) = Суффикс Тогда ПоддержанПоток = Истина; КонецЕсли; КонецЦикла;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		Если Не ПоддержанПоток Или ТипЗнч(Внешний.version) <> Тип("Строка") Или СтрДлина(Внешний.version) <> 40
			Или (ЭтоНовый И Внешний.action <> ОжидаемоеДействие) Или (Не ЭтоНовый И Внешний.action <> 0 И (Пакет.ВидОперации() <> "Удаление" Или Внешний.action <> 1)) Или Имена.Получить(Внешний.name) <> Неопределено Тогда
			ВызватьИсключение "Некорректное описание внешнего потока объекта.";
		КонецЕсли;
		Для Индекс = 1 По 40 Цикл
			Если СтрНайти("0123456789abcdef", Сред(Внешний.version, Индекс, 1)) = 0 Тогда ВызватьИсключение "Неверная версия внешнего текста."; КонецЕсли;
		КонецЦикла;
		Имена.Вставить(Внешний.name, Истина);
		ЕстьНовый = ЕстьНовый Или ЭтоНовый;
	КонецЦикла;
	Если НуженНовый И (Пакет.ВидМетаданных() = "CommonModule" Или СтрНайти("," + ПравилаПакетовХранилища.КлассыФорм() + ",Template,CommonTemplate,", "," + Пакет.ВидМетаданных() + ",") > 0) И Не ЕстьНовый Тогда ВызватьИсключение "Отсутствуют внешние данные нового объекта."; КонецЕсли;
	Если ПравилаПакетовХранилища.ПрофилиСозданияОбъектов().Свойство(Пакет.ВидМетаданных()) Тогда
		Для Каждого Объект Из Пакет.ОбъектыПакета Цикл
			Если Строка(Объект.ИдентификаторРодителя) = Строка(Пакет.ИдентификаторОбъекта)
				И (ПравилаПакетовХранилища.ЭтоФорма(ПравилаПакетовХранилища.ВидПоКлассу(Объект.ИдентификаторКласса)) Или НРег(Строка(Объект.ИдентификаторКласса)) = ИдентификаторыМетаданных.ИдентификаторКласса("Template"))
				И Имена.Получить(Строка(Объект.Идентификатор) + ".0") = Неопределено Тогда ВызватьИсключение "Отсутствуют внешние данные вложенного объекта."; КонецЕсли;
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

// Читает UUID классов из снимка, включая пустые коллекции.
Функция КлассыМетаданных(Снимок, ВерсияПлатформы, ПутьPython = "python") Экспорт
	Параметры = Новый Структура;
	Параметры.Вставить("snapshot", Base64Строка(Снимок.ПакетСнимков));
	Параметры.Вставить("object_id", Строка(Снимок.Объект.Идентификатор));
	Параметры.Вставить("repository_version", Снимок.ВерсияХранилища);
	Параметры.Вставить("platform", ВерсияПлатформы);
	Возврат ВыполнитьPython(Параметры, ПутьPython, "metadata_classes.py");
КонецФункции

Функция ВыполнитьPython(Параметры, ПутьPython, ИмяСкрипта, ВремяОжидания = 30000)
	ПутьЗапроса = ПолучитьИмяВременногоФайла("json");
	ПутьОтвета = ПолучитьИмяВременногоФайла("json");
	Чтение = Неопределено; Запись = Неопределено;
	Попытка
		Запись = Новый ЗаписьJSON;
		Запись.ОткрытьФайл(ПутьЗапроса);
		ЗаписатьJSON(Запись, Параметры);
		Запись.Закрыть();
		Запись = Неопределено;
		Скрипт = ОбъединитьПути(ТекущийСценарий().Каталог, "..", "Сериализация", ИмяСкрипта);
		Команда = Аргумент(ПутьPython) + " " + Аргумент(Скрипт) + " " + Аргумент(ПутьЗапроса) + " " + Аргумент(ПутьОтвета);
		// Пути пользователя и XML содержатся в JSON, не в командной строке.
		Процесс = СоздатьПроцесс(Команда);
		Процесс.Запустить();
		Если Не Процесс.ОжидатьЗавершения(ВремяОжидания) Тогда
			Процесс.Завершить();
			ВызватьИсключение "Превышено время работы сериализатора.";
		КонецЕсли;
		Если Процесс.КодВозврата <> 0 Тогда
			ВызватьИсключение "Не удалось выполнить Python-сериализатор. Проверьте Python 3.9+ и путь к нему.";
		КонецЕсли;
		Чтение = Новый ЧтениеJSON;
		Чтение.ОткрытьФайл(ПутьОтвета);
		Результат = ПрочитатьJSON(Чтение);
		Чтение.Закрыть();
		Чтение = Неопределено;
		Если Не Результат.ok Тогда
			Если ИмяСкрипта = "metadata_classes.py" Тогда
				ВызватьИсключение "Каталог классов не прочитан: " + Результат.error;
			КонецЕсли;
			ВызватьИсключение "Сериализация XML не выполнена: " + Результат.error;
		КонецЕсли;
	Исключение
		Если Чтение <> Неопределено Тогда Чтение.Закрыть(); КонецЕсли;
		Если Запись <> Неопределено Тогда Запись.Закрыть(); КонецЕсли;
		УдалитьВременныеФайлы(ПутьЗапроса, ПутьОтвета);
		ВызватьИсключение;
	КонецПопытки;
	УдалитьВременныеФайлы(ПутьЗапроса, ПутьОтвета);
	Возврат Результат;
КонецФункции

Функция Аргумент(Путь)
	Если ТипЗнч(Путь) <> Тип("Строка") Или Не ЗначениеЗаполнено(Путь)
		Или СтрНайти(Путь, """") > 0 Или СтрНайти(Путь, Символы.ПС) > 0 Или СтрНайти(Путь, Символы.ВК) > 0 Тогда
		ВызватьИсключение "Некорректный путь запуска сериализатора.";
	КонецЕсли;
	Возврат """" + Путь + """";
КонецФункции

Процедура УдалитьВременныеФайлы(ПутьЗапроса, ПутьОтвета)
	// Только два созданных файла, без рекурсивного удаления каталога.
	Для Каждого Путь Из СтрРазделить(ПутьЗапроса + Символы.ПС + ПутьОтвета, Символы.ПС) Цикл
		Если Новый Файл(Путь).Существует() Тогда
			УдалитьФайлы(Путь);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры
