// Компиляция XML выполняется только ibcmd-rs; CRS собирает пакет хранилища.
// Полные пакеты снимков одного UUID; Неопределено означает отсутствие объекта.
// Результат: нативные тексты/diff и двоичные данные, без преобразования в XML.
Функция СравнитьСнимкиОбъекта(ИдентификаторОбъекта, До = Неопределено, После = Неопределено, ПутьPython = "python") Экспорт
 Запрос = Новый Структура("object_id", Строка(ИдентификаторОбъекта));
 Если До <> Неопределено Тогда Запрос.Вставить("before", Base64Строка(До.ПакетСнимков)); КонецЕсли;
 Если После <> Неопределено Тогда Запрос.Вставить("after", Base64Строка(После.ПакетСнимков)); КонецЕсли;
 Возврат ВыполнитьPython(Запрос, ПутьPython, "object_changes.py", 600000);
КонецФункции

Функция ЧитаемоеСравнениеСнимков(Запрос, ПутьPython = "python") Экспорт
 Возврат ВыполнитьPython(Запрос, ПутьPython, "object_xml_changes.py", 600000);
КонецФункции

Функция КонтекстЧитаемогоСнимка(Снимок, Платформа, ПутьPython = "python") Экспорт
 Запрос = Новый Структура("mode,object_id,snapshot,platform", "context", Строка(Снимок.Объект.Идентификатор), Base64Строка(Снимок.ПакетСнимков), Платформа);
 Возврат ВыполнитьPython(Запрос, ПутьPython, "object_xml_changes.py", 600000);
КонецФункции

Функция ПотокиСнимка(Снимок, ПутьPython = "python", Полный = Ложь) Экспорт
 Запрос = Новый Структура("mode,object_id,snapshot", "streams", Строка(Снимок.Объект.Идентификатор), Base64Строка(Снимок.ПакетСнимков));
 Запрос.Вставить("complete", Полный);
 Результат = ВыполнитьPython(Запрос, ПутьPython, "object_changes.py", 600000);
 Если Результат.original <> Лев(НРег(Снимок.Объект.ИсходнаяВерсия), 32) Или Результат.local <> Лев(НРег(Снимок.Объект.ЛокальнаяВерсия), 32) Тогда
  ВызватьИсключение "Исторический снимок не соответствует хешам описания объекта.";
 КонецЕсли;
 Возврат Результат.streams;
КонецФункции

Функция ЖурналПодготовки(Запрос, ПутьPython = "python") Экспорт
 Возврат ВыполнитьPython(Запрос, ПутьPython, "preparation_journal.py", 600000);
КонецФункции

Функция КэшКонфигурации(Запрос, ПутьPython = "python") Экспорт
