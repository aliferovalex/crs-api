#Использовать ".."

Функция ПрочитатьНастройки(Путь)
	Чтение = Новый ЧтениеJSON;
	Чтение.ОткрытьФайл(Путь);
	Настройки = ПрочитатьJSON(Чтение);
	Чтение.Закрыть();
	Возврат Настройки;
КонецФункции

Если АргументыКоманднойСтроки.Количество() <> 2 Тогда
	ВызватьИсключение "Укажите пути к JSON с данными администратора и тестового пользователя.";
КонецЕсли;

Администратор = ПрочитатьНастройки(АргументыКоманднойСтроки[0]);
ТестовыйПользователь = ПрочитатьНастройки(АргументыКоманднойСтроки[1]);
АдресХранилища = "http://127.0.0.1:18088/repo/repo.1ccr";
ВерсияПлатформы = "8.5.4.1878";

Клиент = Новый КлиентХранилища(АдресХранилища, ВерсияПлатформы);
Клиент.Подключиться(Администратор.User, Администратор.Password, Администратор.Repository);
Если Не Клиент.АвторизацияПройдена() Тогда
	ВызватьИсключение "Авторизация администратора не пройдена.";
КонецЕсли;
Сообщить("Авторизация администратора: успешно");

Пользователь = Клиент.НайтиПользователя(ТестовыйПользователь.User);
Если Пользователь = Неопределено Тогда
	Клиент.СоздатьПользователя(ТестовыйПользователь.User,
		ТестовыйПользователь.Password, РолиХранилища.Разработчик);
	Сообщить("Пользователь создан: " + ТестовыйПользователь.User);
Иначе
	Сообщить("Пользователь уже существует: " + ТестовыйПользователь.User);
КонецЕсли;

Пользователь = Клиент.НайтиПользователя(ТестовыйПользователь.User);
Если Пользователь = Неопределено Тогда
	ВызватьИсключение "Созданный пользователь не найден.";
КонецЕсли;
Если Пользователь.Удален Или Пользователь.Роль <> РолиХранилища.Разработчик Тогда
	ВызватьИсключение "Состояние или роль пользователя не соответствует ожидаемым.";
КонецЕсли;
Сообщить("Проверка пользователя: " + Пользователь.Имя + ", роль: " + Пользователь.ПредставлениеРоли());

НовыйКлиент = Новый КлиентХранилища(АдресХранилища, ВерсияПлатформы);
НовыйКлиент.Подключиться(ТестовыйПользователь.User,
	ТестовыйПользователь.Password, Администратор.Repository);
Если Не НовыйКлиент.АвторизацияПройдена() Тогда
	ВызватьИсключение "Вход под созданным пользователем не удался.";
КонецЕсли;
Сообщить("Вход под созданным пользователем: успешно");
